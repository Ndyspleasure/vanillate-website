# Salin file ini menjadi `.env` untuk pengembangan lokal.
# Variabel berawalan PUBLIC_ ikut ter-bundle ke output statis (situs ini tidak
# punya sisi server), jadi jangan pernah menaruh rahasia di sini.

# Nomor WhatsApp Business untuk Support Center (/support).
# Format internasional. Tanda "+", spasi, dan tanda hubung otomatis dibersihkan.
# Kosongkan untuk memakai nilai default di src/data/support.ts.
PUBLIC_SUPPORT_WHATSAPP=6281540040115

# Alamat email support — kanal alternatif dari WhatsApp di halaman yang sama.
PUBLIC_SUPPORT_EMAIL=vanillatestudio@gmail.com
