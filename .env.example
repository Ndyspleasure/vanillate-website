# Salin file ini menjadi `.env` untuk pengembangan lokal.
# Variabel berawalan PUBLIC_ ikut ter-bundle ke output statis (situs ini tidak
# punya sisi server), jadi jangan pernah menaruh rahasia di sini.

# Nomor WhatsApp Business untuk Support Center (/support).
# Format internasional. Tanda "+", spasi, dan tanda hubung otomatis dibersihkan.
# Kosongkan untuk memakai nilai default di src/data/support.ts.
PUBLIC_SUPPORT_WHATSAPP=6281540040115

# Alamat email support — kanal alternatif dari WhatsApp di halaman yang sama.
PUBLIC_SUPPORT_EMAIL=vanillatestudio@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# Panel admin (/admin) — Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Untuk production, isi keduanya sebagai GitHub Actions secret dengan nama yang
# sama persis: Settings -> Secrets and variables -> Actions.
# Bila dikosongkan, halaman /admin menampilkan panduan setup, bukan error.
#
# Anon key memang dirancang untuk publik — yang menjaga data adalah Row Level
# Security di Supabase, bukan kerahasiaan kunci ini. JANGAN PERNAH menaruh
# service_role key di sini: kunci itu mem-bypass RLS dan hanya boleh tinggal di
# server bot serta GitHub Actions secret.
#
# Panduan lengkap: docs/ADMIN-CMS.md
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
