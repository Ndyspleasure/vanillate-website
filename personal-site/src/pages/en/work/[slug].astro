---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import { projects } from '../../../data/projects.ts';
import { site } from '../../../data/content.ts';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const locale = 'en' as const;
const path = `/work/${project.slug}`; // canonical ID path; SEO derives /en/... for this page
const SITE = Astro.site ?? new URL(site.url);
const pageUrl = new URL('/en' + path, SITE).href;
const imgUrl = new URL(project.image, SITE).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.name,
    headline: project.name,
    description: project.metaDescription[locale],
    url: pageUrl,
    image: imgUrl,
    inLanguage: 'en',
    dateCreated: project.year,
    keywords: project.tech.join(', '),
    author: { '@type': 'Person', name: site.author, url: SITE.origin + '/' },
    producer: { '@type': 'Organization', name: site.studioName, url: site.studioUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.origin + '/en' },
      { '@type': 'ListItem', position: 2, name: 'Work', item: SITE.origin + '/en/#work' },
      { '@type': 'ListItem', position: 3, name: project.name, item: pageUrl },
    ],
  },
];
---
<BaseLayout
  locale={locale}
  path={path}
  type="article"
  title={project.metaTitle[locale]}
  description={project.metaDescription[locale]}
  image={project.image}
  jsonLd={jsonLd}
>
  <Nav locale={locale} path={path} />
  <ProjectDetail locale={locale} project={project} />
  <Footer locale={locale} path={path} />
</BaseLayout>
