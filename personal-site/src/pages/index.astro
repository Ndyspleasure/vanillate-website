---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile.ts';

const year = new Date().getFullYear();
const primaryLink = profile.links.find((l) => l.primary) ?? profile.links[0];
const otherLinks = profile.links.filter((l) => l !== primaryLink);
---

<BaseLayout>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">{profile.name}</a>
      <a class="back-link" href={profile.orgUrl}>← {profile.org}</a>
    </div>
  </header>

  <main class="wrap">
    <!-- Hero -->
    <div class="hero">
      <div class="avatar" aria-hidden={profile.avatar ? undefined : 'true'}>
        {profile.avatar ? <img src={profile.avatar} alt={profile.name} /> : profile.initials}
      </div>
      <div>
        <h1>{profile.name}</h1>
        <p class="role">
          {profile.role} <span class="org">· {profile.org}</span>
        </p>
        <p class="meta">
          {profile.location}
          {profile.pronounHint && <> · {profile.pronounHint}</>}
        </p>
      </div>
    </div>

    <p class="tagline">{profile.tagline}</p>

    <div class="actions">
      {primaryLink && (
        <a class="btn primary" href={primaryLink.href}>{primaryLink.label}</a>
      )}
      {otherLinks.map((l) => (
        <a class="btn" href={l.href}>{l.label}</a>
      ))}
    </div>

    <!-- Tentang -->
    <section aria-labelledby="tentang">
      <p class="eyebrow" id="tentang">Tentang</p>
      <div class="prose">
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <!-- Data diri -->
    <section aria-labelledby="data-diri">
      <p class="eyebrow" id="data-diri">Data diri</p>
      <ul class="facts">
        {profile.facts.map((f) => (
          <li>
            <div class="k">{f.label}</div>
            <div class="v">{f.value}</div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Fokus -->
    {profile.focus.length > 0 && (
      <section aria-labelledby="fokus">
        <p class="eyebrow" id="fokus">Fokus & keahlian</p>
        <ul class="chips">
          {profile.focus.map((f) => <li>{f}</li>)}
        </ul>
      </section>
    )}

    <!-- Kontak -->
    <section aria-labelledby="kontak">
      <p class="eyebrow" id="kontak">Kontak</p>
      <ul class="links">
        {profile.links.map((l) => (
          <li>
            <a href={l.href}>
              <span>{l.label}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="site-footer wrap">
    <span>© {year} {profile.name}</span>
    <span>
      Bagian dari <a href={profile.orgUrl}>{profile.org}</a>
    </span>
  </footer>
</BaseLayout>
