---
import { content, globeStages, site, type Locale } from '../data/content.ts';
interface Props { locale?: Locale }
const { locale = 'id' } = Astro.props;
const t = content[locale];
---
<section class="globe" id="location" aria-labelledby="globe-h">
  <div class="globe__pin">
    <canvas class="globe__stars" aria-hidden="true"></canvas>

    <div class="globe__stage" aria-hidden="true">
      <svg class="globe__svg" viewBox="0 0 1000 1000" role="presentation">
        <defs>
          <radialGradient id="atmo" cx="50%" cy="46%" r="52%">
            <stop offset="70%" stop-color="var(--accent)" stop-opacity="0" />
            <stop offset="92%" stop-color="var(--accent)" stop-opacity="0.18" />
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
          </radialGradient>
          <clipPath id="earthClip"><circle cx="500" cy="470" r="300" /></clipPath>
        </defs>

        <g id="g-zoom">
          <circle cx="500" cy="470" r="330" fill="url(#atmo)" />
          <circle cx="500" cy="470" r="300" fill="var(--bg-elev)" stroke="var(--border)" stroke-width="1.5" />
          <g clip-path="url(#earthClip)" stroke="var(--border)" stroke-width="1" fill="none" opacity="0.7">
            <ellipse cx="500" cy="470" rx="300" ry="90" />
            <ellipse cx="500" cy="470" rx="300" ry="180" />
            <ellipse cx="500" cy="470" rx="300" ry="270" />
            <ellipse cx="500" cy="470" rx="90" ry="300" />
            <ellipse cx="500" cy="470" rx="180" ry="300" />
            <ellipse cx="500" cy="470" rx="270" ry="300" />
            <line x1="200" y1="470" x2="800" y2="470" />
          </g>
          <!-- Kepulauan Indonesia (disederhanakan) di sekitar Bekasi -->
          <g clip-path="url(#earthClip)" fill="var(--text)" opacity="0.5">
            <path d="M430 486c26-8 60-6 92 2 20 5 40 4 60-2 14-4 30 0 30 8 0 10-24 16-52 16-40 0-70-2-104-10-24-6-40-12-26-14z" />
            <path d="M600 500c22-2 44 2 60 10 10 5 6 14-8 14-22 0-46-6-60-14-8-5-4-9 8-10z" />
            <ellipse cx="405" cy="500" rx="16" ry="7" />
            <ellipse cx="690" cy="516" rx="20" ry="8" />
            <ellipse cx="470" cy="520" rx="30" ry="9" />
          </g>
          <!-- Penanda Bekasi tepat di pusat (500,500) -->
          <g>
            <circle class="globe__ring" cx="500" cy="500" r="14" fill="none" stroke="var(--accent)" stroke-width="2" />
            <circle cx="500" cy="500" r="5.5" fill="var(--accent)" />
          </g>
        </g>
      </svg>

      <p class="globe__stagelabel" data-stagelabel>
        <span class="globe__stagebig mono">{globeStages[0].label}</span>
      </p>
    </div>

    <ol class="globe__rail" aria-hidden="true">
      {globeStages.map((s, i) => (
        <li data-rail={i} class={i === globeStages.length - 1 ? 'is-active' : ''}>
          <span class="mono">{s.label}</span>
        </li>
      ))}
    </ol>

    <!-- Konten SEO permanen — tersedia tanpa WebGL/JS (§14). -->
    <div class="globe__content container">
      <p class="eyebrow">{t.globe.eyebrow}</p>
      <h2 class="h2" id="globe-h">{t.globe.title}</h2>
      <p class="globe__body">{t.globe.body}</p>
      <p class="globe__caption mono">{t.globe.caption} · {site.region}</p>
      <p class="globe__hint mono">{t.globe.hint}</p>
    </div>
  </div>
</section>

<style>
  .globe { min-height: 320vh; position: relative; }
  .globe__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--accent) 6%, var(--bg)) 0%, var(--bg) 55%);
  }
  .globe__stars { position: absolute; inset: 0; width: 100%; height: 100%; }
  .globe__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .globe__svg {
    width: min(78vh, 88vw);
    height: auto;
    overflow: visible;
  }
  #g-zoom { transform-box: fill-box; }
  .globe__ring { transform-origin: 500px 500px; animation: ringPulse 2.6s ease-out infinite; }
  @keyframes ringPulse {
    0% { r: 8; opacity: 0.9; }
    100% { r: 26; opacity: 0; }
  }
  .globe__stagelabel {
    position: absolute;
    top: 12%;
    left: 0;
    right: 0;
    text-align: center;
  }
  .globe__stagebig {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.8vw, 1.05rem);
    letter-spacing: 0.3em;
    color: var(--accent-ink);
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(6px);
  }
  .globe__rail {
    position: absolute;
    right: clamp(16px, 4vw, 54px);
    top: 50%;
    transform: translateY(-50%);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 3;
  }
  .globe__rail li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--text-2);
    opacity: 0.4;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: opacity 0.3s var(--ease), color 0.3s var(--ease);
  }
  .globe__rail li::before {
    content: '';
    width: 16px;
    height: 1px;
    background: currentColor;
    transition: width 0.3s var(--ease);
  }
  .globe__rail li.is-active { opacity: 1; color: var(--accent-ink); }
  .globe__rail li.is-active::before { width: 30px; }
  .globe__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(28px, 6vh, 72px);
    z-index: 3;
    max-width: 600px;
  }
  .globe__body { margin-top: 14px; color: var(--text-2); max-width: 42ch; }
  .globe__caption { margin-top: 14px; color: var(--accent-ink); font-size: 0.8rem; letter-spacing: 0.08em; }
  .globe__hint { margin-top: 20px; color: var(--text-2); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.7; }

  @media (max-width: 640px) {
    .globe__rail { right: 12px; gap: 9px; }
    .globe__rail li { font-size: 0.6rem; }
  }

  /* Reduced motion / no-JS: hentikan pinning, tampilkan keadaan statis penuh. */
  @media (prefers-reduced-motion: reduce) {
    .globe { min-height: auto; }
    .globe__pin { position: static; height: auto; min-height: 92svh; padding-block: var(--section-y); }
    .globe__ring { animation: none; }
    .globe__stagelabel { top: 8%; }
  }
</style>

<script>
  const section = document.querySelector('.globe') as HTMLElement | null;
  const zoom = document.getElementById('g-zoom');
  const canvas = document.querySelector('.globe__stars') as HTMLCanvasElement | null;
  const stageLabel = document.querySelector('[data-stagelabel] .globe__stagebig') as HTMLElement | null;
  const rail = Array.from(document.querySelectorAll('[data-rail]')) as HTMLElement[];
  const stages = ['SPACE', 'EARTH', 'ASIA', 'INDONESIA', 'WEST JAVA', 'BEKASI'];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && zoom && !reduce) {
    let active = false;
    let raf = 0;
    let stars: { x: number; y: number; r: number; a: number; t: number }[] = [];
    const ctx = canvas?.getContext('2d') ?? null;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    function initStars() {
      if (!canvas || !ctx) return;
      const w = (canvas.width = canvas.offsetWidth * dpr);
      const h = (canvas.height = canvas.offsetHeight * dpr);
      const count = window.innerWidth < 700 ? 45 : 150;
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: (Math.random() * 1.3 + 0.3) * dpr,
        a: Math.random(),
        t: Math.random() * Math.PI * 2,
      }));
    }

    let starOpacity = 1;
    function drawStars() {
      if (!canvas || !ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (starOpacity <= 0.02) return;
      const col = getComputedStyle(document.documentElement).getPropertyValue('--text').trim() || '#111';
      for (const s of stars) {
        s.t += 0.02;
        const tw = (Math.sin(s.t) * 0.4 + 0.6) * s.a * starOpacity;
        ctx.globalAlpha = Math.max(0, tw);
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function progress() {
      const rect = section!.getBoundingClientRect();
      const total = section!.offsetHeight - window.innerHeight;
      return Math.min(1, Math.max(0, -rect.top / total));
    }

    function apply(p: number) {
      // Zoom scale: eases into a fast dive toward Bekasi (pusat 500,500).
      const s = 0.45 + Math.pow(p, 1.7) * 7.5;
      zoom!.setAttribute('transform', `translate(500 500) scale(${s.toFixed(3)}) translate(-500 -500)`);
      // Bintang memudar saat mendekati permukaan.
      starOpacity = Math.max(0, 1 - p * 1.7);
      // Label & rail per tahap.
      const idx = Math.min(stages.length - 1, Math.floor(p * stages.length + 0.0001));
      if (stageLabel && stageLabel.textContent !== stages[idx]) stageLabel.textContent = stages[idx];
      rail.forEach((li, i) => li.classList.toggle('is-active', i === idx));
    }

    function loop() {
      drawStars();
      raf = requestAnimationFrame(loop);
    }
    function onScroll() {
      if (active) apply(progress());
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          active = e.isIntersecting;
          if (active) {
            if (!raf) loop();
            onScroll();
          } else if (raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        }
      },
      { threshold: 0 }
    );

    initStars();
    apply(0);
    io.observe(section);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      initStars();
    });
  }
</script>
