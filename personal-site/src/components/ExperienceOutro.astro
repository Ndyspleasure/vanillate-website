---
import { content, type Locale } from '../data/content.ts';
interface Props { locale?: Locale }
const { locale = 'id' } = Astro.props;
const p = content[locale].perf;
---
<section class="outro" aria-labelledby="outro-h">
  <div class="outro__sky" aria-hidden="true"></div>
  <div class="container outro__inner" data-reveal>
    <p class="eyebrow outro__eyebrow">{p.endEyebrow}</p>
    <h2 class="h2 outro__title" id="outro-h">{p.endTitle}</h2>
    <p class="outro__lead">{p.endLead}</p>
    <div class="outro__modes">
      <button type="button" class="outro__mode" data-exp-restart="auto" data-magnetic="0.4">
        <span class="outro__modeic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 5v14l11-7z"/></svg></span>
        <span class="outro__modename">{p.animAuto.name}</span>
      </button>
      <button type="button" class="outro__mode" data-exp-restart="manual" data-magnetic="0.4">
        <span class="outro__modeic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13M7 11l5 5 5-5M5 21h14"/></svg></span>
        <span class="outro__modename">{p.animManual.name}</span>
      </button>
    </div>
  </div>
</section>

<style>
  .outro { position: relative; overflow: hidden; padding-block: clamp(80px, 16vh, 200px); text-align: center; background: #05060d; }
  .outro__sky {
    position: absolute; inset: 0;
    background:
      radial-gradient(80% 60% at 50% 120%, color-mix(in srgb, var(--accent) 22%, transparent) 0%, transparent 60%),
      radial-gradient(1px 1px at 20% 30%, #fff6 40%, transparent), radial-gradient(1px 1px at 70% 20%, #fff5 40%, transparent),
      radial-gradient(1.5px 1.5px at 40% 70%, #fff5 40%, transparent), radial-gradient(1px 1px at 85% 60%, #fff4 40%, transparent),
      radial-gradient(1px 1px at 55% 45%, #fff4 40%, transparent), radial-gradient(1px 1px at 10% 80%, #fff4 40%, transparent);
  }
  .outro__inner { position: relative; z-index: 1; max-width: 620px; }
  .outro__eyebrow { justify-content: center; color: #ff9a9a; }
  .outro__title { margin-top: 16px; color: #fff; }
  .outro__lead { margin-top: 16px; color: #b9c6da; max-width: 42ch; margin-inline: auto; }
  .outro__modes { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 32px; }
  .outro__mode {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 26px;
    border: 1px solid rgba(255,255,255,0.16); border-radius: 999px; background: rgba(255,255,255,0.04);
    color: #eaf1ff; font-family: var(--font-display); font-weight: 600; font-size: 1rem;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease), background 0.25s var(--ease);
  }
  .outro__mode:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 16%, transparent); transform: translateY(-2px); }
  .outro__modeic { width: 20px; height: 20px; color: #ff9a9a; }
  .outro__modeic svg { width: 100%; height: 100%; }
</style>

<script>
  document.querySelectorAll('[data-exp-restart]').forEach((b) =>
    b.addEventListener('click', () => {
      const mode = (b as HTMLElement).dataset.expRestart as 'auto' | 'manual';
      (window as any).EXP?.restart(mode);
    })
  );
</script>
