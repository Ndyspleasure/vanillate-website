---
import { content, systemNodes, type Locale } from '../data/content.ts';
interface Props { locale?: Locale }
const { locale = 'id' } = Astro.props;
const t = content[locale];

// data-flow core nodes around a centre (small panel, viewBox 240×180)
const CX = 120, CY = 90, R = 66;
const nodes = systemNodes.map((label, i) => {
  const ang = (-90 + i * 60) * (Math.PI / 180);
  return { label, x: +(CX + Math.cos(ang) * R).toFixed(1), y: +(CY + Math.sin(ang) * R).toFixed(1) };
});
const files = [
  { n: 'system.ts', hi: true }, { n: 'db.ts' }, { n: 'ai.ts' },
  { n: 'automation.ts' }, { n: 'config.json' },
];
---
<section class="sc" id="build" aria-labelledby="build-h" data-sc>
  <div class="container sc__intro">
    <p class="eyebrow">{t.build.eyebrow}</p>
    <h2 class="h2" id="build-h">{t.build.title}</h2>
    <p class="sc__lead">{t.build.lead}</p>
  </div>

  <div class="sc__stage" data-scstage>
    <!-- IDE window -->
    <div class="sc__ide" data-ide>
      <div class="sc__chrome">
        <span class="sc__dots"><i></i><i></i><i></i></span>
        <span class="sc__tabs">
          {files.map((f) => <span class={`sc__tab${f.hi ? ' is-active' : ''}`}>{f.n}</span>)}
        </span>
        <span class="sc__status" data-status><i class="sc__statdot"></i><b data-statustxt>READY</b></span>
      </div>
      <div class="sc__main">
        <aside class="sc__tree hi-only" aria-hidden="true">
          {files.map((f) => (
            <span class={`sc__file${f.hi ? ' is-active' : ''}`} data-file={f.n}>{f.n}</span>
          ))}
        </aside>
        <div class="sc__editor">
          <div class="sc__gutter" data-gutter aria-hidden="true"></div>
          <pre class="sc__code" data-code aria-hidden="true"></pre>
        </div>
      </div>
      <div class="sc__term" data-term aria-hidden="true"></div>
    </div>

    <!-- floating: data flow core -->
    <div class="sc__float sc__float--core hi-only" data-core aria-hidden="true">
      <span class="sc__floatlabel mono">system.core</span>
      <svg viewBox="0 0 240 180" fill="none">
        {nodes.map((n, i) => (
          <>
            <line class="sc__cline" data-cline={i} x1={CX} y1={CY} x2={n.x} y2={n.y} stroke="var(--border)" stroke-width="1.5" pathLength="1" />
            <line class="sc__cflow" data-cflow={i} x1={CX} y1={CY} x2={n.x} y2={n.y} stroke="var(--accent)" stroke-width="1.5" />
          </>
        ))}
        {nodes.map((n, i) => (
          <g class="sc__cnode" data-cnode={i}>
            <circle cx={n.x} cy={n.y} r="15" fill="var(--bg-elev)" stroke="var(--border)" stroke-width="1" />
            <text x={n.x} y={n.y} text-anchor="middle" dominant-baseline="central">{n.label}</text>
          </g>
        ))}
        <circle cx={CX} cy={CY} r="20" fill="var(--bg-elev)" stroke="var(--accent)" stroke-width="1.5" />
        <text class="sc__ccore" x={CX} y={CY} text-anchor="middle" dominant-baseline="central">AK</text>
      </svg>
    </div>

    <!-- floating: API/JSON response -->
    <div class="sc__float sc__float--api hi-only" data-api aria-hidden="true">
      <span class="sc__floatlabel mono">response 200 OK</span>
      <pre class="sc__json" data-json></pre>
    </div>

    <!-- floating: activity / git -->
    <div class="sc__float sc__float--git" data-git aria-hidden="true">
      <span class="sc__gitrow mono"><i class="sc__pulse"></i><span data-gittxt>main syncing</span></span>
    </div>
  </div>

  <!-- Permanent, crawlable summary (available without JS) -->
  <div class="container sc__fallback">
    <p class="muted">{t.build.fallback}</p>
  </div>
</section>

<style>
  .sc { padding-block: var(--section-y); overflow: hidden; }
  .sc__intro { max-width: 760px; margin-bottom: clamp(28px, 5vh, 56px); }
  .sc__lead { margin-top: 14px; color: var(--text-2); max-width: 46ch; }

  .sc__stage {
    position: relative;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    min-height: min(70vh, 620px);
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* don't let the pre content widen the track */
    justify-items: center;
    align-items: center;
  }

  /* IDE window */
  .sc__ide {
    width: min(760px, 100%);
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-elev);
    overflow: hidden;
    box-shadow: 0 30px 80px -40px color-mix(in srgb, var(--accent) 40%, transparent);
    position: relative;
    z-index: 2;
  }
  .sc__chrome { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-bottom: 1px solid var(--border); }
  .sc__dots { display: inline-flex; gap: 6px; }
  .sc__dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--border); }
  .sc__dots i:first-child { background: var(--accent); }
  .sc__tabs { display: flex; gap: 6px; overflow: hidden; flex: 1; min-width: 0; }
  .sc__tab { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-2); padding: 4px 9px; border-radius: 6px; white-space: nowrap; }
  .sc__tab.is-active { color: var(--text); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .sc__status { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.08em; color: var(--text-2); }
  .sc__statdot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-2); transition: background 0.4s var(--ease); }
  .sc__status[data-tone='build'] .sc__statdot { background: #e5a13a; } .sc__status[data-tone='build'] b { color: #e5a13a; }
  .sc__status[data-tone='ok'] .sc__statdot { background: #21a366; } .sc__status[data-tone='ok'] b { color: #21a366; }

  .sc__main { display: flex; min-height: 300px; }
  .sc__tree { width: 130px; flex: 0 0 auto; border-right: 1px solid var(--border); padding: 12px 8px; display: flex; flex-direction: column; gap: 3px; background: color-mix(in srgb, var(--bg) 40%, var(--bg-elev)); }
  .sc__file { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-2); padding: 5px 8px; border-radius: 6px; transition: color 0.3s, background 0.3s; }
  .sc__file.is-active { color: var(--accent-ink); background: color-mix(in srgb, var(--accent) 10%, transparent); }

  .sc__editor { flex: 1; min-width: 0; display: flex; padding: 14px 0; max-height: 320px; overflow: hidden; position: relative; }
  .sc__editor::after { content: ''; position: absolute; inset: auto 0 0 0; height: 42px; background: linear-gradient(transparent, var(--bg-elev)); pointer-events: none; }
  .sc__editor::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 24px; background: linear-gradient(var(--bg-elev), transparent); pointer-events: none; z-index: 1; }
  .sc__gutter, .sc__code { font-family: var(--font-mono); font-size: clamp(0.68rem, 1.15vw, 0.82rem); line-height: 1.65; will-change: transform; }
  .sc__gutter { flex: 0 0 auto; width: 40px; text-align: right; padding-right: 12px; color: color-mix(in srgb, var(--text-2) 60%, transparent); user-select: none; white-space: pre; }
  .sc__code { margin: 0; flex: 1; min-width: 0; white-space: pre; overflow: hidden; color: var(--text); }
  /* runtime-injected nodes need :global (scoped styles skip dynamic DOM) */
  .sc__code :global(.ln) { display: block; padding-inline: 14px; border-radius: 4px; min-height: 1.65em; }
  .sc__code :global(.ln.is-hot) { background: color-mix(in srgb, var(--accent) 9%, transparent); }
  .sc__code :global(.k) { color: #c678dd; }
  .sc__code :global(.s) { color: #98c379; }
  .sc__code :global(.c) { color: color-mix(in srgb, var(--text-2) 85%, transparent); font-style: italic; }
  .sc__code :global(.f) { color: #61afef; }
  .sc__code :global(.n) { color: #d19a66; }
  .sc__code :global(.t) { color: #e5c07b; }
  .sc__code :global(.p) { color: #56b6c2; }
  :global([data-theme='light'] .sc__code .k) { color: #a626a4; }
  :global([data-theme='light'] .sc__code .s) { color: #50a14f; }
  :global([data-theme='light'] .sc__code .f) { color: #4078f2; }
  :global([data-theme='light'] .sc__code .t) { color: #b26b00; }
  :global([data-theme='light'] .sc__code .p) { color: #0184bc; }
  .sc__editor :global(.sc__caret) { display: inline-block; width: 2px; height: 1.05em; background: var(--accent); vertical-align: text-bottom; animation: scblink 1s steps(2) infinite; }
  @keyframes scblink { 50% { opacity: 0; } }

  .sc__term { border-top: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 55%, #000); padding: 10px 16px; min-height: 76px; font-family: var(--font-mono); font-size: 0.68rem; line-height: 1.7; color: var(--text-2); }
  .sc__term :global(.tl) { display: block; opacity: 0; transform: translateY(4px); transition: opacity 0.4s, transform 0.4s; white-space: pre; overflow: hidden; text-overflow: ellipsis; }
  .sc__term :global(.tl.on) { opacity: 1; transform: none; }
  .sc__term :global(.ok) { color: #21a366; } .sc__term :global(.ac) { color: var(--accent-ink); } .sc__term :global(.dim) { color: color-mix(in srgb, var(--text-2) 70%, transparent); }

  /* floating panels */
  .sc__float {
    position: absolute; z-index: 3; border: 1px solid var(--border); border-radius: 12px;
    background: color-mix(in srgb, var(--bg-elev) 92%, transparent); backdrop-filter: blur(8px);
    box-shadow: 0 20px 50px -30px rgba(0,0,0,0.6); padding: 12px; opacity: 0; transform: translateY(10px) scale(0.98);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); pointer-events: none;
  }
  .sc__float.on { opacity: 1; transform: none; }
  .sc__floatlabel { display: block; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--text-2); margin-bottom: 8px; text-transform: uppercase; }
  .sc__float--core { top: -2%; right: max(-8px, -3vw); width: 210px; }
  .sc__float--core svg { width: 100%; height: auto; }
  .sc__cnode text, .sc__ccore { font-family: var(--font-mono); font-size: 8px; fill: var(--text-2); }
  .sc__ccore { fill: var(--accent-ink); font-weight: 600; font-size: 9px; }
  .sc__cnode { opacity: 0; transition: opacity 0.5s var(--ease); }
  .sc__cnode.on { opacity: 1; }
  .sc__cflow { stroke-dasharray: 4 60; opacity: 0; }
  .sc__cflow.on { opacity: 0.9; animation: scflow 1.8s linear infinite; }
  @keyframes scflow { to { stroke-dashoffset: -64; } }
  .sc__float--api { bottom: 4%; right: max(-6px, -2vw); width: 210px; }
  .sc__json { margin: 0; font-family: var(--font-mono); font-size: 0.66rem; line-height: 1.6; color: var(--text-2); white-space: pre; }
  .sc__json :global(.s) { color: #98c379; } .sc__json :global(.k) { color: #56b6c2; } .sc__json :global(.n) { color: #d19a66; }
  .sc__float--git { bottom: 6%; left: max(-6px, -2vw); width: auto; padding: 8px 12px; }
  .sc__gitrow { display: inline-flex; align-items: center; gap: 8px; font-size: 0.64rem; color: var(--text-2); }
  .sc__pulse { width: 7px; height: 7px; border-radius: 50%; background: #21a366; box-shadow: 0 0 0 0 #21a36699; animation: scpulse 2s infinite; }
  @keyframes scpulse { 0% { box-shadow: 0 0 0 0 #21a36666; } 70% { box-shadow: 0 0 0 7px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  .sc__fallback { max-width: 620px; margin-top: clamp(28px, 5vh, 52px); }
  .sc__fallback .muted { font-size: 0.9rem; opacity: 0.62; }

  /* Performance: Smooth mode sheds the floating panels + heavy motion, keeps the IDE story */
  :global(:root[data-perf='low']) .hi-only { display: none; }
  :global(:root[data-perf='low']) .sc__ide { box-shadow: 0 18px 50px -34px rgba(0,0,0,0.6); }

  @media (max-width: 900px) {
    .sc__tree { display: none; }
    .sc__float--core { width: 150px; top: -12px; right: -6px; }
    .sc__float--api { width: 168px; bottom: -10px; right: -6px; }
  }
  @media (max-width: 620px) {
    .sc__stage { padding-inline: var(--gutter); min-height: 0; }
    .sc__float--core, .sc__float--api { display: none; }
    .sc__float--git { left: auto; right: 8px; bottom: -8px; }
  }

  /* Reduced motion / no JS: show full code + panels, no animation. */
  @media (prefers-reduced-motion: reduce) {
    .sc__caret, .sc__pulse, .sc__cflow.on { animation: none; }
    .sc__float, .sc__term .tl { opacity: 1; transform: none; }
    .sc__cnode { opacity: 1; }
  }
</style>

<script>
  import { initShowcase } from '../scripts/showcase.ts';
  initShowcase();
</script>
