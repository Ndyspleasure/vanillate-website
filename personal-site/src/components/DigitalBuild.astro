---
import { content, systemNodes, type Locale } from '../data/content.ts';
interface Props { locale?: Locale }
const { locale = 'id' } = Astro.props;
const t = content[locale];

// Posisi node sistem mengelilingi core (viewBox 1000×840, core di 500,410).
const CX = 500, CY = 410, R = 250;
const nodes = systemNodes.map((label, i) => {
  const ang = (-90 + i * 60) * (Math.PI / 180);
  return { label, x: +(CX + Math.cos(ang) * R).toFixed(1), y: +(CY + Math.sin(ang) * R).toFixed(1) };
});
const fragPos = [
  { x: 0.13, y: 0.26 }, { x: 0.72, y: 0.20 }, { x: 0.24, y: 0.70 },
  { x: 0.78, y: 0.64 }, { x: 0.46, y: 0.13 }, { x: 0.55, y: 0.82 },
];
---
<section class="build" aria-labelledby="build-h">
  <div class="build__pin">
    <!-- SCENE: CODE -->
    <div class="scene scene--code" data-scene="code" aria-hidden="true">
      {t.build.fragments.map((f, i) => (
        <code class="frag mono" data-frag data-x={fragPos[i]?.x ?? 0.5} data-y={fragPos[i]?.y ?? 0.5}>{f}</code>
      ))}
    </div>

    <!-- SCENE: AK -->
    <div class="scene scene--ak" data-scene="ak" aria-hidden="true">
      <svg viewBox="0 0 200 200" class="ak" fill="none">
        <path class="ak__p" d="M58 150 L86 50 L114 150 M67 118 H105" stroke="var(--accent)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
        <path class="ak__p" d="M126 50 V150 M126 104 L162 50 M133 100 L164 150" stroke="var(--text)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
      </svg>
      <p class="scene__cap mono">{t.build.convergeLabel} <b>AK</b></p>
    </div>

    <!-- SCENE: SYSTEM CORE -->
    <div class="scene scene--core" data-scene="core" aria-hidden="true">
      <svg viewBox="0 0 1000 840" class="core" fill="none">
        {nodes.map((n, i) => (
          <>
            <line class="core__line" data-line={i} x1={CX} y1={CY} x2={n.x} y2={n.y} stroke="var(--border)" stroke-width="2" pathLength="1" style={`stroke-dasharray:1;stroke-dashoffset:1`} />
            <line class="core__flow" data-flow={i} x1={CX} y1={CY} x2={n.x} y2={n.y} stroke="var(--accent)" stroke-width="2" />
          </>
        ))}
        {nodes.map((n, i) => (
          <g class="core__node" data-node={i}>
            <circle cx={n.x} cy={n.y} r="34" fill="var(--bg-elev)" stroke="var(--border)" stroke-width="1.5" />
            <text x={n.x} y={n.y} text-anchor="middle" dominant-baseline="central" class="core__nodetext">{n.label}</text>
          </g>
        ))}
        <circle cx={CX} cy={CY} r="52" fill="var(--bg-elev)" stroke="var(--accent)" stroke-width="2" />
        <text x={CX} y={CY} text-anchor="middle" dominant-baseline="central" class="core__center mono">AK</text>
      </svg>
    </div>

    <!-- SCENE: PROCESS state -->
    <div class="scene scene--process" data-scene="process" aria-hidden="true">
      <span class="state" data-state>
        <span class="state__dot"></span>
        <span class="state__txt mono">{t.build.fragments && 'LOADING'}</span>
      </span>
    </div>

    <!-- SCENE: PRODUCT -->
    <div class="scene scene--product" data-scene="product" aria-hidden="true">
      <div class="product">
        <div class="product__bar"><span></span><span></span><span></span></div>
        <div class="product__body">
          <span class="product__row w70"></span>
          <span class="product__row w90"></span>
          <span class="product__row w40 accent"></span>
        </div>
      </div>
      <p class="product__from mono" data-from>{t.build.fromTo}</p>
      <p class="product__studio" data-studio>{t.build.studioReveal}</p>
    </div>

    <!-- Konten SEO permanen (§25) -->
    <div class="build__content container">
      <p class="eyebrow">{t.build.eyebrow}</p>
      <h2 class="h2" id="build-h">{t.build.title}</h2>
      <p class="build__lead">{t.build.lead}</p>
      <p class="build__fallback muted">{t.build.fallback}</p>
    </div>

    <div class="build__progress" aria-hidden="true"><span data-progressbar></span></div>
  </div>
</section>

<style>
  .build { min-height: 460vh; position: relative; }
  .build__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(80% 60% at 50% 45%, color-mix(in srgb, var(--accent) 5%, var(--bg)) 0%, var(--bg) 70%);
  }
  .scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    will-change: opacity, transform;
  }

  /* Code */
  .frag {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1.3vw, 0.92rem);
    color: var(--text-2);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    padding: 8px 12px;
    border-radius: 8px;
    white-space: nowrap;
  }

  /* AK */
  .ak { width: min(38vh, 60vw); height: auto; }
  .ak__p { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .scene__cap {
    position: absolute;
    bottom: 20%;
    font-size: 0.8rem;
    color: var(--text-2);
    letter-spacing: 0.06em;
  }
  .scene__cap b { color: var(--accent-ink); }

  /* Core */
  .core { width: min(96vh, 94vw); height: auto; }
  .core__nodetext { font-family: var(--font-mono); font-size: 20px; fill: var(--text); letter-spacing: 0.04em; }
  .core__center { font-family: var(--font-mono); font-size: 30px; fill: var(--accent-ink); font-weight: 600; }
  .core__flow {
    stroke-dasharray: 6 240;
    stroke-dashoffset: 0;
    opacity: 0;
  }
  .scene--core.is-live .core__flow {
    opacity: 0.9;
    animation: flow 1.6s linear infinite;
  }
  @keyframes flow { to { stroke-dashoffset: -246; } }
  .core__node { opacity: 0; }

  /* Process */
  .scene--process { align-items: end; padding-bottom: 20%; pointer-events: none; }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    backdrop-filter: blur(6px);
  }
  .state__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .state__txt { font-size: 0.8rem; letter-spacing: 0.16em; color: var(--text); }
  .state[data-tone='fail'] .state__dot { background: var(--accent); animation: blink 0.5s steps(2) infinite; }
  .state[data-tone='fail'] .state__txt { color: var(--accent-ink); }
  .state[data-tone='ok'] .state__dot { background: #21a366; }
  .state[data-tone='ok'] .state__txt { color: #21a366; }
  @keyframes blink { 50% { opacity: 0.3; } }

  /* Product */
  .scene--product { flex-direction: column; }
  .product {
    width: min(360px, 74vw);
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-elev);
    overflow: hidden;
    box-shadow: 0 24px 60px -30px color-mix(in srgb, var(--accent) 50%, transparent);
    transform: scale(0.9);
  }
  .product__bar { display: flex; gap: 6px; padding: 12px 14px; border-bottom: 1px solid var(--border); }
  .product__bar span { width: 9px; height: 9px; border-radius: 50%; background: var(--border); }
  .product__bar span:first-child { background: var(--accent); }
  .product__body { padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .product__row { height: 12px; border-radius: 6px; background: var(--border); }
  .product__row.w70 { width: 70%; }
  .product__row.w90 { width: 90%; }
  .product__row.w40 { width: 40%; }
  .product__row.accent { background: color-mix(in srgb, var(--accent) 60%, var(--border)); }
  .product__from {
    position: absolute;
    bottom: 24%;
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    letter-spacing: 0.1em;
    color: var(--text);
    opacity: 0;
  }
  .product__studio {
    position: absolute;
    bottom: 14%;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(1.6rem, 6vw, 4rem);
    color: var(--accent-ink);
    opacity: 0;
  }

  .build__content {
    position: absolute;
    left: 0;
    right: 0;
    top: clamp(60px, 12vh, 120px);
    text-align: center;
    z-index: 4;
    pointer-events: none;
  }
  .build__content .eyebrow { justify-content: center; }
  .build__content .eyebrow::before { display: none; }
  .build__lead { margin: 14px auto 0; color: var(--text-2); max-width: 40ch; }
  .build__fallback {
    max-width: 60ch;
    margin: 14px auto 0;
    font-size: 0.9rem;
    /* Terlihat oleh crawler & pembaca; disamarkan halus agar tak menutup animasi */
    opacity: 0.55;
  }
  .build__progress {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: var(--border);
  }
  .build__progress span { display: block; height: 100%; width: 0; background: var(--accent); }

  /* Reduced motion / no-JS: tampilkan semua konten sebagai daftar statis. */
  @media (prefers-reduced-motion: reduce) {
    .build { min-height: auto; }
    .build__pin { position: static; height: auto; min-height: 80svh; padding-block: var(--section-y); place-items: center; }
    .scene { position: static; opacity: 1; inset: auto; }
    .scene--code, .scene--process, .scene--product .product,
    .scene--ak, .scene--core { display: none; } /* animasi disembunyikan; teks tetap */
    .product__from, .product__studio { position: static; opacity: 1; }
    .build__content { position: static; }
    .build__fallback { opacity: 1; }
  }
</style>

<script>
  const section = document.querySelector('.build') as HTMLElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && !reduce) {
    const scenes: Record<string, HTMLElement> = {};
    section.querySelectorAll('[data-scene]').forEach((el) => {
      scenes[(el as HTMLElement).dataset.scene!] = el as HTMLElement;
    });
    const frags = Array.from(section.querySelectorAll('[data-frag]')) as HTMLElement[];
    const lines = Array.from(section.querySelectorAll('[data-line]')) as SVGElement[];
    const coreNodes = Array.from(section.querySelectorAll('[data-node]')) as SVGElement[];
    const stateEl = section.querySelector('[data-state]') as HTMLElement | null;
    const stateTxt = section.querySelector('[data-state] .state__txt') as HTMLElement | null;
    const fromEl = section.querySelector('[data-from]') as HTMLElement | null;
    const studioEl = section.querySelector('[data-studio]') as HTMLElement | null;
    const bar = section.querySelector('[data-progressbar]') as HTMLElement | null;

    const stops = [
      { until: 0.745, txt: 'LOADING', tone: '' },
      { until: 0.78, txt: 'ANALYZING', tone: '' },
      { until: 0.815, txt: 'BUILDING', tone: '' },
      { until: 0.845, txt: 'VALIDATING', tone: '' },
      { until: 0.875, txt: 'BUILD FAILED', tone: 'fail' },
      { until: 0.9, txt: 'RETRYING…', tone: 'fail' },
      { until: 0.94, txt: 'BUILD SUCCESS', tone: 'ok' },
      { until: 1.01, txt: 'DEPLOYED', tone: 'ok' },
    ];

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const seg = (p: number, a: number, b: number, c: number, d: number) =>
      p <= a || p >= d ? 0 : p < b ? (p - a) / (b - a) : p > c ? 1 - (p - c) / (d - c) : 1;
    const lerp = (a: number, b: number, x: number) => a + (b - a) * x;

    let active = false;
    let raf = 0;

    function render() {
      const rect = section!.getBoundingClientRect();
      const total = section!.offsetHeight - window.innerHeight;
      const p = clamp(-rect.top / total);
      if (bar) bar.style.width = (p * 100).toFixed(1) + '%';

      // Scene opacities
      const oCode = seg(p, 0, 0.03, 0.30, 0.42);
      const oAk = seg(p, 0.34, 0.42, 0.54, 0.62);
      const oCore = seg(p, 0.56, 0.64, 0.88, 0.93);
      const oProc = seg(p, 0.69, 0.72, 0.93, 0.96);
      const oProd = seg(p, 0.90, 0.95, 1.1, 1.2);
      scenes.code.style.opacity = String(oCode);
      scenes.ak.style.opacity = String(oAk);
      scenes.core.style.opacity = String(oCore);
      scenes.process.style.opacity = String(oProc);
      scenes.product.style.opacity = String(oProd);

      // Code convergence (0.18 → 0.40)
      const c = clamp((p - 0.16) / 0.24);
      for (const f of frags) {
        const bx = parseFloat(f.dataset.x || '0.5');
        const by = parseFloat(f.dataset.y || '0.5');
        f.style.left = lerp(bx, 0.5, c) * 100 + '%';
        f.style.top = lerp(by, 0.5, c) * 100 + '%';
        f.style.opacity = String(1 - clamp((c - 0.75) / 0.25));
        f.style.transform = `translate(-50%,-50%) scale(${lerp(1, 0.7, c)})`;
      }

      // AK draw (0.38 → 0.54)
      const ak = clamp((p - 0.38) / 0.16);
      section!.querySelectorAll('.ak__p').forEach((el) =>
        ((el as SVGElement).style.strokeDashoffset = String(1 - ak))
      );

      // Core lines draw (0.58 → 0.80) + nodes appear staggered
      const core = clamp((p - 0.58) / 0.22);
      lines.forEach((ln, i) => {
        const lp = clamp((core - i * 0.06) / 0.5);
        (ln as SVGElement).style.strokeDashoffset = String(1 - lp);
      });
      coreNodes.forEach((nd, i) => {
        const np = clamp((core - i * 0.07) / 0.4);
        (nd as SVGElement).style.opacity = String(np);
      });
      scenes.core.classList.toggle('is-live', oCore > 0.6);

      // Process state
      if (oProc > 0.05 && stateTxt && stateEl) {
        const s = stops.find((x) => p < x.until) || stops[stops.length - 1];
        if (stateTxt.textContent !== s.txt) stateTxt.textContent = s.txt;
        if (stateEl.dataset.tone !== s.tone) stateEl.dataset.tone = s.tone;
      }

      // Final texts
      if (fromEl) fromEl.style.opacity = String(seg(p, 0.9, 0.93, 0.985, 1.02));
      if (studioEl) {
        const sp = clamp((p - 0.95) / 0.05);
        studioEl.style.opacity = String(sp);
        studioEl.style.transform = `translateY(${lerp(14, 0, sp)}px)`;
      }
    }

    function loop() {
      render();
      raf = requestAnimationFrame(loop);
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          active = e.isIntersecting;
          if (active && !raf) loop();
          else if (!active && raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        }
      },
      { threshold: 0 }
    );
    render();
    io.observe(section);
  }
</script>
