---
import { content, type Locale } from '../data/content.ts';
interface Props { locale?: Locale }
const { locale = 'id' } = Astro.props;
const t = content[locale];
---
<section class="values" aria-labelledby="values-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{t.values.eyebrow}</p>
      <h2 class="h2" id="values-h">{t.values.title}</h2>
    </div>
    <div class="values__list">
      {t.values.items.map((v, i) => (
        <article class="value" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="value__num mono">0{i + 1}</span>
          <h3 class="value__title">{v.title}</h3>
          <p class="value__desc">{v.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .values__list {
    display: grid;
    gap: 0;
  }
  .value {
    display: grid;
    grid-template-columns: 80px 1fr;
    align-items: baseline;
    gap: clamp(16px, 4vw, 48px);
    padding: clamp(28px, 5vh, 46px) 0;
    border-top: 1px solid var(--border);
  }
  .value:last-child { border-bottom: 1px solid var(--border); }
  .value__num { font-family: var(--font-mono); color: var(--accent-ink); font-size: 0.9rem; }
  .value__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .value__desc {
    grid-column: 2;
    margin-top: 14px;
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text-2);
    max-width: 40ch;
  }
  .value:hover .value__title { color: var(--accent-ink); transition: color 0.3s var(--ease); }
  @media (max-width: 640px) {
    .value { grid-template-columns: 1fr; gap: 8px; }
    .value__desc { grid-column: 1; }
  }
</style>
