---
// ─────────────────────────────────────────────────────────────────────────────
// SEO — canonical, Open Graph, Twitter card, dan JSON-LD Person.
//
// Semua URL absolut dibangun dari `Astro.site` (= domain produksi di
// astro.config.mjs). Jadi canonical, og:url, dan og:image SELALU memakai
// https://personal.andikurniawan.vanillate.id, tidak pernah URL *.vercel.app,
// di mana pun situs ini di-deploy.
// ─────────────────────────────────────────────────────────────────────────────
import { profile } from '../data/profile.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = profile.seo.title || `${profile.name} · ${profile.role}`,
  description = profile.seo.description,
  image = profile.seo.ogImage,
} = Astro.props;

// `Astro.site` wajib ada (di-set di astro.config.mjs). Fallback defensif agar
// build tidak pecah bila konfigurasi hilang.
const SITE = Astro.site ?? new URL('https://personal.andikurniawan.vanillate.id');

const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = image ? new URL(image, SITE).href : '';

// JSON-LD: schema.org/Person — bentuk terbaik untuk halaman data diri.
const sameAs = profile.links
  .map((l) => l.href)
  .filter((h) => /^https?:\/\//.test(h)); // hanya URL http(s), bukan mailto:

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: SITE.origin,
  jobTitle: profile.role,
  worksFor: {
    '@type': 'Organization',
    name: profile.org,
    url: profile.orgUrl,
  },
  ...(profile.location ? { address: { '@type': 'PostalAddress', addressCountry: profile.location } } : {}),
  ...(ogImage ? { image: ogImage } : {}),
  ...(sameAs.length ? { sameAs } : {}),
  description,
};
---

<!-- Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content="profile" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:locale" content="id_ID" />
{ogImage && <meta property="og:image" content={ogImage} />}

<!-- Twitter -->
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<!-- JSON-LD Person -->
<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
