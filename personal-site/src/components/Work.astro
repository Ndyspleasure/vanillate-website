---
import Icon from './Icon.astro';
import { content, type Locale } from '../data/content.ts';
import { projects } from '../data/projects.ts';
interface Props { locale?: Locale }
const { locale = 'id' } = Astro.props;
const t = content[locale];
const base = locale === 'en' ? '/en' : '';
---
<section class="work" id="work" aria-labelledby="work-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{t.work.eyebrow}</p>
      <h2 class="h2" id="work-h">{t.work.title}</h2>
      <p class="lead" style="margin-top:16px">{t.work.lead}</p>
    </div>

    <div class="work__list">
      {projects.map((p, i) => (
        <article class="pcard" data-reveal data-tilt="4" style={`--reveal-delay:${i * 90}ms`}>
          <span class="tilt-glare" aria-hidden="true"></span>
          <a class="pcard__link" href={`${base}/work/${p.slug}`} aria-labelledby={`p-${p.slug}`}>
            <div class="pcard__media">
              <img
                src={p.image}
                alt={p.alt[locale]}
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
              <span class="pcard__cat mono">{p.category}</span>
            </div>
            <div class="pcard__body">
              <h3 class="pcard__title" id={`p-${p.slug}`}>{p.name}</h3>
              <p class="pcard__desc">{p.summary[locale]}</p>
              <span class="pcard__cta">
                {t.work.cta}
                <Icon name="arrowUpRight" size={16} />
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work__list { display: grid; gap: 20px; }
  .pcard {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elev);
  }
  .pcard:hover { border-color: var(--text); --lift: -3px; }
  .pcard__link { display: grid; grid-template-columns: 1.1fr 1fr; align-items: stretch; }
  .pcard__media {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    aspect-ratio: 16 / 10;
  }
  .pcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .pcard:hover .pcard__media img { transform: scale(1.04); }
  .pcard__cat {
    position: absolute;
    left: 14px;
    top: 14px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: 999px;
  }
  .pcard__body { padding: clamp(24px, 4vw, 40px); display: flex; flex-direction: column; justify-content: center; }
  .pcard__title { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 600; }
  .pcard__desc { margin: 14px 0 20px; color: var(--text-2); max-width: 40ch; }
  .pcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent-ink);
  }
  @media (max-width: 720px) {
    .pcard__link { grid-template-columns: 1fr; }
  }
</style>
