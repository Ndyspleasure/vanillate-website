---
import { ui } from '../data/icons.ts';

interface Props {
  name: keyof typeof ui | string;
  size?: number;
  label?: string; // jika ada → ikon punya makna (aria-label); jika tidak → dekoratif
  class?: string;
}
const { name, size = 20, label, class: cls = '' } = Astro.props;
const svg = ui[name as string] ?? '';
---
<span
  class={`icon ${cls}`}
  style={`--icon-size:${size}px`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg}
/>

<style>
  .icon {
    display: inline-flex;
    width: var(--icon-size);
    height: var(--icon-size);
    flex: 0 0 auto;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
