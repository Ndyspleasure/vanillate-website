---
import { content, skills, type Locale } from '../data/content.ts';
import { skillIcons } from '../data/icons.ts';
interface Props { locale?: Locale }
const { locale = 'id' } = Astro.props;
const t = content[locale];
---
<section class="skills" aria-labelledby="skills-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{t.skills.eyebrow}</p>
      <h2 class="h2" id="skills-h">{t.skills.title}</h2>
      <p class="lead" style="margin-top:16px">{t.skills.lead}</p>
    </div>

    <ul class="skills__grid">
      {skills.map((s, i) => {
        const icon = skillIcons[s.name];
        return (
          <li class="skill" data-reveal style={`--brand:${icon?.color ?? 'var(--accent)'};--reveal-delay:${i * 50}ms`}>
            <span class="skill__icon" set:html={icon?.svg ?? ''} aria-hidden="true" />
            <div class="skill__meta">
              <h3 class="skill__name">{s.name}</h3>
              <p class="skill__desc">{s[locale]}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .skills__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .skill {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .skill:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--brand) 60%, var(--border));
    box-shadow: 0 12px 30px -18px color-mix(in srgb, var(--brand) 70%, transparent);
  }
  .skill__icon {
    width: 34px;
    height: 34px;
    color: var(--text-2);
    transition: color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .skill__icon :global(svg) { width: 100%; height: 100%; }
  .skill:hover .skill__icon {
    color: var(--brand);
    transform: scale(1.06);
  }
  .skill__name {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
  }
  .skill__desc {
    margin-top: 6px;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-2);
  }
  @media (max-width: 900px) {
    .skills__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 460px) {
    .skills__grid { grid-template-columns: 1fr; }
  }
</style>
