---
import Icon from './Icon.astro';
import { content, site, studioStats, type Locale } from '../data/content.ts';
interface Props { locale?: Locale }
const { locale = 'id' } = Astro.props;
const t = content[locale];
---
<section class="van" id="vanillate" aria-labelledby="van-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{t.vanillate.eyebrow}</p>
      <h2 class="h2" id="van-h">{t.vanillate.title}</h2>
      <p class="van__role mono">{t.vanillate.role}</p>
      <p class="lead" style="margin-top:18px">{t.vanillate.lead}</p>
    </div>

    <dl class="van__stats" data-reveal>
      {studioStats.map((s) => (
        <div class="van__stat">
          <dt class="van__num" data-count>{s.value}</dt>
          <dd class="van__lbl">{s[locale]}</dd>
        </div>
      ))}
    </dl>

    <div class="van__story">
      <div class="van__col" data-reveal>
        <h3 class="h3 van__story-title">{t.vanillate.storyTitle}</h3>
        {t.vanillate.story.map((p) => <p class="van__p">{p}</p>)}
        <a class="btn btn--primary van__cta" href={site.studioUrl} target="_blank" rel="noopener" data-magnetic="0.35">
          {t.vanillate.cta}
          <span class="arrow"><Icon name="arrowUpRight" size={16} /></span>
        </a>
      </div>

      <div class="van__col" data-reveal style="--reveal-delay:120ms">
        <h3 class="h3 van__story-title">{t.vanillate.futureTitle}</h3>
        <ul class="van__future">
          {t.vanillate.future.map((f) => <li>{f}</li>)}
        </ul>
        <p class="van__note muted">
          {locale === 'en'
            ? 'From Vanillate Sambung Kata, a Discord community game, toward a broader studio building community tools, AI tools, and automation for Indonesia.'
            : 'Dari Vanillate Sambung Kata, permainan komunitas Discord, menuju studio yang membangun community tools, AI tools, dan automation untuk Indonesia.'}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .van__role { margin-top: 14px; font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent-ink); letter-spacing: 0.04em; }
  .van__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin: clamp(24px, 4vh, 48px) 0 clamp(40px, 7vh, 80px);
  }
  .van__stat { background: var(--bg-elev); padding: 26px 22px; }
  .van__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    color: var(--accent-ink);
  }
  .van__lbl { margin-top: 6px; font-size: 0.85rem; color: var(--text-2); }
  .van__story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .van__story-title { margin-bottom: 18px; }
  .van__p { color: var(--text-2); margin-bottom: 14px; max-width: 44ch; }
  .van__cta { margin-top: 16px; }
  .van__future { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .van__future li {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 9px 15px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-2);
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .van__future li:hover { border-color: var(--accent); color: var(--text); }
  .van__note { margin-top: 20px; font-size: 0.9rem; max-width: 40ch; }
  @media (max-width: 820px) {
    .van__stats { grid-template-columns: repeat(2, 1fr); }
    .van__story { grid-template-columns: 1fr; }
  }
</style>
