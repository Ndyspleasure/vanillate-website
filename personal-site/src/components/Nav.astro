---
import Icon from './Icon.astro';
import { content, altUrl, type Locale } from '../data/content.ts';

interface Props {
  locale?: Locale;
  path?: string;
}
const { locale = 'id', path = '/' } = Astro.props;
const t = content[locale];
const homeHref = locale === 'en' ? '/en' : '/';
const other: Locale = locale === 'en' ? 'id' : 'en';
const altHref = altUrl(other, path);
const secHref = (id: string) => `${homeHref === '/' ? '' : homeHref}/#${id}`;

const links = [
  { label: t.nav.about, id: 'about' },
  { label: t.nav.work, id: 'work' },
  { label: t.nav.vanillate, id: 'vanillate' },
  { label: t.nav.contact, id: 'contact' },
];

// Experience toggles (Performance + Animation). Wired by scripts/experience.ts.
const toggles = [
  {
    kind: 'perf', label: t.perf.label, a11y: t.perf.a11y,
    opts: [
      { set: 'perf:auto', name: t.perf.auto.name, note: t.perf.systemPick, short: t.perf.modeAuto },
      { set: 'perf:high', name: t.perf.high.name, note: '', short: t.perf.modeHigh },
      { set: 'perf:low', name: t.perf.low.name, note: '', short: t.perf.modeLow },
    ],
  },
  {
    kind: 'anim', label: t.perf.animLabel, a11y: t.perf.animA11y,
    opts: [
      { set: 'anim:auto', name: t.perf.animAuto.name, note: '', short: t.perf.animAutoShort },
      { set: 'anim:manual', name: t.perf.animManual.name, note: '', short: t.perf.animManualShort },
    ],
  },
];
---
<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__brand" href={homeHref} aria-label={locale === 'en' ? 'Andi Kurniawan, home' : 'Andi Kurniawan, beranda'}>
      <span class="mono">AK</span>
      <span class="nav__name">Andi Kurniawan</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={secHref(l.id)} data-navlink={l.id}>{l.label}</a>)}
    </nav>

    <div class="nav__ctrls">
      {toggles.map((tg) => (
        <div class="exptog" data-exp-tog={tg.kind}>
          <button type="button" class="exptog__btn" data-exp-btn aria-haspopup="true" aria-expanded="false" aria-label={tg.a11y}>
            <span class="exptog__k mono">{tg.label}</span>
            <span class="exptog__v mono" data-exp-val></span>
            <svg class="exptog__cn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="exptog__menu" data-exp-menu hidden role="menu">
            {tg.opts.map((o) => (
              <button type="button" class="exptog__opt" role="menuitemradio" aria-checked="false" data-exp-set={o.set} data-short={o.short}>
                <b>{o.name}</b>
                {o.note && <small>{o.note}</small>}
              </button>
            ))}
          </div>
        </div>
      ))}
      <button type="button" class="iconbtn" data-theme-toggle aria-label={t.a11y.theme}>
        <span class="only-light"><Icon name="moon" size={18} /></span>
        <span class="only-dark"><Icon name="sun" size={18} /></span>
      </button>
      <a class="iconbtn langbtn" href={altHref} aria-label={t.a11y.lang} hreflang={other}>
        <span class="mono">{locale === 'en' ? 'ID' : 'EN'}</span>
      </a>
      <button type="button" class="iconbtn nav__burger" data-menu-toggle aria-label={t.a11y.menu} aria-expanded="false" aria-controls="mobile-nav">
        <span data-burger-open><Icon name="menu" size={20} /></span>
        <span data-burger-close hidden><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>

  <div class="nav__mobile" id="mobile-nav" hidden>
    <nav aria-label="Mobile">
      {links.map((l) => <a href={secHref(l.id)} data-menu-link>{l.label}</a>)}
      <a href={altHref} class="mono" hreflang={other}>{locale === 'en' ? 'Bahasa Indonesia' : 'English'}</a>
    </nav>
    <div class="nav__mobtog">
      {toggles.map((tg) => (
        <div class="mobtog" data-exp-tog={tg.kind}>
          <span class="mobtog__k mono">{tg.label}</span>
          <div class="mobtog__opts">
            {tg.opts.map((o) => (
              <button type="button" class="mobtog__opt mono" role="menuitemradio" aria-checked="false" data-exp-set={o.set} data-short={o.short}>{o.short}</button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: background 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  .nav[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom-color: var(--border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 20px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .nav__brand .mono {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent-ink);
  }
  .nav__name {
    font-family: var(--font-display);
    font-size: 0.98rem;
  }
  .nav__links {
    display: flex;
    gap: 28px;
    margin-left: auto;
    margin-right: 26px;
  }
  .nav__links a {
    font-size: 0.92rem;
    color: var(--text-2);
    position: relative;
    padding: 4px 0;
    transition: color 0.25s var(--ease);
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s var(--ease);
  }
  .nav__links a:hover,
  .nav__links a[aria-current='true'] {
    color: var(--text);
  }
  .nav__links a[aria-current='true']::after {
    width: 100%;
  }
  .nav__ctrls {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text);
    transition: border-color 0.25s var(--ease), transform 0.2s var(--ease), background 0.25s var(--ease);
  }
  .iconbtn:hover {
    border-color: var(--text);
    transform: translateY(-1px);
  }
  .langbtn .mono {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  /* Experience toggles */
  .exptog { position: relative; display: none; }
  @media (min-width: 921px) { .exptog { display: inline-flex; } }
  .exptog__btn {
    display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 10px;
    border: 1px solid var(--border); border-radius: 10px; background: var(--bg-elev); color: var(--text);
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.03em;
    transition: border-color 0.2s var(--ease);
  }
  .exptog__btn:hover { border-color: var(--text); }
  .exptog__k { color: var(--text-2); display: none; }
  @media (min-width: 1040px) { .exptog__k { display: inline; } }
  .exptog__v { color: var(--accent-ink); }
  .exptog__cn { width: 13px; height: 13px; color: var(--text-2); }
  .exptog__menu {
    position: absolute; top: calc(100% + 8px); right: 0; z-index: 120; width: 230px;
    border: 1px solid var(--border); border-radius: 12px; background: var(--bg-elev);
    box-shadow: 0 20px 50px -24px rgba(0,0,0,0.5); padding: 6px; display: flex; flex-direction: column; gap: 2px;
  }
  .exptog__opt { display: flex; flex-direction: column; gap: 2px; text-align: left; padding: 9px 11px; border-radius: 8px; transition: background 0.2s; }
  .exptog__opt:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .exptog__opt b { font-family: var(--font-body); font-weight: 600; font-size: 0.88rem; }
  .exptog__opt small { color: var(--text-2); font-family: var(--font-mono); font-size: 0.64rem; }
  .exptog__opt.is-on { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .exptog__opt.is-on b { color: var(--accent-ink); }

  /* mobile toggles inside the menu */
  .nav__mobtog { padding: 4px var(--gutter) 20px; display: flex; flex-direction: column; gap: 16px; }
  .mobtog__k { display: block; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-2); margin-bottom: 8px; }
  .mobtog__opts { display: flex; gap: 8px; flex-wrap: wrap; }
  .mobtog__opt { padding: 8px 14px; border: 1px solid var(--border); border-radius: 999px; font-size: 0.8rem; color: var(--text-2); }
  .mobtog__opt.is-on { border-color: var(--accent); color: var(--accent-ink); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  @media (min-width: 921px) { .nav__mobtog { display: none; } }
  .only-dark { display: none; }
  :global([data-theme='dark']) .only-dark { display: inline-flex; }
  :global([data-theme='dark']) .only-light { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .only-dark { display: inline-flex; }
    :global(:root:not([data-theme='light'])) .only-light { display: none; }
  }

  .nav__burger { display: none; }
  .nav__mobile {
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .nav__mobile nav {
    display: flex;
    flex-direction: column;
    padding: 12px var(--gutter) 22px;
    gap: 4px;
  }
  .nav__mobile a {
    padding: 14px 4px;
    font-family: var(--font-display);
    font-size: 1.4rem;
    border-bottom: 1px solid var(--border);
  }
  .nav__mobile a:last-child {
    border-bottom: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-2);
    margin-top: 8px;
  }

  @media (max-width: 920px) {
    .nav__links {
      display: none;
    }
    .nav__burger {
      display: inline-flex;
    }
  }
  /* keep the long name only where there's room next to the toggles */
  @media (max-width: 1040px) {
    .nav__name {
      display: none;
    }
  }
</style>

<script>
  // Theme toggle — persist choice; default follows system.
  const root = document.documentElement;
  function currentTheme() {
    const explicit = root.getAttribute('data-theme');
    if (explicit) return explicit;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  });

  // Sticky nav background after scroll.
  const nav = document.querySelector('[data-nav]');
  const onScroll = () => {
    if (window.scrollY > 12) nav?.setAttribute('data-scrolled', '');
    else nav?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu.
  const menu = document.getElementById('mobile-nav');
  const openIcon = document.querySelector('[data-burger-open]');
  const closeIcon = document.querySelector('[data-burger-close]');
  function setMenu(open: boolean) {
    if (!menu) return;
    menu.hidden = !open;
    openIcon && ((openIcon as HTMLElement).hidden = open);
    closeIcon && ((closeIcon as HTMLElement).hidden = !open);
    document.querySelectorAll('[data-menu-toggle]').forEach((b) =>
      b.setAttribute('aria-expanded', String(open))
    );
  }
  document.querySelectorAll('[data-menu-toggle]').forEach((b) =>
    b.addEventListener('click', () => setMenu(menu?.hidden ?? true))
  );
  document.querySelectorAll('[data-menu-link]').forEach((a) =>
    a.addEventListener('click', () => setMenu(false))
  );

  // Active-section highlight in nav.
  const navlinks = new Map<string, Element>();
  document.querySelectorAll('[data-navlink]').forEach((a) =>
    navlinks.set(a.getAttribute('data-navlink') || '', a)
  );
  const sections = document.querySelectorAll('section[id]');
  if ('IntersectionObserver' in window && navlinks.size && sections.length) {
    const so = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            navlinks.forEach((el) => el.removeAttribute('aria-current'));
            navlinks.get((e.target as HTMLElement).id)?.setAttribute('aria-current', 'true');
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((s) => so.observe(s));
  }
</script>
