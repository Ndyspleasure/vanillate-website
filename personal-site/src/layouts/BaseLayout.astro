---
import SEO from '../components/SEO.astro';
import Experience from '../components/Experience.astro';
import { type Locale } from '../data/content.ts';
import '../styles/global.css';

interface Props {
  locale?: Locale;
  path?: string;
  title?: string;
  description?: string;
  type?: 'website' | 'profile' | 'article';
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any>[];
}
const { locale = 'id', ...seo } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <SEO locale={locale} {...seo} />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Theme init (no FOUC): explicit choice wins, else system. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>

    <!-- Experience init (no FOUC): resolves Performance (High/Smooth) + Animation
         (Auto/Manual) before first paint. A light capability probe only feeds an
         advisory recommendation; a saved manual choice always wins. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, ls = null;
        try { ls = window.localStorage; } catch (e) {}
        function get(k) { try { return ls && ls.getItem(k); } catch (e) { return null; } }
        var perfChoice = get('exp.perf') || 'auto';   // 'auto' | 'high' | 'low'
        var animChoice = get('exp.anim') || 'auto';   // 'auto' | 'manual'
        var seen = !!get('exp.seen');
        var reduce = false;
        try { reduce = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

        function detect() {
          var s = 0, n = navigator;
          var cores = n.hardwareConcurrency || 0;
          if (cores >= 8) s += 2; else if (cores >= 4) s += 1; else if (cores > 0) s -= 1;
          var mem = n.deviceMemory || 0;
          if (mem >= 8) s += 2; else if (mem >= 4) s += 1; else if (mem && mem <= 2) s -= 2;
          var coarse = false;
          try { coarse = matchMedia('(pointer:coarse)').matches; } catch (e) {}
          if (coarse) s -= 1;
          var dpr = window.devicePixelRatio || 1;
          if (coarse && screen.width * dpr * screen.height * dpr > 4200000) s -= 1;
          var gl = null;
          try { var c = document.createElement('canvas'); gl = c.getContext('webgl2') || c.getContext('webgl'); } catch (e) {}
          if (!gl) { s -= 3; }
          else {
            s += 1;
            try {
              var ext = gl.getExtension('WEBGL_debug_renderer_info');
              if (ext) {
                var r = (gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) || '').toLowerCase();
                if (/mali-[4t]|adreno \(tm\) [1-5]|powervr|videocore|swiftshader|llvmpipe|software/.test(r)) s -= 3;
                else if (/apple|nvidia|geforce|radeon|adreno \(tm\) [67]|iris|apple m/.test(r)) s += 1;
              }
            } catch (e) {}
          }
          if (reduce) s -= 2;
          return s >= 1 ? 'high' : 'low';
        }

        var rec = detect();
        var perf = perfChoice === 'auto' ? rec : perfChoice;
        d.setAttribute('data-perf', perf);
        d.setAttribute('data-anim', animChoice);
        d.setAttribute('data-perf-choice', perfChoice);
        d.setAttribute('data-perf-rec', rec);
        if (!seen) d.setAttribute('data-exp-fresh', '');
        window.__EXP__ = { perf: perf, anim: animChoice, perfChoice: perfChoice, rec: rec, seen: seen };
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <Experience locale={locale} />
    <slot />

    <!-- Reveal-on-scroll (progressive enhancement; CSS keeps content visible for reduced-motion) -->
    <script>
      const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('[data-reveal]');
      if (!rm && 'IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
