---
// HALAMAN ARTIKEL — /blog/<slug>
//
// Dibangun statis saat build dari Sanity (lihat src/lib/blog/sanity.ts), jadi
// crawler & mesin AI menerima HTML lengkap tanpa perlu menjalankan JavaScript.
// SEO: canonical, Open Graph article, BlogPosting + BreadcrumbList (+ FAQPage
// bila ada FAQ), daftar isi ber-anchor, dan tautan internal ke produk & FAQ.
//
// Slug lama sebuah artikel (previousSlugs, dicatat otomatis saat slug diganti
// lalu diterbitkan ulang) ikut dibangun di sini sebagai halaman redirect.
import BaseLayout from '@layouts/BaseLayout.astro';
import RedirectStub from '@components/RedirectStub.astro';
import PostCard from '@components/blog/PostCard.astro';
import { getBlog } from '@/lib/blog/sanity';
import type { BlogPost } from '@/lib/blog/model';
import {
  authorPath,
  blogPostingJsonLd,
  breadcrumbJsonLd,
  canonicalUrl,
  categoryPath,
  faqPageJsonLd,
  formatTanggal,
  jsonLdString,
  postPath,
  relatedPosts,
  tagPath,
  wasUpdated,
} from '@/lib/blog/model';
import { sanityImageUrl, sanitySrcset } from '@/lib/blog/markdown';
import { faqList, productList, renderArticle, siteInfo } from '@/lib/blog/site';
import { adHtml, adsenseClient, withInArticleAd } from '@/lib/blog/ads';
import { url } from '@utils/url';

export async function getStaticPaths() {
  const blog = await getBlog();
  const bySlug = new Map(blog.posts.map((p) => [p.slug, p]));
  return [
    ...blog.posts.map((post) => ({
      params: { slug: post.slug },
      props: { post, related: relatedPosts(post, blog.posts), redirectTo: null },
    })),
    ...blog.redirects.map((r) => ({
      params: { slug: r.from },
      props: { post: bySlug.get(r.to)!, related: [], redirectTo: url(postPath(r.to)) },
    })),
  ];
}

interface Props {
  post: BlogPost;
  related: BlogPost[];
  redirectTo: string | null;
}

const { post, related, redirectTo } = Astro.props as Props;

const { html: isiHtml, headings } = renderArticle(post.body);
// Iklan hanya di halaman artikel (bukan /blog & daftar lain). Mati bila ID kosong.
const adClient = adsenseClient();
const html = withInArticleAd(isiHtml);
const adAkhir = adHtml('afterArticle');
const toc = headings.filter((h) => h.level === 2);
const img = post.mainImage;
const ogImage = img ? sanityImageUrl(img.url, { w: 1200, h: 630, fit: 'crop', fm: 'jpg' }) : null;
const kategori = post.categories[0];
const produk = post.relatedProducts.map((s) => productList.find((p) => p.slug === s)).filter(Boolean) as typeof productList;
const faqTerkait = post.relatedFaqs.map((r) => faqList.find((f) => f.ref === r)).filter(Boolean) as typeof faqList;
const faqHtml = post.faqs.map((f) => ({ q: f.q, a: renderArticle(f.a).html }));
const canonical = canonicalUrl(siteInfo.url, postPath(post.slug));
const avatar = post.author?.avatar ? sanityImageUrl(post.author.avatar.url, { w: 96, h: 96, fit: 'crop' }) : null;

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    blogPostingJsonLd(post, siteInfo, ogImage),
    breadcrumbJsonLd(siteInfo, [
      { name: 'Blog', path: '/blog' },
      ...(kategori ? [{ name: kategori.title, path: categoryPath(kategori.slug) }] : []),
      { name: post.title, path: postPath(post.slug) },
    ]),
    ...(post.faqs.length ? [faqPageJsonLd(post.faqs)] : []),
  ],
};

const share = [
  { label: 'WhatsApp', href: `https://wa.me/?text=${encodeURIComponent(`${post.title} ${canonical}`)}` },
  { label: 'X', href: `https://x.com/intent/post?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(canonical)}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}` },
];
const linkMuted = 'hover:text-amber-600 dark:hover:text-amber-400 transition-colors';
---

{redirectTo ? (
  <RedirectStub to={redirectTo} title="Artikel dipindahkan" text="Artikel ini kini berada di" linkLabel={post.title} />
) : (
  <BaseLayout
    title={post.seo.title || post.title}
    rawTitle={Boolean(post.seo.title)}
    description={post.seo.description || post.excerpt}
    image={ogImage ?? undefined}
    imageAlt={img?.alt || undefined}
    noindex={post.seo.noindex}
    article={{
      publishedTime: post.publishedAt,
      modifiedTime: post.updatedAt,
      section: kategori?.title,
      tags: post.tags.map((t) => t.name),
      author: post.author ? canonicalUrl(siteInfo.url, authorPath(post.author.slug)) : undefined,
    }}
  >
    <script type="application/ld+json" slot="head" set:html={jsonLdString(ld)} />
    {adClient && (
      <script is:inline async slot="head" crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`}></script>
    )}
    {img && <link rel="preload" as="image" slot="head" imagesrcset={sanitySrcset(img.url)} imagesizes="(min-width: 1024px) 960px, 100vw" />}

    <article>
      <!-- HEADER -->
      <header class="container-page pt-14 md:pt-20">
        <div class="max-w-3xl">
          <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-sm text-ink-500 dark:text-cream-300/60">
            <a href={url('/blog')} class={linkMuted}>Blog</a>
            {kategori && (
              <>
                <span aria-hidden="true">/</span>
                <a href={url(categoryPath(kategori.slug))} class={linkMuted}>{kategori.title}</a>
              </>
            )}
          </nav>

          <h1 class="font-display font-semibold tracking-tightest text-[clamp(2rem,4.6vw,3.25rem)] leading-[1.08]">{post.title}</h1>
          <p class="mt-5 text-lg md:text-xl text-ink-600 dark:text-cream-200/80 leading-relaxed">{post.excerpt}</p>

          <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-ink-500 dark:text-cream-300/60">
            {post.author && (
              <a href={url(authorPath(post.author.slug))} class={`flex items-center gap-2.5 ${linkMuted}`}>
                {avatar ? (
                  <img src={avatar} alt="" width="36" height="36" class="h-9 w-9 rounded-full object-cover" loading="lazy" decoding="async" />
                ) : (
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-500/15 font-semibold text-amber-700 dark:text-amber-400" aria-hidden="true">{post.author.name.slice(0, 1)}</span>
                )}
                <span>
                  <span class="block font-medium text-ink-900 dark:text-cream-50">{post.author.name}</span>
                  {post.author.role && <span class="block text-xs">{post.author.role}</span>}
                </span>
              </a>
            )}
            <span class="font-mono text-xs">
              <time datetime={post.publishedAt}>{formatTanggal(post.publishedAt)}</time>
              {wasUpdated(post) && (
                <> · Diperbarui <time datetime={post.updatedAt}>{formatTanggal(post.updatedAt)}</time></>
              )}
              {' '}· {post.readingMinutes} menit baca
            </span>
          </div>
        </div>
      </header>

      {img && (
        <figure class="container-page mt-10">
          <img
            src={sanityImageUrl(img.url, { w: 1600 })}
            srcset={sanitySrcset(img.url)}
            sizes="(min-width: 1024px) 960px, 100vw"
            alt={img.alt}
            width={img.width ?? undefined}
            height={img.height ?? undefined}
            fetchpriority="high"
            decoding="async"
            class="w-full max-w-5xl max-h-[560px] object-cover rounded-3xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100 dark:bg-ink-900"
            style={img.lqip ? `background-image:url(${img.lqip});background-size:cover` : undefined}
          />
          {img.caption && <figcaption class="mt-3 max-w-5xl text-center text-sm text-ink-500 dark:text-cream-300/60">{img.caption}</figcaption>}
        </figure>
      )}

      <!-- ISI + DAFTAR ISI -->
      <div class="container-page mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_260px]">
        <div class="min-w-0 max-w-[720px]">
          {post.tldr.length > 0 && (
            <section aria-labelledby="poin-penting" class="mb-10 rounded-2xl border border-amber-500/30 bg-amber-500/5 p-6">
              <h2 id="poin-penting" class="font-mono text-xs uppercase tracking-[0.2em] text-amber-700 dark:text-amber-400 mb-3">Poin penting</h2>
              <ul class="space-y-2">
                {post.tldr.map((t) => (
                  <li class="flex gap-3 text-ink-700 dark:text-cream-200 leading-relaxed">
                    <span class="text-amber-600 dark:text-amber-500 mt-0.5" aria-hidden="true">✓</span><span>{t}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {toc.length >= 3 && (
            <details class="lg:hidden mb-10 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 px-5 py-4">
              <summary class="cursor-pointer font-medium">Daftar isi</summary>
              <ol class="mt-3 space-y-1.5 text-sm">
                {toc.map((h) => <li><a href={`#${h.id}`} class={`text-ink-600 dark:text-cream-300 ${linkMuted}`}>{h.text}</a></li>)}
              </ol>
            </details>
          )}

          <div class="blog-isi" set:html={html} />
          {adAkhir && <Fragment set:html={adAkhir} />}

          {faqHtml.length > 0 && (
            <section aria-labelledby="faq-artikel" class="mt-14">
              <h2 id="faq-artikel" class="font-display text-2xl md:text-[1.75rem] font-semibold tracking-tightest mb-5 scroll-mt-24">Pertanyaan yang sering diajukan</h2>
              <div class="divide-y divide-ink-900/10 dark:divide-cream-100/10 rounded-2xl border border-ink-900/10 dark:border-cream-100/10">
                {faqHtml.map((f) => (
                  <details class="group px-5 py-4">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-medium text-ink-900 dark:text-cream-50">
                      <h3 class="text-base">{f.q}</h3>
                      <span class="mt-0.5 text-amber-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                    </summary>
                    <div class="mt-3 [&_p]:mb-3 [&_p:last-child]:mb-0" set:html={f.a} />
                  </details>
                ))}
              </div>
            </section>
          )}

          {post.tags.length > 0 && (
            <ul class="mt-12 flex flex-wrap gap-2" aria-label="Tag">
              {post.tags.map((t) => (
                <li><a href={url(tagPath(t.slug))} class="inline-flex rounded-full border border-ink-900/10 dark:border-cream-100/10 px-3 py-1 text-sm text-ink-600 dark:text-cream-200/80 hover:border-amber-500/50 transition-colors">#{t.name}</a></li>
              ))}
            </ul>
          )}

          <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-ink-900/10 dark:border-cream-100/10 pt-6 text-sm">
            <span class="text-ink-500 dark:text-cream-300/60">Bagikan:</span>
            {share.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink-900/10 dark:border-cream-100/10 px-3 py-1 hover:border-amber-500/50 transition-colors">{s.label}</a>
            ))}
          </div>

          {post.author && (
            <aside class="mt-10 flex gap-4 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-6">
              {avatar ? (
                <img src={avatar} alt="" width="56" height="56" class="h-14 w-14 flex-none rounded-full object-cover" loading="lazy" decoding="async" />
              ) : (
                <span class="flex h-14 w-14 flex-none items-center justify-center rounded-full bg-amber-500/15 text-xl font-semibold text-amber-700 dark:text-amber-400" aria-hidden="true">{post.author.name.slice(0, 1)}</span>
              )}
              <div>
                <p class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-ink-500 dark:text-cream-300/60">Ditulis oleh</p>
                <a href={url(authorPath(post.author.slug))} class={`font-display text-lg font-semibold tracking-tightest ${linkMuted}`}>{post.author.name}</a>
                {post.author.role && <p class="text-sm text-ink-500 dark:text-cream-300/60">{post.author.role}</p>}
                {post.author.bio && <p class="mt-2 text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{post.author.bio}</p>}
              </div>
            </aside>
          )}
        </div>

        <!-- SIDEBAR -->
        <aside class="hidden lg:block">
          <div class="sticky top-24 space-y-8">
            {toc.length >= 2 && (
              <nav aria-label="Daftar isi">
                <p class="eyebrow mb-3">Daftar isi</p>
                <ol class="space-y-1.5 border-l border-ink-900/10 dark:border-cream-100/10">
                  {toc.map((h) => (
                    <li><a href={`#${h.id}`} data-toc={h.id} class={`-ml-px block border-l-2 border-transparent pl-4 py-1 text-sm text-ink-600 dark:text-cream-300 ${linkMuted}`}>{h.text}</a></li>
                  ))}
                </ol>
              </nav>
            )}
            {produk.length > 0 && (
              <div>
                <p class="eyebrow mb-3">Produk terkait</p>
                <ul class="space-y-2">
                  {produk.map((p) => (
                    <li>
                      <a href={url(`/products/${p.slug}`)} class="block rounded-xl border border-ink-900/10 dark:border-cream-100/10 p-3 hover:border-amber-500/50 transition-colors">
                        <span class="block font-medium text-sm">{p.name}</span>
                        <span class="block text-xs text-ink-500 dark:text-cream-300/60 line-clamp-2">{p.tagline}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </aside>
      </div>

      <!-- PRODUK & FAQ TERKAIT -->
      {(produk.length > 0 || faqTerkait.length > 0) && (
        <section class="container-page mt-16" aria-label="Produk dan panduan terkait">
          <div class="grid gap-6 md:grid-cols-2 max-w-5xl">
            {produk.map((p) => (
              <a href={url(`/products/${p.slug}`)} class="group rounded-2xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/40 dark:bg-ink-900/40 p-6 hover:border-amber-500/40 transition-colors">
                <p class="eyebrow mb-2">Coba produknya</p>
                <p class="font-display text-xl font-semibold tracking-tightest group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors">{p.name} →</p>
                <p class="mt-2 text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{p.tagline}</p>
              </a>
            ))}
            {faqTerkait.length > 0 && (
              <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-6">
                <p class="eyebrow mb-3">Panduan & FAQ terkait</p>
                <ul class="space-y-2">
                  {faqTerkait.map((f) => (
                    <li><a href={f.href} class={`text-sm text-ink-700 dark:text-cream-200 ${linkMuted}`}>→ {f.question}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )}
    </article>

    <!-- ARTIKEL TERKAIT -->
    {related.length > 0 && (
      <section class="container-page mt-20 pt-12 pb-24 border-t border-ink-900/10 dark:border-cream-100/10" aria-labelledby="artikel-terkait">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
          <h2 id="artikel-terkait" class="font-display text-2xl md:text-3xl font-semibold tracking-tightest">Artikel terkait</h2>
          <a href={url('/blog')} class="text-sm text-amber-700 dark:text-amber-400 hover:text-amber-500 transition-colors">Semua artikel →</a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <PostCard post={p} as="h3" />)}
        </div>
      </section>
    )}
    {related.length === 0 && <div class="pb-24"></div>}
  </BaseLayout>
)}

<script>
  // Isi tiap unit AdSense di halaman (antrean jalan walau skripnya belum termuat).
  const iklan = document.querySelectorAll('ins.adsbygoogle');
  if (iklan.length) {
    const w = window as unknown as { adsbygoogle?: object[] };
    w.adsbygoogle = w.adsbygoogle || [];
    iklan.forEach(() => w.adsbygoogle!.push({}));
  }

  // Sorot item daftar isi yang sedang dibaca. Tanpa JS, daftar isi tetap
  // berfungsi sebagai tautan anchor biasa.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map([...links].map((a) => [a.dataset.toc!, a]));
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.remove('!border-amber-500', '!text-amber-700', 'dark:!text-amber-400'));
          byId.get(e.target.id)?.classList.add('!border-amber-500', '!text-amber-700', 'dark:!text-amber-400');
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) obs.observe(el);
    });
  }
</script>
