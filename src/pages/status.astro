---
// Redirect permanen: /status dilebur ke /changelog.
//
// Dulu /status menampilkan status sinkronisasi data bot sekaligus changelog
// yang sama persis dengan /changelog. Status sinkronisasinya kini menjadi
// bagian "Status data" di /changelog, jadi URL lama diarahkan langsung ke
// bagian itu. GitHub Pages tidak bisa 301, jadi memakai stub redirect.
// Dikeluarkan dari sitemap (lihat astro.config.mjs).
import RedirectStub from '@components/RedirectStub.astro';
import { site } from '@data/site';

const to = `${site.url}/changelog/#status-data`;
---

<RedirectStub to={to} title="Pindah ke Changelog" text="Status data kini berada di" linkLabel="halaman Changelog" />
