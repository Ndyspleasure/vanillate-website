---
// Halaman pengarah Partnership (/partnership).
//
// Sengaja TANPA harga dan tanpa rincian fitur: halaman ini hanya menjelaskan
// cara Vanillate bekerja sama, lalu mengarahkan ke Campaign atau Jasa. Rincian
// dan harga ada di halaman masing-masing (dikelola dari CMS).
// Teks statis di kode, jadi tidak menambah query database.
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import { site } from '@data/site';
import { url } from '@utils/url';

const prinsip = [
  { title: 'Jelas sejak awal', text: 'Ruang lingkup, jadwal, dan biaya dibahas dan disepakati sebelum pekerjaan dimulai.' },
  { title: 'Menguntungkan dua pihak', text: 'Kerja sama dijalankan jika berguna bagi partner dan nyaman bagi pemain kami.' },
  { title: 'Komunikasi langsung', text: 'Semua pengajuan masuk lewat WhatsApp official, ditangani langsung oleh tim kami.' },
];

const jalur = [
  {
    icon: 'sparkles' as const,
    title: 'Campaign',
    text: 'Jangkau pemain aktif Discord lewat bot Vanillate.',
    href: '/partnership/campaign/',
    cta: 'Lihat Campaign',
  },
  {
    icon: 'bot' as const,
    title: 'Jasa',
    text: 'Hosting bot dan pembuatan bot Discord untuk komunitasmu.',
    href: '/partnership/jasa/',
    cta: 'Lihat Jasa',
  },
];

const judul = 'Partnership';
const deskripsi = 'Cara Vanillate Studio bekerja sama dengan komunitas, kreator, dan brand. Pilih Campaign untuk menjangkau pemain atau Jasa untuk bot Discord.';
const canonical = new URL('/partnership', site.url).toString();
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: site.url },
        { '@type': 'ListItem', position: 2, name: judul, item: canonical },
      ],
    },
  ],
}).replace(/</g, '\\u003c');
---

<BaseLayout title={judul} description={deskripsi}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <section class="container-page pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">Vanillate Partnership</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-semibold tracking-tightest leading-[1.05]">Bekerja sama, dengan cara yang jelas</h1>
      <p class="mt-5 text-lg md:text-xl text-ink-600 dark:text-cream-200/80 leading-relaxed">
        Vanillate Studio dibangun bersama komunitas. Kami membuka kerja sama dengan komunitas,
        kreator, dan brand yang ingin tumbuh bersama, selama hasilnya baik untuk semua pihak.
      </p>
    </div>
  </section>

  <section class="container-page pb-12 md:pb-16">
    <div class="grid gap-3 md:grid-cols-3">
      {prinsip.map((p) => (
        <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
          <h2 class="font-display text-lg font-semibold tracking-tightest">{p.title}</h2>
          <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Pilih jalurnya</h2>
      <p class="mt-3 text-ink-600 dark:text-cream-200/80 leading-relaxed">Setiap jalur punya halaman sendiri dengan rincian dan cara pemesanan.</p>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {jalur.map((j) => (
        <article class="flex flex-col rounded-3xl border border-ink-900/10 dark:border-cream-100/10 p-6 md:p-7">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400">
            <Icon name={j.icon} class="h-5 w-5" />
          </span>
          <h3 class="mt-4 font-display text-2xl font-semibold tracking-tightest">{j.title}</h3>
          <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{j.text}</p>
          <div class="mt-6"><Button href={j.href} class="w-full">{j.cta}</Button></div>
        </article>
      ))}
    </div>
    <p class="mt-8 text-sm text-ink-600 dark:text-cream-200/80">
      Sudah punya akun partner? <a class="font-semibold underline" href={url('/partnership/masuk/')}>Masuk ke dashboard partner</a>.
    </p>
  </section>
</BaseLayout>
