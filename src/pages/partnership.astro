---
// Halaman publik Partnership — halaman penjualan.
//
// SELURUH isinya (teks, produk, HARGA, SEO) dikelola dari panel /admin lalu
// ditarik saat build oleh scripts/sync-content.mjs ke
// src/data/synced/partnership.json. Jadi memperbarui harga atau copy TIDAK
// perlu mengubah kode — pola yang sama dipakai AnnouncementBanner.
//
// Tombol produk membuka WhatsApp official dengan pesan terisi. URL-nya dibangun
// SAAT BUILD karena pesannya statis per produk (tanpa harga/ID), jadi halaman
// ini tidak butuh JavaScript sama sekali.
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import FAQAccordion from '@components/FAQAccordion.astro';
import Icon from '@components/Icon.astro';
import partnership from '@data/synced/partnership.json';
import { site, homeStats } from '@data/site';
import { buildPartnershipWhatsappUrl, formatPrice, safeUrl } from '@data/partnership';

const { settings, products, content } = partnership as any;

const hero = content?.hero ?? {};
const intro: Array<{ title: string; text: string }> = content?.intro ?? [];
const benefits: Array<{ title: string; text: string }> = content?.benefits ?? [];
const process: Array<{ n?: string; title: string; text: string }> = content?.process ?? [];
const faq: Array<{ q: string; a: string }> = content?.faq ?? [];
const audience: Array<{ title: string; text: string }> = content?.audience ?? [];
const compare = content?.compare ?? {};
const compareRows: Array<{ label: string; a?: string; b?: string }> = compare?.rows ?? [];
const compareCols: string[] = Array.isArray(compare?.columns) ? compare.columns : [];
const preview = content?.preview ?? {};
const previewItems: Array<{ label?: string; title?: string; text?: string; button?: string }> =
  preview?.items ?? [];
const rules = content?.rules ?? {};
const rulesAllowed: string[] = Array.isArray(rules?.allowed) ? rules.allowed : [];
const rulesNot: string[] = Array.isArray(rules?.notAllowed) ? rules.notAllowed : [];
const cta = content?.cta ?? {};
const seo = content?.seo ?? {};
const showStats = content?.showStats !== false;

/** Tujuan tombol: WhatsApp (default) atau URL kustom dari CMS. */
function ctaHref(p: any): string {
  if (p.ctaMode === 'url') {
    const u = safeUrl(p.ctaUrl);
    if (u) return u;
    // Mode URL tapi URL-nya kosong/tidak sah → jangan biarkan tombol mati.
    return buildPartnershipWhatsappUrl({ productName: p.name, category: 'marketing' });
  }
  return buildPartnershipWhatsappUrl({ productName: p.name, category: 'marketing' });
}

/** CTA global: Apply URL bila diisi, kalau tidak → WhatsApp umum. */
const applyHref = safeUrl(settings?.applyUrl) || buildPartnershipWhatsappUrl({ category: 'marketing' });

const judul = String(seo.title || hero.title || 'Partnership');
const deskripsi = String(
  seo.description ||
    hero.subtitle ||
    'Program kerja sama Vanillate Studio untuk komunitas, kreator, dan brand.',
);
const ogImage = safeUrl(seo.ogImage) || undefined;

// ── Structured data (Schema.org) ────────────────────────────────────────────
// Ditulis khusus di halaman ini; SEO.astro global tetap memasang Organization &
// WebSite. `Offer` memakai harga dari CMS sehingga hasil pencarian berpeluang
// menampilkan harga; `FAQPage` memberi peluang accordion di SERP.
const canonical = new URL('/partnership', site.url).toString();
const penawaran = products
  .filter((p: any) => p.price !== null && p.price !== undefined)
  .map((p: any) => ({
    '@type': 'Offer',
    name: p.name,
    description: p.tagline || p.description || undefined,
    price: String(p.price),
    priceCurrency: p.currency || 'IDR',
    availability: 'https://schema.org/InStock',
    url: canonical,
  }));

const graph: any[] = [
  {
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: 'Vanillate Partnership',
    serviceType: 'Discord community advertising',
    description: deskripsi,
    url: canonical,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: 'ID',
    ...(penawaran.length
      ? { offers: penawaran.length === 1 ? penawaran[0] : penawaran }
      : {}),
  },
];

if (faq.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

graph.push({
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: site.url },
    { '@type': 'ListItem', position: 2, name: judul, item: canonical },
  ],
});

const structuredData = { '@context': 'https://schema.org', '@graph': graph };

/**
 * Serialisasi JSON-LD yang aman ditempel ke dalam <script>.
 *
 * Isi graph ini berasal dari CMS (nama produk, deskripsi, FAQ). Bila salah satu
 * memuat penutup tag script, JSON.stringify biasa akan menutup tag lebih awal
 * dan sisa teksnya dieksekusi sebagai HTML/JS di halaman PUBLIK. Mengubah setiap
 * "<" menjadi escape < menutup celah itu dan tetap JSON yang sah.
 */
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<BaseLayout title={judul} description={deskripsi} image={ogImage}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- HERO -->
  <section class="container-page pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">
        Vanillate Partnership
      </p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-semibold tracking-tightest leading-[1.05]">
        {hero.title || 'Partnership'}
      </h1>
      {hero.subtitle && (
        <p class="mt-5 text-lg md:text-xl text-ink-600 dark:text-cream-200/80 leading-relaxed">
          {hero.subtitle}
        </p>
      )}
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href={applyHref} external size="lg">
          {hero.ctaLabel || 'Become a Partner'}
        </Button>
        {products.length > 0 && (
          <Button href="#paket" variant="secondary" size="lg">Lihat paket &amp; harga</Button>
        )}
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF: bukti jangkauan sebelum bicara harga -->
  {showStats && (
    <section class="container-page pb-12 md:pb-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {homeStats.map((s) => (
          <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
            <p class="font-display text-3xl md:text-4xl font-semibold tracking-tightest text-amber-600 dark:text-amber-400">
              {s.prefix}{s.num.toLocaleString('id-ID')}{s.suffix}
            </p>
            <p class="mt-1 text-sm font-medium">{s.label}</p>
            <p class="mt-0.5 text-xs text-ink-500 dark:text-cream-300/60">{s.hint}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- PRODUK & HARGA -->
  {products.length > 0 && (
    <section id="paket" class="container-page py-12 md:py-16 scroll-mt-24">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Paket &amp; harga</h2>
        <p class="mt-3 text-ink-600 dark:text-cream-200/80 leading-relaxed">
          Pilih bentuk broadcast yang paling sesuai. Tekan tombolnya untuk langsung terhubung
          dengan tim kami lewat WhatsApp.
        </p>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {products.map((p: any) => (
          <article
            class={`relative flex flex-col rounded-3xl border p-6 md:p-7 ${
              p.badge
                ? 'border-amber-500/40 bg-amber-500/[0.04]'
                : 'border-ink-900/10 dark:border-cream-100/10'
            }`}
          >
            {p.badge && (
              <span class="absolute -top-3 left-6 rounded-full bg-amber-500 px-3 py-1 text-xs font-semibold text-ink-950">
                {p.badge}
              </span>
            )}

            <h3 class="font-display text-2xl font-semibold tracking-tightest">{p.name}</h3>
            {p.tagline && <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/80">{p.tagline}</p>}

            <div class="mt-5">
              <p class="font-display text-3xl font-semibold tracking-tightest">
                {formatPrice(p.price, p.currency)}
                {/* Satuan paket dari CMS ("Pemain"/"Hari") lebih spesifik daripada
                    priceUnit lama, jadi ia yang dipakai bila tersedia. */}
                {(p.unit || p.priceUnit) && (
                  <span class="ml-1.5 text-sm font-normal text-ink-500 dark:text-cream-300/60">
                    {p.unit ? `/ ${p.unit}` : p.priceUnit}
                  </span>
                )}
              </p>
              {p.minQuantity > 0 && (
                <p class="mt-1 text-sm font-medium text-amber-700 dark:text-amber-400">
                  Minimum {new Intl.NumberFormat('id-ID').format(p.minQuantity)}{p.unit ? ` ${p.unit}` : ''}
                </p>
              )}
              {p.priceNote && (
                <p class="mt-1 text-xs text-ink-500 dark:text-cream-300/60">{p.priceNote}</p>
              )}
              {(p.price === null || p.price === undefined) && (
                <p class="mt-1 text-xs text-ink-500 dark:text-cream-300/60">
                  Hubungi kami untuk penawaran.
                </p>
              )}
            </div>

            {p.description && (
              <p class="mt-5 text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{p.description}</p>
            )}

            {p.info && (
              <p class="mt-3 text-sm text-ink-600 dark:text-cream-200/80">{p.info}</p>
            )}

            {p.features?.length > 0 && (
              <ul class="mt-5 space-y-2.5">
                {p.features.map((f: string) => (
                  <li class="flex items-start gap-2.5 text-sm">
                    <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-teal-600 dark:text-teal-400" />
                    <span class="text-ink-700 dark:text-cream-100/90">{f}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="mt-7 pt-1">
              <Button href={ctaHref(p)} external class="w-full">{p.ctaLabel}</Button>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- BANDINGKAN PAKET: bantu calon partner memilih, bukan menebak -->
  {compareRows.length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">
          {compare.title || 'Bandingkan paket'}
        </h2>
        {compare.note && (
          <p class="mt-3 text-ink-600 dark:text-cream-200/80 leading-relaxed">{compare.note}</p>
        )}
      </div>

      <!-- Tabel dibungkus wadah ber-scroll sendiri supaya body halaman tidak
           pernah ikut menggeser mendatar di layar kecil. -->
      <div class="mt-8 overflow-x-auto rounded-2xl border border-ink-900/10 dark:border-cream-100/10">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead class="bg-cream-100/60 dark:bg-ink-900/40">
            <tr>
              <th scope="col" class="px-5 py-3.5 font-medium text-ink-500 dark:text-cream-300/60">Aspek</th>
              {compareCols.map((c) => (
                <th scope="col" class="px-5 py-3.5 font-display text-base font-semibold tracking-tightest">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {compareRows.map((r) => (
              <tr class="border-t border-ink-900/5 dark:border-cream-100/5 align-top">
                <th scope="row" class="px-5 py-4 font-medium">{r.label}</th>
                <td class="px-5 py-4 text-ink-600 dark:text-cream-200/80">{r.a}</td>
                <td class="px-5 py-4 text-ink-600 dark:text-cream-200/80">{r.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- CONTOH TAMPILAN: tunjukkan hasilnya, jangan hanya dijelaskan -->
  {previewItems.length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">
          {preview.title || 'Begini tampilannya nanti'}
        </h2>
        {preview.note && (
          <p class="mt-3 text-ink-600 dark:text-cream-200/80 leading-relaxed">{preview.note}</p>
        )}
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {previewItems.map((it) => (
          <figure class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
            {it.label && (
              <figcaption class="font-mono text-xs uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">
                {it.label}
              </figcaption>
            )}
            <!-- Mock pesan bot: garis aksen kiri meniru embed Discord. Murni CSS,
                 tanpa gambar, jadi tetap tajam di layar apa pun & ringan. -->
            <div class="mt-4 rounded-xl bg-cream-100/60 dark:bg-ink-900/50 p-4">
              <div class="border-l-4 border-amber-500 pl-4">
                {it.title && (
                  <p class="font-display text-base font-semibold tracking-tightest">{it.title}</p>
                )}
                {it.text && (
                  <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{it.text}</p>
                )}
                {it.button && (
                  <span class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-ink-950">
                    {it.button}
                    <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                  </span>
                )}
              </div>
            </div>
          </figure>
        ))}
      </div>
      <p class="mt-4 text-xs text-ink-500 dark:text-cream-300/60">
        Ilustrasi tampilan, bukan tangkapan layar sesungguhnya.
      </p>
    </section>
  )}

  <!-- COCOK UNTUK SIAPA -->
  {audience.length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Cocok untuk siapa</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {audience.map((a) => (
          <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-500/15 text-teal-700 dark:text-teal-300">
              <Icon name="handshake" class="h-5 w-5" />
            </span>
            <h3 class="mt-4 font-display text-base font-semibold tracking-tightest">{a.title}</h3>
            <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{a.text}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- INFORMASI PARTNERSHIP -->
  {intro.length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Tentang program ini</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        {intro.map((s) => (
          <div>
            <h3 class="font-display text-lg font-semibold tracking-tightest">{s.title}</h3>
            <p class="mt-2 text-ink-600 dark:text-cream-200/80 leading-relaxed">{s.text}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- BENEFIT -->
  {benefits.length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Yang partner dapatkan</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {benefits.map((b) => (
          <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400">
              <Icon name="sparkles" class="h-5 w-5" />
            </span>
            <h3 class="mt-4 font-display text-base font-semibold tracking-tightest">{b.title}</h3>
            <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{b.text}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- HOW IT WORKS -->
  {process.length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Cara kerjanya</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {process.map((s, i) => (
          <li>
            <p class="font-mono text-sm text-amber-600 dark:text-amber-400">
              {s.n || String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-2 font-display text-lg font-semibold tracking-tightest">{s.title}</h3>
            <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{s.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- KETENTUAN: jujur di depan supaya tidak ada kejutan di belakang -->
  {(rulesAllowed.length > 0 || rulesNot.length > 0) && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">
          {rules.title || 'Ketentuan singkat'}
        </h2>
        {rules.note && (
          <p class="mt-3 text-ink-600 dark:text-cream-200/80 leading-relaxed">{rules.note}</p>
        )}
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {rulesAllowed.length > 0 && (
          <div class="rounded-2xl border border-teal-500/25 bg-teal-500/5 p-5">
            <h3 class="font-display text-base font-semibold tracking-tightest">Kami terima</h3>
            <ul class="mt-4 space-y-2.5">
              {rulesAllowed.map((r) => (
                <li class="flex gap-2.5 text-sm text-ink-600 dark:text-cream-200/80">
                  <Icon name="circle-check" class="mt-0.5 h-4 w-4 flex-none text-teal-700 dark:text-teal-300" />
                  <span>{r}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {rulesNot.length > 0 && (
          <div class="rounded-2xl border border-red-500/25 bg-red-500/5 p-5">
            <h3 class="font-display text-base font-semibold tracking-tightest">Tidak kami terima</h3>
            <ul class="mt-4 space-y-2.5">
              {rulesNot.map((r) => (
                <li class="flex gap-2.5 text-sm text-ink-600 dark:text-cream-200/80">
                  <Icon name="triangle-alert" class="mt-0.5 h-4 w-4 flex-none text-red-600 dark:text-red-400" />
                  <span>{r}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {faq.length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Pertanyaan umum</h2>
      <div class="mt-8 max-w-3xl">
        <FAQAccordion items={faq} />
      </div>
    </section>
  )}

  <!-- CTA PENUTUP -->
  <section class="container-page py-16 md:py-24">
    <div class="rounded-3xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/50 dark:bg-ink-900/40 px-6 py-12 md:px-12 md:py-16 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">
        {cta.title || 'Tertarik bekerja sama dengan kami?'}
      </h2>
      {cta.text && (
        <p class="mt-4 mx-auto max-w-xl text-ink-600 dark:text-cream-200/80 leading-relaxed">{cta.text}</p>
      )}
      <div class="mt-8 flex justify-center">
        <Button href={applyHref} external size="lg">{cta.label || 'Become a Partner'}</Button>
      </div>
      <p class="mt-4 text-xs text-ink-500 dark:text-cream-300/60">
        Tombol ini membuka WhatsApp official Vanillate dengan pesan yang sudah terisi.
      </p>
    </div>
  </section>
</BaseLayout>
