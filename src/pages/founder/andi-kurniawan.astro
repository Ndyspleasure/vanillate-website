---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import FounderImage from '@components/FounderImage.astro';
import { site } from '@data/site';
import { founder } from '@data/founder';
import { url } from '@utils/url';

const canonical = new URL(`/founder/${founder.slug}`, site.url).toString();
const imageAbs = new URL(founder.image, site.url).toString();

// Structured data: Person + BreadcrumbList (Studio → Tentang → Founder).
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${canonical}#person`,
      name: founder.name,
      alternateName: founder.nickname,
      url: canonical,
      image: imageAbs,
      jobTitle: founder.role,
      worksFor: { '@type': 'Organization', name: site.name, url: site.url },
      founder: { '@type': 'Organization', name: site.name, url: site.url },
      homeLocation: { '@type': 'Place', name: founder.location },
      knowsAbout: founder.skills,
      sameAs: [founder.personalWebsite, founder.linkedin],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vanillate Studio', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Tentang', item: `${site.url}/about` },
        { '@type': 'ListItem', position: 3, name: founder.name, item: canonical },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${founder.name} — ${founder.role}`}
  description={`${founder.name}, ${founder.roleFull}. ${founder.summary}`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />

  <!-- HERO -->
  <section class="container-page pt-20 pb-16 md:pt-28">
    <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 font-mono text-xs text-ink-500 dark:text-cream-300/60">
      <a href={url('/')} class="hover:text-amber-600 dark:hover:text-amber-400">Vanillate Studio</a>
      <span aria-hidden="true">/</span>
      <a href={url('/about')} class="hover:text-amber-600 dark:hover:text-amber-400">Tentang</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink-800 dark:text-cream-100">Founder</span>
    </nav>

    <div class="grid gap-10 md:gap-14 md:grid-cols-[minmax(0,22rem)_1fr] md:items-center">
      <FounderImage variant="hero" class="w-full max-w-sm mx-auto md:mx-0" />
      <div>
        <p class="eyebrow mb-4">Official Founder Profile</p>
        <h1 class="font-display font-semibold tracking-tightest text-[clamp(2.25rem,6vw,4rem)] leading-[1.02]">
          {founder.name}
        </h1>
        <p class="mt-3 text-lg font-medium text-amber-600 dark:text-amber-500">{founder.roleFull}</p>
        <p class="mt-1.5 font-mono text-xs text-ink-500 dark:text-cream-300/60">{founder.location} · {founder.nickname}</p>
        <p class="mt-6 max-w-prose text-lg text-ink-600 dark:text-cream-200/80 leading-relaxed">
          {founder.summary}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={founder.personalWebsite} variant="primary" size="lg" external>Kunjungi Personal Website</Button>
          <Button href={founder.linkedin} variant="secondary" size="lg" external>LinkedIn</Button>
        </div>
        <p class="mt-4 text-sm text-ink-500 dark:text-cream-300/60 max-w-prose">
          Profil ini adalah halaman founder resmi Vanillate Studio. Untuk portfolio, karya, dan cerita
          lengkapnya, lanjut ke personal website.
        </p>
      </div>
    </div>
  </section>

  <!-- PERAN DI VANILLATE -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">Peran di Vanillate</p>
      </div>
      <div class="md:col-span-2 max-w-prose">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest mb-6">Yang dikerjakan di studio</h2>
        <div class="space-y-5 text-lg text-ink-700 dark:text-cream-200 leading-relaxed">
          {founder.roleInVanillate.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {founder.focus.map((f) => (
            <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/40 dark:bg-ink-900/40 p-5">
              <h3 class="font-display text-lg font-semibold mb-1.5 flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500 flex-none"></span>
                {f.title}
              </h3>
              <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- KEAHLIAN -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">Keahlian</p>
      </div>
      <div class="md:col-span-2">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest mb-6">Perkakas & kapasitas</h2>
        <ul class="flex flex-wrap gap-2.5">
          {founder.skills.map((s) => (
            <li class="rounded-full border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2 text-sm text-ink-700 dark:text-cream-200">
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- PENGALAMAN & KONTRIBUSI -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">Pengalaman</p>
      </div>
      <div class="md:col-span-2 grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tightest mb-6">Kapasitas</h2>
          <div>
            {founder.experience.map((e, i) => (
              <div class="relative flex gap-5">
                <div class="flex flex-col items-center flex-none">
                  <span class="mt-1 h-3 w-3 rounded-full bg-amber-500 ring-4 ring-amber-500/15"></span>
                  {i < founder.experience.length - 1 && <span class="w-px flex-1 bg-ink-900/10 dark:bg-cream-100/10 my-1"></span>}
                </div>
                <div class={i < founder.experience.length - 1 ? 'pb-7' : ''}>
                  <h3 class="font-display text-lg font-semibold">{e.label}</h3>
                  <p class="text-sm text-ink-600 dark:text-cream-200/80">{e.org}</p>
                  <p class="font-mono text-xs text-amber-600 dark:text-amber-500 mt-1">{e.period}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tightest mb-6">Kontribusi</h2>
          <ul class="space-y-4">
            {founder.contributions.map((c) => (
              <li class="flex gap-3 text-ink-700 dark:text-cream-200 leading-relaxed">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-amber-500 flex-none"></span>
                <span class="text-[0.98rem]">{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA: PERSONAL WEBSITE -->
  <section class="container-page py-20 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="rounded-3xl bg-ink-900 p-10 md:p-16 relative overflow-hidden reveal">
      <div class="aurora bg-amber-500/20 h-[300px] w-[300px] top-[-50px] right-[-50px]" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <p class="eyebrow mb-4 !text-amber-400">Personal Brand</p>
        <h2 class="font-display text-3xl md:text-5xl font-semibold tracking-tightest text-cream-50">
          Kenali {founder.name} lebih dekat
        </h2>
        <p class="mt-4 text-cream-100/80 text-lg leading-relaxed">
          Personal website adalah ruang untuk profil, portfolio, project, dan pengalaman Founder secara
          lebih luas, di luar peran resminya di Vanillate Studio.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={founder.personalWebsite}
            target="_blank"
            rel="noopener noreferrer"
            data-magnetic="0.35"
            class="inline-flex items-center gap-2 rounded-full bg-amber-500 text-ink-950 px-6 py-3 font-medium hover:bg-amber-400 transition-colors"
          >
            Kunjungi Personal Website
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
          </a>
          <a
            href={url('/about')}
            class="inline-flex items-center rounded-full border border-cream-100/20 text-cream-100 px-6 py-3 font-medium hover:bg-cream-100/5 transition-colors"
          >
            Kembali ke Tentang
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
