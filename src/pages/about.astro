---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import LogoPNG from '@components/LogoPNG.astro';
import FounderImage from '@components/FounderImage.astro';
import Vani from '@components/mascot/Vani.astro';
import TeamAvatar from '@components/TeamAvatar.astro';
import { site, homeStats } from '@data/site';
import { pageContent } from '@data/pages';
import { founder, founderUrl } from '@data/founder';
import { team, teamUrl } from '@data/team';
import { url } from '@utils/url';

// Hero halaman ini dikelola dari /admin/halaman → tab "Tentang".
const c = pageContent('about');

// Cuplikan anggota tim untuk section Team (data dari CMS, bukan hardcode).
const teamPreview = team.slice(0, 5);
const teamExtra = Math.max(0, team.length - teamPreview.length);

// Format angka gaya Indonesia (pemisah ribuan titik).
function formatNum(n: number): string {
  return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}

// Perjalanan singkat komunitas, ditampilkan sebagai timeline.
const timeline = [
  { year: '2026', title: 'Vanillate lahir', desc: 'Berawal dari satu pengamatan sederhana: komunitas online Indonesia butuh tempat berkumpul yang benar-benar dirawat, bukan ditinggal setelah ramai sebentar.' },
  { year: '2026', title: 'Game Sambung Kata hadir di Discord', desc: 'Permainan kata yang kita kenal sejak kecil dibawa ke Discord lewat bot Vanillate Sambung Kata, lengkap dengan class, quest, dungeon, dan ekonomi yang seimbang. Dari sinilah anggota pertama berkumpul.' },
  { year: '2026', title: 'Makin dalam, makin seru', desc: 'Class System, Talent Tree, Boost, quest harian dan mingguan, sampai Dungeon Mode terus ditambah dan diseimbangkan berdasarkan masukan para pemain.' },
  { year: '2026', title: 'Main lintas server', desc: 'Pemain dari server berbeda bisa saling bertanding lewat antrean matchmaking global. Lawan main jadi lebih luas, tidak terbatas satu komunitas.' },
  { year: '2026', title: 'Botnya berganti nama jadi Vanillate.ID', desc: 'Bot ini kini punya beragam fitur, bukan hanya game Sambung Kata, jadi namanya ikut berganti menjadi Vanillate.ID. Sambung Kata tetap ada sebagai salah satu game andalannya. Semua fitur yang sudah ada tetap berjalan seperti biasa.' },
  { year: 'Kini', title: 'Rumah yang terus bertambah', desc: 'Game dan bot terus dipoles lewat pembaruan rutin, sementara komunitas membuka ruang baru untuk fitur sosial, alat pengelola server, dan hal-hal seru lain yang kita usulkan bersama.' },
];

const values = [
  {
    title: 'Ramah',
    desc: 'Siapa pun boleh gabung, dari yang baru kenal Discord sampai pemain lama. Kami menjaga obrolan tetap hangat dan saling menghargai.',
  },
  {
    title: 'Terbuka',
    desc: 'Aturan jelas, catatan pembaruan jujur, dan kabar apa adanya saat ada masalah. Kepercayaan tumbuh dari keterbukaan, bukan kesempurnaan.',
  },
  {
    title: 'Saling bantu',
    desc: 'Bingung cara main atau menemukan bug? Tanya saja. Anggota dan pengurus biasanya sudah siap menjawab.',
  },
  {
    title: 'Dirawat bersama',
    desc: 'Komunitas ini tidak berhenti setelah satu rilis. Kami terus memperbaiki dan menambah hal baru, karena kamu kembali setiap hari.',
  },
  {
    title: 'Suara anggota',
    desc: 'Laporan bug, kritik, dan ide dari anggota adalah bahan bakar arah kita berikutnya. Kami benar-benar membaca semuanya.',
  },
  {
    title: 'Terus belajar',
    desc: 'Tidak ada versi final. Selalu ada yang bisa dibuat lebih cepat, lebih adil, dan lebih menyenangkan untuk semua orang.',
  },
];

const reasons = [
  {
    title: 'Ada orangnya',
    desc: 'Pertanyaanmu dijawab langsung oleh pengurus dan anggota yang paham, bukan balasan otomatis.',
  },
  {
    title: 'Gratis dan terbuka',
    desc: 'Inti permainan bisa dinikmati tanpa bayar. Tidak ada fitur penting yang dikunci di balik langganan wajib.',
  },
  {
    title: 'Cepat dan lancar',
    desc: 'Respons terasa instan karena kami terus mengoptimalkan di belakang layar, supaya main tidak terganggu.',
  },
  {
    title: 'Bahasa kita sendiri',
    desc: 'Dari kamus 25.000+ kata sampai candaan lokal, semuanya dibuat untuk pemain Indonesia.',
  },
  {
    title: 'Selalu ada yang baru',
    desc: 'Perbaikan bug, penyempurnaan, dan fitur baru datang rutin, banyak di antaranya dari usulan anggota.',
  },
  {
    title: 'Aman dan rapi',
    desc: 'Data pemain dijaga, aturan komunitas jelas, dan tampilannya dibuat konsisten supaya nyaman dipakai.',
  },
];

const roadmap = [
  {
    title: 'Game dan event baru',
    desc: 'Permainan dan acara seru yang bisa dimainkan bareng, mulai dari yang santai sampai yang kompetitif.',
  },
  {
    title: 'Alat untuk pengurus server',
    desc: 'Bantuan untuk kamu yang mengelola server: pengaturan lebih mudah, tugas berulang lebih ringan.',
  },
  {
    title: 'Fitur sosial',
    desc: 'Cara-cara baru untuk saling kenal, menyapa, dan betah ngobrol setiap hari.',
  },
  {
    title: 'Dashboard web',
    desc: 'Atur bot, lihat statistik, dan ubah konfigurasi langsung dari browser tanpa repot.',
  },
  {
    title: 'Pendamping di genggaman',
    desc: 'Pantau kabar komunitas dan tetap terhubung dari ponsel, di mana pun kamu berada.',
  },
  {
    title: 'Bantuan yang lebih cerdas',
    desc: 'Teknologi AI yang benar-benar berguna, misalnya menjawab pertanyaan lebih cepat dan menjaga obrolan tetap nyaman.',
  },
];
---

<BaseLayout
  title="Tentang Komunitas Kita"
  description="Cerita, nilai, dan arah Vanillate Studio, komunitas Indonesia yang berkumpul di Discord untuk main game, ngobrol, dan membuat bot serta fitur seru bersama."
>
  <!-- HERO -->
  <section class="container-page pt-20 pb-16 md:pt-28 grid gap-12 md:grid-cols-[1fr_auto] items-center">
    <div>
      <p class="eyebrow mb-6">{c.heroEyebrow}</p>
      <h1 class="font-display font-semibold tracking-tightest text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.02] max-w-3xl">
        {c.heroTitle} <span class="italic text-amber-600 dark:text-amber-500">{c.heroTitleAccent}</span> {c.heroTitleEnd}
      </h1>
      <p class="mt-8 max-w-2xl text-lg md:text-xl text-ink-600 dark:text-cream-200/80 leading-relaxed">
        {c.heroLead}
      </p>
    </div>
    <div class="hidden md:flex justify-end">
      <LogoPNG variant="vertical" alt="Vanillate Studio" class="h-52 lg:h-56" />
    </div>
  </section>

  <!-- ANGKA -->
  <section class="container-page pb-4">
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink-900/10 dark:border-cream-100/10 bg-ink-900/10 dark:bg-cream-100/10 md:grid-cols-4 reveal">
      {homeStats.map((s) => (
        <div class="flex flex-col gap-1 bg-cream-50 dark:bg-ink-950 px-5 py-6">
          <span class="font-display text-2xl md:text-[2rem] font-semibold tracking-tightest text-ink-900 dark:text-cream-50 tabular-nums">
            {s.prefix + formatNum(s.num) + s.suffix}
          </span>
          <span class="text-sm font-semibold text-ink-800 dark:text-cream-100">{s.label}</span>
          <span class="text-xs text-ink-500 dark:text-cream-300/60 leading-snug">{s.hint}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- 01 CERITA -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">01 / Cerita Kita</p>
      </div>
      <div class="md:col-span-2 max-w-prose">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest mb-6">Berawal dari satu game sederhana</h2>
        <div class="space-y-5 text-lg text-ink-700 dark:text-cream-200 leading-relaxed">
          <p>
            Vanillate lahir pada 2026 dari pengamatan yang sederhana. Komunitas online Indonesia penuh orang yang senang berkumpul dan bermain bersama, tapi tempat berbahasa Indonesia yang benar-benar dirawat bisa dihitung dengan jari. Banyak yang ramai sebentar, lalu sepi: tidak diperbarui, penuh bug, dan akhirnya ditinggalkan.
          </p>
          <p>
            Kami mulai dari satu bot Discord dengan satu game, yaitu Sambung Kata. Bot itu kini bernama Vanillate.ID. Permainan kata yang semua orang kenal sejak kecil dibawa ke Discord dengan sistem progresi yang dalam. Sambutan para pemain membuat kami sadar bahwa yang dicari orang bukan banyak pilihan, melainkan tempat yang digarap dengan sungguh-sungguh.
          </p>
          <p>
            Dari sana Vanillate tumbuh jadi komunitas. Kami memilih fokus: merawat satu rumah sampai nyaman, lalu menambah ruang baru seperti fitur sosial dan alat bantu untuk pengurus server. Satu prinsip tetap sama, yaitu rilis adalah garis start, bukan garis finis.
          </p>
          <p>
            Hari ini kami masih komunitas kecil, dan itu disengaja. Skala kecil membuat kami bisa saling kenal, cepat merespons, dan menjaga suasananya tetap hangat tanpa birokrasi.
          </p>
        </div>

        <!-- Timeline perjalanan -->
        <div class="mt-12">
          <p class="eyebrow mb-6">Perjalanan Kita</p>
          <div>
            {timeline.map((item, i) => (
              <div class="relative flex gap-5">
                <div class="flex flex-col items-center flex-none">
                  <span class="mt-1 h-3 w-3 rounded-full bg-amber-500 ring-4 ring-amber-500/15"></span>
                  {i < timeline.length - 1 && <span class="w-px flex-1 bg-ink-900/10 dark:bg-cream-100/10 my-1"></span>}
                </div>
                <div class={i < timeline.length - 1 ? 'pb-8' : ''}>
                  <p class="font-mono text-xs text-amber-600 dark:text-amber-500 mb-1">{item.year}</p>
                  <h3 class="font-display text-lg font-semibold mb-1.5">{item.title}</h3>
                  <p class="text-ink-600 dark:text-cream-200/80 leading-relaxed text-[0.95rem]">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">Pendiri</p>
      </div>
      <div class="md:col-span-2">
        <a
          href={url(founderUrl)}
          class="group grid gap-6 sm:grid-cols-[minmax(0,15rem)_1fr] items-center rounded-3xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/40 dark:bg-ink-900/40 p-5 sm:p-6 transition-all hover:-translate-y-0.5 hover:border-amber-500/40 hover:shadow-[0_20px_60px_-30px_rgba(11,10,14,0.4)]"
          aria-label={`Lihat profil pendiri: ${founder.name}`}
        >
          <FounderImage variant="card" class="w-full" />
          <div>
            <p class="eyebrow mb-2">{founder.role}</p>
            <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tightest">{founder.name}</h2>
            <p class="mt-1.5 font-mono text-xs text-ink-500 dark:text-cream-300/60">{founder.roleFull} · {founder.location}</p>
            <p class="mt-4 text-ink-600 dark:text-cream-200/80 leading-relaxed max-w-prose">{founder.short}</p>
            <span class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink-900 text-cream-50 dark:bg-amber-500 dark:text-ink-950 px-5 py-2.5 text-sm font-medium transition-transform group-hover:gap-3">
              Kenalan dengan Pendiri
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- TIM -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">Pengurus</p>
      </div>
      <div class="md:col-span-2">
        <a
          href={url(teamUrl)}
          class="group block rounded-3xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/40 dark:bg-ink-900/40 p-6 sm:p-8 transition-all hover:-translate-y-0.5 hover:border-amber-500/40 hover:shadow-[0_20px_60px_-30px_rgba(11,10,14,0.4)]"
          aria-label="Lihat pengurus komunitas Vanillate"
        >
          <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tightest mb-4">Orang-orang di balik komunitas</h2>
          <p class="text-ink-600 dark:text-cream-200/80 leading-relaxed max-w-prose">
            Komunitas ini dijalankan oleh pengurus yang juga anggota. Mereka mengurus game dan bot,
            menjawab pertanyaan, dan menjaga obrolan tetap nyaman. Kenali siapa saja mereka.
          </p>

          {teamPreview.length > 0 && (
            <div class="mt-6 flex items-center">
              <div class="flex items-center">
                {teamPreview.map((m) => (
                  <div class="-ml-3 first:ml-0 rounded-full ring-2 ring-cream-50 dark:ring-ink-950">
                    <TeamAvatar member={m} class="h-12 w-12 !rounded-full" />
                  </div>
                ))}
              </div>
              {teamExtra > 0 && (
                <span class="ml-3 font-mono text-xs text-ink-500 dark:text-cream-300/60">+{teamExtra} lainnya</span>
              )}
            </div>
          )}

          <span class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink-900 text-cream-50 dark:bg-amber-500 dark:text-ink-950 px-5 py-2.5 text-sm font-medium transition-transform group-hover:gap-3">
            Kenalan dengan Pengurus
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 02 FILOSOFI BRAND -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">02 / Filosofi</p>
      </div>
      <div class="md:col-span-2">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest mb-6">Di balik nama dan logo kita</h2>
        <div class="space-y-5 text-lg text-ink-700 dark:text-cream-200 leading-relaxed max-w-prose">
          <p>
            Nama <strong class="text-ink-900 dark:text-cream-50">Vanillate</strong> berangkat dari kata <em>vanilla</em>. Di dunia perangkat lunak, "vanilla" berarti versi paling murni, tanpa tambahan yang tidak perlu. Akhiran "-ate" mengubahnya menjadi kata kerja, sebuah proses. Vanillate berarti mengolah sesuatu yang sederhana menjadi pengalaman yang matang. Begitulah cara kita bekerja: mulai dari fondasi yang bersih, lalu menyempurnakannya lapis demi lapis bersama-sama.
          </p>
          <p>
            Logo kami adalah huruf <strong class="text-ink-900 dark:text-cream-50">V</strong> yang terbentuk dari tiga pita geometris yang saling mengunci. Tiga pita itu mewakili tiga hal yang menopang Vanillate, yaitu <em>komunitas</em> yang berkumpul, <em>teknologi</em> yang menjalankannya, dan <em>pengalaman bermain</em> yang menyatukan keduanya. Bentuknya melingkar tanpa putus, sebuah pengingat bahwa rumah ini tidak pernah benar-benar selesai karena selalu ada hal baru yang bisa kita buat bareng.
          </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
            <div class="h-8 w-8 rounded-lg mb-4" style="background: #17171E;"></div>
            <h3 class="font-display font-semibold mb-1.5">Hitam</h3>
            <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">Fondasi dan fokus. Keseriusan di balik setiap fitur yang terlihat sederhana.</p>
          </div>
          <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
            <div class="h-8 w-8 rounded-lg mb-4" style="background: #F0DCAE;"></div>
            <h3 class="font-display font-semibold mb-1.5">Emas Vanilla</h3>
            <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">Kehangatan dan kualitas. Sentuhan premium pada hal-hal yang biasa, persis seperti vanilla.</p>
          </div>
          <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
            <div class="h-8 w-8 rounded-lg mb-4" style="background: #6C3BEB;"></div>
            <h3 class="font-display font-semibold mb-1.5">Ungu</h3>
            <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">Imajinasi dan energi digital, warna dunia tempat kita berkumpul setiap hari.</p>
          </div>
        </div>

        <p class="mt-8 max-w-prose text-lg text-ink-700 dark:text-cream-200 leading-relaxed">
          Identitas ini kami pilih karena jujur menggambarkan kita: serius dalam menjaga, hangat dalam menyambut, dan tumbuh di dunia digital. Tidak lebih, tidak kurang.
        </p>
      </div>
    </div>
  </section>

  <!-- MASKOT: VANI -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">Maskot</p>
      </div>
      <div class="md:col-span-2">
        <div class="rounded-3xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/40 dark:bg-ink-900/40 p-6 sm:p-8">
          <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tightest mb-4">Kenalan dengan Vani</h2>
          <p class="text-ink-600 dark:text-cream-200/80 leading-relaxed max-w-prose">
            Vani adalah maskot Vanillate, wajah ramah yang menyambut siapa saja yang datang. Hitam pekat sebagai fondasi, emas vanilla sebagai kehangatan, dan sentuhan ungu untuk energi digital: karakter ini membawa identitas yang sama seperti nama dan logo kami.
          </p>
          <p class="mt-4 text-ink-600 dark:text-cream-200/80 leading-relaxed max-w-prose">
            Kamu akan menjumpainya di berbagai sudut Vanillate, dari halaman ini sampai channel Discord, sebagai penanda bahwa kamu sedang berada di rumah yang sama.
          </p>
          <div class="mt-8 flex justify-center">
            <Vani expression="lineup" size="xl" animation="fade" alt="Tiga pose Vani: menyapa, tampak menyamping, dan tampak dari belakang" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 VISI -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">03 / Harapan</p>
      </div>
      <div class="md:col-span-2 max-w-prose">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest mb-6">Ke mana kita menuju</h2>
        <div class="space-y-5 text-lg text-ink-700 dark:text-cream-200 leading-relaxed">
          <p>
            Harapan kami sederhana untuk diucapkan dan panjang untuk dikerjakan: menjadi rumah komunitas Indonesia yang hangat, dipercaya, dan selalu dinantikan. Dimulai dari satu game di Discord, tapi tidak berhenti di sana.
          </p>
          <p>
            Kami percaya cara orang berkumpul secara digital masih bisa dibuat jauh lebih menyenangkan. Interaksi real-time, komunitas yang sudah terbentuk, dan teknologi yang semakin matang membuka ruang untuk cara bermain dan ngobrol yang belum pernah ada. Kami ingin menjelajahinya bersama kamu, bukan sekadar mengikuti tren.
          </p>
          <p>
            Ke depan, semua ruang di Vanillate akan saling terhubung: game yang bisa dipantau dari web, alat yang meringankan pengurus server, sampai bantuan cerdas yang bekerja diam-diam supaya setiap obrolan terasa lebih hidup. Teknologi bagi kami hanyalah alat untuk satu tujuan, yaitu pengalaman berkumpul yang lebih baik.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 MISI -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">04 / Komitmen</p>
      </div>
      <div class="md:col-span-2 max-w-prose">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest mb-8">Yang kami jaga setiap hari</h2>
        <ol class="space-y-7">
          <li class="flex gap-4">
            <span class="font-mono text-sm text-amber-600 dark:text-amber-500 flex-none mt-1.5">01</span>
            <div>
              <h3 class="font-display text-lg font-semibold mb-1">Merawat, bukan sekadar merilis</h3>
              <p class="text-ink-600 dark:text-cream-200/80 leading-relaxed">Setiap game dan bot yang hadir mendapat perawatan berupa pembaruan rutin, perbaikan cepat, dan fitur baru yang tidak berhenti setelah minggu pertama.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="font-mono text-sm text-amber-600 dark:text-amber-500 flex-none mt-1.5">02</span>
            <div>
              <h3 class="font-display text-lg font-semibold mb-1">Mengutamakan rasa nyaman anggota</h3>
              <p class="text-ink-600 dark:text-cream-200/80 leading-relaxed">Setiap keputusan berangkat dari pertanyaan yang sama: apakah ini membuat anggota lebih nyaman dan lebih seru bermain? Kalau tidak, kami tidak mengerjakannya.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="font-mono text-sm text-amber-600 dark:text-amber-500 flex-none mt-1.5">03</span>
            <div>
              <h3 class="font-display text-lg font-semibold mb-1">Menjaga semuanya tetap lancar</h3>
              <p class="text-ink-600 dark:text-cream-200/80 leading-relaxed">Kode yang cepat, infrastruktur yang hemat, dan fondasi yang mudah dikembangkan. Semua itu demi game yang responsif dan komunitas yang bisa bertahan lama.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="font-mono text-sm text-amber-600 dark:text-amber-500 flex-none mt-1.5">04</span>
            <div>
              <h3 class="font-display text-lg font-semibold mb-1">Tumbuh bersama anggota</h3>
              <p class="text-ink-600 dark:text-cream-200/80 leading-relaxed">Kami mendengarkan sebelum membuat. Fitur terbaik kita lahir dari obrolan bersama anggota, dan kami ingin terus begitu.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="font-mono text-sm text-amber-600 dark:text-amber-500 flex-none mt-1.5">05</span>
            <div>
              <h3 class="font-display text-lg font-semibold mb-1">Berjalan dengan terbuka</h3>
              <p class="text-ink-600 dark:text-cream-200/80 leading-relaxed">Aturan yang jelas, catatan pembaruan yang jujur, dan kabar apa adanya saat ada masalah. Kepercayaan dibangun dari keterbukaan, bukan kesempurnaan.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 05 NILAI -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="max-w-3xl mb-12 reveal">
      <p class="eyebrow mb-3">05 / Nilai Kita</p>
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">
        Enam hal yang kita pegang bersama
      </h2>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {values.map((v, i) => (
        <div class="reveal rounded-2xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/40 dark:bg-ink-900/40 p-6" style={`--reveal-delay: ${i * 70}ms`}>
          <h3 class="font-display text-lg font-semibold mb-2">{v.title}</h3>
          <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{v.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 06 MENGAPA VANILLATE -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="grid gap-12 md:grid-cols-3 reveal">
      <div class="md:col-span-1">
        <p class="eyebrow">06 / Kenapa Betah</p>
      </div>
      <div class="md:col-span-2">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest mb-8">Alasan orang betah di sini</h2>
        <div class="grid gap-x-8 gap-y-7 sm:grid-cols-2">
          {reasons.map((r) => (
            <div>
              <h3 class="font-display text-lg font-semibold mb-1.5 flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500 flex-none"></span>
                {r.title}
              </h3>
              <p class="text-ink-600 dark:text-cream-200/80 leading-relaxed text-[0.95rem]">{r.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 07 MASA DEPAN -->
  <section class="container-page py-16 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="max-w-3xl mb-4 reveal">
      <p class="eyebrow mb-3">07 / Ke Depan</p>
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">
        Yang sedang kita kerjakan
      </h2>
      <p class="mt-5 text-lg text-ink-600 dark:text-cream-200/80 leading-relaxed">
        Ini bukan daftar janji dengan tanggal, melainkan peta arah: ruang-ruang yang sedang dan akan kami garap seiring bertumbuhnya komunitas. Semuanya bermuara pada satu hal, yaitu rumah Vanillate yang saling terhubung dan nyaman untuk semua.
      </p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {roadmap.map((r, i) => (
        <div class="reveal rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-6" style={`--reveal-delay: ${i * 70}ms`}>
          <p class="font-mono text-xs text-amber-600 dark:text-amber-500 mb-3">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="font-display text-lg font-semibold mb-2">{r.title}</h3>
          <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">{r.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-20 border-t border-ink-900/10 dark:border-cream-100/10">
    <div class="max-w-2xl reveal">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest mb-4">
        Ikut jadi bagian ceritanya
      </h2>
      <p class="text-lg text-ink-600 dark:text-cream-200/80 leading-relaxed mb-8">
        Cara terbaik mengenal Vanillate adalah ikut main, lalu mampir ke Discord kami dan bilang apa yang menurutmu bisa lebih baik. Kami benar-benar membaca semuanya.
      </p>
      <div class="flex flex-wrap gap-3">
        <Button href={site.links.discordSupport} variant="primary" size="lg" external>Gabung Discord</Button>
        <Button href="/products" variant="secondary" size="lg">Lihat Game & Bot</Button>
      </div>
    </div>
  </section>
</BaseLayout>
