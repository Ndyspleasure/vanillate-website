---
// Redirect permanen: dokumentasi dipindah dari /docs ke /faq.
//
// Panduan per produk sudah dilebur ke FAQ terpusat, tapi URL lama masih hidup
// di riwayat browser, tautan Discord, dan hasil pencarian. Situs ini statis
// (tidak ada redirect sisi server), jadi caranya memakai meta-refresh +
// canonical, sama seperti stub /bots. Dikeluarkan dari sitemap.
import RedirectStub from '@components/RedirectStub.astro';
import { faqIndexUrl } from '@data/faq';
const to = faqIndexUrl();
---

<RedirectStub to={to} title="Pindah ke FAQ" text="Dokumentasi kini berada di" linkLabel="halaman FAQ" />
