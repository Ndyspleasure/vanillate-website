---
// Redirect per produk: /docs/<slug> → /faq/<kategori FAQ produk itu>.
//
// Selain URL-nya, ANCHOR dokumentasi lama juga dipetakan. Tautan seperti
// /docs/sambung-kata#event-spesial pernah dibagikan ke banyak tempat, dan
// anchor tidak pernah sampai ke server — hanya browser yang melihatnya. Jadi
// pemetaannya dijalankan di klien: anchor yang dikenali diarahkan ke FAQ yang
// tepat, sisanya jatuh ke halaman kategori.
//
// Tabel di bawah adalah pemetaan URL WARISAN, bukan konten FAQ: ia menerjemahkan
// alamat lama ke alamat baru. Boleh dihapus setelah tautan lama tidak lagi
// dipakai, tanpa memengaruhi isi FAQ mana pun.
import RedirectStub from '@components/RedirectStub.astro';
import { bots } from '@data/bots';
import { faqCategoryUrl, faqUrl, getFaq } from '@data/faq';

export function getStaticPaths() {
  // Ditulis di dalam fungsi karena Astro menjalankan getStaticPaths di scope
  // terpisah: variabel frontmatter di luar sini tidak terlihat olehnya.
  /** Anchor section dokumentasi lama → slug FAQ penggantinya. */
  const ANCHOR: Record<string, Record<string, string>> = {
    'sambung-kata': {
      'cara-bermain': 'cara-bermain',
      'mode-permainan': 'mode-permainan',
      'boost-system': 'boost',
      'progression': 'progression-exp-coin',
      'quest-shop': 'quest',
      'dungeon-events': 'dungeon',
      'event-spesial': 'event-spesial',
      'game-sampingan': 'game-sampingan',
      'commands': 'daftar-command',
      // Section bawaan pada produk yang dulu belum punya dokumentasi.
      'pendahuluan': 'cara-mulai-bermain',
      'cara-memulai': 'cara-mulai-bermain',
    },
  };

  // Satu stub per slug dokumentasi lama yang mungkin masih ditautkan. Dulu
  // docs_slug hampir selalu sama dengan slug produk, jadi keduanya dibangun.
  const dibuat = new Set<string>();
  const halaman: any[] = [];

  for (const bot of bots) {
    if (!bot.faqCategory) continue;
    for (const slug of [bot.slug, bot.faqCategory]) {
      if (!slug || dibuat.has(slug)) continue;
      dibuat.add(slug);

      const kategori = bot.faqCategory;
      const peta = ANCHOR[kategori] ?? {};
      // Hanya anchor yang FAQ tujuannya benar-benar ada yang ikut dikirim.
      const anchor: Record<string, string> = {};
      for (const [dari, ke] of Object.entries(peta)) {
        if (getFaq(kategori, ke)) anchor[dari] = faqUrl(kategori, ke);
      }

      halaman.push({ params: { slug }, props: { to: faqCategoryUrl(kategori), anchor } });
    }
  }

  return halaman;
}

const { to, anchor } = Astro.props as { to: string; anchor: Record<string, string> };
---

<RedirectStub
  to={to}
  title="Pindah ke FAQ"
  text="Dokumentasi ini kini berada di"
  linkLabel="FAQ"
  anchorMap={anchor}
/>
