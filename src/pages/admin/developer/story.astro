---
// Panel Developer: 🌇 Vanillate Story (game di hub /game bot Vanillate.ID).
// Ringkasan dari snapshot `story`; aksi lewat bot_commands dengan tipe yang
// sama persis dengan handler bot (src/cms/handlers/story.js): story.detail,
// story.reset, story.exportIds. Data pemain ada di database game, bukan di proyek ini.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Vanillate Story" active="dev-story">
  <AdminPageHeader
    eyebrow="Discord Bot"
    title="Vanillate Story"
    description="Game cerita di hub /game: ringkasan pemain, aktivitas terbaru, detail, export User ID & reset progres per pemain."
  />
  <div class="px-6 lg:px-10 py-8 max-w-5xl space-y-10">
    <p id="st-fresh"></p>
    <div id="st-body" class="space-y-10"></div>
  </div>
</AdminLayout>

<script>
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { fmtAngka } from '@/lib/admin-auth';
  import { bacaSnapshot } from '@/lib/dev-panel/client';
  import { FPLAYER } from '@/lib/dev-panel/actions';
  import { KELAS, fmtJam, formCard, freshness, pasangAksi, section, stat, table, unduhTeks } from '@/lib/dev-panel/ui';

  let role = 'viewer';

  document.addEventListener('admin:ready', (e) => {
    role = (e as CustomEvent).detail?.role ?? 'viewer';
    void muat();
  });

  const ada = (v: unknown) => v !== undefined && v !== null && v !== '';
  const teks = (v: unknown) => (ada(v) ? esc(v) : `<span class="${KELAS.muted}">belum ada</span>`);
  const angka = (v: unknown) => (ada(v) ? fmtAngka(v as number) : `<span class="${KELAS.muted}">belum ada</span>`);
  const waktu = (v: unknown) => (ada(v) ? esc(fmtJam(v as string)) : `<span class="${KELAS.muted}">belum ada</span>`);

  const pemain = (id: string, nama?: string | null) =>
    `${esc(nama ?? 'Pemain')}<br><code class="text-xs ${KELAS.muted}">${esc(id)}</code>`;

  const SKILL: [string, string][] = [
    ['strength', 'Kekuatan'], ['intelligence', 'Kecerdasan'], ['communication', 'Komunikasi'], ['luck', 'Keberuntungan'],
  ];

  function detailHtml(d: any): string {
    const skills = SKILL.map(([k, l]) => `${l} ${angka(d.skills?.[k])}`).join(' · ');
    const bab = ada(d.chapter)
      ? `${angka(d.chapter)}${ada(d.chapterTitle) ? ` · ${esc(d.chapterTitle)}` : ''}`
      : '<span class="' + KELAS.muted + '">belum ada</span>';
    const baris: [string, string][] = [
      ['Pemain', pemain(d.userId, d.name)],
      ['Hari', `${angka(d.day)} / ${angka(d.totalDays)} (minggu ${angka(d.week)})`],
      ['Jam & lokasi', `${teks(d.clock)} · ${teks(d.location)}`],
      ['Uang', angka(d.money)],
      ['Tabungan', angka(d.savings)],
      ['Energi', `${angka(d.energy)} / ${angka(d.energyMax)}`],
      ['Sisa utang', angka(d.debtRemaining)],
      ['Tagihan minggu ini', angka(d.weekDue)],
      ['Skill', skills],
      ['Kontak', angka(d.contacts)],
      ['Pacaran / menikah', `${angka(d.couples?.dating)} / ${angka(d.couples?.married)}`],
      ['Anak', angka(d.children)],
      ['Bab cerita utama', bab],
      ['Quest aktif', angka(d.questsActive)],
      ['Quest selesai', angka(d.questsDone)],
      ['Mulai main', waktu(d.createdAt)],
      ['Aktif terakhir', waktu(d.lastActive)],
    ];
    return `<div class="${KELAS.kartu}"><dl class="grid gap-x-6 gap-y-2 sm:grid-cols-2 text-sm">${baris
      .map(([k, v]) => `<div><dt class="text-xs ${KELAS.muted}">${esc(k)}</dt><dd>${v}</dd></div>`).join('')}</dl></div>`;
  }

  async function muat() {
    const s = await bacaSnapshot('story');
    document.getElementById('st-fresh')!.innerHTML = freshness(s.updatedAt);
    const body = document.getElementById('st-body')!;
    if (!s.data) { body.innerHTML = stateBlock('error', s.error ?? 'Belum ada data. Pastikan bot sudah memakai versi dengan Vanillate Story.'); return; }
    const t = s.data;
    const editor = role === 'owner' || role === 'admin';

    body.innerHTML = [
      section('Ringkasan', `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        ${stat('Total pemain', fmtAngka(t.summary?.total))}
        ${stat('Aktif 30 hari', fmtAngka(t.summary?.active))}
        ${stat('Pemain baru hari ini', fmtAngka(t.summary?.newToday), 'WIB')}
        ${stat('Utang lunas', fmtAngka(t.summary?.cleared))}
        ${stat('Hari tertinggi', fmtAngka(t.summary?.dayMax), `dari ${fmtAngka(t.summary?.totalDays)} hari`)}
      </div>`),
      section('Aktivitas terbaru', table(['Pemain', 'Hari', 'Bab', 'Uang', 'Tabungan', 'Sisa utang', 'Lokasi', 'Aktif terakhir'], (t.recent ?? []).map((r: any) => [
        pemain(r.userId, r.name), fmtAngka(r.day), ada(r.chapter) ? fmtAngka(r.chapter) : 'belum ada',
        fmtAngka(r.money), fmtAngka(r.savings), fmtAngka(r.debtRemaining), esc(r.location ?? 'belum ada'),
        `<span class="text-xs">${esc(fmtJam(r.lastActive))}</span>`,
      ]), 'Belum ada pemain.')),
      editor ? section('Alat bantu', `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        ${formCard({ id: 'st-detail', title: 'Lihat detail pemain', fields: [FPLAYER], submit: 'Lihat' })}
        ${formCard({ id: 'st-export', title: 'Export User ID pemain aktif', submit: 'Export',
          fields: [{ name: 'days', label: 'Aktif dalam (hari)', type: 'number', value: '30', step: '1', required: true }] })}
        ${formCard({ id: 'st-reset', title: 'Reset progres pemain', danger: true, submit: 'Reset',
          desc: 'Menghapus SELURUH progres Vanillate Story pemain ini (uang, skill, hubungan, quest). Tidak bisa dibatalkan. Data game lain tidak tersentuh.',
          fields: [FPLAYER, { name: 'confirm', label: 'Ketik RESET', required: true, placeholder: 'RESET' }] })}
      </div>
      <div id="st-detail-out"></div>`) : '',
    ].join('');

    if (!editor) return;
    pasangAksi(document.getElementById('st-detail') as HTMLFormElement, {
      type: 'story.detail',
      success: (o) => { document.getElementById('st-detail-out')!.innerHTML = detailHtml(o.result ?? {}); return 'Detail dimuat di bawah.'; },
    });
    pasangAksi(document.getElementById('st-export') as HTMLFormElement, {
      type: 'story.exportIds',
      success: (o) => {
        const ids: string[] = o.result?.ids ?? [];
        unduhTeks(`vanillate-story-aktif-${o.result?.days ?? ''}hari.txt`, ids.join('\n'));
        return `${fmtAngka(ids.length)} User ID diunduh.`;
      },
    });
    pasangAksi(document.getElementById('st-reset') as HTMLFormElement, {
      type: 'story.reset',
      confirm: (p) => (String(p.confirm).toUpperCase() === 'RESET' ? `Hapus seluruh progres Vanillate Story "${p.player}"?` : null),
      success: () => 'Progres pemain dihapus.',
      resetOnSuccess: true,
      onDone: (o) => { if (o.ok) setTimeout(() => void muat(), 1500); },
    });
  }
</script>
