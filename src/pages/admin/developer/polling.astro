---
// Panel Developer — Polling (pengganti /developer › 📊 Polling Manager).
//
// Polling dibuat lewat Broadcast DM. Daftar & hasil sementara dibaca dari
// snapshot `polls`; audit pemilih (poll.voters) dan pembatalan (poll.cancel)
// dikirim sebagai perintah. Data pemilih untuk audit admin — jangan dibagikan.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
import { url } from '@utils/url';
---

<AdminLayout title="Polling" active="dev-polling">
  <AdminPageHeader
    eyebrow="Panel Developer"
    title="Polling"
    description="Polling yang dikirim bersama Broadcast DM: hasil sementara, audit pemilih, dan pembatalan. Hasil akhir otomatis diumumkan bot ke channel polling."
  />
  <div class="px-6 lg:px-10 py-8 space-y-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p id="poll-fresh"></p>
      <a href={url('/admin/developer/broadcast')} class="text-xs text-amber-700 dark:text-amber-400 underline">Buat polling lewat Broadcast DM →</a>
    </div>
    <div id="poll-body" class="space-y-4"></div>
  </div>
</AdminLayout>

<script>
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { fmtAngka } from '@/lib/admin-auth';
  import { bacaSnapshot, kirimPerintah } from '@/lib/dev-panel/client';
  import { toEpoch } from '@/lib/dev-panel/model';
  import { fmtJam, freshness, notice, pill, table, KELAS, type Tone } from '@/lib/dev-panel/ui';

  let bolehEdit = false;
  // Hasil audit/aksi per polling (HTML aman) — dipertahankan saat auto-refresh.
  const hasil = new Map<string, string>();

  document.addEventListener('admin:ready', (e) => {
    const role = (e as CustomEvent).detail?.role;
    bolehEdit = role === 'owner' || role === 'admin';
    void muat();
    setInterval(() => void muat(), 30_000);
    document.getElementById('poll-body')!.addEventListener('click', onKlik);
  });

  const TONE: Record<string, Tone> = { ACTIVE: 'ok', PROCESSING: 'warn', FINISHED: 'muted', CANCELLED: 'bad' };

  async function muat() {
    const s = await bacaSnapshot('polls');
    document.getElementById('poll-fresh')!.innerHTML = freshness(s.updatedAt) + (s.data ? ` <span class="text-xs ${KELAS.muted}">· scheduler ${s.data.schedulerRunning ? 'berjalan' : 'diam (tidak ada polling aktif)'}</span>` : '');
    const body = document.getElementById('poll-body')!;
    if (!s.data) { body.innerHTML = stateBlock('error', s.error ?? 'Belum ada data.'); return; }
    const polls: any[] = s.data.polls ?? [];
    if (!polls.length) { body.innerHTML = stateBlock('empty', 'Belum ada polling.'); return; }
    body.innerHTML = `<p class="text-xs ${KELAS.muted}">${fmtAngka(s.data.total)} polling tercatat · menampilkan 20 terbaru.</p>` + polls.map((p) => {
      const r = p.results ?? { total: 0, perOption: [] };
      const bar = (o: any) => `<div class="space-y-1">
        <div class="flex justify-between text-sm"><span>${esc(o.label)}</span><span class="${KELAS.muted}">${esc(o.votes)} · ${esc(o.pct)}%</span></div>
        <div class="h-2 rounded-full bg-ink-900/10 dark:bg-cream-100/10 overflow-hidden"><div class="h-full bg-amber-500" style="width:${Number(o.pct) || 0}%"></div></div>
      </div>`;
      return `<div class="${KELAS.kartu} space-y-3" id="poll-${esc(p.poll_id)}">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <p class="text-xs ${KELAS.muted}">Poll #${esc(p.poll_id)} · berakhir ${esc(fmtJam(toEpoch(p.end_at)))}</p>
            <h3 class="font-semibold">${esc(p.question)}</h3>
          </div>
          ${pill(p.status, TONE[p.status] ?? 'muted')}
        </div>
        ${(r.perOption ?? []).map(bar).join('')}
        <p class="text-xs ${KELAS.muted}">${esc(r.total)} suara${r.winner ? ` · unggul: ${esc(r.winner.label)}` : ''}</p>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-voters="${esc(p.poll_id)}" class="${KELAS.tombolNetral}">Audit pemilih</button>
          ${bolehEdit && p.status === 'ACTIVE' ? `<button type="button" data-cancel="${esc(p.poll_id)}" class="${KELAS.tombolNetral}">Batalkan polling</button>` : ''}
        </div>
        <div data-out="${esc(p.poll_id)}">${hasil.get(String(p.poll_id)) ?? ''}</div>
      </div>`;
    }).join('');
  }

  async function onKlik(e: Event) {
    const t = e.target as HTMLElement;
    const voters = t.closest<HTMLElement>('[data-voters]')?.dataset.voters;
    const cancel = t.closest<HTMLElement>('[data-cancel]')?.dataset.cancel;
    const id = voters ?? cancel;
    if (!id) return;
    const out = document.querySelector<HTMLElement>(`[data-out="${CSS.escape(id)}"]`)!;
    if (voters) {
      if (!bolehEdit) { out.innerHTML = notice('info', 'Audit pemilih hanya untuk owner/admin.'); return; }
      out.innerHTML = notice('info', 'Menunggu bot…');
      const o = await kirimPerintah('poll.voters', { pollId: Number(id) });
      if (!o.ok) { out.innerHTML = notice('error', o.error ?? 'Gagal.'); return; }
      out.innerHTML = table(['Discord ID', 'Pilihan', 'Waktu'], (o.result?.voters ?? []).map((v: any) => [
        `<code class="text-xs">${esc(v.user_id)}</code>`, esc(v.label), `<span class="text-xs">${esc(fmtJam(toEpoch(v.voted_at)))}</span>`,
      ]), 'Belum ada suara masuk.');
      hasil.set(id, out.innerHTML);
      return;
    }
    if (!window.confirm(`Batalkan polling #${id}? Hasil tidak akan diumumkan.`)) return;
    out.innerHTML = notice('info', 'Menunggu bot…');
    const o = await kirimPerintah('poll.cancel', { pollId: Number(id) });
    out.innerHTML = o.ok ? notice('ok', `Polling #${id} dibatalkan.`) : notice('error', o.error ?? 'Gagal.');
    hasil.set(id, out.innerHTML);
    if (o.ok) setTimeout(() => void muat(), 1500);
  }
</script>
