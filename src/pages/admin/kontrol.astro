---
// Control Panel Bot — Settings.
//
// Mengubah state bot (maintenance, pengumuman, toggle mode, tunable, fitur)
// yang tersimpan di tabel Supabase `bot_settings`. Bot MENARIKNYA berkala
// (live polling) lalu menerapkannya — jadi perubahan di sini berlaku ke bot
// dalam hitungan menit TANPA menyentuh source code atau me-restart bot.
//
// Berbeda dari halaman Konten (yang mengubah teks website & butuh rebuild),
// halaman ini menyetir BOT. Situs publik tidak ikut berubah.
//
// Sumber kebenaran versi/changelog tetap version.json di repo bot — halaman ini
// sengaja TIDAK menyediakan editor versi/changelog.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Kontrol Bot" active="kontrol">
  <AdminPageHeader
    eyebrow="Control Panel"
    title="Kontrol Bot"
    description="Atur bot langsung dari sini. Bot menerapkan perubahan otomatis dalam beberapa menit — tanpa mengubah kode atau restart."
  />

  <div class="px-6 lg:px-10 py-8 max-w-3xl space-y-8">
    <!-- STATUS + PEMANTAUAN BOT (live dari bot_stats) -->
    <section
      id="status-bot"
      class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 px-5 py-4 space-y-4"
    >
      <div class="flex flex-wrap items-center gap-3">
        <span id="status-badge" class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium bg-ink-500/15 text-ink-500 dark:text-cream-300/60">
          <span class="h-1.5 w-1.5 rounded-full bg-ink-400"></span>
          <span id="status-teks">Memeriksa status…</span>
        </span>
        <span id="status-detail" class="text-xs text-ink-500 dark:text-cream-300/60 font-mono"></span>
      </div>
      <div id="status-metrics" class="hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3"></div>
    </section>

    <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 px-5 py-4">
      <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">
        Perubahan tersimpan ke database saat kamu menekan <strong>Simpan</strong>, lalu bot
        menariknya pada siklus berikutnya (± 1 menit). Nilai angka tetap dibatasi bot ke rentang
        aman meski kamu mengetik di luar batas.
      </p>
    </div>

    <form id="form-kontrol" class="space-y-10">
      <div id="kontrol-body" class="space-y-10"></div>

      <div id="kontrol-aksi" class="hidden flex-wrap items-center gap-3 pt-2">
        <button
          type="submit"
          id="btn-simpan"
          class="rounded-xl bg-amber-500 px-5 py-2.5 text-sm font-semibold text-ink-950 hover:bg-amber-400 disabled:opacity-60 disabled:cursor-not-allowed transition-colors"
        >
          Simpan perubahan
        </button>
        <p id="kontrol-pesan" class="text-sm" role="status" aria-live="polite"></p>
      </div>
    </form>

    <!-- RIWAYAT PERUBAHAN (audit) -->
    <section class="space-y-4 pt-4">
      <h2 class="font-display text-lg font-semibold tracking-tightest">Riwayat perubahan</h2>
      <div id="audit-body" class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 overflow-hidden"></div>
    </section>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import { fmtWaktu, fmtAngka } from '@/lib/admin-auth';

  // Registry ikon Lucide (NAMA → path SVG). Metadata kategori kini datang dari
  // tabel `bot_setting_categories` (data-driven); DB menyimpan nama ikon, bukan
  // markup — dipetakan di sini agar tidak ada HTML mentah dari database. Nama
  // yang tak dikenal jatuh ke ikon default `settings`.
  const IC: Record<string, string> = {
    wrench:   '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
    megaphone:'<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
    gamepad:  '<line x1="6" x2="10" y1="12" y2="12"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="15" x2="15.01" y1="13" y2="13"/><line x1="18" x2="18.01" y1="11" y2="11"/><rect width="20" height="12" x="2" y="6" rx="2"/>',
    sliders:  '<line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="10" y2="3"/><line x1="12" x2="12" y1="21" y2="12"/><line x1="12" x2="12" y1="8" y2="3"/><line x1="20" x2="20" y1="21" y2="16"/><line x1="20" x2="20" y1="12" y2="3"/><line x1="1" x2="7" y1="14" y2="14"/><line x1="9" x2="15" y1="8" y2="8"/><line x1="17" x2="23" y1="16" y2="16"/>',
    toggle:   '<rect width="20" height="12" x="2" y="6" rx="6"/><circle cx="16" cy="12" r="2"/>',
    settings: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  };
  const ikonSvg = (nama: string | null | undefined) => IC[nama ?? ''] ?? IC.settings;

  let bolehEdit = false;

  document.addEventListener('admin:ready', (e) => {
    const profile = (e as CustomEvent).detail;
    bolehEdit = profile?.role === 'owner' || profile?.role === 'admin';
    void muatStatus();
    void muat();
    void muatAudit();
  });

  // ─── Riwayat perubahan setting (audit) ───────────────────────────────────
  async function muatAudit() {
    const body = document.getElementById('audit-body')!;
    const supabase = getSupabase();
    if (!supabase) return;
    body.innerHTML = stateBlock('loading', '');

    const { data, error } = await supabase
      .from('bot_settings_audit')
      .select('key, old_value, new_value, changed_at')
      .order('changed_at', { ascending: false })
      .limit(20);

    if (error) { body.innerHTML = stateBlock('error', pesanError(error)); return; }
    if (!data || data.length === 0) { body.innerHTML = stateBlock('empty', 'Belum ada perubahan tercatat.'); return; }

    const potong = (s: string | null) => {
      const t = String(s ?? '—');
      return t.length > 40 ? t.slice(0, 39) + '…' : (t || '—');
    };
    body.innerHTML = `<ul class="divide-y divide-ink-900/5 dark:divide-cream-100/5">${
      data.map((r: any) => `
        <li class="px-5 py-3 text-sm flex flex-wrap items-center gap-x-2 gap-y-1">
          <code class="font-mono text-xs">${esc(r.key)}</code>
          <span class="text-ink-400 dark:text-cream-300/40">·</span>
          <span class="text-ink-500 dark:text-cream-300/60 line-through">${esc(potong(r.old_value))}</span>
          <span class="text-ink-400 dark:text-cream-300/40">→</span>
          <span class="font-medium">${esc(potong(r.new_value))}</span>
          <span class="ml-auto text-xs text-ink-500 dark:text-cream-300/60">${esc(fmtWaktu(r.changed_at))}</span>
        </li>`).join('')
    }</ul>`;
  }

  // ─── Status bot (ringkas, dari snapshot statistik terbaru) ────────────────
  async function muatStatus() {
    const supabase = getSupabase();
    if (!supabase) return;

    const badge = document.getElementById('status-badge')!;
    const teks = document.getElementById('status-teks')!;
    const detail = document.getElementById('status-detail')!;

    const { data } = await supabase
      .from('bot_stats')
      .select('captured_at, guild_count, member_reach, active_players, games_played, commands_run, latency_ms, uptime_seconds, meta')
      .order('captured_at', { ascending: false })
      .limit(1)
      .maybeSingle();

    if (!data) {
      teks.textContent = 'Bot belum mengirim status';
      return;
    }

    // Bot dianggap online bila snapshot terakhir < 15 menit lalu.
    const usiaMs = Date.now() - new Date(data.captured_at).getTime();
    const online = usiaMs < 15 * 60 * 1000;

    badge.className = `inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium ${
      online
        ? 'bg-teal-500/15 text-teal-700 dark:text-teal-300'
        : 'bg-red-500/15 text-red-600 dark:text-red-400'
    }`;
    (badge.querySelector('span.rounded-full') as HTMLElement).className =
      `h-1.5 w-1.5 rounded-full ${online ? 'bg-teal-500' : 'bg-red-500'}`;
    teks.textContent = online ? 'Bot online' : 'Bot mungkin offline';
    detail.textContent = `ping ${fmtAngka(data.latency_ms)}ms · update ${fmtWaktu(data.captured_at)}`;

    // Kartu pemantauan (gabungan kolom + meta jsonb).
    const meta = (data.meta ?? {}) as Record<string, any>;
    const kartu: Array<[string, string]> = [
      ['Server', fmtAngka(data.guild_count)],
      ['Jangkauan member', fmtAngka(data.member_reach)],
      ['Pemain aktif 24j', fmtAngka(data.active_players)],
      ['Total pemain', fmtAngka(meta.total_players)],
      ['Game berlangsung', fmtAngka(meta.active_games)],
      ['Total coin', fmtAngka(meta.total_coins)],
      ['Pemain banned', fmtAngka(meta.banned_players)],
      ['Command dijalankan', fmtAngka(data.commands_run)],
      ['Memori', meta.memory_mb != null ? `${fmtAngka(meta.memory_mb)} MB` : '—'],
      ['Uptime', fmtDurasi(data.uptime_seconds)],
    ];
    const grid = document.getElementById('status-metrics')!;
    grid.innerHTML = kartu.map(([label, nilai]) => `
      <div class="rounded-xl border border-ink-900/10 dark:border-cream-100/10 px-3 py-2.5">
        <p class="font-display text-xl font-semibold tabular-nums">${esc(nilai)}</p>
        <p class="text-[0.7rem] text-ink-500 dark:text-cream-300/60 mt-0.5">${esc(label)}</p>
      </div>`).join('');
    grid.classList.remove('hidden');
  }

  /** Detik → "3j 12m" / "5m" ringkas. */
  function fmtDurasi(detik: number | null | undefined): string {
    if (!detik || detik < 0) return '—';
    const h = Math.floor(detik / 3600);
    const m = Math.floor((detik % 3600) / 60);
    if (h > 0) return `${h}j ${m}m`;
    return `${m}m`;
  }

  // ─── Muat settings (hierarki Kategori → Item, data-driven dari DB) ─────────
  async function muat() {
    const wadah = document.getElementById('kontrol-body')!;
    wadah.innerHTML = stateBlock('loading', '');

    const supabase = getSupabase();
    if (!supabase) {
      wadah.innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.');
      return;
    }

    // Kategori (metadata) + setting (item) diambil bersamaan.
    const [kat, set] = await Promise.all([
      supabase.from('bot_setting_categories').select('key, label, description, icon, sort').order('sort', { ascending: true }),
      supabase.from('bot_settings').select('key, label, value, kind, category, help, min_value, max_value, sort').order('sort', { ascending: true }),
    ]);

    if (set.error) {
      wadah.innerHTML = stateBlock('error', pesanError(set.error));
      return;
    }
    const data = set.data ?? [];
    if (data.length === 0) {
      wadah.innerHTML = stateBlock('empty', 'Belum ada setting. Jalankan supabase/schema.sql terbaru.');
      return;
    }

    // Kelompokkan item per kategori (urutan item = sort dari query).
    const perKategori = new Map<string, any[]>();
    for (const row of data) {
      const k = row.category || 'lainnya';
      if (!perKategori.has(k)) perKategori.set(k, []);
      perKategori.get(k)!.push(row);
    }

    // Urutan section mengikuti tabel kategori (DB). Kategori yang punya item
    // tapi belum ada metadata-nya tetap tampil di akhir sebagai fallback —
    // jadi menambah kategori baru lewat DB langsung terorganisir.
    const kategoriDb = (kat.error ? [] : (kat.data ?? [])) as any[];
    const dikenal = new Set(kategoriDb.map((c) => c.key));
    const daftarKategori = [
      ...kategoriDb.filter((c) => perKategori.has(c.key)),
      ...[...perKategori.keys()]
        .filter((k) => !dikenal.has(k))
        .map((k) => ({ key: k, label: k === 'lainnya' ? 'Lainnya' : k, description: null, icon: null })),
    ];

    wadah.innerHTML = daftarKategori
      .map((c) => sectionKategori(c, perKategori.get(c.key) ?? []))
      .join('');
    document.getElementById('kontrol-aksi')!.classList.remove('hidden');

    if (!bolehEdit) {
      wadah.querySelectorAll('input, textarea').forEach((el) => {
        (el as HTMLInputElement).disabled = true;
      });
      const btn = document.getElementById('btn-simpan') as HTMLButtonElement;
      btn.disabled = true;
      document.getElementById('kontrol-pesan')!.textContent = 'Peran kamu hanya bisa melihat.';
    }
  }

  // Satu section per kategori: header (ikon + judul + jumlah + deskripsi) lalu
  // daftar item — tiap item kartu tersendiri (Kategori → Item yang jelas).
  function sectionKategori(cat: any, items: any[]): string {
    const ikon = `<span class="mt-0.5 flex h-9 w-9 flex-none items-center justify-center rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ikonSvg(cat.icon)}</svg></span>`;
    const desc = cat.description ? `<p class="mt-0.5 text-sm text-ink-500 dark:text-cream-300/60">${esc(cat.description)}</p>` : '';
    const badge = `<span class="ml-2 rounded-full bg-ink-900/5 dark:bg-cream-100/10 px-2 py-0.5 text-xs font-medium text-ink-500 dark:text-cream-300/60">${items.length}</span>`;
    return `
      <section class="space-y-4">
        <div class="flex items-start gap-3">
          ${ikon}
          <div class="min-w-0">
            <h2 class="font-display text-lg font-semibold tracking-tightest flex items-center">${esc(cat.label)}${badge}</h2>
            ${desc}
          </div>
        </div>
        <div class="space-y-3">
          ${items.map(field).join('') || `<p class="text-sm text-ink-500 dark:text-cream-300/60">Belum ada item.</p>`}
        </div>
      </section>`;
  }

  // Tiap item = satu kartu tersendiri (sub-section dari kategori-nya).
  const KARTU = 'rounded-xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-50/40 dark:bg-ink-900/20';
  const INPUT = 'rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2.5 text-sm outline-none focus:border-amber-500 transition-colors';

  function field(row: any): string {
    const id = `f-${row.key}`;
    const help = row.help
      ? `<p class="mt-1 text-xs text-ink-500 dark:text-cream-300/60">${esc(row.help)}</p>`
      : '';

    if (row.kind === 'boolean') {
      const aktif = row.value === 'true';
      return `
        <div class="${KARTU}">
          <label class="flex items-start justify-between gap-4 px-4 py-3.5 cursor-pointer">
            <span class="min-w-0">
              <span class="block text-sm font-medium">${esc(row.label)}</span>
              ${help}
            </span>
            <input type="checkbox" id="${esc(id)}" data-key="${esc(row.key)}" data-kind="boolean" ${aktif ? 'checked' : ''}
              class="mt-0.5 h-5 w-5 flex-none rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" />
          </label>
        </div>`;
    }

    if (row.kind === 'number') {
      const batas = row.min_value != null && row.max_value != null
        ? ` (${esc(row.min_value)}–${esc(row.max_value)})` : '';
      const attrs =
        (row.min_value != null ? ` min="${esc(row.min_value)}"` : '') +
        (row.max_value != null ? ` max="${esc(row.max_value)}"` : '') + ' step="1"';
      return `
        <div class="${KARTU} px-4 py-3.5">
          <label for="${esc(id)}" class="block text-sm font-medium mb-1.5">${esc(row.label)}${batas}</label>
          <input type="number" id="${esc(id)}" data-key="${esc(row.key)}" data-kind="number"${attrs} value="${esc(row.value ?? '')}"
            class="w-40 ${INPUT}" />
          ${help}
        </div>`;
    }

    if (row.kind === 'markdown') {
      return `
        <div class="${KARTU} px-4 py-3.5">
          <label for="${esc(id)}" class="block text-sm font-medium mb-1.5">${esc(row.label)}</label>
          <textarea id="${esc(id)}" data-key="${esc(row.key)}" data-kind="markdown" rows="4"
            class="w-full ${INPUT}">${esc(row.value ?? '')}</textarea>
          ${help}
        </div>`;
    }

    const tipe = row.kind === 'url' ? 'url' : 'text';
    return `
      <div class="${KARTU} px-4 py-3.5">
        <label for="${esc(id)}" class="block text-sm font-medium mb-1.5">${esc(row.label)}</label>
        <input type="${tipe}" id="${esc(id)}" data-key="${esc(row.key)}" data-kind="${esc(row.kind)}" value="${esc(row.value ?? '')}"
          class="w-full ${INPUT}" />
        ${help}
      </div>`;
  }

  document.getElementById('form-kontrol')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!bolehEdit) return;

    const supabase = getSupabase();
    if (!supabase) return;

    const btn = document.getElementById('btn-simpan') as HTMLButtonElement;
    const pesan = document.getElementById('kontrol-pesan')!;

    btn.disabled = true;
    btn.textContent = 'Menyimpan…';
    pesan.textContent = '';
    pesan.className = 'text-sm';

    const { data: sesi } = await supabase.auth.getSession();
    const uid = sesi.session?.user.id ?? null;

    const fields = Array.from(
      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-key]'),
    );

    // Validasi silang: min pemain tidak boleh melebihi max pemain.
    const nilaiOf = (key: string) => {
      const el = fields.find((f) => f.dataset.key === key);
      return el ? parseInt((el as HTMLInputElement).value, 10) : NaN;
    };
    const minP = nilaiOf('tunable_min_players');
    const maxP = nilaiOf('tunable_max_players');
    if (Number.isFinite(minP) && Number.isFinite(maxP) && minP > maxP) {
      pesan.textContent = 'Minimal pemain tidak boleh melebihi maksimal pemain.';
      pesan.className = 'text-sm text-red-600 dark:text-red-400';
      btn.disabled = false;
      btn.textContent = 'Simpan perubahan';
      return;
    }

    const hasil = await Promise.all(
      fields.map((el) => {
        let nilai: string;
        if (el.dataset.kind === 'boolean') nilai = String((el as HTMLInputElement).checked);
        else nilai = el.value;
        return supabase
          .from('bot_settings')
          .update({ value: nilai, updated_at: new Date().toISOString(), updated_by: uid })
          .eq('key', el.dataset.key!);
      }),
    );

    const gagal = hasil.find((r) => r.error);
    if (gagal?.error) {
      pesan.textContent = pesanError(gagal.error);
      pesan.className = 'text-sm text-red-600 dark:text-red-400';
    } else {
      pesan.textContent = 'Tersimpan. Bot akan menerapkannya dalam ± 1 menit.';
      pesan.className = 'text-sm text-teal-700 dark:text-teal-300';
    }

    btn.disabled = false;
    btn.textContent = 'Simpan perubahan';
  });
</script>
