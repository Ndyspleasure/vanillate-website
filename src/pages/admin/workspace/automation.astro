---
// Automation Vanillate Workspace — tabel workspace_automation (definisi rule).
// Statistik eksekusi (runCount/lastRunAt) tetap dilacak bot.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Automation · Workspace" active="ws-automation">
  <AdminPageHeader
    eyebrow="Vanillate Workspace"
    title="Automation"
    description="Aturan pemicu → aksi. Contoh: saat staff menjadi Aktif, kirim Welcome + beri onboarding + beritahu ketua tim."
  />
  <div class="px-6 lg:px-10 py-8 max-w-3xl space-y-5">
    <button type="button" id="ws-add" class="hidden rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-amber-400 transition-colors">+ Tambah rule</button>
    <div id="ws-body" class="space-y-3"></div>
    <p id="ws-pesan" class="text-sm" role="status" aria-live="polite"></p>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import { newWorkspaceId, AUTOMATION_TRIGGERS, AUTOMATION_ACTIONS } from '@/lib/workspace-admin';
  import { loadCatalog, options } from '@/lib/workspace-catalog';

  let bolehEdit = false;
  // Daftar trigger/action berasal dari katalog bot (tak hardcode); fallback ke konstanta.
  let TRIGGERS = AUTOMATION_TRIGGERS;
  let ACTIONS = AUTOMATION_ACTIONS;
  const INPUT = 'w-full rounded-lg border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-3 py-2 text-sm outline-none focus:border-amber-500';

  document.addEventListener('admin:ready', (e) => {
    bolehEdit = ['owner', 'admin'].includes((e as CustomEvent).detail?.role);
    void muat();
  });

  function pesan(msg: string, ok = true) {
    const el = document.getElementById('ws-pesan')!;
    el.textContent = msg;
    el.className = `text-sm ${ok ? 'text-teal-700 dark:text-teal-300' : 'text-red-600 dark:text-red-400'}`;
  }

  function card(row: any): string {
    const dis = bolehEdit ? '' : 'disabled';
    const actions: string[] = Array.isArray(row.actions) ? row.actions : [];
    const msg = (row.params && typeof row.params === 'object' ? row.params.message : '') ?? '';
    return `<div class="rounded-xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-50/40 dark:bg-ink-900/20 px-4 py-3.5 space-y-3" data-id="${esc(row.id)}" data-system="${row.is_system ? '1' : '0'}">
      <div class="flex items-center justify-between gap-2">
        <span class="font-mono text-xs text-ink-500 dark:text-cream-300/60">${esc(row.id)}${row.is_system ? ' · bawaan' : ''}</span>
        ${bolehEdit ? `<div class="flex gap-2">
          <button type="button" data-act="save" class="rounded-lg bg-amber-500/90 px-3 py-1 text-xs font-semibold text-ink-950 hover:bg-amber-400">Simpan</button>
          ${row.is_system ? '' : `<button type="button" data-act="del" class="rounded-lg border border-red-500/40 px-3 py-1 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-500/10">Hapus</button>`}
        </div>` : ''}
      </div>
      <input data-f="name" placeholder="Nama rule" value="${esc(row.name ?? '')}" class="${INPUT}" ${dis} />
      <div class="grid sm:grid-cols-2 gap-2">
        <select data-f="trigger" class="${INPUT}" ${dis}>
          ${TRIGGERS.map((t) => `<option value="${t.value}" ${row.trigger === t.value ? 'selected' : ''}>${esc(t.label)}</option>`).join('')}
        </select>
        <label class="flex items-center gap-2 text-sm px-1">
          <input data-f="enabled" type="checkbox" ${row.enabled !== false ? 'checked' : ''} class="h-4 w-4 rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" ${dis} />
          Aktif
        </label>
      </div>
      <div>
        <p class="text-xs font-medium mb-1">Aksi</p>
        <div class="grid sm:grid-cols-2 gap-1.5">
          ${ACTIONS.map((a) => `<label class="flex items-center gap-2 text-sm">
            <input data-action="${a.value}" type="checkbox" ${actions.includes(a.value) ? 'checked' : ''} class="h-4 w-4 rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" ${dis} />
            <span>${esc(a.label)}</span></label>`).join('')}
        </div>
      </div>
      <input data-f="message" placeholder="Pesan (untuk aksi Kirim Notifikasi)" value="${esc(msg)}" class="${INPUT}" ${dis} />
    </div>`;
  }

  async function muat() {
    const body = document.getElementById('ws-body')!;
    body.innerHTML = stateBlock('loading', '');
    const supabase = getSupabase();
    if (!supabase) { body.innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.'); return; }
    const rows = await loadCatalog();
    TRIGGERS = options(rows, 'automation_trigger', AUTOMATION_TRIGGERS);
    ACTIONS = options(rows, 'automation_action', AUTOMATION_ACTIONS);
    const { data, error } = await supabase.from('workspace_automation').select('*').order('sort', { ascending: true });
    if (error) { body.innerHTML = stateBlock('error', pesanError(error)); return; }
    if (bolehEdit) document.getElementById('ws-add')!.classList.remove('hidden');
    body.innerHTML = (data && data.length) ? data.map(card).join('') : stateBlock('empty', 'Belum ada rule automation.');
  }

  document.getElementById('ws-add')?.addEventListener('click', () => {
    const body = document.getElementById('ws-body')!;
    if (body.querySelector('[data-id="new"]')) return;
    const empty = body.querySelector('.py-16'); if (empty) empty.remove();
    body.insertAdjacentHTML('afterbegin', card({ id: 'new', name: '', trigger: TRIGGERS[0].value, actions: [], enabled: true, is_system: false, params: {} }));
  });

  document.getElementById('ws-body')?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-act]') as HTMLButtonElement | null;
    if (!btn || !bolehEdit) return;
    const cardEl = btn.closest('[data-id]') as HTMLElement;
    const id = cardEl.dataset.id!;
    const supabase = getSupabase(); if (!supabase) return;
    const { data: sesi } = await supabase.auth.getSession();
    const uid = sesi.session?.user.id ?? null;

    if (btn.dataset.act === 'del') {
      if (id === 'new') { cardEl.remove(); return; }
      if (!confirm('Hapus rule ini?')) return;
      const { error } = await supabase.from('workspace_automation').delete().eq('id', id);
      if (error) return pesan(pesanError(error), false);
      cardEl.remove(); pesan('Rule dihapus.');
      return;
    }

    const name = (cardEl.querySelector('[data-f="name"]') as HTMLInputElement).value.trim();
    if (!name) return pesan('Nama rule wajib diisi.', false);
    const actions = Array.from(cardEl.querySelectorAll<HTMLInputElement>('[data-action]:checked')).map((i) => i.dataset.action);
    if (!actions.length) return pesan('Pilih minimal satu aksi.', false);
    const message = (cardEl.querySelector('[data-f="message"]') as HTMLInputElement).value.trim();
    const payload: any = {
      name,
      trigger: (cardEl.querySelector('[data-f="trigger"]') as HTMLSelectElement).value,
      actions,
      params: message ? { message } : {},
      enabled: (cardEl.querySelector('[data-f="enabled"]') as HTMLInputElement).checked,
      updated_at: new Date().toISOString(),
      updated_by: uid,
    };
    if (id === 'new') {
      const newId = newWorkspaceId('AUT');
      const { error } = await supabase.from('workspace_automation').insert({ id: newId, is_system: false, conditions: {}, ...payload });
      if (error) return pesan(pesanError(error), false);
      cardEl.dataset.id = newId;
      (cardEl.querySelector('.font-mono') as HTMLElement).textContent = newId;
    } else {
      const { error } = await supabase.from('workspace_automation').update(payload).eq('id', id);
      if (error) return pesan(pesanError(error), false);
    }
    pesan('Tersimpan. Bot menerapkannya dalam beberapa menit.');
  });
</script>
