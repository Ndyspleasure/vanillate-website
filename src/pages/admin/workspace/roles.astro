---
// Role & Izin Vanillate Workspace — tabel workspace_roles.
// Nama role bebas; hanya KUNCI izin yang jadi kontrak internal. Assignment
// member→role tetap operasional di bot.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Role & Izin · Workspace" active="ws-roles">
  <AdminPageHeader
    eyebrow="Vanillate Workspace"
    title="Role & Izin"
    description="Definisi role, kunci izin granular, dan cakupan (own/team/project/workspace). Role bawaan tak bisa dihapus tapi izinnya bisa diubah."
  />
  <div class="px-6 lg:px-10 py-8 max-w-3xl space-y-5">
    <button type="button" id="ws-add" class="hidden rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-amber-400 transition-colors">+ Tambah role</button>
    <div id="ws-body" class="space-y-4"></div>
    <p id="ws-pesan" class="text-sm" role="status" aria-live="polite"></p>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import {
    newWorkspaceId, PERMISSION_CATEGORIES, SCOPED_PERMISSIONS, PERMISSION_SCOPES,
    SCOPE_LABEL, WILDCARD_PERMISSION, permissionLabel,
  } from '@/lib/workspace-admin';
  import { wsIcon } from '@/lib/workspace-icons';
  import { loadCatalog, ofKind } from '@/lib/workspace-catalog';

  let bolehEdit = false;
  const INPUT = 'w-full rounded-lg border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-3 py-2 text-sm outline-none focus:border-amber-500';

  // Daftar izin/kategori/scope berasal dari KATALOG bot (tak hardcode). Fallback
  // ke konstanta bila katalog belum diterbitkan. Ikon kategori tetap presentasi.
  const ICON_BY_KEY: Record<string, string> = Object.fromEntries(PERMISSION_CATEGORIES.map((c) => [c.key, c.icon]));
  let CATS: { key: string; label: string; icon: string; permissions: string[] }[] = PERMISSION_CATEGORIES;
  let SCOPED = new Set<string>(SCOPED_PERMISSIONS);
  let SCOPES: { value: string; label: string }[] = PERMISSION_SCOPES.map((s) => ({ value: s, label: SCOPE_LABEL[s] }));
  let LABELS: Record<string, string> = {};

  async function refreshCatalog() {
    const rows = await loadCatalog();
    const permRows = ofKind(rows, 'permission');
    const catRows = ofKind(rows, 'permission_category');
    const scopeRows = ofKind(rows, 'scope');
    if (!permRows.length || !catRows.length) return; // pakai fallback
    LABELS = Object.fromEntries(permRows.map((p) => [p.value, p.label ?? p.value]));
    SCOPED = new Set(permRows.filter((p) => p.meta?.scoped).map((p) => p.value));
    if (scopeRows.length) SCOPES = scopeRows.map((s) => ({ value: s.value, label: s.label ?? s.value }));
    const known = new Set(catRows.map((c) => c.value));
    CATS = [
      ...catRows.map((c) => ({
        key: c.value, label: c.label ?? c.value, icon: ICON_BY_KEY[c.value] ?? 'dot',
        permissions: permRows.filter((p) => (p.meta?.category ?? 'lainnya') === c.value).map((p) => p.value),
      })),
      // izin tanpa kategori dikenal → grup "Lainnya" di akhir.
      ...(() => {
        const rest = permRows.filter((p) => !known.has(p.meta?.category ?? 'lainnya')).map((p) => p.value);
        return rest.length ? [{ key: 'lainnya', label: 'Lainnya', icon: 'dot', permissions: rest }] : [];
      })(),
    ];
  }

  document.addEventListener('admin:ready', (e) => {
    bolehEdit = ['owner', 'admin'].includes((e as CustomEvent).detail?.role);
    void muat();
  });

  function pesan(msg: string, ok = true) {
    const el = document.getElementById('ws-pesan')!;
    el.textContent = msg;
    el.className = `text-sm ${ok ? 'text-teal-700 dark:text-teal-300' : 'text-red-600 dark:text-red-400'}`;
  }

  function permGrid(perms: string[], scopes: Record<string, string>): string {
    const dis = bolehEdit ? '' : 'disabled';
    return CATS.map((c) => `
      <details class="rounded-lg border border-ink-900/10 dark:border-cream-100/10">
        <summary class="cursor-pointer px-3 py-2 text-sm font-medium flex items-center gap-2"><span class="text-ink-500 dark:text-cream-300/70">${wsIcon(c.icon, 'h-4 w-4')}</span>${esc(c.label)} <span class="text-xs text-ink-500 dark:text-cream-300/60">(${c.permissions.filter((p) => perms.includes(p)).length}/${c.permissions.length})</span></summary>
        <div class="px-3 pb-3 space-y-1.5">
          ${c.permissions.map((p) => {
            const scoped = SCOPED.has(p);
            const sc = scopes[p] || 'own';
            return `<div class="flex items-center gap-2 flex-wrap">
              <label class="flex items-center gap-2 text-sm">
                <input data-perm="${esc(p)}" type="checkbox" ${perms.includes(p) ? 'checked' : ''} class="h-4 w-4 rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" ${dis} />
                <span class="font-mono text-xs">${esc(LABELS[p] ?? permissionLabel(p))}</span>
              </label>
              ${scoped ? `<select data-scope="${esc(p)}" class="rounded-md border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-2 py-0.5 text-xs" ${dis}>
                ${SCOPES.map((s) => `<option value="${s.value}" ${sc === s.value ? 'selected' : ''}>${esc(s.label)}</option>`).join('')}
              </select>` : ''}
            </div>`;
          }).join('')}
        </div>
      </details>`).join('');
  }

  function card(row: any): string {
    const dis = bolehEdit ? '' : 'disabled';
    const perms: string[] = Array.isArray(row.permissions) ? row.permissions : [];
    const scopes: Record<string, string> = (row.scopes && typeof row.scopes === 'object') ? row.scopes : {};
    const wildcard = perms.includes(WILDCARD_PERMISSION);
    return `<div class="rounded-xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-50/40 dark:bg-ink-900/20 px-4 py-3.5 space-y-3" data-id="${esc(row.id)}" data-system="${row.is_system ? '1' : '0'}">
      <div class="flex items-center justify-between gap-2">
        <span class="font-mono text-xs text-ink-500 dark:text-cream-300/60">${esc(row.id)}${row.is_system ? ' · bawaan' : ''}</span>
        ${bolehEdit ? `<div class="flex gap-2">
          <button type="button" data-act="save" class="rounded-lg bg-amber-500/90 px-3 py-1 text-xs font-semibold text-ink-950 hover:bg-amber-400">Simpan</button>
          ${row.is_system ? '' : `<button type="button" data-act="del" class="rounded-lg border border-red-500/40 px-3 py-1 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-500/10">Hapus</button>`}
        </div>` : ''}
      </div>
      <div class="grid sm:grid-cols-2 gap-2">
        <input data-f="name" placeholder="Nama role" value="${esc(row.name ?? '')}" class="${INPUT}" ${dis} />
        <input data-f="rank" type="number" placeholder="Rank (angka besar = tinggi)" value="${esc(row.rank ?? 100)}" class="${INPUT}" ${dis} />
      </div>
      <input data-f="description" placeholder="Deskripsi (opsional)" value="${esc(row.description ?? '')}" class="${INPUT}" ${dis} />
      <label class="flex items-center gap-2 text-sm">
        <input data-f="wildcard" type="checkbox" ${wildcard ? 'checked' : ''} class="h-4 w-4 rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" ${dis} />
        <span>Super-admin — semua izin (<code>*</code>)</span>
      </label>
      <div data-perms class="${wildcard ? 'hidden' : ''} space-y-2">${permGrid(perms, scopes)}</div>
    </div>`;
  }

  async function muat() {
    const body = document.getElementById('ws-body')!;
    body.innerHTML = stateBlock('loading', '');
    const supabase = getSupabase();
    if (!supabase) { body.innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.'); return; }
    await refreshCatalog();
    const { data, error } = await supabase.from('workspace_roles').select('*').order('sort', { ascending: true }).order('rank', { ascending: false });
    if (error) { body.innerHTML = stateBlock('error', pesanError(error)); return; }
    if (bolehEdit) document.getElementById('ws-add')!.classList.remove('hidden');
    body.innerHTML = (data && data.length) ? data.map(card).join('') : stateBlock('empty', 'Belum ada role.');
  }

  document.getElementById('ws-add')?.addEventListener('click', () => {
    const body = document.getElementById('ws-body')!;
    if (body.querySelector('[data-id="new"]')) return;
    const empty = body.querySelector('.py-16'); if (empty) empty.remove();
    body.insertAdjacentHTML('afterbegin', card({ id: 'new', name: '', rank: 100, permissions: ['dashboard.access'], scopes: {}, is_system: false }));
  });

  // Sembunyikan grid izin saat wildcard dicentang.
  document.getElementById('ws-body')?.addEventListener('change', (e) => {
    const t = e.target as HTMLElement;
    if (t.matches('[data-f="wildcard"]')) {
      const cardEl = t.closest('[data-id]')!;
      cardEl.querySelector('[data-perms]')!.classList.toggle('hidden', (t as HTMLInputElement).checked);
    }
  });

  document.getElementById('ws-body')?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-act]') as HTMLButtonElement | null;
    if (!btn || !bolehEdit) return;
    const cardEl = btn.closest('[data-id]') as HTMLElement;
    const id = cardEl.dataset.id!;
    const supabase = getSupabase(); if (!supabase) return;
    const { data: sesi } = await supabase.auth.getSession();
    const uid = sesi.session?.user.id ?? null;

    if (btn.dataset.act === 'del') {
      if (id === 'new') { cardEl.remove(); return; }
      if (!confirm('Hapus role ini? Anggota di bot akan kehilangan role ini pada sync berikutnya.')) return;
      const { error } = await supabase.from('workspace_roles').delete().eq('id', id);
      if (error) return pesan(pesanError(error), false);
      cardEl.remove(); pesan('Role dihapus.');
      return;
    }

    const name = (cardEl.querySelector('[data-f="name"]') as HTMLInputElement).value.trim();
    if (!name) return pesan('Nama role wajib diisi.', false);
    const rankRaw = parseInt((cardEl.querySelector('[data-f="rank"]') as HTMLInputElement).value, 10);
    const wildcard = (cardEl.querySelector('[data-f="wildcard"]') as HTMLInputElement).checked;

    let permissions: string[];
    const scopes: Record<string, string> = {};
    if (wildcard) {
      permissions = [WILDCARD_PERMISSION];
    } else {
      permissions = Array.from(cardEl.querySelectorAll<HTMLInputElement>('[data-perm]:checked')).map((i) => i.dataset.perm!);
      cardEl.querySelectorAll<HTMLSelectElement>('[data-scope]').forEach((sel) => {
        const p = sel.dataset.scope!;
        if (permissions.includes(p) && sel.value !== 'own') scopes[p] = sel.value;
      });
    }

    const payload: any = {
      name,
      description: (cardEl.querySelector('[data-f="description"]') as HTMLInputElement).value.trim() || null,
      rank: Number.isFinite(rankRaw) ? rankRaw : 100,
      permissions,
      scopes,
      updated_at: new Date().toISOString(),
      updated_by: uid,
    };
    if (id === 'new') {
      const newId = newWorkspaceId('ROLE');
      const { error } = await supabase.from('workspace_roles').insert({ id: newId, is_system: false, ...payload });
      if (error) return pesan(pesanError(error), false);
      cardEl.dataset.id = newId;
      (cardEl.querySelector('.font-mono') as HTMLElement).textContent = newId;
    } else {
      const { error } = await supabase.from('workspace_roles').update(payload).eq('id', id);
      if (error) return pesan(pesanError(error), false);
    }
    pesan('Tersimpan. Bot menerapkannya dalam beberapa menit.');
  });
</script>
