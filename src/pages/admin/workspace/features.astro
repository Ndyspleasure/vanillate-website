---
// Feature Toggle Vanillate Workspace — tabel workspace_features (CRUD).
// Tiap fitur bisa on / off / maintenance. Admin bisa tambah/hapus fitur.
// Bot menegakkan hanya kunci yang memang dicek kodenya (lihat katalog).
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Feature Toggle · Workspace" active="ws-features">
  <AdminPageHeader
    eyebrow="Vanillate Workspace"
    title="Feature Toggle"
    description="Nyalakan, matikan, atau set maintenance tiap subsistem bot. Kamu bisa menambah/menghapus fitur; bot menerapkannya untuk kunci yang memang dikenal (lihat daftar katalog)."
  />
  <div class="px-6 lg:px-10 py-8 max-w-3xl space-y-5">
    <button type="button" id="ws-add" class="hidden rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-amber-400 transition-colors">+ Tambah fitur</button>
    <datalist id="feature-keys"></datalist>
    <div id="ws-body" class="space-y-3"></div>
    <p id="ws-pesan" class="text-sm" role="status" aria-live="polite"></p>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import { wsStateDot } from '@/lib/workspace-icons';
  import { loadCatalog, ofKind } from '@/lib/workspace-catalog';

  let bolehEdit = false;
  const STATES = [
    { v: 'on', label: 'ON' },
    { v: 'maintenance', label: 'Maintenance' },
    { v: 'off', label: 'OFF' },
  ];
  const INPUT = 'w-full rounded-lg border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-3 py-2 text-sm outline-none focus:border-amber-500';

  document.addEventListener('admin:ready', (e) => {
    bolehEdit = ['owner', 'admin'].includes((e as CustomEvent).detail?.role);
    void muat();
  });

  function pesan(msg: string, ok = true) {
    const el = document.getElementById('ws-pesan')!;
    el.textContent = msg;
    el.className = `text-sm ${ok ? 'text-teal-700 dark:text-teal-300' : 'text-red-600 dark:text-red-400'}`;
  }

  function card(row: any): string {
    const isNew = row.key === undefined;
    const dis = bolehEdit ? '' : 'disabled';
    const state = row.state ?? 'on';
    return `<div class="rounded-xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-50/40 dark:bg-ink-900/20 px-4 py-3.5 space-y-2.5" data-key="${esc(row.key ?? '')}" data-new="${isNew ? '1' : '0'}">
      <div class="flex items-center gap-2.5">
        <span data-dot class="flex-none">${wsStateDot(state)}</span>
        <div class="min-w-0 flex-1 grid sm:grid-cols-2 gap-2">
          ${isNew
            ? `<input data-f="key" list="feature-keys" placeholder="kunci fitur (mis. tasks)" class="${INPUT} font-mono" ${dis} />`
            : `<span class="font-mono text-xs text-ink-500 dark:text-cream-300/60 self-center">${esc(row.key)}</span>`}
          <input data-f="label" placeholder="Nama fitur" value="${esc(row.label ?? '')}" class="${INPUT}" ${dis} />
        </div>
        ${bolehEdit ? `<div class="flex flex-none gap-2">
          <button type="button" data-act="save" class="rounded-lg bg-amber-500/90 px-3 py-1 text-xs font-semibold text-ink-950 hover:bg-amber-400">Simpan</button>
          <button type="button" data-act="del" class="rounded-lg border border-red-500/40 px-3 py-1 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-500/10">Hapus</button>
        </div>` : ''}
      </div>
      <select data-f="state" class="w-44 rounded-lg border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-3 py-2 text-sm outline-none focus:border-amber-500" ${dis}>
        ${STATES.map((s) => `<option value="${s.v}" ${state === s.v ? 'selected' : ''}>${s.label}</option>`).join('')}
      </select>
    </div>`;
  }

  async function muat() {
    const body = document.getElementById('ws-body')!;
    body.innerHTML = stateBlock('loading', '');
    const supabase = getSupabase();
    if (!supabase) { body.innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.'); return; }

    // Katalog kunci fitur yang dikenal bot → saran input (datalist).
    const cat = ofKind(await loadCatalog(), 'feature');
    document.getElementById('feature-keys')!.innerHTML =
      cat.map((r) => `<option value="${esc(r.value)}">${esc(r.label ?? r.value)}</option>`).join('');

    const { data, error } = await supabase
      .from('workspace_features')
      .select('key, label, state, sort')
      .order('sort', { ascending: true });
    if (error) { body.innerHTML = stateBlock('error', pesanError(error)); return; }
    if (bolehEdit) document.getElementById('ws-add')!.classList.remove('hidden');
    body.innerHTML = (data && data.length) ? data.map(card).join('') : stateBlock('empty', 'Belum ada fitur.');

    // Titik status ikut berubah saat state diganti.
    body.querySelectorAll<HTMLSelectElement>('[data-f="state"]').forEach((sel) => {
      sel.addEventListener('change', () => {
        const dot = sel.closest('[data-key]')?.querySelector('[data-dot]');
        if (dot) dot.innerHTML = wsStateDot(sel.value);
      });
    });
  }

  document.getElementById('ws-add')?.addEventListener('click', () => {
    const body = document.getElementById('ws-body')!;
    if (body.querySelector('[data-new="1"]')) return;
    const empty = body.querySelector('.py-16'); if (empty) empty.remove();
    body.insertAdjacentHTML('afterbegin', card({}));
  });

  document.getElementById('ws-body')?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-act]') as HTMLButtonElement | null;
    if (!btn || !bolehEdit) return;
    const cardEl = btn.closest('[data-key]') as HTMLElement;
    const isNew = cardEl.dataset.new === '1';
    const supabase = getSupabase(); if (!supabase) return;
    const { data: sesi } = await supabase.auth.getSession();
    const uid = sesi.session?.user.id ?? null;
    const val = (f: string) => (cardEl.querySelector(`[data-f="${f}"]`) as HTMLInputElement | HTMLSelectElement).value.trim();

    if (btn.dataset.act === 'del') {
      if (isNew) { cardEl.remove(); return; }
      if (!confirm('Hapus fitur ini?')) return;
      const { error } = await supabase.from('workspace_features').delete().eq('key', cardEl.dataset.key);
      if (error) return pesan(pesanError(error), false);
      cardEl.remove(); pesan('Fitur dihapus.');
      return;
    }

    const label = val('label');
    const state = val('state');
    if (!label) return pesan('Nama fitur wajib diisi.', false);
    if (isNew) {
      const key = val('key');
      if (!/^[a-z0-9_]+$/.test(key)) return pesan('Kunci fitur hanya boleh huruf kecil, angka, dan garis bawah.', false);
      const { error } = await supabase.from('workspace_features').insert({ key, label, state, updated_at: new Date().toISOString(), updated_by: uid });
      if (error) return pesan(pesanError(error), false);
      cardEl.dataset.key = key; cardEl.dataset.new = '0';
      pesan('Fitur ditambahkan. Bot menerapkannya (bila kunci dikenal) dalam beberapa menit.');
      void muat();
    } else {
      const { error } = await supabase.from('workspace_features').update({ label, state, updated_at: new Date().toISOString(), updated_by: uid }).eq('key', cardEl.dataset.key);
      if (error) return pesan(pesanError(error), false);
      pesan('Tersimpan. Bot menerapkannya dalam beberapa menit.');
    }
  });
</script>
