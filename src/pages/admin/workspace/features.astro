---
// Feature Toggle Vanillate Workspace — tabel workspace_features.
// Tiap fitur bisa on / off / maintenance. Bot menegakkannya.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Feature Toggle · Workspace" active="ws-features">
  <AdminPageHeader
    eyebrow="Vanillate Workspace"
    title="Feature Toggle"
    description="Nyalakan, matikan, atau set maintenance tiap subsistem bot. Bot menarik perubahan ini secara berkala."
  />
  <div class="px-6 lg:px-10 py-8 max-w-3xl space-y-6">
    <div id="ws-body" class="space-y-3"></div>
    <div id="ws-aksi" class="hidden flex-wrap items-center gap-3">
      <button type="button" id="ws-save" class="rounded-xl bg-amber-500 px-5 py-2.5 text-sm font-semibold text-ink-950 hover:bg-amber-400 disabled:opacity-60 disabled:cursor-not-allowed transition-colors">Simpan perubahan</button>
      <p id="ws-pesan" class="text-sm" role="status" aria-live="polite"></p>
    </div>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';

  let bolehEdit = false;
  const STATES = [
    { v: 'on', label: '🟢 ON' },
    { v: 'maintenance', label: '🟡 Maintenance' },
    { v: 'off', label: '🔴 OFF' },
  ];

  document.addEventListener('admin:ready', (e) => {
    bolehEdit = ['owner', 'admin'].includes((e as CustomEvent).detail?.role);
    void muat();
  });

  async function muat() {
    const body = document.getElementById('ws-body')!;
    body.innerHTML = stateBlock('loading', '');
    const supabase = getSupabase();
    if (!supabase) { body.innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.'); return; }

    const { data, error } = await supabase
      .from('workspace_features')
      .select('key, label, state, sort')
      .order('sort', { ascending: true });

    if (error) { body.innerHTML = stateBlock('error', pesanError(error)); return; }
    if (!data || !data.length) { body.innerHTML = stateBlock('empty', 'Belum ada fitur. Jalankan supabase/workspace-schema.sql.'); return; }

    body.innerHTML = data.map((row: any) => `
      <div class="rounded-xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-50/40 dark:bg-ink-900/20 px-4 py-3.5 flex items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="text-sm font-medium">${esc(row.label)}</p>
          <p class="text-xs text-ink-500 dark:text-cream-300/60 font-mono">${esc(row.key)}</p>
        </div>
        <select data-key="${esc(row.key)}" class="rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-3 py-2 text-sm outline-none focus:border-amber-500">
          ${STATES.map((s) => `<option value="${s.v}" ${row.state === s.v ? 'selected' : ''}>${s.label}</option>`).join('')}
        </select>
      </div>`).join('');

    document.getElementById('ws-aksi')!.classList.remove('hidden');
    if (!bolehEdit) {
      body.querySelectorAll('select').forEach((el) => ((el as HTMLSelectElement).disabled = true));
      (document.getElementById('ws-save') as HTMLButtonElement).disabled = true;
      document.getElementById('ws-pesan')!.textContent = 'Peran kamu hanya bisa melihat.';
    }
  }

  document.getElementById('ws-save')?.addEventListener('click', async () => {
    if (!bolehEdit) return;
    const supabase = getSupabase();
    if (!supabase) return;
    const btn = document.getElementById('ws-save') as HTMLButtonElement;
    const pesan = document.getElementById('ws-pesan')!;
    btn.disabled = true; btn.textContent = 'Menyimpan…'; pesan.textContent = ''; pesan.className = 'text-sm';
    const { data: sesi } = await supabase.auth.getSession();
    const uid = sesi.session?.user.id ?? null;

    const selects = Array.from(document.querySelectorAll<HTMLSelectElement>('[data-key]'));
    const hasil = await Promise.all(selects.map((el) =>
      supabase.from('workspace_features')
        .update({ state: el.value, updated_at: new Date().toISOString(), updated_by: uid })
        .eq('key', el.dataset.key!),
    ));
    const gagal = hasil.find((r) => r.error);
    if (gagal?.error) { pesan.textContent = pesanError(gagal.error); pesan.className = 'text-sm text-red-600 dark:text-red-400'; }
    else { pesan.textContent = 'Tersimpan. Bot menerapkannya dalam beberapa menit.'; pesan.className = 'text-sm text-teal-700 dark:text-teal-300'; }
    btn.disabled = false; btn.textContent = 'Simpan perubahan';
  });
</script>
