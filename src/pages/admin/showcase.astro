---
// Admin: 🌐 Showcase Server (daftar server pemakai bot di vanillate.id).
//
// Bot menerbitkan daftar server yang tampil ke `showcase_snapshot`; halaman ini
// MEMBACA daftar itu dan mengelola `showcase_hidden` (server yang tidak
// ditampilkan karena tinjauan). Yang tersimpan hanya ID server + kode alasan +
// catatan internal, tanpa nama, ikon, atau link. Admin server hanya melihat teks
// netral di dashboard mereka; alasan dan catatan tidak pernah keluar dari sini.
// SQL: supabase/showcase-servers.sql. Acuan: docs/SHOWCASE-SERVER.md.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Showcase Server" active="showcase">
  <AdminPageHeader
    eyebrow="Discord Bot"
    title="Showcase Server"
    description="Server pemakai bot yang tampil di beranda dan halaman produk. Di sini tim menyembunyikan server yang sedang ditinjau. Daftar diterbitkan bot tiap beberapa jam, halaman website mengikuti pembangunan harian."
  />

  <div id="sc-root" class="px-6 lg:px-10 py-8 max-w-5xl space-y-10">
    <div id="sc-summary"></div>
    <section aria-labelledby="sc-hidden-title">
      <h2 id="sc-hidden-title" class="font-display text-xl font-semibold tracking-tightest">Disembunyikan</h2>
      <p class="mt-1 text-sm text-ink-600 dark:text-cream-200/80">Hanya ID, kode alasan, dan catatan internal yang disimpan. Admin server melihat teks netral tentang tinjauan tim Vanillate dan arahan ke dukungan. Jangan menulis data pribadi di catatan.</p>
      <div id="sc-hidden" class="mt-4"></div>
    </section>
    <section aria-labelledby="sc-list-title">
      <h2 id="sc-list-title" class="font-display text-xl font-semibold tracking-tightest">Server yang tampil</h2>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <label class="sr-only" for="sc-search">Cari nama atau ID server</label>
        <input id="sc-search" type="search" autocomplete="off" placeholder="Cari nama atau ID server" class="w-full max-w-sm rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2.5 text-sm outline-none focus:border-amber-500 transition-colors" />
        <span id="sc-count" class="text-sm text-ink-500 dark:text-cream-300/60"></span>
      </div>
      <div id="sc-list" class="mt-4 space-y-2"></div>
    </section>
    <section aria-labelledby="sc-log-title">
      <h2 id="sc-log-title" class="font-display text-xl font-semibold tracking-tightest">Riwayat tinjauan</h2>
      <div id="sc-log" class="mt-4"></div>
    </section>
    <dialog id="sc-dialog" class="w-[min(32rem,calc(100vw-2rem))] rounded-2xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-50 dark:bg-ink-950 text-ink-900 dark:text-cream-100 p-0 shadow-2xl backdrop:bg-black/50">
      <form id="sc-form" method="dialog" class="space-y-4 p-6" novalidate></form>
    </dialog>
    <p id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 hidden rounded-xl px-4 py-2.5 text-sm font-medium shadow-lg z-50" role="status" aria-live="polite"></p>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import { fmtWaktu } from '@/lib/admin-auth';
  import { BOT_SLUG_NEW } from '@/lib/bot-slug';
  import { iconUrl, formatMembers, initials, matchesQuery, parseList, type ShowcaseServer } from '@/lib/showcase-model';

  const INPUT = 'w-full rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2.5 text-sm outline-none focus:border-amber-500 transition-colors';
  const BTN = 'rounded-xl bg-amber-500 px-5 py-2.5 text-sm font-semibold text-ink-950 hover:bg-amber-400 disabled:opacity-60 disabled:cursor-not-allowed transition-colors';
  const BTN2 = 'rounded-xl border border-ink-900/15 dark:border-cream-100/15 px-4 py-2 text-sm font-medium hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors disabled:opacity-40 disabled:cursor-not-allowed';
  const MUTED = 'text-ink-500 dark:text-cream-300/60';
  const MAX_ROWS = 100;
  const SNOWFLAKE = /^[0-9]{15,22}$/;

  const REASONS: Record<string, string> = {
    review: 'Sedang ditinjau',
    nsfw: 'Konten dewasa',
    violation: 'Pelanggaran',
    other: 'Lainnya',
  };

  type Hidden = { guild_id: string; reason: string; note: string | null; hidden_at: string };
  type LogRow = { id: number; guild_id: string; action: string; reason: string | null; at: string };
  const ACTION: Record<string, string> = { hide: 'Disembunyikan', update: 'Diubah', unhide: 'Ditampilkan lagi' };

  let bolehEdit = false;
  let uid: string | null = null;
  let servers: ShowcaseServer[] = [];
  let hidden: Hidden[] = [];
  let updatedAt: string | null = null;
  let sibuk = false;

  const $ = (id: string) => document.getElementById(id)!;

  document.addEventListener('admin:ready', (e) => {
    const profile = (e as CustomEvent).detail;
    bolehEdit = profile?.role === 'owner' || profile?.role === 'admin';
    uid = profile?.id ?? null;
    void muat();
    $('sc-root').addEventListener('click', onClick);
    $('sc-search').addEventListener('input', renderList);
  });

  function toast(pesan: string, ok = true) {
    const t = $('toast');
    t.textContent = pesan;
    t.className = `fixed bottom-5 left-1/2 -translate-x-1/2 rounded-xl px-4 py-2.5 text-sm font-medium shadow-lg z-50 ${ok ? 'bg-teal-600 text-white' : 'bg-red-600 text-white'}`;
    window.clearTimeout((toast as any)._t);
    (toast as any)._t = window.setTimeout(() => t.classList.add('hidden'), 4000);
  }

  async function muat() {
    const supabase = getSupabase();
    if (!supabase) { $('sc-summary').innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.'); return; }
    $('sc-summary').innerHTML = stateBlock('loading', '');
    const [snap, hid, log] = await Promise.all([
      supabase.from('showcase_snapshot').select('data, total, updated_at').eq('bot_slug', BOT_SLUG_NEW).maybeSingle(),
      supabase.from('showcase_hidden').select('guild_id, reason, note, hidden_at').order('hidden_at', { ascending: false }),
      supabase.from('showcase_hidden_log').select('id, guild_id, action, reason, at').order('id', { ascending: false }).limit(30),
    ]);
    const bad = snap.error ?? hid.error ?? log.error;
    if (bad) {
      $('sc-summary').innerHTML = stateBlock('error', bad.code === '42P01'
        ? 'Tabel Showcase belum ada. Terapkan migrasi supabase/showcase-servers.sql.'
        : pesanError(bad));
      return;
    }
    const parsed = parseList({ servers: (snap.data?.data as unknown[]) ?? [], updated_at: snap.data?.updated_at ?? null });
    servers = parsed.servers.sort((a, b) => a.n.localeCompare(b.n, 'id'));
    updatedAt = parsed.updatedAt;
    hidden = (hid.data ?? []) as Hidden[];
    renderSummary();
    renderHidden();
    renderList();
    renderLog((log.data ?? []) as LogRow[]);
  }

  function renderSummary() {
    const stale = !updatedAt || Date.now() - Date.parse(updatedAt) > 6 * 3600 * 1000;
    $('sc-summary').innerHTML = `
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-4"><p class="font-mono text-xs uppercase tracking-wider ${MUTED}">Server tampil</p><p class="mt-1 font-display text-3xl font-semibold">${servers.length}</p></div>
        <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-4"><p class="font-mono text-xs uppercase tracking-wider ${MUTED}">Disembunyikan</p><p class="mt-1 font-display text-3xl font-semibold">${hidden.length}</p></div>
        <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-4"><p class="font-mono text-xs uppercase tracking-wider ${MUTED}">Diterbitkan bot</p><p class="mt-1 text-sm font-medium">${esc(updatedAt ? fmtWaktu(updatedAt) : 'belum pernah')}</p></div>
      </div>
      ${stale ? `<p class="mt-3 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-200">Daftar belum diterbitkan bot dalam 6 jam terakhir. Cek keadaan bot di Ringkasan &amp; Sistem. Website menyembunyikan seksi ini bila daftar lebih tua dari 7 hari.</p>` : ''}`;
  }

  function renderHidden() {
    const known = new Map(servers.map((s) => [s.i, s]));
    const rows = hidden.map((h) => `
      <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-4">
        <div class="min-w-0 flex-1">
          <p class="font-mono text-sm">${esc(h.guild_id)}</p>
          <p class="text-xs ${MUTED}">${esc(REASONS[h.reason] ?? h.reason)} · ${esc(fmtWaktu(h.hidden_at))}${known.has(h.guild_id) ? ' · masih ada di daftar bot (hilang pada penerbitan berikutnya)' : ''}</p>
          ${h.note ? `<p class="mt-1 text-sm">${esc(h.note)}</p>` : ''}
        </div>
        ${bolehEdit ? `<button type="button" class="${BTN2}" data-action="ubah" data-id="${esc(h.guild_id)}">Ubah</button>
        <button type="button" class="${BTN2}" data-action="tampilkan" data-id="${esc(h.guild_id)}">Tampilkan lagi</button>` : ''}
      </div>`);
    $('sc-hidden').innerHTML = `
      ${bolehEdit ? `<div class="mb-4 flex flex-wrap items-end gap-3">
        <label class="block text-sm font-medium">Sembunyikan lewat ID server
          <input id="sc-newid" inputmode="numeric" maxlength="22" placeholder="ID server (angka 15 sampai 22 digit)" class="${INPUT} mt-1 w-80 max-w-full" /></label>
        <button type="button" class="${BTN}" data-action="tambah-id">Sembunyikan</button></div>` : `<p class="mb-4 text-sm ${MUTED}">Peran kamu hanya bisa melihat.</p>`}
      <div class="space-y-3">${rows.length ? rows.join('') : stateBlock('empty', 'Tidak ada server yang disembunyikan.')}</div>`;
  }

  function renderList() {
    const q = ($('sc-search') as HTMLInputElement).value.trim();
    const hiddenIds = new Set(hidden.map((h) => h.guild_id));
    const match = servers.filter((s) => !q || matchesQuery(s.n, q) || s.i.includes(q));
    $('sc-count').textContent = `${match.length} dari ${servers.length} server${match.length > MAX_ROWS ? `, menampilkan ${MAX_ROWS} pertama` : ''}`;
    $('sc-list').innerHTML = match.slice(0, MAX_ROWS).map((s) => {
      const icon = iconUrl(s, 64);
      return `<div class="flex items-center gap-3 rounded-xl border border-ink-900/10 dark:border-cream-100/10 px-3 py-2">
        ${icon
          ? `<img src="${esc(icon)}" alt="" width="32" height="32" loading="lazy" referrerpolicy="no-referrer" class="h-8 w-8 flex-none rounded-full bg-ink-900/10" />`
          : `<span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-ink-900/10 text-xs font-semibold" aria-hidden="true">${esc(initials(s.n))}</span>`}
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium">${esc(s.n)}</p>
          <p class="truncate font-mono text-xs ${MUTED}">${esc(s.i)}${s.m ? ` · ${esc(formatMembers(s.m))} member` : ''}${s.v ? ' · ada link' : ''}</p>
        </div>
        ${bolehEdit && !hiddenIds.has(s.i) ? `<button type="button" class="${BTN2}" data-action="sembunyikan" data-id="${esc(s.i)}">Sembunyikan</button>` : ''}
      </div>`;
    }).join('') || stateBlock('empty', servers.length ? 'Tidak ada server dengan kata itu.' : 'Bot belum menerbitkan daftar.');
  }

  function renderLog(rows: LogRow[]) {
    $('sc-log').innerHTML = rows.length
      ? `<ul class="space-y-1 text-sm">${rows.map((r) => `<li><span class="font-mono text-xs">${esc(r.guild_id)}</span> · ${esc(ACTION[r.action] ?? r.action)}${r.reason ? ` (${esc(REASONS[r.reason] ?? r.reason)})` : ''} <span class="${MUTED}">· ${esc(fmtWaktu(r.at))}</span></li>`).join('')}</ul>`
      : stateBlock('empty', 'Belum ada riwayat.');
  }

  function dialog(guildId: string, existing: Hidden | null) {
    const name = servers.find((s) => s.i === guildId)?.n;
    $('sc-form').innerHTML = `
      <h2 class="font-display text-xl font-semibold tracking-tightest">${existing ? 'Ubah alasan' : 'Sembunyikan server'}</h2>
      <p class="text-sm ${MUTED}">${name ? `<strong>${esc(name)}</strong><br>` : ''}<span class="font-mono">${esc(guildId)}</span></p>
      <label class="block text-sm font-medium">Kode alasan
        <select id="sc-reason" class="${INPUT} mt-1">${Object.entries(REASONS).map(([k, v]) => `<option value="${k}" ${(existing?.reason ?? 'review') === k ? 'selected' : ''}>${esc(v)}</option>`).join('')}</select></label>
      <label class="block text-sm font-medium">Catatan internal (opsional, maksimal 500 karakter)
        <textarea id="sc-note" rows="3" maxlength="500" class="${INPUT} mt-1">${esc(existing?.note ?? '')}</textarea>
        <span class="mt-1 block text-xs font-normal ${MUTED}">Hanya terlihat di CMS. Jangan menulis data pribadi.</span></label>
      <div class="flex justify-end gap-2">
        <button type="button" class="${BTN2}" data-action="batal">Batal</button>
        <button type="button" class="${BTN}" data-action="simpan" data-id="${esc(guildId)}">Simpan</button>
      </div>`;
    ($('sc-dialog') as HTMLDialogElement).showModal();
  }

  async function simpan(guildId: string) {
    if (!bolehEdit || sibuk) return;
    if (!SNOWFLAKE.test(guildId)) { toast('ID server tidak sah.', false); return; }
    sibuk = true;
    const note = ($('sc-note') as HTMLTextAreaElement).value.trim();
    const { error } = await getSupabase()!.from('showcase_hidden').upsert({
      guild_id: guildId, reason: ($('sc-reason') as HTMLSelectElement).value, note: note || null, hidden_by: uid,
    }, { onConflict: 'guild_id' });
    sibuk = false;
    if (error) { toast(pesanError(error), false); return; }
    ($('sc-dialog') as HTMLDialogElement).close();
    toast('Tersimpan. Server hilang dari daftar pada penerbitan bot berikutnya.');
    await muat();
  }

  async function tampilkan(guildId: string) {
    if (!bolehEdit || sibuk) return;
    if (!confirm('Tampilkan lagi server ini? Server kembali ke daftar pada penerbitan bot berikutnya.')) return;
    sibuk = true;
    const { error } = await getSupabase()!.from('showcase_hidden').delete().eq('guild_id', guildId);
    sibuk = false;
    if (error) { toast(pesanError(error), false); return; }
    toast('Server ditampilkan lagi.');
    await muat();
  }

  function onClick(e: Event) {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
    if (!b) return;
    const id = b.dataset.id ?? '';
    switch (b.dataset.action) {
      case 'sembunyikan': dialog(id, null); break;
      case 'ubah': dialog(id, hidden.find((h) => h.guild_id === id) ?? null); break;
      case 'tambah-id': {
        const v = ($('sc-newid') as HTMLInputElement).value.trim();
        if (!SNOWFLAKE.test(v)) { toast('ID server harus 15 sampai 22 digit angka.', false); break; }
        dialog(v, hidden.find((h) => h.guild_id === v) ?? null);
        break;
      }
      case 'tampilkan': void tampilkan(id); break;
      case 'simpan': void simpan(id); break;
      case 'batal': ($('sc-dialog') as HTMLDialogElement).close(); break;
    }
  }
</script>
