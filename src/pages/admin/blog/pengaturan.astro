---
// Admin — Kategori & Penulis Blog.
//
// Kategori membentuk /blog/kategori/<slug>; penulis membentuk
// /blog/penulis/<slug> dan muncul di setiap artikel (sinyal E-E-A-T untuk SEO).
// Disimpan di Sanity lewat Edge Function `blog-admin`. Lihat docs/BLOG.md.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Kategori & Penulis Blog" active="blog-pengaturan">
  <AdminPageHeader
    eyebrow="Blog"
    title="Kategori & Penulis"
    description="Kategori mengelompokkan artikel di /blog. Penulis tampil di setiap artikel beserta profilnya — Google menilai konten lebih tepercaya bila penulisnya jelas."
  />

  <div class="px-6 lg:px-10 py-8 space-y-12 max-w-3xl">
    <section class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display text-lg font-semibold tracking-tightest">Kategori</h2>
        <button type="button" data-tambah="category" class="rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-amber-400 transition-colors">+ Tambah kategori</button>
      </div>
      <p class="text-sm text-ink-500 dark:text-cream-300/60">Slug menjadi URL <code class="font-mono text-xs">/blog/kategori/&lt;slug&gt;</code>. Urutan kecil tampil lebih dulu.</p>
      <div id="kategori" class="space-y-4"></div>
    </section>

    <section class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display text-lg font-semibold tracking-tightest">Penulis</h2>
        <button type="button" data-tambah="author" class="rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-amber-400 transition-colors">+ Tambah penulis</button>
      </div>
      <p class="text-sm text-ink-500 dark:text-cream-300/60">Tautan profil (satu per baris, https://) dipakai Google untuk mengenali penulis, mis. LinkedIn atau X.</p>
      <div id="penulis" class="space-y-4"></div>
    </section>

    <p id="pesan" class="text-sm" role="status" aria-live="polite"></p>
  </div>
</AdminLayout>

<script>
  import { blogCall, uploadImage } from '@/lib/blog/admin-client';
  import { esc, stateBlock } from '@/lib/admin-ui';

  const INPUT = 'w-full rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2.5 text-sm outline-none focus:border-amber-500 transition-colors';
  const KARTU = 'rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5 space-y-4';

  type Kategori = { id: string; title: string; slug: string; description: string | null; sort: number | null };
  type Penulis = { id: string; name: string; slug: string; role: string | null; bio: string | null; links: string[] | null; avatar: { assetId: string; url: string } | null };

  let bolehEdit = false;
  /** Avatar yang baru diunggah tapi belum disimpan, per id kartu. */
  const avatarBaru = new Map<string, { assetId: string; url: string }>();

  document.addEventListener('admin:ready', (e) => {
    const role = (e as CustomEvent).detail?.role;
    bolehEdit = role === 'owner' || role === 'admin';
    document.querySelectorAll<HTMLButtonElement>('[data-tambah]').forEach((b) => {
      b.disabled = !bolehEdit;
      b.addEventListener('click', () => tambah(b.dataset.tambah as 'category' | 'author'));
    });
    document.getElementById('kategori')!.addEventListener('click', onAksi);
    document.getElementById('penulis')!.addEventListener('click', onAksi);
    document.getElementById('penulis')!.addEventListener('change', onAvatar);
    void muat();
  });

  function lapor(teks: string, sukses = false) {
    const p = document.getElementById('pesan')!;
    p.textContent = teks;
    p.className = sukses ? 'text-sm text-teal-700 dark:text-teal-300' : 'text-sm text-red-600 dark:text-red-400';
  }

  const field = (id: string, nama: string, label: string, isi: string, bantuan = '') => `
    <div>
      <label class="block text-sm font-medium mb-1.5" for="f-${esc(id)}-${nama}">${esc(label)}</label>
      ${isi}
      ${bantuan ? `<p class="mt-1 text-xs text-ink-500 dark:text-cream-300/60">${esc(bantuan)}</p>` : ''}
    </div>`;
  const teks = (id: string, nama: string, nilai: unknown, extra = '') =>
    `<input id="f-${esc(id)}-${nama}" data-id="${esc(id)}" data-field="${nama}" value="${esc(nilai ?? '')}" ${extra} class="${INPUT}" />`;
  const area = (id: string, nama: string, nilai: unknown, rows = 3, extra = '') =>
    `<textarea id="f-${esc(id)}-${nama}" data-id="${esc(id)}" data-field="${nama}" rows="${rows}" ${extra} class="${INPUT}">${esc(nilai ?? '')}</textarea>`;
  const tombol = (id: string, jenis: string, nama: string) => `
    <div class="flex gap-2">
      <button type="button" data-simpan="${esc(id)}" data-jenis="${jenis}" class="rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-ink-950 hover:bg-amber-400 transition-colors">Simpan</button>
      ${id.startsWith('baru-') ? '' : `<button type="button" data-hapus="${esc(id)}" data-jenis="${jenis}" data-nama="${esc(nama)}" class="rounded-lg border border-red-500/40 px-3 py-1.5 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-500/10 transition-colors">Hapus</button>`}
    </div>`;

  function kartuKategori(c: Kategori): string {
    return `
      <section class="${KARTU}" data-kartu="${esc(c.id)}">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="font-display text-base font-semibold tracking-tightest">${esc(c.title || 'Kategori baru')}</h3>
            <p class="font-mono text-xs text-ink-500 dark:text-cream-300/60">/blog/kategori/${esc(c.slug || '…')}</p>
          </div>
          ${tombol(c.id, 'category', c.title)}
        </div>
        <div class="grid gap-4 sm:grid-cols-[1fr_1fr_6rem]">
          ${field(c.id, 'title', 'Nama', teks(c.id, 'title', c.title, 'maxlength="60"'))}
          ${field(c.id, 'slug', 'Slug (URL)', teks(c.id, 'slug', c.slug, 'maxlength="60"'), 'Kosongkan = dari nama.')}
          ${field(c.id, 'sort', 'Urutan', teks(c.id, 'sort', c.sort ?? 100, 'inputmode="numeric"'))}
        </div>
        ${field(c.id, 'description', 'Deskripsi', area(c.id, 'description', c.description, 2, 'maxlength="300"'), 'Tampil di halaman kategori & jadi meta description-nya.')}
      </section>`;
  }

  function kartuPenulis(a: Penulis): string {
    const foto = avatarBaru.get(a.id)?.url ?? a.avatar?.url;
    return `
      <section class="${KARTU}" data-kartu="${esc(a.id)}">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            ${foto
              ? `<img src="${esc(foto)}?w=96&h=96&fit=crop&auto=format" alt="" class="h-12 w-12 rounded-full object-cover" />`
              : `<span class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-500/15 font-semibold text-amber-700 dark:text-amber-400">${esc((a.name || '?').slice(0, 1))}</span>`}
            <div class="min-w-0">
              <h3 class="font-display text-base font-semibold tracking-tightest">${esc(a.name || 'Penulis baru')}</h3>
              <p class="font-mono text-xs text-ink-500 dark:text-cream-300/60">/blog/penulis/${esc(a.slug || '…')}</p>
            </div>
          </div>
          ${tombol(a.id, 'author', a.name)}
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          ${field(a.id, 'name', 'Nama', teks(a.id, 'name', a.name, 'maxlength="80"'))}
          ${field(a.id, 'role', 'Peran / jabatan', teks(a.id, 'role', a.role, 'maxlength="80" placeholder="mis. Founder, Game Designer"'))}
          ${field(a.id, 'slug', 'Slug (URL)', teks(a.id, 'slug', a.slug, 'maxlength="60"'), 'Kosongkan = dari nama.')}
          ${field(a.id, 'avatar', 'Foto', `<input type="file" accept="image/*" data-avatar="${esc(a.id)}" class="block w-full text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-amber-500/15 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-amber-700 dark:file:text-amber-400" />`)}
        </div>
        ${field(a.id, 'bio', 'Bio singkat', area(a.id, 'bio', a.bio, 3, 'maxlength="800"'))}
        ${field(a.id, 'links', 'Tautan profil', area(a.id, 'links', (a.links ?? []).join('\n'), 2, 'placeholder="https://www.linkedin.com/in/…"'))}
      </section>`;
  }

  let dataKategori: Kategori[] = [];
  let dataPenulis: Penulis[] = [];

  async function muat() {
    const k = document.getElementById('kategori')!;
    const p = document.getElementById('penulis')!;
    k.innerHTML = p.innerHTML = stateBlock('loading', '');
    const r = await blogCall<{ categories: Kategori[]; authors: Penulis[] }>('list');
    if (!r.ok) { k.innerHTML = p.innerHTML = stateBlock('error', r.error.message); return; }
    dataKategori = r.data.categories;
    dataPenulis = r.data.authors;
    avatarBaru.clear();
    gambar();
  }

  function gambar() {
    const k = document.getElementById('kategori')!;
    const p = document.getElementById('penulis')!;
    k.innerHTML = dataKategori.length ? dataKategori.map(kartuKategori).join('') : stateBlock('empty', 'Belum ada kategori.');
    p.innerHTML = dataPenulis.length ? dataPenulis.map(kartuPenulis).join('') : stateBlock('empty', 'Belum ada penulis. Tambahkan minimal satu sebelum menerbitkan artikel.');
    if (!bolehEdit) {
      document.querySelectorAll<HTMLInputElement>('#kategori input, #kategori textarea, #kategori button, #penulis input, #penulis textarea, #penulis button')
        .forEach((n) => (n.disabled = true));
      lapor('Peran kamu hanya bisa melihat.');
    }
  }

  function tambah(jenis: 'category' | 'author') {
    const id = `baru-${Date.now()}`;
    if (jenis === 'category') dataKategori.unshift({ id, title: '', slug: '', description: '', sort: 100 });
    else dataPenulis.unshift({ id, name: '', slug: '', role: '', bio: '', links: [], avatar: null });
    gambar();
    document.querySelector<HTMLInputElement>(`[data-id="${CSS.escape(id)}"]`)?.focus();
  }

  function nilai(id: string): Record<string, string> {
    const out: Record<string, string> = {};
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[data-id="${CSS.escape(id)}"][data-field]`)
      .forEach((n) => (out[n.dataset.field!] = n.value.trim()));
    return out;
  }

  async function onAvatar(e: Event) {
    const input = e.target as HTMLInputElement;
    const id = input.dataset.avatar;
    if (!id || !input.files?.[0]) return;
    lapor('Mengunggah foto…', true);
    const r = await uploadImage(input.files[0]);
    if (!r.ok) { lapor(r.error.message); return; }
    avatarBaru.set(id, { assetId: r.data.assetId, url: r.data.url });
    lapor('Foto terunggah. Klik Simpan pada kartu penulis untuk memakainya.', true);
  }

  async function onAksi(e: Event) {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-simpan], button[data-hapus]');
    if (!b || !bolehEdit) return;
    const jenis = b.dataset.jenis as 'category' | 'author';
    const label = jenis === 'category' ? 'Kategori' : 'Penulis';

    if (b.dataset.hapus) {
      if (!window.confirm(`Hapus ${label.toLowerCase()} "${b.dataset.nama}"?`)) return;
      b.disabled = true;
      const r = await blogCall(jenis === 'category' ? 'deleteCategory' : 'deleteAuthor', { id: b.dataset.hapus });
      b.disabled = false;
      if (!r.ok) {
        lapor(r.error.code === 'IN_USE' ? `${label} ini masih dipakai artikel (termasuk draft). Ganti dulu di artikel tersebut.` : r.error.message);
        return;
      }
      lapor(`${label} dihapus.`, true);
      void muat();
      return;
    }

    const id = b.dataset.simpan!;
    const v = nilai(id);
    let data: Record<string, unknown>;
    if (jenis === 'category') {
      data = { title: v.title, slug: v.slug, description: v.description, sort: v.sort };
    } else {
      const lama = dataPenulis.find((a) => a.id === id)?.avatar;
      const foto = avatarBaru.get(id) ?? lama;
      data = {
        name: v.name,
        slug: v.slug,
        role: v.role,
        bio: v.bio,
        links: (v.links ?? '').split('\n').map((s) => s.trim()).filter(Boolean),
        avatar: foto ? { assetId: foto.assetId, alt: v.name } : null,
      };
    }
    b.disabled = true;
    const r = await blogCall<{ rebuild: string }>(jenis === 'category' ? 'saveCategory' : 'saveAuthor', {
      id: id.startsWith('baru-') ? null : id,
      data,
    });
    b.disabled = false;
    if (!r.ok) {
      lapor(r.error.code === 'SLUG_TAKEN' ? `Slug itu sudah dipakai ${label.toLowerCase()} lain.` : r.error.message);
      return;
    }
    lapor(`${label} tersimpan.${r.data.rebuild === 'sent' ? ' Situs sedang dibangun ulang.' : ''}`, true);
    void muat();
  }
</script>
