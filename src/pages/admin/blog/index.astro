---
// Admin — Semua Artikel Blog.
//
// Semua artikel (draft, terbit, ada perubahan, terjadwal) dibaca dari Sanity
// lewat Edge Function `blog-admin`. Menulis & mengedit ada di /admin/blog/tulis.
// Lihat docs/BLOG.md.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Blog" active="blog">
  <AdminPageHeader
    eyebrow="Blog"
    title="Semua artikel"
    description="Tulis, edit, dan terbitkan artikel blog vanillate.id/blog. Artikel disimpan di Sanity; situs dibangun ulang otomatis setelah artikel terbit."
  >
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="/admin/blog/tulis" id="btn-tulis"
        class="rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-amber-400 transition-colors">
        + Tulis artikel
      </a>
      <button type="button" id="btn-rebuild"
        class="rounded-xl border border-ink-900/15 dark:border-cream-100/15 px-4 py-2 text-sm font-medium hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors">
        Bangun ulang situs sekarang
      </button>
      <a href="/blog" target="_blank" rel="noopener"
        class="rounded-xl px-4 py-2 text-sm font-medium text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors">
        Buka blog ↗
      </a>
    </div>
  </AdminPageHeader>

  <div class="px-6 lg:px-10 py-8 space-y-6 max-w-5xl">
    <div id="blog-info" class="hidden rounded-2xl border px-5 py-4 text-sm leading-relaxed"></div>

    <div class="flex flex-wrap items-center gap-3">
      <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Saring status" id="filter">
        <button type="button" data-filter="semua">Semua</button>
        <button type="button" data-filter="published">Terbit</button>
        <button type="button" data-filter="draft">Draft</button>
        <button type="button" data-filter="changed">Ada perubahan</button>
        <button type="button" data-filter="scheduled">Terjadwal</button>
      </div>
      <input id="cari" type="search" placeholder="Cari judul atau slug…"
        class="ml-auto w-full sm:w-64 rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2 text-sm outline-none focus:border-amber-500 transition-colors" />
    </div>

    <div id="daftar" class="space-y-3"></div>
    <p id="pesan" class="text-sm" role="status" aria-live="polite"></p>
  </div>
</AdminLayout>

<script>
  import { blogCall } from '@/lib/blog/admin-client';
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { fmtWaktu } from '@/lib/admin-auth';

  type Item = {
    id: string;
    title: string;
    slug: string;
    status: 'draft' | 'published' | 'changed' | 'scheduled';
    publishedAt: string | null;
    editedAt: string | null;
    hasPublished: boolean;
    publishedSlug: string | null;
    imageUrl: string | null;
    categoryIds: string[];
  };

  const STATUS: Record<Item['status'], { label: string; cls: string }> = {
    published: { label: 'Terbit', cls: 'bg-teal-500/15 text-teal-700 dark:text-teal-300' },
    draft: { label: 'Draft', cls: 'bg-ink-500/15 text-ink-600 dark:text-cream-300/70' },
    changed: { label: 'Terbit · ada perubahan', cls: 'bg-amber-500/15 text-amber-700 dark:text-amber-400' },
    scheduled: { label: 'Terjadwal', cls: 'bg-teal-500/10 text-teal-700 dark:text-teal-300' },
  };

  let semua: Item[] = [];
  let kategori = new Map<string, string>();
  let filter = 'semua';
  let bolehEdit = false;

  document.addEventListener('admin:ready', (e) => {
    const role = (e as CustomEvent).detail?.role;
    bolehEdit = role === 'owner' || role === 'admin';
    if (!bolehEdit) {
      document.getElementById('btn-tulis')!.classList.add('hidden');
      document.getElementById('btn-rebuild')!.classList.add('hidden');
    }
    pilihFilter('semua');
    document.getElementById('filter')!.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (b) pilihFilter(b.dataset.filter!);
    });
    document.getElementById('cari')!.addEventListener('input', render);
    document.getElementById('daftar')!.addEventListener('click', onAksi);
    document.getElementById('btn-rebuild')!.addEventListener('click', onRebuild);
    void muat();
  });

  function lapor(teks: string, sukses = false) {
    const p = document.getElementById('pesan')!;
    p.textContent = teks;
    p.className = sukses ? 'text-sm text-teal-700 dark:text-teal-300' : 'text-sm text-red-600 dark:text-red-400';
  }

  const FILTER_DASAR = 'rounded-full border px-3.5 py-1.5 text-sm transition-colors';
  const FILTER_AKTIF = 'border-amber-500 bg-amber-500/15 font-medium text-amber-700 dark:text-amber-400';
  const FILTER_DIAM = 'border-ink-900/10 dark:border-cream-100/10 text-ink-600 dark:text-cream-200/70 hover:border-amber-500/50';

  function pilihFilter(f: string) {
    filter = f;
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
      const aktif = b.dataset.filter === f;
      b.setAttribute('aria-selected', String(aktif));
      b.className = `${FILTER_DASAR} ${aktif ? FILTER_AKTIF : FILTER_DIAM}`;
    });
    render();
  }

  async function muat() {
    const daftar = document.getElementById('daftar')!;
    daftar.innerHTML = stateBlock('loading', '');
    const r = await blogCall<{ posts: Item[]; categories: { id: string; title: string }[]; authors: unknown[]; rebuild: 'auto' | 'cron' }>('list');
    if (!r.ok) { daftar.innerHTML = stateBlock('error', r.error.message); return; }
    semua = r.data.posts;
    kategori = new Map(r.data.categories.map((c) => [c.id, c.title]));

    const info = document.getElementById('blog-info')!;
    info.classList.remove('hidden');
    if (r.data.rebuild === 'auto') {
      info.className = 'rounded-2xl border border-teal-500/30 bg-teal-500/5 px-5 py-4 text-sm leading-relaxed';
      info.textContent = 'Terbit otomatis aktif: setelah klik Publish, situs dibangun ulang dan artikel tayang ±2–5 menit kemudian.';
    } else {
      info.className = 'rounded-2xl border border-amber-500/30 bg-amber-500/5 px-5 py-4 text-sm leading-relaxed';
      info.textContent = 'Terbit otomatis belum aktif (secret GITHUB_DISPATCH_TOKEN belum diisi). Artikel tetap tersimpan dan akan tayang lewat pemeriksaan berkala tiap jam. Lihat docs/BLOG.md untuk mengaktifkannya.';
    }
    if (r.data.authors.length === 0 && bolehEdit) {
      info.textContent += ' Belum ada penulis — buat dulu di Kategori & Penulis sebelum menerbitkan artikel.';
    }
    render();
  }

  function render() {
    const daftar = document.getElementById('daftar')!;
    const q = (document.getElementById('cari') as HTMLInputElement).value.trim().toLowerCase();
    const rows = semua.filter((p) =>
      (filter === 'semua' || p.status === filter) &&
      (!q || p.title.toLowerCase().includes(q) || p.slug.includes(q)));

    if (semua.length === 0) {
      daftar.innerHTML = stateBlock('empty', 'Belum ada artikel. Klik "Tulis artikel" untuk memulai.');
      return;
    }
    if (rows.length === 0) { daftar.innerHTML = stateBlock('empty', 'Tidak ada artikel yang cocok.'); return; }

    daftar.innerHTML = rows.map((p) => {
      const s = STATUS[p.status];
      const kat = p.categoryIds.map((c) => kategori.get(c)).filter(Boolean).join(', ');
      const thumb = p.imageUrl
        ? `<img src="${esc(p.imageUrl)}?w=160&h=96&fit=crop&auto=format" alt="" class="h-16 w-28 flex-none rounded-lg object-cover bg-ink-900/5" loading="lazy" />`
        : `<div class="h-16 w-28 flex-none rounded-lg bg-gradient-to-br from-amber-500/20 to-teal-500/10"></div>`;
      const lihat = p.hasPublished && p.publishedSlug
        ? `<a href="/blog/${esc(p.publishedSlug)}" target="_blank" rel="noopener" class="rounded-lg px-3 py-1.5 text-xs font-medium hover:bg-ink-900/5 dark:hover:bg-cream-100/5">Lihat ↗</a>`
        : '';
      const hapus = bolehEdit
        ? `<button type="button" data-hapus="${esc(p.id)}" data-judul="${esc(p.title)}" data-terbit="${p.hasPublished ? '1' : ''}" class="rounded-lg px-3 py-1.5 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-500/10">Hapus</button>`
        : '';
      return `
        <article class="flex flex-col sm:flex-row sm:items-center gap-4 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-4">
          ${thumb}
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <span class="rounded-full px-2.5 py-0.5 text-[0.7rem] font-semibold ${s.cls}">${esc(s.label)}</span>
              ${kat ? `<span class="text-xs text-ink-500 dark:text-cream-300/60">${esc(kat)}</span>` : ''}
            </div>
            <a href="/admin/blog/tulis?id=${encodeURIComponent(p.id)}" class="font-display text-base font-semibold tracking-tightest hover:text-amber-600 dark:hover:text-amber-400 transition-colors">${esc(p.title)}</a>
            <p class="font-mono text-xs text-ink-500 dark:text-cream-300/60 truncate">/blog/${esc(p.slug || '—')}
              · ${p.publishedAt ? `terbit ${esc(fmtWaktu(p.publishedAt))}` : 'belum terbit'}
              · diedit ${esc(fmtWaktu(p.editedAt))}</p>
          </div>
          <div class="flex items-center gap-1">
            <a href="/admin/blog/tulis?id=${encodeURIComponent(p.id)}" class="rounded-lg bg-amber-500/15 px-3 py-1.5 text-xs font-semibold text-amber-700 dark:text-amber-400 hover:bg-amber-500/25">${bolehEdit ? 'Edit' : 'Buka'}</a>
            ${lihat}
            ${hapus}
          </div>
        </article>`;
    }).join('');
  }

  async function onAksi(e: Event) {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-hapus]');
    if (!b || !bolehEdit) return;
    const peringatan = b.dataset.terbit
      ? `Hapus "${b.dataset.judul}"? Artikel ini sedang tayang — alamatnya akan jadi 404 setelah situs dibangun ulang. Kalau hanya ingin menyembunyikan, pakai "Tarik dari situs" di editor.`
      : `Hapus draft "${b.dataset.judul}"?`;
    if (!window.confirm(peringatan)) return;
    b.disabled = true;
    const r = await blogCall('delete', { id: b.dataset.hapus });
    if (!r.ok) { lapor(r.error.message); b.disabled = false; return; }
    lapor('Artikel dihapus.', true);
    void muat();
  }

  async function onRebuild(e: Event) {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    const r = await blogCall<{ rebuild: string }>('rebuild');
    b.disabled = false;
    if (!r.ok) { lapor(r.error.message); return; }
    if (r.data.rebuild === 'sent') lapor('Build situs dipicu. Perubahan tayang ±2–5 menit lagi.', true);
    else if (r.data.rebuild === 'skipped') lapor('Terbit otomatis belum aktif (GITHUB_DISPATCH_TOKEN kosong). Jalankan workflow "Deploy to GitHub Pages" di tab Actions.');
    else lapor('Gagal memicu build. Periksa GITHUB_DISPATCH_TOKEN (lihat docs/BLOG.md).');
  }
</script>
