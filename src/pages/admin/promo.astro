---
// Manajemen promo (pengganti /developer › 🎟️ Promo Manager).
//
// Bot mengirim daftar promo ke tabel `bot_promos` (via websiteSync). Halaman ini
// menampilkan daftar, analitik klaim per kode (promo.analytics), nyalakan/
// matikan cepat (promo.enable / promo.disable), serta form buat & ubah promo
// (promo.create / promo.edit — registry yang sama dengan halaman Operasi).
// Bot memvalidasi ulang setiap payload (src/cms/handlers/promo.js).
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Promo" active="promo">
  <AdminPageHeader
    eyebrow="Pemasaran"
    title="Promo"
    description="Kode promo bot beserta status, jumlah klaim, dan analitiknya. Buat atau ubah promo langsung di sini."
  />

  <div class="px-6 lg:px-10 py-8 space-y-10">
    <section class="space-y-4">
      <div class="flex items-center justify-between gap-3">
        <p id="promo-info" class="text-sm text-ink-500 dark:text-cream-300/60"></p>
        <button type="button" id="promo-refresh" class="rounded-lg border border-ink-900/10 dark:border-cream-100/10 px-3 py-1.5 text-xs font-medium hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors">Muat ulang</button>
      </div>
      <div id="promo-body" class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 overflow-hidden"></div>
      <div id="promo-analitik"></div>
    </section>

    <div id="promo-form"></div>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import { fmtAngka, fmtWaktu } from '@/lib/admin-auth';
  import { GRUP } from '@/lib/dev-panel/actions';
  import { kirimPerintah } from '@/lib/dev-panel/client';
  import { toEpoch } from '@/lib/dev-panel/model';
  import { KELAS, fmtJam, formCard, notice, pasangAksi, section, stat, table } from '@/lib/dev-panel/ui';

  let bolehEdit = false;

  const WARNA_STATUS: Record<string, string> = {
    active:    'bg-teal-500/15 text-teal-700 dark:text-teal-300',
    expired:   'bg-red-500/15 text-red-600 dark:text-red-400',
    scheduled: 'bg-amber-500/15 text-amber-700 dark:text-amber-400',
    disabled:  'bg-ink-500/15 text-ink-500 dark:text-cream-300/60',
    limit_reached: 'bg-red-500/15 text-red-600 dark:text-red-400',
  };

  document.addEventListener('admin:ready', (e) => {
    const profile = (e as CustomEvent).detail;
    bolehEdit = profile?.role === 'owner' || profile?.role === 'admin';
    void muat();
    setInterval(() => void muat(), 30_000);
    document.getElementById('promo-refresh')?.addEventListener('click', () => void muat());
    document.getElementById('promo-body')?.addEventListener('click', onAksi);
    renderForm();
  });

  async function muat() {
    const body = document.getElementById('promo-body')!;
    const supabase = getSupabase();
    if (!supabase) return;

    const { data, error } = await supabase
      .from('bot_promos')
      .select('code, title, reward, status, claimed_count, max_claims, expired_at, created_at')
      .order('created_at', { ascending: false, nullsFirst: false })
      .limit(200);

    if (error) { body.innerHTML = stateBlock('error', pesanError(error)); return; }
    if (!data || data.length === 0) {
      body.innerHTML = stateBlock('empty', bolehEdit ? 'Belum ada promo. Buat lewat form di bawah.' : 'Belum ada promo.');
      document.getElementById('promo-info')!.textContent = '';
      return;
    }

    document.getElementById('promo-info')!.textContent = `${fmtAngka(data.length)} promo`;
    const tombolKecil = 'rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors disabled:opacity-60';
    const rows = data.map((p: any) => {
      const status = String(p.status ?? '—');
      const badge = WARNA_STATUS[status] ?? WARNA_STATUS.disabled;
      const klaim = `${fmtAngka(p.claimed_count)} / ${p.max_claims ? fmtAngka(p.max_claims) : '∞'}`;
      const nonaktif = status === 'disabled';
      return `
        <tr class="border-t border-ink-900/5 dark:border-cream-100/5">
          <td class="px-5 py-3"><code class="text-xs font-mono font-semibold">${esc(p.code)}</code></td>
          <td class="px-5 py-3 text-sm">${esc(p.title ?? '—')}</td>
          <td class="px-5 py-3 text-sm whitespace-pre-line">${esc(p.reward ?? '—')}</td>
          <td class="px-5 py-3"><span class="inline-block rounded-full px-2.5 py-0.5 text-[0.7rem] ${badge}">${esc(status)}</span></td>
          <td class="px-5 py-3 whitespace-nowrap tabular-nums">${esc(klaim)}</td>
          <td class="px-5 py-3 text-xs text-ink-500 dark:text-cream-300/60 whitespace-nowrap">${esc(p.expired_at ? fmtWaktu(p.expired_at) : 'Tanpa batas')}</td>
          <td class="px-5 py-3 text-right whitespace-nowrap space-x-1">
            ${bolehEdit
              ? `<button type="button" data-analitik="${esc(p.code)}" class="${KELAS.tombolNetral}">Analitik</button>
                 <button type="button" data-edit="${esc(p.code)}" class="${KELAS.tombolNetral}">Ubah</button>
                 ${nonaktif
                  ? `<button type="button" data-enable="${esc(p.code)}" class="${tombolKecil} bg-teal-500 text-ink-950 hover:bg-teal-400">Nyalakan</button>`
                  : `<button type="button" data-disable="${esc(p.code)}" class="${tombolKecil} border border-red-500/40 text-red-600 dark:text-red-400 hover:bg-red-500/10">Matikan</button>`}`
              : '<span class="text-xs text-ink-400 dark:text-cream-300/40">—</span>'}
          </td>
        </tr>`;
    }).join('');

    body.innerHTML = `
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="bg-ink-900/5 dark:bg-cream-100/5">
            <tr class="text-[0.7rem] uppercase tracking-wider text-ink-400 dark:text-cream-300/40">
              <th class="px-5 py-3 font-medium">Kode</th>
              <th class="px-5 py-3 font-medium">Judul</th>
              <th class="px-5 py-3 font-medium">Reward</th>
              <th class="px-5 py-3 font-medium">Status</th>
              <th class="px-5 py-3 font-medium">Klaim</th>
              <th class="px-5 py-3 font-medium">Kedaluwarsa</th>
              <th class="px-5 py-3 font-medium text-right">Aksi</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>`;
  }

  async function onAksi(e: Event) {
    const t = e.target as HTMLElement;
    const analitik = t.closest<HTMLButtonElement>('button[data-analitik]');
    if (analitik) { void tampilAnalitik(analitik.dataset.analitik!, analitik); return; }
    const edit = t.closest<HTMLButtonElement>('button[data-edit]');
    if (edit) { isiFormUbah(edit.dataset.edit!); return; }

    const el = t.closest('button[data-enable], button[data-disable]') as HTMLButtonElement | null;
    if (!el) return;
    const enable = el.hasAttribute('data-enable');
    const code = (enable ? el.dataset.enable : el.dataset.disable)!;
    if (!enable && !window.confirm(`Matikan promo "${code}"? Pemain tidak bisa klaim lagi.`)) return;

    el.disabled = true;
    el.textContent = 'Memproses…';
    const o = await kirimPerintah(enable ? 'promo.enable' : 'promo.disable', { code });
    if (!o.ok && !o.timedOut) {
      el.disabled = false;
      el.textContent = enable ? 'Nyalakan' : 'Matikan';
      alert(o.error ?? 'Gagal.');
      return;
    }
    el.textContent = o.timedOut ? 'Antre…' : 'Selesai';
    // Bot menyinkronkan ulang bot_promos setelah perubahan.
    setTimeout(() => void muat(), 2500);
  }

  async function tampilAnalitik(code: string, tombol: HTMLButtonElement) {
    const el = document.getElementById('promo-analitik')!;
    tombol.disabled = true;
    el.innerHTML = notice('info', `Memuat analitik ${code}…`);
    const o = await kirimPerintah('promo.analytics', { code });
    tombol.disabled = false;
    if (!o.ok) { el.innerHTML = notice(o.timedOut ? 'warn' : 'error', o.error ?? 'Gagal memuat analitik.'); return; }
    const a = o.result;
    el.innerHTML = section(`Analitik ${a.code}`, `
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        ${stat('Status', a.status)}
        ${stat('Klaim', fmtAngka(a.claimed), a.maxClaims ? `dari ${fmtAngka(a.maxClaims)} (${a.claimRate}%)` : 'tanpa batas')}
        ${stat('Sisa kuota', a.remaining === null || a.remaining === undefined ? '∞' : fmtAngka(a.remaining))}
        ${stat('Kedaluwarsa', a.expiredAt ? fmtJam(toEpoch(a.expiredAt)) : 'Tanpa batas')}
      </div>
      <div class="${KELAS.kartu}">
        <p class="text-xs ${KELAS.muted}">Reward</p>
        <p class="mt-1 text-sm whitespace-pre-line">${esc(a.reward)}</p>
      </div>
      ${table(['Pemain', 'Waktu klaim'], (a.recentClaims ?? []).map((c: any) => [
        esc(c.username ?? 'Unknown'),
        `<span class="text-xs">${esc(fmtJam(toEpoch(c.claimed_at)))}</span>`,
      ]), 'Belum ada yang mengklaim.')}`, `${a.title ?? ''} — 5 klaim terakhir ditampilkan.`);
    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ─── Buat & ubah promo ────────────────────────────────────────────────────
  const aksiPromo = () => GRUP.find((g) => g.key === 'promo')!.aksi.filter((a) => a.type === 'promo.create' || a.type === 'promo.edit');
  const idForm = (type: string) => `pr-${type.replace(/\./g, '-')}`;

  function renderForm() {
    if (!bolehEdit) return;
    const el = document.getElementById('promo-form')!;
    el.innerHTML = section('Buat & ubah promo', `<div class="grid gap-4 lg:grid-cols-2">
      ${aksiPromo().map((a) => formCard({ id: idForm(a.type), title: a.label, fields: a.fields, desc: a.help, submit: a.type === 'promo.create' ? 'Buat promo' : 'Simpan perubahan' })).join('')}
    </div>`, 'Reward ditulis "kunci:jumlah" dipisah koma, mis. coin:300, exp:75, hint:1.');
    for (const a of aksiPromo()) {
      pasangAksi(document.getElementById(idForm(a.type)) as HTMLFormElement, {
        type: a.type,
        success: (o) => String(o.result?.message ?? 'Selesai.').replace(/\*\*/g, ''),
        resetOnSuccess: true,
        onDone: (o) => { if (o.ok) setTimeout(() => void muat(), 2500); },
      });
    }
  }

  function isiFormUbah(code: string) {
    const form = document.getElementById(idForm('promo.edit')) as HTMLFormElement | null;
    if (!form) return;
    (form.elements.namedItem('code') as HTMLInputElement).value = code;
    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    (form.elements.namedItem('title') as HTMLInputElement | null)?.focus();
  }
</script>
