---
// Admin — Katalog Produk (umbrella studio).
//
// CRUD produk Vanillate Studio + unggah media (foto/video/ikon) ke Supabase
// Storage. Data tersimpan ke tabel products / product_media, lalu ditarik saat
// build (scripts/sync-content.mjs) ke halaman publik /products. Gambar tinggal
// di Storage (bucket publik).
//
// Aplikasi web (mis. yang di-deploy ke Netlify/Vercel) cukup diisi tautannya —
// tidak ada berkas aplikasi yang diunggah, jadi hemat kuota Storage.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Produk" active="produk">
  <AdminPageHeader
    eyebrow="Katalog"
    title="Produk"
    description="Kelola semua produk Vanillate Studio: Discord bot, aplikasi web (cukup tempel tautannya), dan lainnya. Perubahan tampil di /products setelah build berikutnya."
  />

  <div id="produk-root" class="px-6 lg:px-10 py-8 max-w-4xl">
    <div id="list-view"></div>
    <div id="editor-view" class="hidden"></div>
    <p id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 hidden rounded-xl px-4 py-2.5 text-sm font-medium shadow-lg z-50" role="status" aria-live="polite"></p>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import { icons } from '@data/icons';

  const INPUT = 'w-full rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2.5 text-sm outline-none focus:border-amber-500 transition-colors';
  const BTN = 'rounded-xl bg-amber-500 px-5 py-2.5 text-sm font-semibold text-ink-950 hover:bg-amber-400 disabled:opacity-60 disabled:cursor-not-allowed transition-colors';
  const BTN2 = 'rounded-xl border border-ink-900/15 dark:border-cream-100/15 px-4 py-2 text-sm font-medium hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors';
  const CHK = 'h-4 w-4 rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500';

  const MEDIA_BUCKET = 'product-media';

  const PLATFORMS = [['discord', 'Discord bot'], ['web', 'Aplikasi web (tautan)']];
  const STATUSES = [['live', 'Live'], ['beta', 'Beta'], ['preorder', 'Preorder'], ['coming-soon', 'Coming soon']];
  const TONES = [
    ['accent', 'Aksen produk'], ['info', 'Info (biru)'], ['success', 'Sukses (hijau)'],
    ['warn', 'Peringatan (kuning)'], ['neutral', 'Netral (abu)'],
  ];
  // Pilihan ikon fallback diambil dari registry situs, jadi daftarnya ikut
  // bertambah otomatis saat registry diperbarui. Butuh ikon di luar daftar?
  // Unggah logo sendiri sebagai thumbnail — tanpa mengubah source code.
  const ICON_OPTIONS: string[][] = [['', '— tanpa ikon —'], ...Object.keys(icons).map((k) => [k, k])];

  let bolehEdit = false;
  let uid: string | null = null;
  let current: any = null; // produk yang sedang diedit (null di tampilan daftar)
  // Kategori FAQ untuk dropdown "Panduan produk". Sejak dokumentasi per produk
  // dihapus, inilah yang menentukan ke mana tombol "Lihat Panduan" mengarah.
  let kategoriFaq: { id: string; name: string; enabled: boolean }[] = [];

  const $ = (id: string) => document.getElementById(id)!;
  const listView = () => $('list-view');
  const editorView = () => $('editor-view');

  document.addEventListener('admin:ready', (e) => {
    const profile = (e as CustomEvent).detail;
    bolehEdit = profile?.role === 'owner' || profile?.role === 'admin';
    void muatDaftar();
    // Delegasi aksi tombol + perubahan input.
    $('produk-root').addEventListener('click', onClick);
    $('produk-root').addEventListener('change', onChange);
  });

  // ─── Util ──────────────────────────────────────────────────────────────────
  function toast(pesan: string, ok = true) {
    const t = $('toast');
    t.textContent = pesan;
    t.className = `fixed bottom-5 left-1/2 -translate-x-1/2 rounded-xl px-4 py-2.5 text-sm font-medium shadow-lg z-50 ${
      ok ? 'bg-teal-600 text-white' : 'bg-red-600 text-white'
    }`;
    window.clearTimeout((toast as any)._t);
    (toast as any)._t = window.setTimeout(() => t.classList.add('hidden'), 4000);
  }
  const safeName = (s: string) => s.replace(/[^a-zA-Z0-9._-]/g, '-').replace(/-+/g, '-');
  const publicUrl = (bucket: string, path: string) =>
    getSupabase()!.storage.from(bucket).getPublicUrl(path).data.publicUrl;

  // ─── Daftar produk ───────────────────────────────────────────────────────────
  async function muatDaftar() {
    current = null;
    editorView().classList.add('hidden');
    const box = listView();
    box.classList.remove('hidden');
    box.innerHTML = stateBlock('loading', '');

    const supabase = getSupabase();
    if (!supabase) { box.innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.'); return; }

    const { data, error } = await supabase.from('products')
      .select('id, slug, name, platform, status, enabled, featured, sort, accent_color')
      .order('sort', { ascending: true });
    if (error) { box.innerHTML = stateBlock('error', pesanError(error)); return; }

    // Kategori FAQ ditarik terpisah dan boleh gagal: pada database yang belum
    // menjalankan schema FAQ, katalog produk tetap bisa dikelola.
    const kat = await supabase.from('faq_categories').select('id, name, enabled').order('sort', { ascending: true });
    kategoriFaq = kat.error ? [] : ((kat.data ?? []) as any[]);

    const rows = data ?? [];
    const kartu = (p: any) => {
      const dot = p.accent_color ? `background:${esc(p.accent_color)}` : 'background:#E8B84A';
      const platform = (PLATFORMS.find((x) => x[0] === p.platform)?.[1]) ?? p.platform;
      return `
        <div class="flex flex-wrap items-center gap-4 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-4">
          <span class="h-9 w-9 flex-none rounded-lg" style="${dot}" aria-hidden="true"></span>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <p class="font-display font-semibold tracking-tightest truncate">${esc(p.name)}</p>
              ${p.featured ? '<span class="rounded-full bg-amber-500/15 text-amber-700 dark:text-amber-400 px-2 py-0.5 text-[0.65rem] font-mono uppercase tracking-wider">unggulan</span>' : ''}
              ${!p.enabled ? '<span class="rounded-full bg-ink-500/15 text-ink-500 dark:text-cream-300/60 px-2 py-0.5 text-[0.65rem] font-mono uppercase tracking-wider">tersembunyi</span>' : ''}
            </div>
            <p class="font-mono text-xs text-ink-500 dark:text-cream-300/60 truncate">/${esc(p.slug)} · ${esc(platform)} · ${esc(p.status)}</p>
          </div>
          <button type="button" class="${BTN2}" data-action="edit" data-slug="${esc(p.slug)}">Edit</button>
        </div>`;
    };

    box.innerHTML = `
      <div class="mb-6 flex items-center justify-between gap-3">
        <p class="text-sm text-ink-600 dark:text-cream-200/80">${rows.length} produk. Perubahan tampil di <strong>/products</strong> setelah build berikutnya.</p>
        ${bolehEdit ? `<button type="button" class="${BTN}" data-action="tambah">+ Tambah produk</button>` : ''}
      </div>
      <div class="space-y-3">
        ${rows.length ? rows.map(kartu).join('') : stateBlock('empty', 'Belum ada produk.')}
      </div>`;
  }

  // ─── Editor ──────────────────────────────────────────────────────────────────
  async function bukaEditor(slug: string | null) {
    const supabase = getSupabase();
    if (!supabase) return;

    if (slug) {
      const { data, error } = await supabase.from('products').select('*').eq('slug', slug).maybeSingle();
      if (error || !data) { toast(pesanError(error), false); return; }
      current = data;
    } else {
      current = {
        id: null, slug: '', name: '', short_name: '', tagline: '', description: '',
        platform: 'discord', status: 'live', category: '', accent_color: '#E8B84A', icon: '',
        featured: false, verified: false, enabled: true, sort: 100,
        features: [], long_intro: [], faq: [],
        badge: '', badge_tone: 'accent', thumbnail_url: '',
        discord_client_id: '', discord_permissions: '', discord_integration_type: '', invite_url: '',
        cta_label: '', cta_url: '', cta_heading: '', cta_text: '', cta_note: '',
        faq_category_id: '', seo_title: '', seo_description: '',
      };
    }
    listView().classList.add('hidden');
    editorView().classList.remove('hidden');
    renderEditor();
    if (current.id) void muatMedia();
    window.scrollTo({ top: 0 });
  }

  function field(id: string, label: string, inner: string, hint = '') {
    return `<div>
      <label class="block text-sm font-medium mb-1.5" for="${id}">${esc(label)}</label>
      ${inner}
      ${hint ? `<p class="mt-1 text-xs text-ink-500 dark:text-cream-300/60">${esc(hint)}</p>` : ''}
    </div>`;
  }
  const inp = (id: string, val: any, extra = '') => `<input id="${id}" value="${esc(val ?? '')}" ${extra} class="${INPUT}" />`;
  const ta = (id: string, val: any, rows = 3, extra = '') => `<textarea id="${id}" rows="${rows}" ${extra} class="${INPUT}">${esc(val ?? '')}</textarea>`;
  const sel = (id: string, val: any, opts: string[][]) =>
    `<select id="${id}" class="${INPUT}">${opts.map(([v, l]) => `<option value="${esc(v)}" ${val === v ? 'selected' : ''}>${esc(l)}</option>`).join('')}</select>`;

  function renderEditor() {
    const p = current;
    const nuevo = !p.id;
    const disabled = !bolehEdit;
    editorView().innerHTML = `
      <div class="mb-6 flex items-center justify-between gap-3">
        <button type="button" class="${BTN2}" data-action="kembali">← Daftar produk</button>
        ${!nuevo && bolehEdit ? `<button type="button" class="rounded-xl border border-red-500/30 text-red-600 dark:text-red-400 px-4 py-2 text-sm font-medium hover:bg-red-500/10 transition-colors" data-action="hapus-produk">Hapus produk</button>` : ''}
      </div>

      <h2 class="font-display text-2xl font-semibold tracking-tightest mb-6">${nuevo ? 'Tambah produk' : esc(p.name)}</h2>

      <div class="space-y-5 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
        <div class="grid gap-4 sm:grid-cols-2">
          ${field('f-name', 'Nama produk', inp('f-name', p.name, 'maxlength="80"'))}
          ${field('f-slug', 'Slug (URL)', inp('f-slug', p.slug, `maxlength="60" ${nuevo ? 'placeholder="mis. nama-app"' : 'readonly'}`), nuevo ? 'Huruf kecil, tanpa spasi. Tak bisa diubah setelah dibuat.' : 'URL: /products/' + esc(p.slug))}
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          ${field('f-platform', 'Platform', sel('f-platform', p.platform, PLATFORMS))}
          ${field('f-status', 'Status', sel('f-status', p.status, STATUSES))}
          ${field('f-category', 'Kategori', inp('f-category', p.category, 'maxlength="40" placeholder="mis. Word Game"'))}
        </div>
        ${field('f-tagline', 'Tagline', inp('f-tagline', p.tagline, 'maxlength="140"'), 'Satu baris di bawah nama.')}
        ${field('f-description', 'Deskripsi', ta('f-description', p.description, 4, 'maxlength="800"'))}
        <div class="grid gap-4 sm:grid-cols-3">
          ${field('f-accent_color', 'Warna aksen', inp('f-accent_color', p.accent_color, 'maxlength="9" placeholder="#E8B84A"'))}
          ${field('f-icon', 'Ikon fallback', sel('f-icon', p.icon || '', ICON_OPTIONS), 'Dipakai bila produk tanpa gambar. Butuh ikon lain? Unggah logo sendiri di bagian Logo/Thumbnail.')}
          ${field('f-sort', 'Urutan', inp('f-sort', p.sort ?? 100, 'inputmode="numeric"'), 'Kecil = atas.')}
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          ${field('f-badge', 'Badge / label', inp('f-badge', p.badge, 'maxlength="24" placeholder="mis. Terpopuler"'), 'Kosongkan bila tidak perlu — elemen badge tidak akan dirender sama sekali.')}
          ${field('f-badge_tone', 'Warna badge', sel('f-badge_tone', p.badge_tone || 'accent', TONES))}
        </div>
        <div class="flex flex-wrap gap-6">
          <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" id="f-featured" ${p.featured ? 'checked' : ''} class="${CHK}" /> Unggulan (disorot di beranda)</label>
          <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" id="f-verified" ${p.verified ? 'checked' : ''} class="${CHK}" /> Terverifikasi (lencana ✓)</label>
          <label class="flex items-center gap-2 text-sm font-medium"><input type="checkbox" id="f-enabled" ${p.enabled ? 'checked' : ''} class="${CHK}" /> Tampil di situs</label>
        </div>
        ${field('f-features', 'Fitur (satu per baris)', ta('f-features', (p.features || []).join('\n'), 4))}
        ${field('f-long_intro', 'Narasi panjang (satu paragraf per baris)', ta('f-long_intro', (p.long_intro || []).join('\n'), 3))}

        <!-- Discord -->
        <div id="sec-discord" class="space-y-4 rounded-xl bg-ink-900/[0.03] dark:bg-cream-100/[0.03] p-4 ${p.platform === 'discord' ? '' : 'hidden'}">
          <p class="font-mono text-xs uppercase tracking-wider text-ink-500 dark:text-cream-300/60">Discord bot</p>
          <div class="grid gap-4 sm:grid-cols-2">
            ${field('f-discord_client_id', 'Client ID', inp('f-discord_client_id', p.discord_client_id))}
            ${field('f-discord_permissions', 'Permissions (bitwise)', inp('f-discord_permissions', p.discord_permissions))}
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            ${field('f-discord_integration_type', 'Integration type', inp('f-discord_integration_type', p.discord_integration_type, "placeholder=\"0 = server, 1 = user\""))}
            ${field('f-invite_url', 'Invite URL (override)', inp('f-invite_url', p.invite_url, 'type="url" placeholder="kosong = dibangun otomatis"'))}
          </div>
        </div>

        <!-- Aplikasi web -->
        <div id="sec-web" class="space-y-4 rounded-xl bg-ink-900/[0.03] dark:bg-cream-100/[0.03] p-4 ${p.platform === 'web' ? '' : 'hidden'}">
          <p class="font-mono text-xs uppercase tracking-wider text-ink-500 dark:text-cream-300/60">Aplikasi web</p>
          <div class="grid gap-4 sm:grid-cols-2">
            ${field('f-cta_url', 'Tautan aplikasi', inp('f-cta_url', p.cta_url, 'type="url" placeholder="https://namaapp.netlify.app"'), 'Alamat aplikasi/website — mis. domain Netlify atau Vercel. Tombol utama di halaman produk mengarah ke sini.')}
            ${field('f-cta_label', 'Label tombol', inp('f-cta_label', p.cta_label, 'maxlength="40" placeholder="Buka Aplikasi"'), 'Kosongkan untuk memakai "Buka Aplikasi".')}
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          ${field('f-faq_category_id', 'Kategori FAQ (panduan)',
            sel('f-faq_category_id', p.faq_category_id || '', [
              ['', kategoriFaq.length ? '— tanpa panduan —' : '— belum ada kategori FAQ —'],
              ...kategoriFaq.map((k) => [k.id, k.enabled === false ? `${k.name} (nonaktif)` : k.name]),
            ]),
            'Menentukan tujuan tombol "Lihat Panduan" dan FAQ yang tampil di halaman produk. Kelola isinya di menu FAQ.')}
        </div>
        <!-- Konten halaman produk: dulu tertanam di kode, kini dari CMS. -->
        <div class="space-y-4 rounded-xl bg-ink-900/[0.03] dark:bg-cream-100/[0.03] p-4">
          <p class="font-mono text-xs uppercase tracking-wider text-ink-500 dark:text-cream-300/60">Isi halaman produk</p>
          ${field('f-faq', 'FAQ cadangan (satu per baris: Pertanyaan | Jawaban)',
            ta('f-faq', (p.faq || []).map((f: any) => `${f.q} | ${f.a}`).join('\n'), 4),
            'Hanya dipakai bila produk ini belum punya Kategori FAQ. Begitu kategorinya diisi, halaman produk memakai FAQ terpusat.')}
          <div class="grid gap-4 sm:grid-cols-2">
            ${field('f-cta_heading', 'Judul CTA penutup', inp('f-cta_heading', p.cta_heading, 'maxlength="120" placeholder="kosong = otomatis dari nama produk"'))}
            ${field('f-cta_note', 'Catatan kecil di bawah tombol', inp('f-cta_note', p.cta_note, 'maxlength="160"'))}
          </div>
          ${field('f-cta_text', 'Teks CTA penutup', ta('f-cta_text', p.cta_text, 2, 'maxlength="400" placeholder="kosong = teks bawaan sesuai platform"'))}
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          ${field('f-seo_title', 'SEO title', inp('f-seo_title', p.seo_title, 'maxlength="120"'))}
          ${field('f-seo_description', 'SEO description', ta('f-seo_description', p.seo_description, 2, 'maxlength="300"'))}
        </div>

        ${bolehEdit ? `<div class="flex items-center gap-3 pt-2">
          <button type="button" class="${BTN}" data-action="simpan-core">${nuevo ? 'Buat produk' : 'Simpan perubahan'}</button>
          ${nuevo ? '<p class="text-sm text-ink-500 dark:text-cream-300/60">Simpan dulu untuk mengunggah media.</p>' : ''}
        </div>` : '<p class="text-sm text-ink-500 dark:text-cream-300/60">Peran kamu hanya bisa melihat.</p>'}
      </div>

      ${p.id ? renderThumbShell() + renderMediaShell() : ''}
    `;
    if (disabled) editorView().querySelectorAll('input,textarea,select').forEach((n) => ((n as any).disabled = true));
  }

  function kumpulkanCore() {
    const v = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value?.trim() ?? '';
    const c = (id: string) => (document.getElementById(id) as HTMLInputElement)?.checked ?? false;
    const lines = (id: string) => v(id).split('\n').map((s) => s.trim()).filter(Boolean);
    const sortN = parseInt(v('f-sort'), 10);
    return {
      slug: v('f-slug'), name: v('f-name'), short_name: v('f-name'),
      tagline: v('f-tagline'), description: v('f-description'),
      platform: v('f-platform'), status: v('f-status'), category: v('f-category') || null,
      accent_color: v('f-accent_color') || null, icon: v('f-icon') || null,
      featured: c('f-featured'), verified: c('f-verified'), enabled: c('f-enabled'),
      sort: Number.isFinite(sortN) ? sortN : 100,
      features: lines('f-features'), long_intro: lines('f-long_intro'),
      // "Pertanyaan | Jawaban" per baris. Baris tanpa "|" dilewati supaya
      // salah ketik tidak menghasilkan FAQ berisi jawaban kosong.
      faq: lines('f-faq')
        .map((baris) => {
          const [q, ...sisa] = baris.split('|');
          return { q: (q ?? '').trim(), a: sisa.join('|').trim() };
        })
        .filter((f) => f.q && f.a),
      badge: v('f-badge') || null,
      badge_tone: v('f-badge_tone') || 'accent',
      cta_heading: v('f-cta_heading') || null,
      cta_text: v('f-cta_text') || null,
      cta_note: v('f-cta_note') || null,
      discord_client_id: v('f-discord_client_id') || null,
      discord_permissions: v('f-discord_permissions') || null,
      discord_integration_type: v('f-discord_integration_type') || null,
      invite_url: v('f-invite_url') || null,
      cta_label: v('f-cta_label') || null, cta_url: v('f-cta_url') || null,
      faq_category_id: v('f-faq_category_id') || null,
      seo_title: v('f-seo_title') || null, seo_description: v('f-seo_description') || null,
    };
  }

  async function simpanCore() {
    if (!bolehEdit) return;
    const supabase = getSupabase()!;
    const patch = kumpulkanCore();
    if (!patch.name || !patch.slug) { toast('Nama dan slug wajib diisi.', false); return; }
    if (!/^[a-z0-9-]+$/.test(patch.slug)) { toast('Slug hanya boleh huruf kecil, angka, dan tanda hubung.', false); return; }

    const meta = { ...patch, updated_at: new Date().toISOString(), updated_by: uid };
    if (current.id) {
      const { error } = await supabase.from('products').update(meta).eq('id', current.id);
      if (error) { toast(pesanError(error), false); return; }
      toast('Tersimpan.');
      current = { ...current, ...meta };
      renderEditor(); if (current.id) void muatMedia();
    } else {
      const { data, error } = await supabase.from('products').insert(meta).select('*').maybeSingle();
      if (error) { toast(error.code === '23505' ? 'Slug sudah dipakai produk lain.' : pesanError(error), false); return; }
      toast('Produk dibuat. Sekarang bisa unggah media.');
      current = data;
      renderEditor(); void muatMedia();
    }
  }

  async function hapusProduk() {
    if (!bolehEdit || !current?.id) return;
    if (!window.confirm(`Hapus produk "${current.name}" beserta semua medianya? Tidak bisa dibatalkan.`)) return;
    const supabase = getSupabase()!;
    // Bersihkan berkas Storage lebih dulu (baris DB ikut terhapus via cascade).
    const { data: berkas } = await supabase.storage.from(MEDIA_BUCKET).list(current.slug);
    if (berkas?.length) await supabase.storage.from(MEDIA_BUCKET).remove(berkas.map((f) => `${current.slug}/${f.name}`));
    const { error } = await supabase.from('products').delete().eq('id', current.id);
    if (error) { toast(pesanError(error), false); return; }
    toast('Produk dihapus.');
    void muatDaftar();
  }

  // ─── Logo / thumbnail ───────────────────────────────────────────────────────
  // Gambar bersifat OPSIONAL. Menghapusnya membuang berkas di Storage sekaligus
  // mengosongkan kolom, sehingga tidak ada URL yatim yang tertinggal dan
  // halaman publik otomatis kembali memakai ikon aksen.
  function renderThumbShell() {
    const t = String(current.thumbnail_url ?? '');
    return `
      <div class="mt-6 space-y-4 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
        <h3 class="font-display text-lg font-semibold tracking-tightest">Logo / thumbnail</h3>
        <p class="text-sm text-ink-600 dark:text-cream-200/80">
          Opsional. Bila kosong, situs memakai ikon aksen — bukan gambar rusak. Unggah logo sendiri
          di sini bila ikon yang kamu mau tidak ada di daftar ikon bawaan.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          ${t
            ? `<img src="${esc(t)}" alt="" class="h-16 w-16 rounded-xl object-cover border border-ink-900/10 dark:border-cream-100/10"
                 onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'h-16 w-16 rounded-xl grid place-items-center text-[10px] text-center bg-red-500/10 text-red-600',textContent:'gambar tidak dapat dimuat'}))" />`
            : `<div class="h-16 w-16 rounded-xl grid place-items-center border border-dashed border-ink-900/20 dark:border-cream-100/20 text-[10px] text-ink-500 dark:text-cream-300/60 text-center">tanpa gambar</div>`}
          <div class="min-w-0 flex-1">
            <p class="font-mono text-xs text-ink-500 dark:text-cream-300/60 break-all">${t ? esc(t) : 'Belum ada gambar.'}</p>
          </div>
        </div>
        ${bolehEdit ? `<div class="flex flex-wrap items-end gap-3">
          <div class="flex-1 min-w-[200px]">
            <label class="block text-sm font-medium mb-1.5" for="t-file">${t ? 'Ganti gambar' : 'Unggah gambar'} (≤50 MB)</label>
            <input id="t-file" type="file" accept="image/*" class="${INPUT}" />
          </div>
          <button type="button" class="${BTN}" data-action="upload-thumb">${t ? 'Ganti' : 'Unggah'}</button>
          ${t ? `<button type="button" class="rounded-xl border border-red-500/30 text-red-600 dark:text-red-400 px-4 py-2 text-sm font-medium hover:bg-red-500/10 transition-colors" data-action="hapus-thumb">Hapus gambar</button>` : ''}
        </div>` : ''}
      </div>`;
  }

  /** Path objek di bucket product-media bila URL memang berasal dari Storage kita. */
  function pathDariUrl(u: string): string | null {
    const tanda = '/storage/v1/object/public/' + MEDIA_BUCKET + '/';
    const i = u.indexOf(tanda);
    return i === -1 ? null : decodeURIComponent(u.slice(i + tanda.length));
  }

  async function uploadThumb() {
    if (!bolehEdit) return;
    const supabase = getSupabase()!;
    const fileEl = document.getElementById('t-file') as HTMLInputElement;
    const file = fileEl?.files?.[0];
    if (!file) { toast('Pilih berkas dulu.', false); return; }
    if (file.size > 52428800) { toast('Berkas melebihi 50 MB.', false); return; }

    toast('Mengunggah…');
    const lama = String(current.thumbnail_url ?? '');
    const path = `${current.slug}/thumb-${Date.now()}-${safeName(file.name)}`;
    const up = await supabase.storage.from(MEDIA_BUCKET).upload(path, file, { contentType: file.type, upsert: false });
    if (up.error) { toast(up.error.message, false); return; }

    const publik = publicUrl(MEDIA_BUCKET, path);
    const { error } = await supabase.from('products')
      .update({ thumbnail_url: publik, updated_at: new Date().toISOString(), updated_by: uid })
      .eq('id', current.id);
    if (error) { toast(pesanError(error), false); return; }

    // Berkas lama dibuang setelah kolom menunjuk ke yang baru, supaya tidak ada
    // jendela waktu ketika kolom menunjuk berkas yang sudah terhapus.
    const pathLama = pathDariUrl(lama);
    if (pathLama) await supabase.storage.from(MEDIA_BUCKET).remove([pathLama]);

    current.thumbnail_url = publik;
    toast('Gambar diperbarui.');
    renderEditor(); void muatMedia();
  }

  async function hapusThumb() {
    if (!bolehEdit || !current?.id) return;
    if (!window.confirm('Hapus logo/thumbnail produk ini? Situs akan memakai ikon aksen sebagai gantinya.')) return;
    const supabase = getSupabase()!;
    const lama = String(current.thumbnail_url ?? '');

    const { error } = await supabase.from('products')
      .update({ thumbnail_url: null, updated_at: new Date().toISOString(), updated_by: uid })
      .eq('id', current.id);
    if (error) { toast(pesanError(error), false); return; }

    const pathLama = pathDariUrl(lama);
    if (pathLama) await supabase.storage.from(MEDIA_BUCKET).remove([pathLama]);

    current.thumbnail_url = '';
    toast('Gambar dihapus.');
    renderEditor(); void muatMedia();
  }

  // ─── Media ─────────────────────────────────────────────────────────────────
  function renderMediaShell() {
    return `
      <div class="mt-6 space-y-4 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
        <h3 class="font-display text-lg font-semibold tracking-tightest">Foto & video</h3>
        ${bolehEdit ? `<div class="flex flex-wrap items-end gap-3">
          <div>
            <label class="block text-sm font-medium mb-1.5" for="m-kind">Jenis</label>
            <select id="m-kind" class="${INPUT}">
              <option value="screenshot">Screenshot</option>
              <option value="icon">Ikon</option>
              <option value="banner">Banner</option>
              <option value="video">Video</option>
            </select>
          </div>
          <div class="flex-1 min-w-[200px]">
            <label class="block text-sm font-medium mb-1.5" for="m-file">Berkas (gambar / video, ≤50 MB)</label>
            <input id="m-file" type="file" accept="image/*,video/mp4,video/webm" class="${INPUT}" />
          </div>
          <button type="button" class="${BTN}" data-action="upload-media">Unggah</button>
        </div>` : ''}
        <div id="media-list" class="space-y-2"></div>
      </div>`;
  }

  async function muatMedia() {
    const box = document.getElementById('media-list');
    if (!box) return;
    box.innerHTML = stateBlock('loading', '');
    const supabase = getSupabase()!;
    const { data, error } = await supabase.from('product_media')
      .select('id, kind, storage_path, url, alt, sort').eq('product_id', current.id).order('sort', { ascending: true });
    if (error) { box.innerHTML = stateBlock('error', pesanError(error)); return; }
    const rows = data ?? [];
    if (!rows.length) { box.innerHTML = `<p class="text-sm text-ink-500 dark:text-cream-300/60">Belum ada media.</p>`; return; }
    box.innerHTML = rows.map((m: any) => {
      const preview = m.kind === 'video'
        ? `<div class="h-14 w-14 flex-none rounded-lg bg-ink-900/10 dark:bg-cream-100/10 grid place-items-center text-xs">video</div>`
        : `<img src="${esc(m.url)}" alt="" class="h-14 w-14 flex-none rounded-lg object-cover bg-ink-900/10 dark:bg-cream-100/10" />`;
      return `<div class="flex items-center gap-3 rounded-xl border border-ink-900/10 dark:border-cream-100/10 p-2.5">
        ${preview}
        <div class="min-w-0 flex-1 space-y-1.5">
          <p class="text-sm font-medium">${esc(m.kind)}</p>
          <div class="flex flex-wrap gap-2">
            <input value="${esc(m.alt ?? '')}" data-media-id="${esc(m.id)}" data-media-field="alt" maxlength="160"
              placeholder="Alt text (deskripsi gambar)" ${bolehEdit ? '' : 'disabled'}
              class="flex-1 min-w-[160px] rounded-lg border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-3 py-1.5 text-xs outline-none focus:border-amber-500" />
            <input value="${esc(m.sort ?? 100)}" data-media-id="${esc(m.id)}" data-media-field="sort" inputmode="numeric"
              title="Urutan" ${bolehEdit ? '' : 'disabled'}
              class="w-20 rounded-lg border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-3 py-1.5 text-xs outline-none focus:border-amber-500" />
          </div>
        </div>
        ${bolehEdit ? `<button type="button" class="text-sm text-red-600 dark:text-red-400 hover:underline" data-action="hapus-media" data-id="${esc(m.id)}" data-path="${esc(m.storage_path)}">Hapus</button>` : ''}
      </div>`;
    }).join('');
  }

  async function uploadMedia() {
    if (!bolehEdit) return;
    const supabase = getSupabase()!;
    const fileEl = document.getElementById('m-file') as HTMLInputElement;
    const kind = (document.getElementById('m-kind') as HTMLSelectElement).value;
    const file = fileEl.files?.[0];
    if (!file) { toast('Pilih berkas dulu.', false); return; }
    if (file.size > 52428800) { toast('Berkas melebihi 50 MB.', false); return; }
    toast('Mengunggah…');
    const path = `${current.slug}/${Date.now()}-${safeName(file.name)}`;
    const up = await supabase.storage.from(MEDIA_BUCKET).upload(path, file, { contentType: file.type, upsert: false });
    if (up.error) { toast(up.error.message, false); return; }
    const { error } = await supabase.from('product_media').insert({
      product_id: current.id, kind, storage_path: path, url: publicUrl(MEDIA_BUCKET, path), sort: 100,
    });
    if (error) { toast(pesanError(error), false); return; }
    fileEl.value = '';
    toast('Media diunggah.');
    void muatMedia();
  }

  async function hapusMedia(id: string, path: string) {
    if (!bolehEdit) return;
    const supabase = getSupabase()!;
    await supabase.storage.from(MEDIA_BUCKET).remove([path]);
    const { error } = await supabase.from('product_media').delete().eq('id', id);
    if (error) { toast(pesanError(error), false); return; }
    toast('Media dihapus.');
    void muatMedia();
  }

  // ─── Delegasi event ──────────────────────────────────────────────────────────
  async function onClick(e: Event) {
    const btn = (e.target as HTMLElement).closest('[data-action]') as HTMLElement | null;
    if (!btn) return;
    const a = btn.dataset.action;
    if (a === 'tambah') return void bukaEditor(null);
    if (a === 'edit') return void bukaEditor(btn.dataset.slug!);
    if (a === 'kembali') return void muatDaftar();
    if (a === 'simpan-core') return void simpanCore();
    if (a === 'hapus-produk') return void hapusProduk();
    if (a === 'upload-thumb') return void uploadThumb();
    if (a === 'hapus-thumb') return void hapusThumb();
    if (a === 'upload-media') return void uploadMedia();
    if (a === 'hapus-media') return void hapusMedia(btn.dataset.id!, btn.dataset.path!);
  }

  function onChange(e: Event) {
    const el = e.target as HTMLElement;
    if (el.id === 'f-platform') {
      const val = (el as HTMLSelectElement).value;
      document.getElementById('sec-discord')?.classList.toggle('hidden', val !== 'discord');
      document.getElementById('sec-web')?.classList.toggle('hidden', val !== 'web');
      return;
    }
    // Alt text & urutan media disimpan begitu selesai diubah — perubahan kecil
    // seperti ini tidak perlu menunggu tombol Simpan produk.
    const id = (el as HTMLElement).dataset?.mediaId;
    const field = (el as HTMLElement).dataset?.mediaField;
    if (id && field) void simpanMedia(id, field, (el as HTMLInputElement).value);
  }

  async function simpanMedia(id: string, field: string, raw: string) {
    if (!bolehEdit) return;
    const supabase = getSupabase()!;
    const patch: Record<string, any> = {};
    if (field === 'sort') {
      const n = parseInt(raw, 10);
      patch.sort = Number.isFinite(n) ? n : 100;
    } else {
      patch.alt = raw.trim();
    }
    const { error } = await supabase.from('product_media').update(patch).eq('id', id);
    if (error) { toast(pesanError(error), false); return; }
    toast('Tersimpan.');
  }

  // Ambil uid sesi untuk kolom updated_by/created_by.
  (async () => {
    const supabase = getSupabase();
    if (supabase) uid = (await supabase.auth.getSession()).data.session?.user.id ?? null;
  })();
</script>
