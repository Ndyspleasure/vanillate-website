---
// Daftar server (guild) Discord tempat bot terpasang.
//
// Catatan penting: daftar ini TIDAK diambil langsung dari Discord API oleh
// browser. Memanggil Discord API butuh bot token, dan token itu rahasia —
// menaruhnya di situs statis sama saja membagikannya ke publik. Jadi bot yang
// mengirim daftarnya ke Supabase, lalu halaman ini membacanya.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Server" active="server">
  <AdminPageHeader
    eyebrow="Jangkauan"
    title="Server"
    description="Daftar server Discord yang memakai bot, beserta perkiraan jumlah anggotanya."
  />

  <div class="px-6 lg:px-10 py-8">
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 mb-8">
      <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
        <p class="font-display text-3xl font-semibold" data-ringkas="aktif">—</p>
        <p class="text-sm mt-1">Server aktif</p>
      </div>
      <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
        <p class="font-display text-3xl font-semibold" data-ringkas="anggota">—</p>
        <p class="text-sm mt-1">Total anggota</p>
      </div>
      <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
        <p class="font-display text-3xl font-semibold" data-ringkas="keluar">—</p>
        <p class="text-sm mt-1">Sudah tidak aktif</p>
      </div>
    </div>

    <div class="flex flex-wrap items-end gap-3 mb-6">
      <div class="flex-1 min-w-[200px]">
        <label for="cari-server" class="block text-xs uppercase tracking-[0.15em] text-ink-500 dark:text-cream-300/60 mb-1.5">Cari server</label>
        <input
          id="cari-server"
          type="search"
          placeholder="Nama server…"
          class="w-full rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-3 py-2 text-sm outline-none focus:border-amber-500"
        />
      </div>
      <label class="flex items-center gap-2 text-sm pb-2.5">
        <input id="tampil-nonaktif" type="checkbox" class="rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" />
        Tampilkan yang tidak aktif
      </label>
    </div>

    <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-ink-900/5 dark:bg-cream-100/5">
            <tr class="text-left">
              <th class="px-5 py-3 font-medium text-xs uppercase tracking-[0.1em] text-ink-500 dark:text-cream-300/60">Nama server</th>
              <th class="px-5 py-3 font-medium text-xs uppercase tracking-[0.1em] text-ink-500 dark:text-cream-300/60">Anggota</th>
              <th class="px-5 py-3 font-medium text-xs uppercase tracking-[0.1em] text-ink-500 dark:text-cream-300/60">Bergabung</th>
              <th class="px-5 py-3 font-medium text-xs uppercase tracking-[0.1em] text-ink-500 dark:text-cream-300/60">Terakhir terlihat</th>
              <th class="px-5 py-3 font-medium text-xs uppercase tracking-[0.1em] text-ink-500 dark:text-cream-300/60">Status</th>
            </tr>
          </thead>
          <tbody id="server-body"></tbody>
        </table>
      </div>
      <div id="server-state"></div>
    </div>

    <div class="mt-5 flex items-center justify-between">
      <p id="server-info" class="text-xs text-ink-500 dark:text-cream-300/60"></p>
      <button type="button" id="server-lagi" class="hidden rounded-xl border border-ink-900/15 dark:border-cream-100/15 px-4 py-2 text-sm font-medium hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors">
        Muat lebih banyak
      </button>
    </div>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { fmtAngka, fmtWaktu } from '@/lib/admin-auth';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';

  const PER_HALAMAN = 50;
  let offset = 0;
  let total = 0;
  let generasi = 0;

  const tbody = document.getElementById('server-body') as HTMLElement;
  const stateEl = document.getElementById('server-state') as HTMLElement;
  const infoEl = document.getElementById('server-info') as HTMLElement;
  const btnLagi = document.getElementById('server-lagi') as HTMLButtonElement;

  document.addEventListener('admin:ready', () => {
    void muatRingkasan();
    void muat(true);

    document.getElementById('tampil-nonaktif')?.addEventListener('change', () => void muat(true));
    btnLagi.addEventListener('click', () => void muat(false));

    let timer: ReturnType<typeof setTimeout>;
    document.getElementById('cari-server')?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => void muat(true), 350);
    });
  });

  async function muatRingkasan() {
    const supabase = getSupabase();
    if (!supabase) return;

    const [aktif, nonaktif, semua] = await Promise.all([
      supabase.from('bot_guilds').select('*', { count: 'exact', head: true }).eq('is_active', true),
      supabase.from('bot_guilds').select('*', { count: 'exact', head: true }).eq('is_active', false),
      supabase.from('bot_guilds').select('member_count').eq('is_active', true).limit(5000),
    ]);

    const set = (k: string, v: string) => {
      const el = document.querySelector(`[data-ringkas="${k}"]`);
      if (el) el.textContent = v;
    };

    set('aktif', fmtAngka(aktif.count ?? 0));
    set('keluar', fmtAngka(nonaktif.count ?? 0));
    set('anggota', fmtAngka((semua.data ?? []).reduce((n: number, r: any) => n + (r.member_count ?? 0), 0)));
  }

  async function muat(reset: boolean) {
    const supabase = getSupabase();
    if (!supabase) return;

    if (reset) {
      offset = 0;
      tbody.innerHTML = '';
      stateEl.innerHTML = stateBlock('loading', '');
      btnLagi.classList.add('hidden');
    }

    const generasiSaatIni = ++generasi;

    const cari = (document.getElementById('cari-server') as HTMLInputElement).value.trim();
    const tampilNonaktif = (document.getElementById('tampil-nonaktif') as HTMLInputElement).checked;

    let query = supabase
      .from('bot_guilds')
      .select('id, guild_id, name, member_count, joined_at, last_seen_at, is_active', { count: 'exact' })
      .order('member_count', { ascending: false, nullsFirst: false })
      .range(offset, offset + PER_HALAMAN - 1);

    if (!tampilNonaktif) query = query.eq('is_active', true);
    if (cari) query = query.ilike('name', `%${cari.replace(/[%,()\\]/g, '\\$&')}%`);

    const { data, error, count } = await query;
    if (generasiSaatIni !== generasi) return;

    if (error) {
      stateEl.innerHTML = stateBlock('error', pesanError(error));
      infoEl.textContent = '';
      return;
    }

    total = count ?? 0;

    if (reset && (!data || data.length === 0)) {
      stateEl.innerHTML = stateBlock(
        'empty',
        cari ? 'Tidak ada server yang cocok.' : 'Belum ada data server. Bot perlu mengirim daftarnya ke Supabase.',
      );
      infoEl.textContent = '';
      return;
    }

    stateEl.innerHTML = '';
    tbody.insertAdjacentHTML('beforeend', (data ?? []).map(baris).join(''));

    offset += data?.length ?? 0;
    infoEl.textContent = `Menampilkan ${fmtAngka(offset)} dari ${fmtAngka(total)} server`;
    btnLagi.classList.toggle('hidden', offset >= total);
  }

  function baris(row: any): string {
    return `
      <tr class="border-t border-ink-900/5 dark:border-cream-100/5">
        <td class="px-5 py-3">
          <span class="font-medium">${esc(row.name ?? 'Tanpa nama')}</span>
          <span class="block font-mono text-[0.7rem] text-ink-400 dark:text-cream-300/40">${esc(row.guild_id)}</span>
        </td>
        <td class="px-5 py-3 whitespace-nowrap">${esc(fmtAngka(row.member_count))}</td>
        <td class="px-5 py-3 whitespace-nowrap text-ink-500 dark:text-cream-300/60 text-xs">${esc(row.joined_at ? fmtWaktu(row.joined_at) : '—')}</td>
        <td class="px-5 py-3 whitespace-nowrap text-ink-500 dark:text-cream-300/60 text-xs">${esc(fmtWaktu(row.last_seen_at))}</td>
        <td class="px-5 py-3">
          <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs ${row.is_active ? 'bg-teal-500/15 text-teal-700 dark:text-teal-300' : 'bg-ink-500/15 text-ink-500 dark:text-cream-300/60'}">
            <span class="h-1.5 w-1.5 rounded-full ${row.is_active ? 'bg-teal-500' : 'bg-ink-400'}"></span>
            ${row.is_active ? 'Aktif' : 'Keluar'}
          </span>
        </td>
      </tr>`;
  }
</script>
