---
// Panel Developer — Operasi (konsol aksi sekali-jalan + riwayat perintah).
//
// Halaman Kontrol mengubah STATE (setting). Halaman ini menjalankan AKSI sekali-
// jalan (pengganti panel /developer lama): kelola pemain, progression, boost,
// promo, quest, tutorial, campaign, database. Aksi ber-UI kaya (broadcast,
// game, kata, sosial, auto-heal, kontrol server) ada di /admin/developer/*.
//
// Alurnya antrean: form meng-INSERT satu baris `pending` ke `bot_commands`
// (src/lib/dev-panel/client.ts). Bot menariknya, memverifikasi peran pembuat,
// mengeksekusi lewat handler-nya (src/cms/handlers/* di repo bot), lalu
// menulis balik status + hasil — ditampilkan langsung di form & riwayat.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Operasi Bot" active="operasi">
  <AdminPageHeader
    eyebrow="Panel Developer"
    title="Operasi Bot"
    description="Kirim perintah ke bot: kelola pemain, progression, boost, promo, quest, tutorial, campaign, dan database. Hasil dari bot tampil langsung di bawah tiap form."
  />

  <div class="px-6 lg:px-10 py-8 max-w-4xl space-y-10">
    <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 px-5 py-4">
      <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">
        Perintah masuk antrean dan dijalankan bot dalam beberapa detik. <strong>Player</strong> boleh diisi
        Player ID <em>atau</em> Discord ID. Bot memvalidasi setiap perintah — perintah yang salah berstatus
        <em>error</em> dengan alasannya.
      </p>
    </div>

    <!-- FORM AKSI (dirender per kategori dari registry src/lib/dev-panel/actions.ts) -->
    <div id="aksi-body" class="space-y-10"></div>

    <!-- RIWAYAT PERINTAH -->
    <section class="space-y-4">
      <div class="flex items-center justify-between gap-3">
        <h2 class="font-display text-lg font-semibold tracking-tightest">Riwayat perintah</h2>
        <button
          type="button"
          id="btn-refresh"
          class="rounded-lg border border-ink-900/10 dark:border-cream-100/10 px-3 py-1.5 text-xs font-medium text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors"
        >
          Muat ulang
        </button>
      </div>
      <div id="riwayat-body" class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 overflow-hidden"></div>
    </section>
  </div>
</AdminLayout>

<script>
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { fmtWaktu } from '@/lib/admin-auth';
  import { GRUP, type Aksi } from '@/lib/dev-panel/actions';
  import { formCard, pasangAksi, pill, statusTone } from '@/lib/dev-panel/ui';
  import { riwayatPerintah } from '@/lib/dev-panel/client';

  let bolehEdit = false;

  document.addEventListener('admin:ready', (e) => {
    const profile = (e as CustomEvent).detail;
    bolehEdit = profile?.role === 'owner' || profile?.role === 'admin';
    render();
    void muatRiwayat();
    // Auto-refresh riwayat supaya perubahan status dari bot terlihat.
    setInterval(() => void muatRiwayat(), 10_000);
  });

  const idForm = (a: Aksi) => `aksi-${a.type.replace(/\./g, '-')}`;

  function render() {
    const body = document.getElementById('aksi-body')!;
    if (!bolehEdit) {
      body.innerHTML = `<p class="text-sm text-ink-500 dark:text-cream-300/60">Peran kamu hanya bisa melihat riwayat perintah di bawah.</p>`;
      return;
    }

    body.innerHTML = GRUP.map((g) => `
      <section class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 flex h-9 w-9 flex-none items-center justify-center rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${g.icon}</svg>
          </span>
          <div>
            <h2 class="font-display text-lg font-semibold tracking-tightest">${esc(g.label)}</h2>
            <p class="mt-0.5 text-sm text-ink-500 dark:text-cream-300/60">${esc(g.desc)}</p>
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          ${g.aksi.map((a) => formCard({ id: idForm(a), title: a.label, fields: a.fields, danger: a.danger, desc: a.help, submit: 'Kirim' })).join('')}
        </div>
      </section>`).join('');

    for (const g of GRUP) {
      for (const a of g.aksi) {
        const form = document.getElementById(idForm(a)) as HTMLFormElement;
        pasangAksi(form, {
          type: a.type,
          confirm: a.danger
            ? (p) => `Jalankan "${a.label}"${p.player ? ` untuk "${p.player}"` : ' untuk SEMUA pemain'}? Aksi ini tidak bisa dibatalkan.`
            : undefined,
          success: (o) => `Selesai. ${ringkas(o.result)}`,
          resetOnSuccess: true,
          onDone: () => void muatRiwayat(),
        });
      }
    }
  }

  async function muatRiwayat() {
    const body = document.getElementById('riwayat-body')!;
    const { rows, error } = await riwayatPerintah([], 25);
    if (error) { body.innerHTML = stateBlock('error', error); return; }
    if (!rows.length) { body.innerHTML = stateBlock('empty', 'Belum ada perintah dikirim.'); return; }

    const baris = rows.map((r: any) => {
      const detail = r.status === 'error'
        ? `<span class="text-red-600 dark:text-red-400">${esc(r.error || 'error')}</span>`
        : r.result
          ? `<span class="text-ink-500 dark:text-cream-300/60">${esc(ringkas(r.result))}</span>`
          : '<span class="text-ink-400 dark:text-cream-300/40">—</span>';
      return `
        <tr class="border-t border-ink-900/5 dark:border-cream-100/5">
          <td class="px-4 py-3 align-top"><code class="text-xs font-mono">${esc(r.type)}</code></td>
          <td class="px-4 py-3 align-top">${pill(r.status, statusTone(r.status))}</td>
          <td class="px-4 py-3 align-top text-xs max-w-[16rem] break-words">${detail}</td>
          <td class="px-4 py-3 align-top text-xs text-ink-500 dark:text-cream-300/60 whitespace-nowrap">${esc(fmtWaktu(r.created_at))}</td>
        </tr>`;
    }).join('');

    body.innerHTML = `
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="text-[0.7rem] uppercase tracking-wider text-ink-400 dark:text-cream-300/40">
              <th class="px-4 py-3 font-medium">Perintah</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3 font-medium">Hasil</th>
              <th class="px-4 py-3 font-medium">Waktu</th>
            </tr>
          </thead>
          <tbody>${baris}</tbody>
        </table>
      </div>`;
  }

  function ringkas(result: unknown): string {
    try {
      const s = typeof result === 'string' ? result : JSON.stringify(result);
      return s.length > 160 ? s.slice(0, 159) + '…' : s;
    } catch {
      return '';
    }
  }

  document.getElementById('btn-refresh')?.addEventListener('click', () => void muatRiwayat());
</script>
