---
// Partnership — Lobby Bot.
//
// Mengelola **Dashboard Partnership** yang tampil terpisah di bawah Dashboard
// Lobby di dalam permainan Discord:
//   • Daftar partner (slot) yang tayang — dikelompokkan per KATEGORI, lengkap
//     dengan jadwal mulai/berakhir.
//   • DETAIL tiap partner: isi balasan ephemeral saat pemain menekan tombol
//     partner. Tombol partner TIDAK lagi melompat langsung ke link tujuan —
//     pemain membaca detailnya dulu, tautannya ada di dalam balasan itu.
//   • Seluruh teks item CTA "Order Partnership" + posisinya di dalam list.
//
// Bot MEMBACA tabel ini langsung dari Supabase (service_role) dan menyegarkan
// isinya berkala — jadi perubahan di sini berlaku tanpa deploy bot dan tanpa
// build website.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
import PartnershipTabs from '@components/PartnershipTabs.astro';
import { url } from '@utils/url';
---

<AdminLayout title="Lobby Bot" active="partnership">
  <AdminPageHeader
    eyebrow="Partnership"
    title="Lobby Bot"
    description="Atur partner yang tampil di Dashboard Partnership dalam permainan, detail tiap partner, dan teks item Order Partnership."
  />
  <PartnershipTabs active="lobby" />

  <div class="px-6 lg:px-10 py-8 space-y-10 max-w-3xl">
    <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 px-5 py-4">
      <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">
        Dashboard Partnership <strong>selalu tampil</strong> di lobby — walau belum ada partner,
        item <em>Order Partnership</em> tetap ada supaya areanya tidak terlihat kosong.
        Menekan tombol partner <strong>tidak langsung membuka link</strong>: bot membalas
        pesan yang hanya terlihat oleh penekannya, berisi <strong>Detail partner</strong> di
        bawah — tautannya menjadi tombol di dalam balasan itu.
        Partner dikelompokkan menurut <a class="font-medium text-amber-700 dark:text-amber-400 hover:underline" href={url('/admin/partnership/categories')}>Kategori</a>,
        dan urutan kelompoknya sama persis dengan yang dilihat pemain.
        Perubahan di halaman ini diterapkan bot dalam beberapa menit (tanpa restart).
      </p>
    </div>

    <!-- KONFIGURASI DASHBOARD + ITEM CTA -->
    <section class="space-y-4">
      <h2 class="font-display text-lg font-semibold tracking-tightest">Dashboard &amp; item CTA</h2>
      <form id="form-cta" class="space-y-4">
        <div id="cta-body"></div>
        <div id="cta-aksi" class="hidden flex-wrap items-center gap-3">
          <button type="submit" id="btn-cta"
            class="rounded-xl bg-amber-500 px-5 py-2.5 text-sm font-semibold text-ink-950 hover:bg-amber-400 disabled:opacity-60 disabled:cursor-not-allowed transition-colors">
            Simpan konfigurasi
          </button>
          <p id="cta-pesan" class="text-sm" role="status" aria-live="polite"></p>
        </div>
      </form>
    </section>

    <!-- DAFTAR PARTNER (per kategori) -->
    <section class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-lg font-semibold tracking-tightest">Partner yang tampil</h2>
          <p class="mt-0.5 text-sm text-ink-500 dark:text-cream-300/60">
            Dikelompokkan per kategori; di dalam kelompok, urutan mengikuti kolom <em>Urutan</em>.
            Kosongkan tanggal untuk tayang tanpa batas.
          </p>
        </div>
        <button type="button" id="btn-tambah"
          class="rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-amber-400 transition-colors">
          + Tambah partner
        </button>
      </div>
      <div id="slot-body" class="space-y-10"></div>
      <p id="slot-pesan" class="text-sm" role="status" aria-live="polite"></p>
    </section>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import { fmtWaktu } from '@/lib/admin-auth';
  import { headerKategori, kelompokkan, opsiKategori, untukScope, type Kategori } from '@/lib/partnership-kategori';

  const INPUT = 'w-full rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2.5 text-sm outline-none focus:border-amber-500 transition-colors';
  let bolehEdit = false;
  let kategori: Kategori[] = [];

  document.addEventListener('admin:ready', (e) => {
    const profile = (e as CustomEvent).detail;
    bolehEdit = profile?.role === 'owner' || profile?.role === 'admin';
    void muatCta();
    void muatSlots();
    document.getElementById('form-cta')!.addEventListener('submit', onSimpanCta);
    document.getElementById('btn-tambah')!.addEventListener('click', onTambah);
    document.getElementById('slot-body')!.addEventListener('click', onAksiSlot);
  });

  // Ubah ISO → nilai untuk <input type="datetime-local"> (waktu lokal browser).
  function keInputWaktu(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '';
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
  }
  const keIso = (v: string) => (v ? new Date(v).toISOString() : null);

  // ─── Konfigurasi dashboard + CTA ──────────────────────────────────────────
  async function muatCta() {
    const body = document.getElementById('cta-body')!;
    body.innerHTML = stateBlock('loading', '');

    const supabase = getSupabase();
    if (!supabase) { body.innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.'); return; }

    const { data, error } = await supabase
      .from('partnership_lobby')
      .select('enabled, dashboard_title, dashboard_note, cta_emoji, cta_title, cta_description, cta_button_label, cta_button_url, cta_position')
      .eq('id', 1)
      .maybeSingle();

    if (error) { body.innerHTML = stateBlock('error', pesanError(error)); return; }
    if (!data) { body.innerHTML = stateBlock('empty', 'Baris konfigurasi belum ada. Jalankan supabase/schema.sql terbaru.'); return; }

    const f = (nama: string, label: string, isi: string, bantuan = '') => `
      <div>
        <label class="block text-sm font-medium mb-1.5" for="cta-${esc(nama)}">${esc(label)}</label>
        ${isi}
        ${bantuan ? `<p class="mt-1 text-xs text-ink-500 dark:text-cream-300/60">${esc(bantuan)}</p>` : ''}
      </div>`;
    const teks = (nama: string, nilai: any, extra = '') =>
      `<input id="cta-${esc(nama)}" data-cta="${esc(nama)}" value="${esc(nilai ?? '')}" ${extra} class="${INPUT}" />`;

    body.innerHTML = `
      <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5 space-y-4">
        <label class="flex items-center gap-2 text-sm font-medium">
          <input type="checkbox" data-cta="enabled" ${data.enabled ? 'checked' : ''}
            class="h-4 w-4 rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" />
          Tampilkan Dashboard Partnership di lobby
        </label>

        <div class="grid gap-4 sm:grid-cols-2">
          ${f('dashboard_title', 'Judul dashboard', teks('dashboard_title', data.dashboard_title, 'maxlength="80"'))}
          ${f('dashboard_note', 'Catatan di bawah judul', teks('dashboard_note', data.dashboard_note, 'maxlength="200"'), 'Opsional.')}
        </div>

        <hr class="border-ink-900/10 dark:border-cream-100/10" />
        <p class="text-sm font-medium">Item CTA (selalu tampil sebagai bagian dari list)</p>

        <div class="grid gap-4 sm:grid-cols-[6rem_1fr]">
          ${f('cta_emoji', 'Emoji', teks('cta_emoji', data.cta_emoji, 'maxlength="8"'))}
          ${f('cta_title', 'Judul item', teks('cta_title', data.cta_title, 'maxlength="200"'))}
        </div>

        ${f('cta_description', 'Deskripsi item',
          `<textarea id="cta-cta_description" data-cta="cta_description" rows="2" maxlength="500" class="${INPUT}">${esc(data.cta_description ?? '')}</textarea>`)}

        <div class="grid gap-4 sm:grid-cols-3">
          ${f('cta_button_label', 'Label tombol', teks('cta_button_label', data.cta_button_label, 'maxlength="60"'))}
          ${f('cta_button_url', 'Tujuan tombol', teks('cta_button_url', data.cta_button_url, 'type="url" placeholder="kosong = URL Partnership dari Settings"'),
            'Kosongkan agar memakai Partnership URL di tab Settings.')}
          ${f('cta_position', 'Posisi dalam list',
            `<select id="cta-cta_position" data-cta="cta_position" class="${INPUT}">
               <option value="last" ${data.cta_position === 'last' ? 'selected' : ''}>Paling bawah</option>
               <option value="first" ${data.cta_position === 'first' ? 'selected' : ''}>Paling atas</option>
             </select>`)}
        </div>
      </div>`;

    document.getElementById('cta-aksi')!.classList.remove('hidden');
    if (!bolehEdit) {
      body.querySelectorAll('input, textarea, select').forEach((n) => ((n as HTMLInputElement).disabled = true));
      (document.getElementById('btn-cta') as HTMLButtonElement).disabled = true;
      document.getElementById('cta-pesan')!.textContent = 'Peran kamu hanya bisa melihat.';
    }
  }

  async function onSimpanCta(e: Event) {
    e.preventDefault();
    if (!bolehEdit) return;
    const supabase = getSupabase();
    if (!supabase) return;

    const btn = document.getElementById('btn-cta') as HTMLButtonElement;
    const pesan = document.getElementById('cta-pesan')!;
    btn.disabled = true; btn.textContent = 'Menyimpan…';
    pesan.textContent = ''; pesan.className = 'text-sm';

    const patch: Record<string, any> = {};
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[data-cta]').forEach((n) => {
      const field = n.dataset.cta!;
      patch[field] = field === 'enabled' ? (n as HTMLInputElement).checked : n.value.trim();
    });

    // Teks wajib tidak boleh kosong — bot memakai default-nya sendiri bila
    // kosong, tapi lebih jelas ditolak di sini agar admin sadar.
    for (const wajib of ['dashboard_title', 'cta_title', 'cta_description', 'cta_button_label']) {
      if (!patch[wajib]) {
        pesan.textContent = 'Judul dashboard, judul item, deskripsi, dan label tombol wajib diisi.';
        pesan.className = 'text-sm text-red-600 dark:text-red-400';
        btn.disabled = false; btn.textContent = 'Simpan konfigurasi';
        return;
      }
    }
    if (patch.cta_button_url && !/^https?:\/\//i.test(patch.cta_button_url)) {
      pesan.textContent = 'Tujuan tombol harus diawali http:// atau https://.';
      pesan.className = 'text-sm text-red-600 dark:text-red-400';
      btn.disabled = false; btn.textContent = 'Simpan konfigurasi';
      return;
    }

    const { data: sesi } = await supabase.auth.getSession();
    const { error } = await supabase.from('partnership_lobby')
      .update({ ...patch, updated_at: new Date().toISOString(), updated_by: sesi.session?.user.id ?? null })
      .eq('id', 1);

    pesan.textContent = error ? pesanError(error) : 'Tersimpan. Bot menerapkannya dalam beberapa menit.';
    pesan.className = error ? 'text-sm text-red-600 dark:text-red-400' : 'text-sm text-teal-700 dark:text-teal-300';
    btn.disabled = false; btn.textContent = 'Simpan konfigurasi';
  }

  // ─── Slot partner ─────────────────────────────────────────────────────────
  async function muatSlots() {
    const body = document.getElementById('slot-body')!;
    body.innerHTML = stateBlock('loading', '');

    const supabase = getSupabase();
    if (!supabase) return;

    const [kat, slot] = await Promise.all([
      supabase.from('partnership_categories')
        .select('key, label, description, icon, emoji, scope, enabled, sort')
        .order('sort', { ascending: true }),
      supabase.from('partnership_slots')
        .select('id, partner_name, title, description, emoji, category, logo_url, banner_url, url, button_label, button_url, detail_title, detail_description, detail_highlights, detail_image_url, detail_footer, detail_link_label, enabled, sort, start_at, end_at, updated_at')
        .order('sort', { ascending: true }),
    ]);

    if (slot.error) { body.innerHTML = stateBlock('error', pesanError(slot.error)); return; }
    const data = slot.data ?? [];

    // Kategori tetap dimuat walau daftar partner kosong: dropdown pada partner
    // baru butuh isinya.
    kategori = untukScope((kat.error ? [] : (kat.data ?? [])) as Kategori[], 'partner');

    if (data.length === 0) {
      body.innerHTML = stateBlock('empty', 'Belum ada partner. Item Order Partnership tetap tampil di lobby.');
      return;
    }

    body.innerHTML = kelompokkan(data as any[], kategori)
      .map((g) => `
        <section class="space-y-4">
          ${headerKategori(g.kategori, g.items.length)}
          <div class="space-y-5">${g.items.map(kartuSlot).join('')}</div>
        </section>`)
      .join('');

    if (!bolehEdit) {
      body.querySelectorAll('input, textarea, select, button').forEach((n) => ((n as HTMLInputElement).disabled = true));
    }
  }

  function kartuSlot(s: any): string {
    const f = (nama: string, label: string, isi: string, bantuan = '') => `
      <div>
        <label class="block text-sm font-medium mb-1.5" for="s${s.id}-${esc(nama)}">${esc(label)}</label>
        ${isi}
        ${bantuan ? `<p class="mt-1 text-xs text-ink-500 dark:text-cream-300/60">${esc(bantuan)}</p>` : ''}
      </div>`;
    const teks = (nama: string, nilai: any, extra = '') =>
      `<input id="s${s.id}-${esc(nama)}" data-id="${esc(s.id)}" data-field="${esc(nama)}" value="${esc(nilai ?? '')}" ${extra} class="${INPUT}" />`;
    const area = (nama: string, nilai: any, baris = 2, maks = 500) =>
      `<textarea id="s${s.id}-${esc(nama)}" data-id="${esc(s.id)}" data-field="${esc(nama)}" rows="${baris}" maxlength="${maks}" class="${INPUT}">${esc(nilai ?? '')}</textarea>`;

    const tayang = s.enabled === false ? 'Nonaktif'
      : (s.start_at && Date.parse(s.start_at) > Date.now()) ? 'Belum mulai'
      : (s.end_at && Date.parse(s.end_at) < Date.now()) ? 'Berakhir'
      : 'Tayang';
    const warna = tayang === 'Tayang'
      ? 'bg-teal-500/15 text-teal-700 dark:text-teal-300'
      : 'bg-ink-500/15 text-ink-500 dark:text-cream-300/60';

    const sorotan = Array.isArray(s.detail_highlights) ? s.detail_highlights.join('\n') : '';

    return `
      <section class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5 space-y-4" data-slot="${esc(s.id)}">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <h3 class="font-display text-base font-semibold tracking-tightest">${esc(s.partner_name)}</h3>
            <span class="rounded-full px-2.5 py-0.5 text-[0.7rem] font-medium ${warna}">${esc(tayang)}</span>
          </div>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" data-id="${esc(s.id)}" data-field="enabled" ${s.enabled ? 'checked' : ''}
                class="h-4 w-4 rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" />
              Aktif
            </label>
            <button type="button" data-simpan="${esc(s.id)}"
              class="rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-ink-950 hover:bg-amber-400 transition-colors">Simpan</button>
            <button type="button" data-hapus="${esc(s.id)}"
              class="rounded-lg border border-red-500/40 px-3 py-1.5 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-500/10 transition-colors">Hapus</button>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-[6rem_1fr_6rem]">
          ${f('emoji', 'Emoji', teks('emoji', s.emoji, 'maxlength="8"'))}
          ${f('partner_name', 'Nama partner', teks('partner_name', s.partner_name, 'maxlength="80"'))}
          ${f('sort', 'Urutan', teks('sort', s.sort ?? 100, 'inputmode="numeric"'))}
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          ${f('category', 'Kategori',
            `<select id="s${s.id}-category" data-id="${esc(s.id)}" data-field="category" class="${INPUT}">
               ${opsiKategori(kategori, s.category)}
             </select>`,
            'Menentukan kelompok partner ini di CMS dan di dashboard bot.')}
          ${f('title', 'Judul item', teks('title', s.title, 'maxlength="120"'), 'Kosong = memakai nama partner.')}
        </div>

        ${f('description', 'Deskripsi singkat (di list dashboard)', area('description', s.description))}

        <!-- DETAIL PARTNER — isi balasan ephemeral saat tombolnya ditekan. -->
        <div class="rounded-xl border border-amber-500/30 bg-amber-500/[0.04] p-4 space-y-4">
          <div>
            <p class="text-sm font-semibold">Detail partnership (balasan tombol)</p>
            <p class="mt-0.5 text-xs text-ink-500 dark:text-cream-300/60">
              Yang dilihat pemain setelah menekan tombol partner — hanya dia yang melihatnya.
              Kosongkan judul/deskripsi untuk memakai judul item &amp; deskripsi singkat di atas.
            </p>
          </div>

          ${f('detail_title', 'Judul detail', teks('detail_title', s.detail_title, 'maxlength="120" placeholder="kosong = judul item"'))}
          ${f('detail_description', 'Deskripsi detail', area('detail_description', s.detail_description, 5, 2000),
            'Boleh beberapa paragraf. Markdown Discord (**tebal**, *miring*) berlaku.')}
          ${f('detail_highlights', 'Sorotan (satu per baris)', area('detail_highlights', sorotan, 4, 1000),
            'Ditampilkan sebagai daftar bullet di dalam detail. Kosongkan bila tidak perlu.')}

          <div class="grid gap-4 sm:grid-cols-2">
            ${f('detail_link_label', 'Label tombol tautan', teks('detail_link_label', s.detail_link_label, 'maxlength="60" placeholder="kosong = Kunjungi <partner>"'),
              'Tombol tautan muncul DI DALAM detail, memakai Tujuan tombol di bawah.')}
            ${f('detail_image_url', 'Gambar detail (URL)', teks('detail_image_url', s.detail_image_url, 'type="url" placeholder="kosong = banner partner"'))}
          </div>

          ${f('detail_footer', 'Catatan kaki detail', teks('detail_footer', s.detail_footer, 'maxlength="120" placeholder="mis. Berlaku sampai 31 Des"'))}
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          ${f('button_label', 'Label tombol di dashboard', teks('button_label', s.button_label, 'maxlength="60" placeholder="kosong = nama partner"'),
            'Tombol ini membuka detail di atas, bukan link.')}
          ${f('button_url', 'Tujuan tombol tautan', teks('button_url', s.button_url, 'type="url" placeholder="https://…"'),
            'Dipakai tombol tautan di dalam detail. Kosong = detail tampil tanpa tombol tautan.')}
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          ${f('url', 'Tautan "Selengkapnya"', teks('url', s.url, 'type="url"'), 'Cadangan bila Tujuan tombol kosong.')}
          ${f('logo_url', 'Logo (URL)', teks('logo_url', s.logo_url, 'type="url"'), 'Thumbnail di detail; di list bila hanya 1 partner tayang.')}
          ${f('banner_url', 'Banner (URL)', teks('banner_url', s.banner_url, 'type="url"'), 'Tampil bila hanya 1 partner tayang.')}
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          ${f('start_at', 'Mulai tayang', `<input id="s${s.id}-start_at" data-id="${esc(s.id)}" data-field="start_at" type="datetime-local" value="${esc(keInputWaktu(s.start_at))}" class="${INPUT}" />`, 'Kosong = langsung tayang.')}
          ${f('end_at', 'Berakhir', `<input id="s${s.id}-end_at" data-id="${esc(s.id)}" data-field="end_at" type="datetime-local" value="${esc(keInputWaktu(s.end_at))}" class="${INPUT}" />`, 'Kosong = tanpa batas.')}
        </div>

        <p class="text-xs text-ink-500 dark:text-cream-300/60">Diperbarui: ${esc(s.updated_at ? fmtWaktu(s.updated_at) : '—')}</p>
      </section>`;
  }

  async function onTambah() {
    if (!bolehEdit) return;
    const nama = window.prompt('Nama partner baru:');
    if (!nama || !nama.trim()) return;

    const supabase = getSupabase();
    if (!supabase) return;
    const { data: sesi } = await supabase.auth.getSession();
    const { error } = await supabase.from('partnership_slots').insert({
      partner_name: nama.trim(),
      enabled: false, // aman: baru tayang setelah admin melengkapi & mengaktifkan
      sort: 100,
      // Kategori pertama yang tersedia supaya partner baru tidak langsung
      // mendarat di section "Lainnya".
      category: kategori[0]?.key ?? 'lainnya',
      updated_by: sesi.session?.user.id ?? null,
    });

    const pesan = document.getElementById('slot-pesan')!;
    if (error) {
      pesan.textContent = pesanError(error);
      pesan.className = 'text-sm text-red-600 dark:text-red-400';
      return;
    }
    pesan.textContent = 'Partner ditambahkan (masih nonaktif). Lengkapi detailnya lalu aktifkan.';
    pesan.className = 'text-sm text-teal-700 dark:text-teal-300';
    void muatSlots();
  }

  async function onAksiSlot(e: Event) {
    const el = (e.target as HTMLElement).closest('button[data-simpan], button[data-hapus]') as HTMLButtonElement | null;
    if (!el || !bolehEdit) return;

    const supabase = getSupabase();
    if (!supabase) return;
    const pesan = document.getElementById('slot-pesan')!;
    pesan.className = 'text-sm';

    // ── Hapus ──
    if (el.hasAttribute('data-hapus')) {
      const id = el.dataset.hapus!;
      if (!window.confirm('Hapus partner ini dari Dashboard Partnership?')) return;
      const { error } = await supabase.from('partnership_slots').delete().eq('id', id);
      pesan.textContent = error ? pesanError(error) : 'Partner dihapus.';
      pesan.className = error ? 'text-sm text-red-600 dark:text-red-400' : 'text-sm text-teal-700 dark:text-teal-300';
      if (!error) void muatSlots();
      return;
    }

    // ── Simpan ──
    const id = el.dataset.simpan!;
    const patch: Record<string, any> = {};
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[data-id="${CSS.escape(id)}"][data-field]`).forEach((n) => {
      const field = n.dataset.field!;
      if (field === 'enabled') patch.enabled = (n as HTMLInputElement).checked;
      else if (field === 'sort') patch.sort = Number(n.value.trim() || 100);
      else if (field === 'start_at' || field === 'end_at') patch[field] = keIso(n.value.trim());
      else if (field === 'detail_highlights') {
        patch.detail_highlights = n.value.split('\n').map((s) => s.trim()).filter(Boolean).slice(0, 10);
      } else if (field === 'category') patch.category = n.value.trim() || 'lainnya';
      else patch[field] = n.value.trim() || null;
    });

    if (!patch.partner_name) {
      pesan.textContent = 'Nama partner wajib diisi.';
      pesan.className = 'text-sm text-red-600 dark:text-red-400';
      return;
    }
    // Semua kolom URL tetap wajib http(s) — nilainya dipakai bot sebagai href.
    for (const label of ['button_url', 'url', 'logo_url', 'banner_url', 'detail_image_url'] as const) {
      const u = patch[label];
      if (u && !/^https?:\/\//i.test(String(u))) {
        pesan.textContent = `Kolom ${label} harus diawali http:// atau https://.`;
        pesan.className = 'text-sm text-red-600 dark:text-red-400';
        return;
      }
    }
    // Tombol partner kini membuka DETAIL, jadi label tanpa URL bukan lagi
    // kesalahan. Yang perlu diingatkan justru detail yang masih kosong: pemain
    // akan mendapat balasan seadanya.
    if (!patch.detail_description && !patch.description) {
      pesan.textContent = 'Isi minimal Deskripsi singkat atau Deskripsi detail — itu yang dibaca pemain saat menekan tombol.';
      pesan.className = 'text-sm text-red-600 dark:text-red-400';
      return;
    }
    if (patch.detail_link_label && !patch.button_url && !patch.url) {
      pesan.textContent = 'Label tombol tautan terisi tapi tidak ada URL tujuan — tombol tautan tidak akan tampil.';
      pesan.className = 'text-sm text-red-600 dark:text-red-400';
      return;
    }
    if (patch.start_at && patch.end_at && Date.parse(patch.start_at) >= Date.parse(patch.end_at)) {
      pesan.textContent = 'Tanggal mulai harus lebih awal dari tanggal berakhir.';
      pesan.className = 'text-sm text-red-600 dark:text-red-400';
      return;
    }

    el.disabled = true;
    const { data: sesi } = await supabase.auth.getSession();
    const { error } = await supabase.from('partnership_slots')
      .update({ ...patch, updated_at: new Date().toISOString(), updated_by: sesi.session?.user.id ?? null })
      .eq('id', id);
    el.disabled = false;

    pesan.textContent = error ? pesanError(error) : 'Partner tersimpan. Bot menyegarkan dalam beberapa menit.';
    pesan.className = error ? 'text-sm text-red-600 dark:text-red-400' : 'text-sm text-teal-700 dark:text-teal-300';
    if (!error) void muatSlots();
  }
</script>
