---
// Partnership — Kategori.
//
// Sumber tunggal struktur kategori Partnership. Sebelum ini partner & produk
// menumpuk jadi satu daftar panjang; sekarang keduanya dikelompokkan memakai
// baris-baris di halaman ini.
//
// Kategori yang sama dipakai TIGA tempat, jadi mengubahnya di sini otomatis
// konsisten di semuanya:
//   • CMS      → section per kategori di tab Produk & Harga dan Lobby Bot.
//   • Publik   → pengelompokan paket di /partnership (setelah build).
//   • Bot      → urutan & judul kelompok di Dashboard Partnership (beberapa
//                menit setelah disimpan, tanpa restart).
//
// `icon` menyimpan NAMA ikon (Lucide) untuk CMS — bukan markup — sementara
// `emoji` dipakai bot karena Discord tidak bisa merender SVG.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
import PartnershipTabs from '@components/PartnershipTabs.astro';
---

<AdminLayout title="Kategori Partnership" active="partnership">
  <AdminPageHeader
    eyebrow="Partnership"
    title="Kategori"
    description="Struktur kategori untuk partner & paket — dipakai CMS, halaman publik, dan Dashboard Partnership di bot."
  />
  <PartnershipTabs active="categories" />

  <div class="px-6 lg:px-10 py-8 space-y-6 max-w-3xl">
    <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 px-5 py-4">
      <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">
        Urutan section di CMS maupun di bot mengikuti kolom <strong>Urutan</strong> di sini.
        <strong>Cakupan</strong> menentukan di mana kategori boleh dipilih: partner (Lobby Bot),
        paket (Produk &amp; Harga), atau keduanya. Kategori yang dinonaktifkan tidak lagi
        muncul sebagai pilihan, tapi item yang terlanjur memakainya tetap tampil.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-display text-lg font-semibold tracking-tightest">Daftar kategori</h2>
      <button type="button" id="btn-tambah"
        class="rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-amber-400 transition-colors">
        + Tambah kategori
      </button>
    </div>

    <div id="kat-body" class="space-y-5"></div>
    <p id="kat-pesan" class="text-sm" role="status" aria-live="polite"></p>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import { ikonKategori, type Kategori } from '@/lib/partnership-kategori';

  const INPUT = 'w-full rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2.5 text-sm outline-none focus:border-amber-500 transition-colors';

  // Nama ikon yang dikenali registry di partnership-kategori.ts. Dropdown ini
  // sengaja terbatas: nama di luar daftar akan jatuh ke ikon netral.
  const IKON = ['users', 'sparkles', 'tag', 'calendar', 'megaphone', 'layout', 'store', 'star', 'gift', 'settings', 'handshake'];

  const SCOPE: Record<string, string> = {
    semua: 'Partner & paket',
    partner: 'Partner (Lobby Bot)',
    produk: 'Paket (Produk & Harga)',
  };

  let bolehEdit = false;

  document.addEventListener('admin:ready', (e) => {
    const profile = (e as CustomEvent).detail;
    bolehEdit = profile?.role === 'owner' || profile?.role === 'admin';
    void muat();
    document.getElementById('btn-tambah')!.addEventListener('click', onTambah);
    document.getElementById('kat-body')!.addEventListener('click', onAksi);
  });

  /** Jumlah pemakai tiap kategori — supaya admin tahu dampak sebelum menghapus. */
  async function hitungPemakai(): Promise<Map<string, { partner: number; produk: number }>> {
    const supabase = getSupabase();
    const peta = new Map<string, { partner: number; produk: number }>();
    if (!supabase) return peta;

    const [slot, prod] = await Promise.all([
      supabase.from('partnership_slots').select('category'),
      supabase.from('partnership_products').select('category'),
    ]);

    const tambah = (key: string, jenis: 'partner' | 'produk') => {
      const k = String(key ?? '').trim() || 'lainnya';
      if (!peta.has(k)) peta.set(k, { partner: 0, produk: 0 });
      peta.get(k)![jenis] += 1;
    };
    for (const r of (slot.data ?? []) as any[]) tambah(r.category, 'partner');
    for (const r of (prod.data ?? []) as any[]) tambah(r.category, 'produk');
    return peta;
  }

  async function muat() {
    const body = document.getElementById('kat-body')!;
    body.innerHTML = stateBlock('loading', '');

    const supabase = getSupabase();
    if (!supabase) { body.innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.'); return; }

    const [{ data, error }, pemakai] = await Promise.all([
      supabase.from('partnership_categories')
        .select('key, label, description, icon, emoji, scope, enabled, sort')
        .order('sort', { ascending: true }),
      hitungPemakai(),
    ]);

    if (error) { body.innerHTML = stateBlock('error', pesanError(error)); return; }
    if (!data || data.length === 0) {
      body.innerHTML = stateBlock('empty', 'Belum ada kategori. Jalankan supabase/schema.sql terbaru.');
      return;
    }

    body.innerHTML = (data as Kategori[]).map((c) => kartu(c, pemakai.get(c.key))).join('');

    if (!bolehEdit) {
      body.querySelectorAll('input, textarea, select, button').forEach((n) => ((n as HTMLInputElement).disabled = true));
      (document.getElementById('btn-tambah') as HTMLButtonElement).disabled = true;
      document.getElementById('kat-pesan')!.textContent = 'Peran kamu hanya bisa melihat.';
    }
  }

  function kartu(c: Kategori, pakai?: { partner: number; produk: number }): string {
    const f = (nama: string, label: string, isi: string, bantuan = '') => `
      <div>
        <label class="block text-sm font-medium mb-1.5" for="k-${esc(c.key)}-${esc(nama)}">${esc(label)}</label>
        ${isi}
        ${bantuan ? `<p class="mt-1 text-xs text-ink-500 dark:text-cream-300/60">${esc(bantuan)}</p>` : ''}
      </div>`;
    const teks = (nama: string, nilai: any, extra = '') =>
      `<input id="k-${esc(c.key)}-${esc(nama)}" data-key="${esc(c.key)}" data-field="${esc(nama)}" value="${esc(nilai ?? '')}" ${extra} class="${INPUT}" />`;

    const jumlah = `${pakai?.partner ?? 0} partner · ${pakai?.produk ?? 0} paket`;

    return `
      <section class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5 space-y-4">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="flex items-start gap-3">
            ${ikonKategori(c)}
            <div class="min-w-0">
              <h3 class="font-display text-base font-semibold tracking-tightest">${esc(c.label)}</h3>
              <p class="font-mono text-xs text-ink-500 dark:text-cream-300/60">${esc(c.key)} · ${esc(jumlah)}</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 text-sm font-medium">
              <input type="checkbox" data-key="${esc(c.key)}" data-field="enabled" ${c.enabled !== false ? 'checked' : ''}
                class="h-4 w-4 rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" />
              Aktif
            </label>
            <button type="button" data-simpan="${esc(c.key)}"
              class="rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-ink-950 hover:bg-amber-400 transition-colors">Simpan</button>
            <button type="button" data-hapus="${esc(c.key)}" data-pakai="${(pakai?.partner ?? 0) + (pakai?.produk ?? 0)}"
              class="rounded-lg border border-red-500/40 px-3 py-1.5 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-500/10 transition-colors">Hapus</button>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-[1fr_6rem_6rem]">
          ${f('label', 'Nama kategori', teks('label', c.label, 'maxlength="60"'))}
          ${f('emoji', 'Emoji (bot)', teks('emoji', c.emoji, 'maxlength="8"'), 'Dipakai Discord.')}
          ${f('sort', 'Urutan', teks('sort', c.sort ?? 100, 'inputmode="numeric"'))}
        </div>

        ${f('description', 'Deskripsi',
          `<textarea id="k-${esc(c.key)}-description" data-key="${esc(c.key)}" data-field="description" rows="2" maxlength="200" class="${INPUT}">${esc(c.description ?? '')}</textarea>`,
          'Tampil di bawah judul kategori (CMS & dashboard bot).')}

        <div class="grid gap-4 sm:grid-cols-2">
          ${f('icon', 'Ikon (CMS)',
            `<select id="k-${esc(c.key)}-icon" data-key="${esc(c.key)}" data-field="icon" class="${INPUT}">
               ${IKON.map((i) => `<option value="${esc(i)}" ${c.icon === i ? 'selected' : ''}>${esc(i)}</option>`).join('')}
             </select>`)}
          ${f('scope', 'Cakupan',
            `<select id="k-${esc(c.key)}-scope" data-key="${esc(c.key)}" data-field="scope" class="${INPUT}">
               ${Object.entries(SCOPE).map(([v, l]) => `<option value="${esc(v)}" ${(c.scope ?? 'semua') === v ? 'selected' : ''}>${esc(l)}</option>`).join('')}
             </select>`,
            'Menentukan di tab mana kategori ini bisa dipilih.')}
        </div>
      </section>`;
  }

  function lapor(teks: string, sukses = false) {
    const pesan = document.getElementById('kat-pesan')!;
    pesan.textContent = teks;
    pesan.className = sukses
      ? 'text-sm text-teal-700 dark:text-teal-300'
      : 'text-sm text-red-600 dark:text-red-400';
  }

  async function onTambah() {
    if (!bolehEdit) return;
    const label = window.prompt('Nama kategori baru (mis. "Server & Komunitas"):');
    if (!label || !label.trim()) return;

    // Key dibuat otomatis dari nama supaya admin tidak perlu memikirkan slug,
    // dan tetap aman dipakai bot (huruf kecil, tanpa spasi).
    const key = label.trim().toLowerCase().normalize('NFKD')
      .replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 40);
    if (!key) { lapor('Nama kategori harus mengandung huruf atau angka.'); return; }

    const supabase = getSupabase();
    if (!supabase) return;
    const { data: sesi } = await supabase.auth.getSession();
    const { error } = await supabase.from('partnership_categories').insert({
      key,
      label: label.trim(),
      scope: 'semua',
      sort: 100,
      updated_by: sesi.session?.user.id ?? null,
    });

    if (error) {
      lapor(error.code === '23505' ? `Kategori "${key}" sudah ada.` : pesanError(error));
      return;
    }
    lapor(`Kategori "${key}" ditambahkan. Lengkapi ikon, emoji, dan cakupannya.`, true);
    void muat();
  }

  async function onAksi(e: Event) {
    const el = (e.target as HTMLElement).closest('button[data-simpan], button[data-hapus]') as HTMLButtonElement | null;
    if (!el || !bolehEdit) return;

    const supabase = getSupabase();
    if (!supabase) return;

    // ── Hapus ──
    if (el.hasAttribute('data-hapus')) {
      const key = el.dataset.hapus!;
      const dipakai = Number(el.dataset.pakai ?? 0);
      if (key === 'lainnya') {
        lapor('Kategori "lainnya" adalah penampung bawaan dan tidak bisa dihapus.');
        return;
      }
      const peringatan = dipakai > 0
        ? `${dipakai} item masih memakai kategori ini. Setelah dihapus, item tersebut pindah ke section "Lainnya". Lanjutkan?`
        : 'Hapus kategori ini?';
      if (!window.confirm(peringatan)) return;

      const { error } = await supabase.from('partnership_categories').delete().eq('key', key);
      if (error) { lapor(pesanError(error)); return; }
      lapor('Kategori dihapus.', true);
      void muat();
      return;
    }

    // ── Simpan ──
    const key = el.dataset.simpan!;
    const patch: Record<string, any> = {};
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[data-key="${CSS.escape(key)}"][data-field]`).forEach((n) => {
      const field = n.dataset.field!;
      if (field === 'enabled') patch.enabled = (n as HTMLInputElement).checked;
      else if (field === 'sort') patch.sort = Number.parseInt(n.value.trim(), 10) || 100;
      else patch[field] = n.value.trim() || null;
    });

    if (!patch.label) { lapor('Nama kategori wajib diisi.'); return; }

    el.disabled = true;
    const { data: sesi } = await supabase.auth.getSession();
    const { error } = await supabase.from('partnership_categories')
      .update({ ...patch, updated_at: new Date().toISOString(), updated_by: sesi.session?.user.id ?? null })
      .eq('key', key);
    el.disabled = false;

    if (error) { lapor(pesanError(error)); return; }
    lapor('Kategori tersimpan. Bot menyegarkan dalam beberapa menit.', true);
    void muat();
  }
</script>
