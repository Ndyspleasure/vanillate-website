---
// Partnership — Produk & Harga.
//
// Inilah yang mengendalikan harga di halaman publik /partnership. Perubahan di
// sini tersimpan ke Supabase, lalu ditarik saat build (scripts/sync-content.mjs)
// sehingga halaman publik menampilkan harga terbaru tanpa mengubah kode.
//
// Dua hal yang membedakan halaman ini dari versi sebelumnya:
//   • HARGA BEBAS — tidak ada `min`, `max`, atau kelipatan `step`. Admin boleh
//     mengetik nominal berapa pun ("150000", "150.000", "Rp 1.250.000,75");
//     yang ditolak hanya input yang bukan angka.
//   • KATEGORI — produk dikelompokkan per kategori (satu section per kategori)
//     memakai `partnership_categories`, bukan menumpuk jadi satu daftar.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
import PartnershipTabs from '@components/PartnershipTabs.astro';
import { url } from '@utils/url';
---

<AdminLayout title="Produk & Harga" active="partnership">
  <AdminPageHeader
    eyebrow="Partnership"
    title="Produk & Harga"
    description="Atur produk yang dijual beserta harganya. Nilai di sini yang tampil di halaman publik."
  />
  <PartnershipTabs active="products" />

  <div class="px-6 lg:px-10 py-8 space-y-6 max-w-3xl">
    <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 px-5 py-4">
      <p class="text-sm text-ink-600 dark:text-cream-200/80 leading-relaxed">
        Perubahan tersimpan ke database saat kamu menekan Simpan, lalu tampil di
        <strong>/partnership</strong> setelah website di-build ulang (berjalan otomatis terjadwal).
        Harga <strong>bebas nominal</strong> — ketik angka berapa pun; kosongkan bila harganya
        belum ditentukan (tampil <strong>—</strong>, bukan "Rp 0").
        Kategori produk diatur di tab <a class="font-medium text-amber-700 dark:text-amber-400 hover:underline" href={url('/admin/partnership/categories')}>Kategori</a>.
      </p>
    </div>

    <form id="form-produk" class="space-y-10">
      <div id="produk-body" class="space-y-10"></div>

      <div id="produk-aksi" class="hidden flex-wrap items-center gap-3">
        <button type="submit" id="btn-simpan"
          class="rounded-xl bg-amber-500 px-5 py-2.5 text-sm font-semibold text-ink-950 hover:bg-amber-400 disabled:opacity-60 disabled:cursor-not-allowed transition-colors">
          Simpan perubahan
        </button>
        <p id="produk-pesan" class="text-sm" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { getSupabase } from '@/lib/supabase';
  import { esc, stateBlock, pesanError } from '@/lib/admin-ui';
  import { headerKategori, kelompokkan, opsiKategori, untukScope, type Kategori } from '@/lib/partnership-kategori';
  import { formatPrice, parsePrice, parseJumlah } from '@data/partnership';

  const INPUT = 'w-full rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-cream-100/40 dark:bg-ink-900/40 px-4 py-2.5 text-sm outline-none focus:border-amber-500 transition-colors';
  let bolehEdit = false;
  let kategori: Kategori[] = [];

  document.addEventListener('admin:ready', (e) => {
    const profile = (e as CustomEvent).detail;
    bolehEdit = profile?.role === 'owner' || profile?.role === 'admin';
    void muat();
    document.getElementById('form-produk')!.addEventListener('submit', onSimpan);
    // Pratinjau harga ikut berubah saat diketik — admin langsung melihat
    // bagaimana nominalnya dibaca sistem (mis. "150.000" → Rp150.000).
    document.getElementById('produk-body')!.addEventListener('input', onKetik);
  });

  async function muat() {
    const body = document.getElementById('produk-body')!;
    body.innerHTML = stateBlock('loading', '');

    const supabase = getSupabase();
    if (!supabase) { body.innerHTML = stateBlock('error', 'Koneksi ke Supabase belum dikonfigurasi.'); return; }

    const [kat, prod] = await Promise.all([
      supabase.from('partnership_categories')
        .select('key, label, description, icon, emoji, scope, enabled, sort')
        .order('sort', { ascending: true }),
      supabase.from('partnership_products')
        .select('key, name, tagline, description, channel, category, price, currency, price_unit, price_note, features, badge, cta_label, cta_mode, cta_url, enabled, sort, unit, min_quantity, banner_url, info, terms')
        .order('sort', { ascending: true }),
    ]);

    if (prod.error) { body.innerHTML = stateBlock('error', pesanError(prod.error)); return; }
    const data = prod.data ?? [];
    if (data.length === 0) {
      body.innerHTML = stateBlock('empty', 'Belum ada produk. Jalankan supabase/schema.sql terbaru.');
      return;
    }

    // Kategori gagal dimuat (mis. schema belum diperbarui) tidak boleh membuat
    // halaman kosong — produk tetap tampil, hanya tanpa pengelompokan resmi.
    kategori = untukScope((kat.error ? [] : (kat.data ?? [])) as Kategori[], 'produk');

    body.innerHTML = kelompokkan(data as any[], kategori)
      .map((g) => `
        <section class="space-y-4">
          ${headerKategori(g.kategori, g.items.length)}
          <div class="space-y-6">${g.items.map(kartu).join('')}</div>
        </section>`)
      .join('');
    document.getElementById('produk-aksi')!.classList.remove('hidden');

    if (!bolehEdit) {
      body.querySelectorAll('input, textarea, select').forEach((n) => ((n as HTMLInputElement).disabled = true));
      const btn = document.getElementById('btn-simpan') as HTMLButtonElement;
      btn.disabled = true;
      document.getElementById('produk-pesan')!.textContent = 'Peran kamu hanya bisa melihat.';
    }
  }

  /** Nilai harga/minimum untuk kotak input: apa adanya, tanpa pemformatan. */
  const nilaiAngka = (v: any) => (v === null || v === undefined || String(v).trim() === '' ? '' : String(v));

  function kartu(p: any): string {
    const fitur = Array.isArray(p.features) ? p.features.join('\n') : '';
    const f = (nama: string, label: string, isi: string, bantuan = '') => `
      <div>
        <label class="block text-sm font-medium mb-1.5" for="${esc(p.key)}-${esc(nama)}">${esc(label)}</label>
        ${isi}
        ${bantuan ? `<p class="mt-1 text-xs text-ink-500 dark:text-cream-300/60">${esc(bantuan)}</p>` : ''}
      </div>`;

    const teks = (nama: string, nilai: string, extra = '') =>
      `<input id="${esc(p.key)}-${esc(nama)}" data-key="${esc(p.key)}" data-field="${esc(nama)}" value="${esc(nilai ?? '')}" ${extra} class="${INPUT}" />`;

    return `
      <section class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="font-display text-lg font-semibold tracking-tightest">${esc(p.name)}</h2>
            <p class="font-mono text-xs text-ink-500 dark:text-cream-300/60">${esc(p.key)} · channel: ${esc(p.channel)}</p>
          </div>
          <label class="flex items-center gap-2 text-sm font-medium">
            <input type="checkbox" data-key="${esc(p.key)}" data-field="enabled" ${p.enabled ? 'checked' : ''}
              class="h-4 w-4 rounded border-ink-900/20 dark:border-cream-100/20 text-amber-500 focus:ring-amber-500" />
            Tampilkan di halaman publik
          </label>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          ${f('name', 'Nama produk', teks('name', p.name, 'maxlength="80"'))}
          ${f('category', 'Kategori',
            `<select id="${esc(p.key)}-category" data-key="${esc(p.key)}" data-field="category" class="${INPUT}">
               ${opsiKategori(kategori, p.category)}
             </select>`,
            'Menentukan pengelompokan di CMS dan di halaman publik.')}
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          ${f('badge', 'Badge', teks('badge', p.badge, 'maxlength="30" placeholder="mis. Terpopuler"'), 'Kosongkan bila tidak perlu.')}
          ${f('sort', 'Urutan', teks('sort', nilaiAngka(p.sort), 'inputmode="numeric" placeholder="100"'), 'Makin kecil makin atas.')}
        </div>

        ${f('tagline', 'Tagline', teks('tagline', p.tagline, 'maxlength="120"'), 'Satu baris singkat di bawah nama produk.')}

        ${f('description', 'Deskripsi',
          `<textarea id="${esc(p.key)}-description" data-key="${esc(p.key)}" data-field="description" rows="3" maxlength="600" class="${INPUT}">${esc(p.description ?? '')}</textarea>`)}

        <!-- HARGA BEBAS: kotak teks biasa, bukan input number. Tidak ada min,
             max, atau kelipatan step yang bisa menolak nominal tertentu. -->
        <div class="grid gap-4 sm:grid-cols-3">
          ${f('price', 'Harga', teks('price', nilaiAngka(p.price), 'inputmode="decimal" placeholder="kosong = —"'),
            'Bebas nominal: 150000, 150.000, atau 1.250.000,75. Kosong → tampil "—".')}
          ${f('currency', 'Mata uang', teks('currency', p.currency ?? 'IDR', 'maxlength="8"'))}
          ${f('price_unit', 'Satuan harga', teks('price_unit', p.price_unit, 'maxlength="40" placeholder="per campaign"'))}
        </div>

        ${f('price_note', 'Catatan harga', teks('price_note', p.price_note, 'maxlength="160" placeholder="mis. Harga dapat menyesuaikan volume"'))}

        <!-- Satuan & minimum order paket. Dipakai halaman publik DAN Dashboard
             Partnership di lobby bot. Keduanya kolom biasa → bebas diubah. -->
        <div class="grid gap-4 sm:grid-cols-2">
          ${f('unit', 'Satuan paket', teks('unit', p.unit, 'maxlength="24" placeholder="mis. Pemain / Hari"'),
            'Broadcast DM biasanya "Pemain"; Broadcast Lobby "Hari".')}
          ${f('min_quantity', 'Minimum order', teks('min_quantity', nilaiAngka(p.min_quantity), 'inputmode="numeric" placeholder="mis. 100"'),
            'Bebas angka, tanpa batas atas. Kosong = tanpa minimum.')}
        </div>

        ${f('info', 'Informasi tambahan', teks('info', p.info, 'maxlength="200"'), 'Satu baris; tampil di daftar paket dalam bot.')}
        ${f('terms', 'Ketentuan paket', teks('terms', p.terms, 'maxlength="200"'), 'Ringkas; tampil miring di bawah paket.')}
        ${f('banner_url', 'Banner paket (URL)', teks('banner_url', p.banner_url, 'type="url" placeholder="https://…"'))}

        ${f('features', 'Fitur (satu per baris)',
          `<textarea id="${esc(p.key)}-features" data-key="${esc(p.key)}" data-field="features" rows="4" class="${INPUT}">${esc(fitur)}</textarea>`,
          'Ditampilkan sebagai daftar bullet di kartu produk.')}

        <div class="grid gap-4 sm:grid-cols-3">
          ${f('cta_label', 'Label tombol', teks('cta_label', p.cta_label, 'maxlength="40"'))}
          ${f('cta_mode', 'Tujuan tombol',
            `<select id="${esc(p.key)}-cta_mode" data-key="${esc(p.key)}" data-field="cta_mode" class="${INPUT}">
               <option value="whatsapp" ${p.cta_mode === 'whatsapp' ? 'selected' : ''}>WhatsApp official</option>
               <option value="url" ${p.cta_mode === 'url' ? 'selected' : ''}>URL kustom</option>
             </select>`,
            'WhatsApp: pesan otomatis terisi nama produk & kategori.')}
          ${f('cta_url', 'URL kustom', teks('cta_url', p.cta_url, 'type="url" placeholder="dipakai bila mode URL"'))}
        </div>

        <p class="text-xs text-ink-500 dark:text-cream-300/60">
          Pratinjau harga: <strong data-preview="${esc(p.key)}">${esc(pratinjau(p.price, p.currency, p.unit, p.price_unit, p.min_quantity))}</strong>
        </p>
      </section>`;
  }

  /** Satu baris pratinjau: harga + satuan + minimum, persis seperti di publik. */
  function pratinjau(price: any, currency: any, unit: any, priceUnit: any, minQty: any): string {
    const harga = parsePrice(price);
    if (!harga.valid) return 'Harga tidak terbaca sebagai angka';
    const satuan = String(unit ?? '').trim()
      ? ` / ${String(unit).trim()}`
      : (String(priceUnit ?? '').trim() ? ` ${String(priceUnit).trim()}` : '');
    const min = parseJumlah(minQty);
    const minimum = min.valid && min.value !== null && min.value !== 0
      ? ` · Minimum ${new Intl.NumberFormat('id-ID').format(min.value)}${String(unit ?? '').trim() ? ` ${String(unit).trim()}` : ''}`
      : '';
    return `${formatPrice(harga.value, String(currency || 'IDR'))}${satuan}${minimum}`;
  }

  /** Perbarui pratinjau kartu yang sedang diketik. */
  function onKetik(e: Event) {
    const el = e.target as HTMLInputElement | null;
    const key = el?.dataset?.key;
    if (!key) return;
    const target = document.querySelector(`[data-preview="${CSS.escape(key)}"]`);
    if (!target) return;
    const ambil = (field: string) =>
      (document.querySelector(`[data-key="${CSS.escape(key)}"][data-field="${field}"]`) as HTMLInputElement | null)?.value ?? '';
    target.textContent = pratinjau(ambil('price'), ambil('currency'), ambil('unit'), ambil('price_unit'), ambil('min_quantity'));
  }

  function gagal(pesan: HTMLElement, btn: HTMLButtonElement, teks: string) {
    pesan.textContent = teks;
    pesan.className = 'text-sm text-red-600 dark:text-red-400';
    btn.disabled = false;
    btn.textContent = 'Simpan perubahan';
  }

  async function onSimpan(e: Event) {
    e.preventDefault();
    if (!bolehEdit) return;

    const supabase = getSupabase();
    if (!supabase) return;

    const btn = document.getElementById('btn-simpan') as HTMLButtonElement;
    const pesan = document.getElementById('produk-pesan')!;
    btn.disabled = true;
    btn.textContent = 'Menyimpan…';
    pesan.textContent = '';
    pesan.className = 'text-sm';

    const { data: sesi } = await supabase.auth.getSession();
    const uid = sesi.session?.user.id ?? null;

    // Kumpulkan field per produk.
    const perProduk = new Map<string, Record<string, any>>();
    const bermasalah: string[] = [];
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[data-key][data-field]').forEach((n) => {
      const key = n.dataset.key!;
      const field = n.dataset.field!;
      if (!perProduk.has(key)) perProduk.set(key, {});
      const bucket = perProduk.get(key)!;

      if (field === 'enabled') {
        bucket.enabled = (n as HTMLInputElement).checked;
      } else if (field === 'price') {
        // Harga bebas nominal: hanya dibaca, tidak dibatasi. Kosong disimpan
        // sebagai NULL → halaman publik menampilkan "—", bukan "Rp 0".
        const hasil = parsePrice(n.value);
        if (!hasil.valid) bermasalah.push(`Harga produk "${key}" bukan angka yang bisa dibaca.`);
        else bucket.price = hasil.value;
      } else if (field === 'min_quantity') {
        const hasil = parseJumlah(n.value);
        if (!hasil.valid) bermasalah.push(`Minimum order produk "${key}" bukan angka yang bisa dibaca.`);
        else bucket.min_quantity = hasil.value;
      } else if (field === 'sort') {
        const hasil = parseJumlah(n.value);
        bucket.sort = hasil.valid && hasil.value !== null ? hasil.value : 100;
      } else if (field === 'features') {
        bucket.features = n.value.split('\n').map((s) => s.trim()).filter(Boolean);
      } else {
        bucket[field] = n.value.trim();
      }
    });

    if (bermasalah.length > 0) { gagal(pesan, btn, bermasalah[0]); return; }

    for (const [key, patch] of perProduk) {
      if (patch.cta_mode === 'url' && !patch.cta_url) {
        gagal(pesan, btn, `Produk "${key}" memakai mode URL tapi URL-nya kosong.`);
        return;
      }
    }

    const hasil = await Promise.all(
      [...perProduk.entries()].map(([key, patch]) =>
        supabase.from('partnership_products')
          .update({ ...patch, updated_at: new Date().toISOString(), updated_by: uid })
          .eq('key', key)),
    );

    const gagalSimpan = hasil.find((r) => r.error);
    if (gagalSimpan?.error) {
      gagal(pesan, btn, pesanError(gagalSimpan.error));
      return;
    }

    pesan.textContent = 'Tersimpan. Harga baru tampil di /partnership setelah build berikutnya.';
    pesan.className = 'text-sm text-teal-700 dark:text-teal-300';
    void muat();

    btn.disabled = false;
    btn.textContent = 'Simpan perubahan';
  }
</script>
