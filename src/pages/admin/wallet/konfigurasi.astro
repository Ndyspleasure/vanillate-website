---
// 💜 Vanillate Wallet › Konfigurasi (khusus owner).
// Nilai VP (`sys.wallet.config.set`) dan daftar akun uji
// (`sys.wallet.testers.set`), tujuan penarikan yang dibuka
// (`sys.wallet.methods.set`), sakelar cek nama BRI (`sys.wallet.namecheck.set`,
// bawaan mati sampai onboarding produksi BRI selesai). Sakelar publik SENGAJA tidak ada di sini:
// pembukaan untuk umum menunggu gerbang aktivasi (docs/wallet-security-review.md §9.3).
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Konfigurasi Wallet" active="wallet-konfigurasi">
  <AdminPageHeader eyebrow="Vanillate Wallet" title="Konfigurasi" description="Nilai Vani Poin, akun uji, dan tujuan penarikan. Perubahan nilai berlaku untuk transaksi berikutnya, transaksi lama tidak berubah. Khusus owner." />
  <div class="px-6 lg:px-10 py-8 max-w-5xl space-y-8" id="wk-body"></div>
</AdminLayout>

<script>
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { kirimPerintah } from '@/lib/dev-panel/client';
  import { section, formCard, pasangAksi, pill, table, KELAS } from '@/lib/dev-panel/ui';

  const KUNCI: [string, string, string][] = [
    ['vote_vp', 'VP per vote Top.gg', 'Bawaan 50'],
    ['activity_vp', 'VP aktivitas harian', 'Bawaan 1, sekali sehari WIB'],
    ['min_withdraw_vp', 'Minimum penarikan (VP)', 'Bawaan 1.000'],
    ['min_account_age_days', 'Umur akun Discord minimum (hari)', 'Bawaan 0'],
    ['counting_required', 'Hitungan Counting benar per hari', 'Bawaan 10'],
    ['vani_messages_required', 'Pesan Chat Vani per hari', 'Bawaan 5'],
    ['transfer_min_vp', 'Minimum transfer (VP)', 'Bawaan 1. Biaya transfer dikunci 0 (keputusan pemilik)'],
    ['transfer_note_max', 'Panjang pesan transfer', 'Bawaan 100'],
  ];
  const TUJUAN: [string, string][] = [
    ['bca', 'BCA'], ['bri', 'BRI'], ['bni', 'BNI'], ['mandiri', 'Mandiri'], ['seabank', 'SeaBank'], ['dana', 'DANA'], ['shopeepay', 'ShopeePay'],
  ];
  let role = 'viewer';

  async function muat() {
    const body = document.getElementById('wk-body')!;
    if (role !== 'owner') { body.innerHTML = stateBlock('empty', 'Halaman ini khusus owner.'); return; }
    body.innerHTML = stateBlock('loading', 'Meminta konfigurasi dari bot...');
    const o = await kirimPerintah('read.wallet.summary');
    if (!o.ok || !o.result) { body.innerHTML = stateBlock('error', o.error ?? 'Konfigurasi tidak tersedia.'); return; }
    const s = o.result;
    const v = s.config?.values ?? {};
    body.innerHTML = [
      section('Akses', `<p class="text-sm">${s.publicOpen ? pill('dibuka untuk publik', 'ok') : pill('tertutup untuk publik', 'warn')} · ${esc(s.testUsers)} akun uji</p>
        <p class="mt-2 text-sm ${KELAS.muted}">Sakelar publik tidak tersedia di sini. Wallet baru dibuka setelah syarat hukum, keamanan, Terms, Privacy, dan kesiapan penarikan terpenuhi (gerbang aktivasi).</p>`),
      section('Akun uji', formCard({ id: 'wk-testers', title: 'Daftar akun uji', submit: 'Simpan akun uji', ownerOnly: true,
        desc: 'Discord ID yang boleh memakai Wallet selama tertutup, dipisah koma atau baris baru (maks. 20). Kosongkan untuk menutup semua. VP akun uji tercatat permanen di ledger.',
        fields: [{ name: 'ids', label: 'Discord ID', type: 'textarea', placeholder: '1036585958553964574' }] })),
      section('Cek nama BRI', `<p class="text-sm">${s.nameCheck?.configured ? pill(`terpasang (${esc(s.nameCheck.env)})`, 'ok') : pill('kredensial BRI belum lengkap', 'warn')}
          ${s.nameCheck?.enabled ? pill('cek nama menyala', 'ok') : pill('cek nama mati', 'warn')}
          ${s.nameCheck?.breakerOpen ? pill('dijeda sementara karena gagal beruntun', 'bad') : ''}</p>
        ${s.nameCheck?.envForcedOff ? `<p class="mt-2 text-sm ${KELAS.muted}">Dimatikan paksa lewat WALLET_NAMECHECK_ENABLED=0 di .env VPS, jadi sakelar di bawah tidak berpengaruh sampai baris itu dihapus.</p>` : ''}
        ${formCard({ id: 'wk-bri-switch', title: 'Sakelar cek nama rekening', submit: 'Simpan sakelar', ownerOnly: true,
          desc: 'Menyala: saat pemain mendaftarkan rekening bank, bot menanyakan nama pemilik ke BRI. Mati: bot tidak menghubungi BRI, rekening tersimpan sebagai nama belum terverifikasi, dan Admin mencocokkan nama saat transfer lewat Tandai nama cocok. Nyalakan setelah onboarding produksi BRI selesai. Uji di bawah tetap bisa dijalankan walau sakelar mati.',
          fields: [{ name: 'enabled', label: 'Nyalakan cek nama BRI', type: 'checkbox', value: String(!!s.nameCheck?.enabled) }] })}
        ${formCard({ id: 'wk-bri', title: 'Uji cek nama BRI', submit: 'Jalankan uji', ownerOnly: true,
          desc: 'Mencoba beberapa variasi (versi path, tanda tangan, Partner ID, format waktu) ke rekening contoh sandbox dan menampilkan kode dari BRI. Tidak menampilkan nama atau nomor, tidak memakai kuota pemain, tercatat. Bisa sampai 1 menit.',
          fields: [
            { name: 'provider', label: 'Bank', type: 'select', value: 'bri', options: [{ value: 'bri', label: 'BRI (rekening contoh 888801000157508)' }, { value: 'bca', label: 'BCA' }, { value: 'bni', label: 'BNI' }, { value: 'mandiri', label: 'Mandiri' }] },
            { name: 'number', label: 'Nomor contoh (opsional)', placeholder: 'kosongkan untuk rekening contoh BRI' },
          ] })}
        <div id="wk-bri-out" class="mt-3"></div>`),
      section('Tujuan penarikan', `${s.keysReady ? '' : `<p class="mb-3 text-sm">${pill('kunci enkripsi belum dipasang', 'warn')} Pemain belum bisa mendaftarkan rekening sampai WALLET_ENC_KEY, WALLET_BIDX_KEY, dan WALLET_PIN_PEPPER dipasang di .env VPS.</p>`}
        ${formCard({ id: 'wk-methods', title: 'Bank dan e-wallet yang dibuka', submit: 'Simpan tujuan', ownerOnly: true,
          desc: 'Hanya tujuh tujuan yang disetujui pemilik. Tujuan yang ditutup tidak bisa dipilih untuk rekening baru; rekening yang sudah terdaftar tidak berubah.',
          fields: TUJUAN.map(([k, label]) => ({ name: `p_${k}`, label, type: 'checkbox' as const, value: String((s.openProviders ?? []).includes(k)) })) })}`),
      section('Nilai VP', formCard({ id: 'wk-config', title: `Versi konfigurasi ${esc(s.config?.version)}`, submit: 'Simpan nilai', ownerOnly: true,
        desc: 'Kurs tetap 1 VP = Rp1. Nilai baru hanya berlaku untuk transaksi berikutnya.',
        fields: KUNCI.map(([k, label, help]) => ({ name: k, label, help, type: 'number' as const, value: String(v[k] ?? ''), required: true })) })),
    ].join('');
    pasangAksi(document.getElementById('wk-testers') as HTMLFormElement, {
      type: 'sys.wallet.testers.set',
      confirm: 'Simpan daftar akun uji?',
      success: (r) => `Tersimpan: ${(r.result?.testUsers ?? []).length} akun uji.`,
      onDone: (r) => { if (r.ok) setTimeout(() => void muat(), 1200); },
    });
    pasangAksi(document.getElementById('wk-bri-switch') as HTMLFormElement, {
      type: 'sys.wallet.namecheck.set',
      confirm: 'Simpan sakelar cek nama rekening?',
      success: (r) => (r.result?.nameCheck?.enabled ? 'Cek nama menyala.' : 'Cek nama mati.'),
      onDone: (r) => { if (r.ok) setTimeout(() => void muat(), 1200); },
    });
    pasangAksi(document.getElementById('wk-bri') as HTMLFormElement, {
      type: 'sys.wallet.namecheck.test',
      send: { timeoutMs: 120_000 },
      success: (r) => {
        const x = r.result ?? {};
        const out = document.getElementById('wk-bri-out')!;
        const VAR = (a: any) => `${esc(a.path)} · ${esc(a.alg)}/${esc(a.enc)} · partner ${a.partner === 'clientId' ? 'Client ID' : 'konfigurasi'} · waktu ${a.millis ? 'dengan' : 'tanpa'} milidetik`;
        if (!x.configured) { out.innerHTML = stateBlock('error', 'Kredensial BRI di .env belum lengkap.'); return 'Belum terpasang.'; }
        if (!x.token?.ok) { out.innerHTML = stateBlock('error', `Token gagal: ${esc(x.token?.why ?? '')} ${esc(x.token?.msg ?? '')}`); return 'Token gagal.'; }
        const saran: string[] = [];
        const w = x.working;
        if (w) {
          const intern = x.provider === 'bri';
          saran.push(`BRI_SNAP_PATH_${intern ? 'INTERNAL' : 'EXTERNAL'}=${w.path}`);
          saran.push(`BRI_SNAP_SIG_ALG_${intern ? 'INTERNAL' : 'EXTERNAL'}=${w.alg}`);
          saran.push(`BRI_SNAP_SIG_ENCODING=${w.enc}`);
          saran.push(`BRI_SNAP_INQUIRY_TS_MILLIS=${w.millis ? '1' : '0'}`);
          if (w.partner === 'clientId') saran.push('BRI_SNAP_SANDBOX_PARTNER_ID=<isi sama dengan Client ID>');
        }
        out.innerHTML = `${w ? `<div class="${KELAS.kartu} text-sm"><p>${pill('berhasil', 'ok')} Variasi yang diterima BRI: ${VAR(w)}</p>
            <p class="mt-2">Pastikan baris ini ada di .env VPS, lalu Restart:</p><pre class="mt-1 text-xs whitespace-pre-wrap select-all">${esc(saran.join('\n'))}</pre></div>`
          : stateBlock('error', 'Belum ada variasi yang diterima BRI. Kirim tabel di bawah ke developer.')}
          <div class="mt-3">${table(['Variasi', 'HTTP', 'Kode', 'Pesan BRI'], (x.attempts ?? []).map((a: any) => [
            `<span class="text-xs">${VAR(a)}</span>`, esc(a.http ?? ''), `<code>${esc(a.code ?? '')}</code>`, esc(a.msg ?? ''),
          ]))}</div>`;
        return w ? 'Ada variasi yang berhasil.' : 'Selesai, belum berhasil.';
      },
    });
    pasangAksi(document.getElementById('wk-methods') as HTMLFormElement, {
      type: 'sys.wallet.methods.set',
      payload: (f) => {
        const dipilih = TUJUAN.map(([k]) => k).filter((k) => (f.querySelector(`input[name="p_${k}"]`) as HTMLInputElement | null)?.checked);
        if (!dipilih.length) { window.alert('Pilih minimal satu tujuan.'); return null; }
        return { providers: dipilih.join(',') };
      },
      confirm: 'Simpan tujuan penarikan yang dibuka?',
      success: (r) => `Tersimpan: ${(r.result?.openProviders ?? []).length} tujuan dibuka.`,
      onDone: (r) => { if (r.ok) setTimeout(() => void muat(), 1200); },
    });
    pasangAksi(document.getElementById('wk-config') as HTMLFormElement, {
      type: 'sys.wallet.config.set',
      confirm: 'Simpan nilai VP? Berlaku untuk transaksi berikutnya.',
      success: (r) => `Tersimpan sebagai versi ${r.result?.version}.`,
      onDone: (r) => { if (r.ok) setTimeout(() => void muat(), 1200); },
    });
  }

  document.addEventListener('admin:ready', (e) => { role = (e as CustomEvent).detail?.role ?? 'viewer'; void muat(); });
</script>
