---
// 💜 Vanillate Wallet › Ringkasan (PLAN-017 Fase 3, docs/wallet.md §9 repo bot).
// Agregat saja (tanpa baris pemain), dibaca SESUAI PERMINTAAN lewat perintah
// `read.wallet.summary` (peran viewer, cache 60 dtk di bot). Tanpa snapshot.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Vanillate Wallet" active="wallet-ringkasan">
  <AdminPageHeader
    eyebrow="Discord Bot"
    title="Vanillate Wallet"
    description="Ringkasan Vani Poin (VP): total beredar, tertahan, dan aktivitas 30 hari terakhir. Dibaca dari bot saat halaman dibuka."
  />
  <div class="px-6 lg:px-10 py-8 max-w-5xl space-y-8">
    <div class="flex items-center gap-3">
      <button id="wl-reload" type="button" class="rounded-full border border-ink-900/15 dark:border-cream-100/15 px-4 py-1.5 text-sm">Muat ulang</button>
      <p id="wl-fresh" class="text-xs text-ink-500 dark:text-cream-300/60"></p>
    </div>
    <div id="wl-body" class="space-y-8"></div>
  </div>
</AdminLayout>

<script>
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { fmtAngka, fmtWaktu } from '@/lib/admin-auth';
  import { kirimPerintah } from '@/lib/dev-panel/client';
  import { section, stat, table, pill } from '@/lib/dev-panel/ui';

  const LABEL: Record<string, string> = {
    vote_reward: 'Vote Top.gg', activity_reward: 'Aktivitas harian', admin_gift: 'Hadiah dari Admin',
    admin_adjust: 'Penyesuaian', transfer_in: 'Transfer masuk', transfer_out: 'Transfer keluar',
    withdraw_hold: 'Penarikan diajukan', withdraw_refund: 'Penarikan dikembalikan', withdraw_paid: 'Penarikan selesai',
  };

  async function muat() {
    const body = document.getElementById('wl-body')!;
    body.innerHTML = stateBlock('loading', 'Meminta ringkasan dari bot...');
    const o = await kirimPerintah('read.wallet.summary');
    if (!o.ok || !o.result) { body.innerHTML = stateBlock('error', o.error ?? 'Ringkasan tidak tersedia.'); return; }
    const s = o.result;
    document.getElementById('wl-fresh')!.textContent = `Dibuat ${fmtWaktu(s.generatedAt)}${s.cached ? ' (cache)' : ''}`;
    const status = s.publicOpen
      ? pill('dibuka untuk publik', 'ok')
      : pill(s.testUsers ? `tertutup, ${s.testUsers} akun uji` : 'tertutup', 'warn');
    body.innerHTML = [
      section('Status', `<p class="text-sm">${status}</p>
        <p class="mt-2 text-sm text-ink-500 dark:text-cream-300/60">Selama sakelar publik mati, hanya akun uji yang bisa memakai Wallet. Sakelar publik dan akun uji diatur di halaman Konfigurasi.</p>`),
      section('Vani Poin', `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        ${stat('Total VP beredar', fmtAngka(s.outstanding), 'tersedia + tertahan = kewajiban rupiah')}
        ${stat('Tersedia', fmtAngka(s.available))}
        ${stat('Tertahan', fmtAngka(s.held), 'penarikan berjalan')}
        ${stat('Total diperoleh', fmtAngka(s.earned))}
        ${stat('Total dicairkan', `Rp${fmtAngka(s.paid)}`)}
        ${stat('Dompet', fmtAngka(s.accounts), `${fmtAngka(s.consents)} sudah setuju aturan, ${fmtAngka(s.frozen)} dibekukan`)}
      </div>`),
      section('Penarikan', `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        ${stat('Berjalan', fmtAngka(s.withdrawals?.open ?? 0), 'menunggu sampai diproses')}
        ${stat('Lewat batas', fmtAngka(s.withdrawals?.overdue ?? 0), '1×24 jam kerja')}
        ${stat('Perlu dicek', fmtAngka(s.withdrawals?.attention ?? 0), 'gagal atau hasil belum pasti')}
        ${stat('Berhasil', fmtAngka(s.withdrawals?.completed ?? 0))}
      </div>
      <p class="mt-3 text-sm"><a class="underline" href="/admin/wallet/pencairan">Buka antrean pencairan</a> · ${s.withdrawals?.publicOpen ? pill('penarikan dibuka untuk publik', 'ok') : pill('penarikan hanya untuk akun uji', 'warn')}</p>`),
      section('Transfer dan pembatasan', `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        ${stat('Transfer 30 hari', fmtAngka(s.transfers?.count ?? 0), `${fmtAngka(s.transfers?.vp ?? 0)} VP ke ${fmtAngka(s.transfers?.receivers ?? 0)} penerima`)}
        ${stat('Akun dibatasi', fmtAngka(s.restrictions ?? 0), 'dipasang Admin dengan alasan')}
        ${stat('Transfer', s.transfers?.publicOpen ? 'Dibuka' : 'Akun uji saja')}
      </div><p class="mt-3 text-sm"><a class="underline" href="/admin/wallet/laporan">Laporan, ekspor, dan penanda risiko</a></p>`),
      section('Cek saldo (opname)', `<p class="text-sm text-ink-500 dark:text-cream-300/60">Mencocokkan saldo setiap dompet dengan catatan transaksi. Hanya laporan: dompet tidak dibekukan dari sini (pembekuan otomatis tetap lewat cek harian). Khusus owner, tercatat.</p>
        <div class="mt-3 flex items-center gap-3"><button id="wl-opname" type="button" class="rounded-full border border-ink-900/15 dark:border-cream-100/15 px-4 py-1.5 text-sm">Jalankan cek saldo</button><span id="wl-opname-status" class="text-xs"></span></div>
        <div id="wl-opname-out" class="mt-3"></div>`),
      section('Akun Discord terhapus', `<p class="text-sm">VP di akun Discord yang sudah dihapus hangus, diperiksa sekali sehari. Hangus otomatis hanya bila Discord menyatakan akunnya tidak ada. Akun yang namanya berpola akun terhapus hanya ditandai di sini, karena pola nama itu bisa dipilih pemain sendiri; hanguskan setelah Anda yakin. Setiap penghapusan tercatat di Riwayat moderasi dan Log Dompet.</p>
        <div class="mt-3 flex items-center gap-3"><button id="wl-deleted" type="button" class="rounded-full border border-ink-900/15 dark:border-cream-100/15 px-4 py-1.5 text-sm">Periksa sekarang</button><span id="wl-deleted-status" class="text-xs"></span></div>
        <div id="wl-deleted-out" class="mt-3"></div>`),
      section('Rekening', `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        ${stat('Rekening aktif', fmtAngka(s.methodsActive ?? 0))}
        ${stat('Peninjauan menunggu', fmtAngka(s.reviewsPending ?? 0), 'diputuskan di profil pemain atau channel Peninjauan Rekening')}
        ${stat('Kunci enkripsi', s.keysReady ? 'Siap' : 'Belum dipasang', s.keysReady ? '' : 'fitur Rekening terkunci sampai kunci .env dipasang di VPS')}
      </div>`),
      section('30 hari terakhir', table(['Jenis', 'Jumlah transaksi', 'VP'], (s.last30 ?? []).map((r: any) => [
        esc(LABEL[r.type] ?? r.type), fmtAngka(r.count), fmtAngka(r.vp),
      ]), 'Belum ada transaksi.')),
      section('Nilai yang berlaku', `<p class="text-sm">Versi konfigurasi <code>${esc(s.config?.version)}</code>: vote ${fmtAngka(s.config?.values?.vote_vp)} VP, aktivitas harian ${fmtAngka(s.config?.values?.activity_vp)} VP, minimum penarikan ${fmtAngka(s.config?.values?.min_withdraw_vp)} VP.</p>`),
    ].join('');
  }

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (t?.id === 'wl-deleted') return void cekTerhapus(t as HTMLButtonElement);
    if (t?.dataset?.hangus) return void hanguskan(t as HTMLButtonElement);
    if (t?.id !== 'wl-opname') return;
    const st = document.getElementById('wl-opname-status')!;
    const out = document.getElementById('wl-opname-out')!;
    (t as HTMLButtonElement).disabled = true;
    st.textContent = 'Menunggu bot...';
    const o = await kirimPerintah('sys.wallet.reconcile');
    (t as HTMLButtonElement).disabled = false;
    if (!o.ok || !o.result) { st.textContent = o.error ?? 'Gagal (khusus owner).'; return; }
    const r = o.result;
    st.textContent = `Dicek ${fmtWaktu(r.checkedAt)}`;
    out.innerHTML = r.ok
      ? `<p class="text-sm">${pill('cocok', 'ok')} Semua ${fmtAngka(r.totals.accounts)} dompet cocok dengan catatan transaksi. Total VP beredar ${fmtAngka(r.totals.outstanding)}, dicairkan Rp${fmtAngka(r.totals.paid)}.</p>`
      : `<p class="text-sm">${pill(r.mismatches.length + ' dompet selisih', 'bad')} Periksa dompet berikut dan laporkan ke developer:</p>
         <ul class="mt-2 text-sm list-disc pl-5">${r.mismatches.map((m: any) => `<li><a class="underline" href="/admin/wallet/pemain/?id=${encodeURIComponent(m.userId)}">${esc(m.userId)}</a></li>`).join('')}</ul>`;
  });
  async function cekTerhapus(btn: HTMLButtonElement) {
    if (!window.confirm('Periksa semua dompet bersaldo ke Discord sekarang? VP di akun yang sudah terhapus akan hangus dan tidak bisa dikembalikan otomatis.')) return;
    const st = document.getElementById('wl-deleted-status')!;
    const out = document.getElementById('wl-deleted-out')!;
    btn.disabled = true;
    st.textContent = 'Menunggu bot... (sekitar 1 detik per dompet)';
    const o = await kirimPerintah('sys.wallet.deleted.check', {}, { timeoutMs: 12 * 60_000 });
    btn.disabled = false;
    if (!o.ok || !o.result) { st.textContent = o.timedOut ? 'Bot belum selesai. Cek Riwayat moderasi beberapa menit lagi.' : (o.error ?? 'Gagal (khusus owner).'); return; }
    const r = o.result;
    st.textContent = `Diperiksa ${fmtAngka(r.checked)} dompet${r.skipped ? `, ${fmtAngka(r.skipped)} dilewati karena Discord tidak menjawab` : ''}.`;
    const link = (id: string) => `<a class="underline" href="/admin/wallet/pemain/?id=${encodeURIComponent(id)}">${esc(id)}</a>`;
    const hangus = (r.forfeited ?? []).length
      ? `<p class="text-sm">${pill(r.forfeited.length + ' akun terhapus', 'warn')} Total ${fmtAngka(r.totalForfeited)} VP hangus.</p>
         <ul class="mt-2 text-sm list-disc pl-5">${r.forfeited.map((f: any) => `<li>${link(f.userId)}: ${fmtAngka(f.amount)} VP${f.held ? `, ${fmtAngka(f.held)} VP masih tertahan di penarikan (tolak penarikannya)` : ''}</li>`).join('')}</ul>`
      : `<p class="text-sm">${pill('tidak ada', 'ok')} Tidak ada akun yang pasti terhapus.</p>`;
    const diduga = (r.suspected ?? []).length
      ? `<p class="mt-3 text-sm">${pill(r.suspected.length + ' perlu konfirmasi', 'info')} Nama berpola akun terhapus. VP belum dihanguskan.</p>
         <ul class="mt-2 text-sm space-y-2">${r.suspected.map((f: any) => `<li class="flex flex-wrap items-center gap-2">${link(f.userId)}: ${fmtAngka(f.available)} VP${f.held ? `, ${fmtAngka(f.held)} tertahan` : ''}
           <button type="button" data-hangus="${esc(f.userId)}" class="rounded-full border border-red-500/40 text-red-600 dark:text-red-400 px-3 py-0.5 text-xs">Hanguskan</button></li>`).join('')}</ul>`
      : '';
    out.innerHTML = hangus + diduga;
  }

  async function hanguskan(btn: HTMLButtonElement) {
    const userId = btn.dataset.hangus!;
    if (!window.confirm(`Hanguskan VP akun ${userId}? Bot memeriksa ulang ke Discord dulu. VP yang hangus tidak bisa dikembalikan otomatis.`)) return;
    btn.disabled = true;
    const o = await kirimPerintah('sys.wallet.deleted.forfeit', { userId });
    if (!o.ok) { btn.disabled = false; window.alert(o.error ?? 'Gagal.'); return; }
    btn.replaceWith(document.createTextNode(` hangus ${fmtAngka(o.result?.amount ?? 0)} VP`));
  }
  document.addEventListener('admin:ready', () => { void muat(); });
  document.getElementById('wl-reload')?.addEventListener('click', () => { void muat(); });
</script>
