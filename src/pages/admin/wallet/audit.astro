---
// 💜 Vanillate Wallet › Riwayat moderasi (khusus owner, `sys.wallet.audit`).
// Semua aksi Admin tercatat di tabel append-only wallet_audit (repo bot).
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Riwayat Moderasi Wallet" active="wallet-audit">
  <AdminPageHeader eyebrow="Vanillate Wallet" title="Riwayat moderasi" description="Semua aksi Admin Wallet. Tidak bisa diubah atau dihapus. Khusus owner." />
  <div class="px-6 lg:px-10 py-8 max-w-5xl space-y-4">
    <form id="wa-filter" class="flex flex-wrap items-end gap-3">
      <label class="text-xs">Pemain (Discord ID)<br><input name="targetUser" class="rounded-lg border px-3 py-1.5 text-sm bg-transparent" placeholder="1036585958553964574" /></label>
      <label class="text-xs">Admin<br><input name="actor" class="rounded-lg border px-3 py-1.5 text-sm bg-transparent" placeholder="cms: atau discord:" /></label>
      <label class="text-xs">Aksi<br><select name="action" id="wa-action" class="rounded-lg border px-3 py-1.5 text-sm bg-transparent"><option value="">Semua</option></select></label>
      <label class="text-xs">Periode<br><select name="days" class="rounded-lg border px-3 py-1.5 text-sm bg-transparent">
        <option value="">Semua</option><option value="7">7 hari</option><option value="30">30 hari</option><option value="90">90 hari</option><option value="365">1 tahun</option></select></label>
      <button type="submit" class="rounded-full border px-4 py-1.5 text-sm">Saring</button>
    </form>
    <div id="wa-body"></div>
    <button id="wa-more" type="button" class="hidden rounded-full border px-4 py-1.5 text-sm">Lebih lama</button>
  </div>
</AdminLayout>

<script>
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { fmtAngka, fmtWaktu } from '@/lib/admin-auth';
  import { kirimPerintah } from '@/lib/dev-panel/client';
  import { table } from '@/lib/dev-panel/ui';

  const AKSI: Record<string, string> = {
    gift: 'Hadiah dari Admin', adjust: 'Penyesuaian', config: 'Konfigurasi', testers: 'Akun uji',
    reveal: 'Buka nomor rekening', method_review_approve: 'Peninjauan rekening disetujui',
    method_review_reject: 'Peninjauan rekening ditolak', methods_open: 'Tujuan penarikan', namecheck_switch: 'Sakelar cek nama', public_switch: 'Sakelar publik', namecheck_test: 'Uji cek nama BRI', opname: 'Cek saldo (opname)',
    restriction: 'Akun dibatasi', restriction_end: 'Partisipasi dihentikan', restriction_review_done: 'Peninjauan selesai',
    restriction_lift: 'Pembatasan dicabut', export: 'Ekspor CSV', method_name_match: 'Nama rekening cocok',
  };
  let role = 'viewer';
  let rows: any[] = [];
  let saring: Record<string, string> = {};
  const sel = document.getElementById('wa-action') as HTMLSelectElement;
  for (const [k, v] of Object.entries(AKSI)) sel.insertAdjacentHTML('beforeend', `<option value="${esc(k)}">${esc(v)}</option>`);
  document.getElementById('wa-filter')!.addEventListener('submit', (e) => {
    e.preventDefault();
    saring = Object.fromEntries([...new FormData(e.target as HTMLFormElement).entries()].map(([k, v]) => [k, String(v).trim()]).filter(([, v]) => v));
    void muat();
  });

  function detail(x: any): string {
    const d = x.detail ?? {};
    if (x.action === 'gift') return `+${fmtAngka(d.amount)} VP`;
    if (x.action === 'adjust') return `${d.delta > 0 ? '+' : ''}${fmtAngka(d.delta)} VP`;
    if (x.action === 'config') return `versi ${esc(d.version)}`;
    if (x.action === 'testers') return `${(d.after ?? []).length} akun uji`;
    return '';
  }

  async function muat(beforeId = 0) {
    const body = document.getElementById('wa-body')!;
    if (role !== 'owner') { body.innerHTML = stateBlock('empty', 'Halaman ini khusus owner.'); return; }
    if (!beforeId) { rows = []; body.innerHTML = stateBlock('loading', 'Meminta riwayat dari bot...'); }
    const o = await kirimPerintah('sys.wallet.audit', { ...saring, ...(beforeId ? { beforeId } : {}) });
    if (!o.ok || !o.result) { body.innerHTML = stateBlock('error', o.error ?? 'Riwayat tidak tersedia.'); return; }
    const baru = o.result.rows ?? [];
    rows = rows.concat(baru);
    body.innerHTML = table(['Waktu', 'Aksi', 'Pemain', 'Detail', 'Oleh', 'Alasan'], rows.map((x) => [
      `<span class="text-xs">${esc(fmtWaktu(x.createdAt))}</span>`, esc(AKSI[x.action] ?? x.action),
      x.targetUser ? `<a class="underline" href="/admin/wallet/pemain/?id=${encodeURIComponent(x.targetUser)}"><code class="text-xs">${esc(x.targetUser)}</code></a>` : '',
      detail(x), esc(x.actor), esc(x.reason ?? ''),
    ]), 'Belum ada aksi Admin.');
    const more = document.getElementById('wa-more')!;
    more.classList.toggle('hidden', baru.length < 50);
    more.onclick = () => void muat(rows[rows.length - 1]?.id ?? 0);
  }

  document.addEventListener('admin:ready', (e) => { role = (e as CustomEvent).detail?.role ?? 'viewer'; void muat(); });
</script>
