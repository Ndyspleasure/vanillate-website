---
// 💜 Vanillate Wallet › Member (khusus owner, `sys.wallet.members`).
// Data baris pemain: hasil perintah dikosongkan bot beberapa menit setelah
// dikirim (docs/wallet-security-review.md SEC-T01).
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Member Wallet" active="wallet-member">
  <AdminPageHeader eyebrow="Vanillate Wallet" title="Member" description="Daftar dompet, urut aktivitas terbaru. Cari dengan Discord ID. Khusus owner." />
  <div class="px-6 lg:px-10 py-8 max-w-5xl space-y-6">
    <form id="wm-search" class="flex flex-wrap gap-2">
      <input name="search" inputmode="numeric" placeholder="Discord ID" class="flex-1 min-w-[12rem] rounded-xl border border-ink-900/15 dark:border-cream-100/15 bg-transparent px-3 py-2 text-sm" />
      <button class="rounded-full bg-ink-900 dark:bg-amber-500 text-cream-50 dark:text-ink-950 px-4 py-2 text-sm">Cari</button>
    </form>
    <div id="wm-body"></div>
    <div class="flex gap-2"><button id="wm-prev" type="button" class="hidden rounded-full border px-4 py-1.5 text-sm">Sebelumnya</button><button id="wm-next" type="button" class="hidden rounded-full border px-4 py-1.5 text-sm">Berikutnya</button></div>
  </div>
</AdminLayout>

<script>
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { fmtAngka, fmtWaktu } from '@/lib/admin-auth';
  import { kirimPerintah } from '@/lib/dev-panel/client';
  import { table, pill } from '@/lib/dev-panel/ui';

  let page = 0;
  let search = '';
  let role = 'viewer';

  async function muat() {
    const body = document.getElementById('wm-body')!;
    if (role !== 'owner') { body.innerHTML = stateBlock('empty', 'Halaman ini khusus owner.'); return; }
    body.innerHTML = stateBlock('loading', 'Meminta daftar dari bot...');
    const o = await kirimPerintah('sys.wallet.members', { page, search });
    if (!o.ok || !o.result) { body.innerHTML = stateBlock('error', o.error ?? 'Daftar tidak tersedia.'); return; }
    const r = o.result;
    body.innerHTML = table(['Pemain', 'Tersedia', 'Tertahan', 'Diperoleh', 'Dicairkan', 'Status', 'Terakhir'], (r.rows ?? []).map((m: any) => [
      `<a class="underline" href="/admin/wallet/pemain/?id=${encodeURIComponent(m.userId)}"><code class="text-xs">${esc(m.userId)}</code></a>`,
      fmtAngka(m.available), fmtAngka(m.held), fmtAngka(m.earned), `Rp${fmtAngka(m.paid)}`,
      m.frozen ? pill('dibekukan', 'bad') : pill('aktif', 'ok'),
      `<span class="text-xs">${esc(fmtWaktu(m.updatedAt))}</span>`,
    ]), search ? 'Discord ID ini belum punya dompet.' : 'Belum ada dompet.');
    document.getElementById('wm-prev')!.classList.toggle('hidden', page === 0 || !!search);
    document.getElementById('wm-next')!.classList.toggle('hidden', !r.hasMore);
  }

  document.addEventListener('admin:ready', (e) => { role = (e as CustomEvent).detail?.role ?? 'viewer'; void muat(); });
  document.getElementById('wm-search')!.addEventListener('submit', (e) => {
    e.preventDefault();
    search = String(new FormData(e.target as HTMLFormElement).get('search') ?? '').trim();
    page = 0; void muat();
  });
  document.getElementById('wm-prev')!.addEventListener('click', () => { page = Math.max(0, page - 1); void muat(); });
  document.getElementById('wm-next')!.addEventListener('click', () => { page += 1; void muat(); });
</script>
