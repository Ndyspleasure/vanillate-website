---
// 💜 Vanillate Wallet › Profil pemain (`/admin/wallet/pemain/?id=<discordId>`).
// Khusus owner. Saldo, riwayat ledger, persetujuan, riwayat moderasi, serta
// Hadiah dari Admin dan Penyesuaian (alasan wajib, tercatat). Fase 4: rekening
// disamarkan, status PIN, buka nomor lengkap (`sys.wallet.reveal`, tercatat,
// hilang dari layar setelah 60 detik), dan keputusan formulir peninjauan. Bot mengirim
// tautan halaman ini di kartu staff. Hasil perintah berisi data pemain
// dikosongkan bot beberapa menit setelah dikirim (SEC-T01).
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Profil Wallet" active="wallet-pemain">
  <AdminPageHeader eyebrow="Vanillate Wallet" title="Profil pemain" description="Saldo, rekening, riwayat, persetujuan, dan riwayat moderasi satu pemain. Khusus owner." />
  <div class="px-6 lg:px-10 py-8 max-w-5xl space-y-8">
    <p><a href="/admin/wallet/member" class="text-sm underline">Kembali ke daftar member</a></p>
    <div id="wp-body" class="space-y-8"></div>
  </div>
</AdminLayout>

<script>
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { fmtAngka, fmtWaktu } from '@/lib/admin-auth';
  import { kirimPerintah } from '@/lib/dev-panel/client';
  import { section, stat, table, pill, formCard, pasangAksi, KELAS } from '@/lib/dev-panel/ui';

  const LABEL: Record<string, string> = {
    vote_reward: 'Vote Top.gg', activity_reward: 'Aktivitas harian', admin_gift: 'Hadiah dari Admin',
    admin_adjust: 'Penyesuaian', transfer_in: 'Transfer masuk', transfer_out: 'Transfer keluar',
    withdraw_hold: 'Penarikan diajukan', withdraw_refund: 'Penarikan dikembalikan', withdraw_paid: 'Penarikan selesai',
  };
  const AKSI: Record<string, string> = {
    gift: 'Hadiah dari Admin', adjust: 'Penyesuaian', config: 'Konfigurasi', testers: 'Akun uji',
    reveal: 'Buka nomor rekening', method_review_approve: 'Peninjauan rekening disetujui',
    method_review_reject: 'Peninjauan rekening ditolak', methods_open: 'Tujuan penarikan', opname: 'Cek saldo (opname)',
  };
  const VERIF: Record<string, string> = { namecheck: 'nama terverifikasi (cek nama)', admin_review: 'disetujui lewat peninjauan', none: 'nama belum terverifikasi' };
  const ULASAN: Record<string, string> = { pending: 'menunggu', approved: 'disetujui', rejected: 'ditolak', cancelled: 'batal' };
  const waktuMs = (ms: number | null | undefined) => (ms ? fmtWaktu(new Date(ms).toISOString()) : '');
  const userId = new URLSearchParams(location.search).get('id')?.trim() ?? '';
  let revealTimer: ReturnType<typeof setTimeout> | null = null;
  let role = 'viewer';

  async function muat() {
    const body = document.getElementById('wp-body')!;
    if (role !== 'owner') { body.innerHTML = stateBlock('empty', 'Halaman ini khusus owner.'); return; }
    if (!/^[0-9]{15,22}$/.test(userId)) { body.innerHTML = stateBlock('error', 'Buka halaman ini dari daftar member (butuh Discord ID di alamat).'); return; }
    body.innerHTML = stateBlock('loading', 'Meminta profil dari bot...');
    const o = await kirimPerintah('sys.wallet.member', { userId });
    if (!o.ok || !o.result) { body.innerHTML = stateBlock('error', o.error ?? 'Profil tidak tersedia.'); return; }
    const p = o.result;
    const a = p.account;
    const sec = p.security;
    const akses = p.canUse ? pill(p.isTester ? 'akun uji' : 'bisa memakai', 'ok') : pill('belum bisa memakai', 'muted');
    body.innerHTML = [
      section('Dompet', `<p class="mb-3 text-sm"><code>${esc(p.userId)}</code> ${akses} ${a?.frozen ? pill('dibekukan: ' + (a.frozenReason ?? ''), 'bad') : ''}</p>
        ${a ? `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          ${stat('Tersedia', fmtAngka(a.available))}${stat('Tertahan', fmtAngka(a.held))}
          ${stat('Total diperoleh', fmtAngka(a.totalEarned))}${stat('Total dicairkan', 'Rp' + fmtAngka(a.totalPaid))}
        </div>` : stateBlock('empty', 'Pemain ini belum punya dompet.')}`),
      section('Rekening dan keamanan', `<div class="space-y-2 text-sm">
          <p>${p.method ? `<strong>${esc(p.method.label)} •••• ${esc(p.method.hint)}</strong> ${pill(VERIF[p.method.verifySource] ?? p.method.verifySource, p.method.verifyStatus === 'verified' ? 'ok' : 'warn')}` : 'Belum ada rekening.'}</p>
          <p>PIN: ${sec?.hasPin ? pill('aktif', 'ok') : pill('belum dibuat', 'muted')}
            ${sec?.pinLockedUntil ? pill('terkunci sampai ' + waktuMs(sec.pinLockedUntil), 'bad') : ''}
            ${sec?.sensitiveLockUntil ? pill('penarikan dan transfer terkunci sampai ' + waktuMs(sec.sensitiveLockUntil), 'warn') : ''}</p>
          ${sec?.ageStatementAt ? `<p class="${KELAS.muted} text-xs">Pernyataan usia dan kepemilikan rekening: ${esc(fmtWaktu(sec.ageStatementAt))}</p>` : ''}
        </div>
        ${p.method ? `<div class="mt-4">${formCard({ id: 'wp-reveal', title: 'Nomor lengkap', submit: 'Tampilkan nomor lengkap', ownerOnly: true,
          desc: 'Untuk transfer manual. Tercatat di riwayat moderasi dan Log Dompet. Nomor hilang dari layar setelah 60 detik dan dari hasil perintah setelah 5 menit.', fields: [] })}
          <div id="wp-reveal-out" class="mt-3"></div></div>` : ''}`),
      section('Riwayat rekening', table(['Didaftarkan', 'Tujuan', 'Status', 'Verifikasi'], (p.methods?.methods ?? []).map((m: any) => [
        `<span class="text-xs">${esc(fmtWaktu(m.createdAt))}</span>`, `${esc(m.label)} •••• ${esc(m.hint)}`,
        m.active ? pill('aktif', 'ok') : pill('diganti ' + fmtWaktu(m.deactivatedAt), 'muted'), esc(VERIF[m.verifySource] ?? m.verifySource),
      ]), 'Belum ada rekening.')),
      section('Formulir peninjauan rekening', table(['Diajukan', 'Tujuan baru', 'Status', 'Alasan', 'Aksi'], (p.methods?.reviews ?? []).map((r: any) => [
        `<span class="text-xs">${esc(fmtWaktu(r.createdAt))}</span>`, `${esc(r.label)} •••• ${esc(r.hint)}`,
        esc(ULASAN[r.status] ?? r.status), esc(r.reason ?? ''),
        r.status === 'pending'
          ? `<button type="button" data-review="${esc(r.id)}" data-decision="approve" class="${KELAS.tombol}">Setujui</button>
             <button type="button" data-review="${esc(r.id)}" data-decision="reject" class="${KELAS.tombolBahaya}">Tolak</button>`
          : '',
      ]), 'Belum ada formulir.'), 'Bukti profil akun ada di channel Discord Peninjauan Rekening. Setuju = rekening pemain diganti dan penarikan serta transfer terkunci 24 jam.'),
      section('Penarikan', table(['No.', 'Diajukan', 'Jumlah', 'Tujuan', 'Status', 'Ref / alasan'], (p.withdrawals ?? []).map((w: any) => [
        `<code>${esc(w.ref)}</code>`, `<span class="text-xs">${esc(fmtWaktu(w.createdAt))}</span>`, `Rp${fmtAngka(w.amountIdr)}`,
        `${esc(w.label)} •••• ${esc(w.hint)}`, esc(w.status), esc(w.providerRef ?? w.reason ?? ''),
      ]), 'Belum ada penarikan.'), 'Aksi penarikan ada di halaman Pencairan.'),
      section('Persetujuan aturan', table(['Versi', 'Waktu', 'Sumber'], (p.consent ?? []).map((c: any) => [
        esc(c.version), esc(fmtWaktu(c.acceptedAt)), esc(c.source),
      ]), 'Belum menyetujui aturan Wallet.')),
      section('Riwayat VP (50 terbaru)', table(['Waktu', 'Jenis', 'Tersedia', 'Tertahan', 'Dibayar', 'Oleh', 'Alasan'], (p.history ?? []).map((e: any) => [
        `<span class="text-xs">${esc(fmtWaktu(e.createdAt))}</span>`, esc(LABEL[e.type] ?? e.type),
        fmtAngka(e.deltaAvailable), fmtAngka(e.deltaHeld), fmtAngka(e.deltaPaid), `<span class="text-xs">${esc(e.actor)}</span>`, esc(e.reason ?? ''),
      ]), 'Belum ada transaksi.')),
      section('Riwayat moderasi', table(['Waktu', 'Aksi', 'Oleh', 'Alasan'], (p.audit ?? []).map((x: any) => [
        `<span class="text-xs">${esc(fmtWaktu(x.createdAt))}</span>`, esc(AKSI[x.action] ?? x.action), esc(x.actor), esc(x.reason ?? ''),
      ]), 'Belum ada aksi Admin.')),
      section('Aksi Admin', `<div class="grid gap-4 sm:grid-cols-2">
        ${formCard({ id: 'wp-gift', title: 'Hadiah dari Admin', submit: 'Kirim hadiah', ownerOnly: true,
          desc: 'VP masuk ke dompet pemain. Alasan terlihat oleh pemain di riwayat dan DM.',
          fields: [{ name: 'amount', label: 'Jumlah VP', type: 'number', required: true }, { name: 'reason', label: 'Alasan (terlihat pemain)', required: true, placeholder: 'Hadiah giveaway November' }] })}
        ${formCard({ id: 'wp-adjust', title: 'Penyesuaian', submit: 'Simpan penyesuaian', danger: true, ownerOnly: true,
          desc: 'Koreksi saldo (positif atau negatif). Tidak bisa membuat saldo minus. Catatan lama tidak dihapus.',
          fields: [{ name: 'delta', label: 'Perubahan VP (mis. -50)', type: 'number', required: true }, { name: 'reason', label: 'Alasan', required: true }] })}
      </div><p class="${KELAS.muted} text-xs">Setiap aksi tercatat di riwayat moderasi dan Log Dompet.</p>`),
    ].join('');

    const formReveal = document.getElementById('wp-reveal') as HTMLFormElement | null;
    if (formReveal) pasangAksi(formReveal, {
      type: 'sys.wallet.reveal', payload: () => ({ userId }),
      confirm: 'Tampilkan nomor rekening lengkap? Aksi ini tercatat.',
      success: (r) => {
        const x = r.result ?? {};
        const out = document.getElementById('wp-reveal-out')!;
        out.innerHTML = x.readable
          ? `<div class="${KELAS.kartu} text-sm space-y-1"><p><strong>${esc(x.label)}</strong> <code class="select-all">${esc(x.number)}</code></p>
              <p>Nama pemilik dari cek nama: ${esc(x.holder ?? 'tidak ada')}</p>
              <p class="${KELAS.muted} text-xs">Cocokkan nama penerima di aplikasi saat transfer. Hilang dari layar dalam 60 detik.</p></div>`
          : stateBlock('error', 'Nomor tidak bisa dibaca (kunci enkripsi berbeda atau data rusak). Minta pemain mendaftar ulang lewat formulir peninjauan.');
        if (revealTimer) clearTimeout(revealTimer);
        revealTimer = setTimeout(() => { out.innerHTML = ''; }, 60_000);
        return 'Nomor ditampilkan dan tercatat.';
      },
    });
    document.querySelectorAll<HTMLButtonElement>('button[data-review]').forEach((b) => b.addEventListener('click', async () => {
      const reviewId = b.dataset.review!;
      const decision = b.dataset.decision!;
      let reason: string | null = null;
      if (decision === 'reject') {
        reason = window.prompt('Alasan penolakan (terlihat pemain, minimal 3 karakter):')?.trim() ?? null;
        if (!reason || reason.length < 3) return;
      } else if (!window.confirm('Setujui formulir ini? Rekening pemain diganti dan penarikan serta transfer terkunci 24 jam.')) return;
      b.disabled = true;
      const o = await kirimPerintah('sys.wallet.review.decide', { reviewId, decision, ...(reason ? { reason } : {}) });
      if (!o.ok) { window.alert(o.error ?? 'Gagal.'); b.disabled = false; return; }
      setTimeout(() => void muat(), 800);
    }));

    const isi = (f: HTMLFormElement) => ({ ...Object.fromEntries(new FormData(f) as any), userId });
    pasangAksi(document.getElementById('wp-gift') as HTMLFormElement, {
      type: 'sys.wallet.gift', payload: isi,
      confirm: (x) => `Kirim ${x.amount} VP ke ${userId}?`,
      success: (r) => `Hadiah terkirim. Saldo tersedia sekarang ${fmtAngka(r.result?.balance)} VP.`,
      resetOnSuccess: true, onDone: (r) => { if (r.ok) setTimeout(() => void muat(), 1200); },
    });
    pasangAksi(document.getElementById('wp-adjust') as HTMLFormElement, {
      type: 'sys.wallet.adjust', payload: isi,
      confirm: (x) => `Ubah saldo ${userId} sebesar ${x.delta} VP?`,
      success: (r) => `Penyesuaian tersimpan. Saldo tersedia sekarang ${fmtAngka(r.result?.balance)} VP.`,
      resetOnSuccess: true, onDone: (r) => { if (r.ok) setTimeout(() => void muat(), 1200); },
    });
  }

  document.addEventListener('admin:ready', (e) => { role = (e as CustomEvent).detail?.role ?? 'viewer'; void muat(); });
</script>
