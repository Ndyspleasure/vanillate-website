---
// 💜 Vanillate Wallet › Laporan (Fase 7). Agregat per periode untuk semua admin
// (`read.wallet.report`, cache 60 dtk di bot, tanpa baris pemain). Khusus owner:
// ekspor CSV (`sys.wallet.export`, tercatat) dan penanda risiko serta akun yang
// dibatasi (`sys.wallet.risk`). Penanda risiko hanya informasi.
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminPageHeader from '@components/AdminPageHeader.astro';
---

<AdminLayout title="Laporan Wallet" active="wallet-laporan">
  <AdminPageHeader eyebrow="Vanillate Wallet" title="Laporan" description="Ringkasan Vani Poin per periode, ekspor CSV, dan penanda risiko." />
  <div class="px-6 lg:px-10 py-8 max-w-6xl space-y-8">
    <div class="flex flex-wrap items-center gap-2" id="wr-period">
      <button type="button" data-days="7" class="rounded-full border border-ink-900/15 dark:border-cream-100/15 px-4 py-1.5 text-sm">7 hari</button>
      <button type="button" data-days="30" class="rounded-full border border-ink-900/15 dark:border-cream-100/15 px-4 py-1.5 text-sm">30 hari</button>
      <button type="button" data-days="90" class="rounded-full border border-ink-900/15 dark:border-cream-100/15 px-4 py-1.5 text-sm">90 hari</button>
      <button type="button" data-days="365" class="rounded-full border border-ink-900/15 dark:border-cream-100/15 px-4 py-1.5 text-sm">1 tahun</button>
      <span id="wr-fresh" class="text-xs text-ink-500 dark:text-cream-300/60"></span>
    </div>
    <div id="wr-body" class="space-y-8"></div>
    <div id="wr-owner" class="space-y-8"></div>
  </div>
</AdminLayout>

<script>
  import { esc, stateBlock } from '@/lib/admin-ui';
  import { fmtAngka, fmtWaktu } from '@/lib/admin-auth';
  import { kirimPerintah } from '@/lib/dev-panel/client';
  import { section, stat, table, pill, KELAS, unduhTeks } from '@/lib/dev-panel/ui';

  const LABEL: Record<string, string> = {
    vote_reward: 'Vote Top.gg', activity_reward: 'Aktivitas harian', admin_gift: 'Hadiah dari Admin',
    admin_adjust: 'Penyesuaian', transfer_in: 'Transfer masuk', transfer_out: 'Transfer keluar',
    withdraw_hold: 'Penarikan diajukan', withdraw_refund: 'Penarikan dikembalikan', withdraw_paid: 'Penarikan selesai',
  };
  const STATUS: Record<string, string> = {
    pending: 'Menunggu', approved: 'Disetujui', processing: 'Diproses', payment_unknown: 'Belum pasti', failed: 'Gagal',
    completed: 'Berhasil', rejected: 'Ditolak', cancelled: 'Dibatalkan',
  };
  let role = 'viewer';
  let days = 30;

  async function muat() {
    const body = document.getElementById('wr-body')!;
    document.querySelectorAll<HTMLButtonElement>('#wr-period button').forEach((b) => { b.style.fontWeight = Number(b.dataset.days) === days ? '700' : '400'; });
    body.innerHTML = stateBlock('loading', 'Meminta laporan dari bot...');
    const o = await kirimPerintah('read.wallet.report', { days });
    if (!o.ok || !o.result) { body.innerHTML = stateBlock('error', o.error ?? 'Laporan tidak tersedia.'); return; }
    const r = o.result;
    document.getElementById('wr-fresh')!.textContent = `Dibuat ${fmtWaktu(r.generatedAt)}${r.cached ? ' (cache)' : ''}`;
    const dibayar = (r.withdrawals ?? []).find((w: any) => w.status === 'completed');
    body.innerHTML = [
      section(`Ringkasan ${r.days} hari`, `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        ${stat('Pendaftar Wallet baru', fmtAngka(r.newConsents))}
        ${stat('Penarikan berhasil', fmtAngka(r.payout?.completed ?? 0), `Rp${fmtAngka(dibayar?.idr ?? 0)}`)}
        ${stat('Tepat waktu', r.payout?.completed ? `${Math.round((r.payout.onTime / r.payout.completed) * 100)}%` : 'belum ada', 'selesai sebelum batas 1×24 jam kerja')}
        ${stat('Rata-rata selesai', r.payout?.completed ? `${r.payout.avgHours} jam` : 'belum ada')}
        ${stat('Transfer antarpemain', fmtAngka(r.transfers?.count ?? 0), `${fmtAngka(r.transfers?.vp ?? 0)} VP`)}
      </div>`),
      section('Vani Poin per jenis', table(['Jenis', 'Transaksi', 'Pemain', 'VP tersedia', 'Dibayar'], (r.ledger ?? []).map((x: any) => [
        esc(LABEL[x.type] ?? x.type), fmtAngka(x.count), fmtAngka(x.users), fmtAngka(x.vp), fmtAngka(x.paid),
      ]), 'Belum ada transaksi.')),
      section('Penarikan per status', table(['Status', 'Jumlah', 'Rupiah'], (r.withdrawals ?? []).map((x: any) => [
        esc(STATUS[x.status] ?? x.status), fmtAngka(x.count), `Rp${fmtAngka(x.idr)}`,
      ]), 'Belum ada penarikan.')),
      section('Harian (WIB)', table(['Tanggal', 'VP diperoleh', 'Rupiah dicairkan', 'VP ditransfer'], (r.daily ?? []).slice().reverse().map((x: any) => [
        esc(x.day), fmtAngka(x.earned), `Rp${fmtAngka(x.paid)}`, fmtAngka(x.transferred),
      ]), 'Belum ada data.'), r.days > 92 ? 'Tabel harian dibatasi 92 hari terakhir.' : ''),
    ].join('');
  }

  async function muatOwner() {
    const box = document.getElementById('wr-owner')!;
    if (role !== 'owner') { box.innerHTML = ''; return; }
    box.innerHTML = [
      section('Ekspor CSV', `<p class="text-sm ${KELAS.muted}">Untuk periode yang dipilih di atas. Berisi Discord ID, jadi simpan di tempat aman. Setiap ekspor tercatat di riwayat moderasi.</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" data-export="withdrawals" class="${KELAS.tombol}">Penarikan</button>
          <button type="button" data-export="daily" class="${KELAS.tombol}">Ringkasan harian</button>
          <button type="button" data-export="audit" class="${KELAS.tombol}">Riwayat moderasi</button>
          <span id="wr-export-status" class="text-xs self-center"></span>
        </div>`),
      `<div id="wr-risk">${stateBlock('loading', 'Meminta penanda risiko...')}</div>`,
    ].join('');
    box.querySelectorAll<HTMLButtonElement>('button[data-export]').forEach((b) => b.addEventListener('click', async () => {
      const st = document.getElementById('wr-export-status')!;
      st.textContent = 'Menunggu bot...';
      const o = await kirimPerintah('sys.wallet.export', { kind: b.dataset.export, days });
      if (!o.ok || !o.result) { st.textContent = o.error ?? 'Gagal.'; return; }
      unduhTeks(o.result.filename, o.result.text, 'text/csv;charset=utf-8');
      st.textContent = `${fmtAngka(o.result.rows)} baris diunduh.`;
    }));
    const o = await kirimPerintah('sys.wallet.risk');
    const risk = document.getElementById('wr-risk')!;
    if (!o.ok || !o.result) { risk.innerHTML = stateBlock('error', o.error ?? 'Penanda risiko tidak tersedia.'); return; }
    const link = (id: string) => `<a class="underline" href="/admin/wallet/pemain/?id=${encodeURIComponent(id)}"><code class="text-xs">${esc(id)}</code></a>`;
    risk.innerHTML = [
      section('Penanda risiko', table(['Pemain', 'Penanda'], (o.result.rows ?? []).map((x: any) => [
        link(x.userId), x.flags.map((f: any) => `${esc(f.label)}${f.detail ? ` (${esc(f.detail)})` : ''}`).join('<br>'),
      ]), 'Tidak ada penanda risiko.'), 'Hanya informasi untuk peninjauan. Penanda tidak membekukan atau membatasi akun. Tindakan tetap keputusan Admin dengan alasan.'),
      section('Akun dibatasi', table(['Pemain', 'Status', 'Alasan', 'Peninjauan', 'Sejak'], (o.result.restrictions ?? []).map((x: any) => [
        link(x.userId), x.status === 'ended' ? pill('dihentikan', 'bad') : pill('dibatasi', 'warn'), esc(x.reason),
        x.reviewDoneAt ? 'selesai' : `paling lambat ${esc(fmtWaktu(new Date(x.reviewUntil).toISOString()))}`, `<span class="text-xs">${esc(fmtWaktu(x.startedAt))}</span>`,
      ]), 'Tidak ada akun yang dibatasi.')),
    ].join('');
  }

  document.querySelectorAll<HTMLButtonElement>('#wr-period button').forEach((b) => b.addEventListener('click', () => {
    days = Number(b.dataset.days) || 30;
    void muat();
  }));
  document.addEventListener('admin:ready', (e) => { role = (e as CustomEvent).detail?.role ?? 'viewer'; void muat(); void muatOwner(); });
</script>
