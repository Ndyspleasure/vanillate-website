---
// Halaman publik Jasa (/partnership/jasa): hosting bot & pembuatan bot.
//
// Isi (paket, HARGA, spesifikasi, FAQ, SEO) dikelola dari
// /admin/partnership/jasa, ditarik saat build ke
// src/data/synced/partnership-jasa.json, lalu dinormalisasi di
// src/data/partnership-jasa.ts. Tanpa JavaScript dan tanpa query saat dibuka.
// Tombol pesan membuka WhatsApp official dengan pesan terisi (dibangun saat build).
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import FAQAccordion from '@components/FAQAccordion.astro';
import Icon from '@components/Icon.astro';
import jasa from '@data/synced/partnership-jasa.json';
import { site } from '@data/site';
import { buildWhatsappUrl } from '@data/support';
import { formatPrice } from '@data/partnership';
import { buildJasaMessage, normalisasiJasa } from '@data/partnership-jasa';

const k = normalisasiJasa((jasa as any).content);
const umum = buildWhatsappUrl(buildJasaMessage());
const hrefPaket = (nama: string) => buildWhatsappUrl(buildJasaMessage(nama));

const judul = k.seo.title || k.hero.title;
const deskripsi = k.seo.description || k.hero.subtitle || 'Jasa hosting bot dan pembuatan bot Discord dari Vanillate Studio.';
const canonical = new URL('/partnership/jasa', site.url).toString();

const penawaran = k.packages
  .filter((p) => p.price !== null)
  .map((p) => ({
    '@type': 'Offer',
    name: p.name,
    description: p.tagline || undefined,
    price: String(p.price),
    priceCurrency: p.currency,
    availability: 'https://schema.org/InStock',
    url: canonical,
  }));
const graph: any[] = [
  {
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: 'Jasa Bot Discord Vanillate',
    serviceType: 'Discord bot hosting and development',
    description: deskripsi,
    url: canonical,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: 'ID',
    ...(penawaran.length ? { offers: penawaran.length === 1 ? penawaran[0] : penawaran } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Partnership', item: new URL('/partnership', site.url).toString() },
      { '@type': 'ListItem', position: 3, name: k.hero.title, item: canonical },
    ],
  },
];
if (k.faq.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: k.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
// Isi dari CMS: "<" di-escape supaya tidak bisa menutup tag script.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<BaseLayout title={judul} description={deskripsi} image={k.seo.ogImage || undefined}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <section class="container-page pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">Vanillate Jasa</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl font-semibold tracking-tightest leading-[1.05]">{k.hero.title}</h1>
      {k.hero.subtitle && (
        <p class="mt-5 text-lg md:text-xl text-ink-600 dark:text-cream-200/80 leading-relaxed">{k.hero.subtitle}</p>
      )}
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href={umum} external size="lg">{k.hero.ctaLabel}</Button>
        {k.packages.length > 0 && <Button href="#paket" variant="secondary" size="lg">Lihat paket &amp; harga</Button>}
      </div>
    </div>
  </section>

  {k.packages.length > 0 && (
    <section id="paket" class="container-page py-12 md:py-16 scroll-mt-24">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Paket &amp; harga</h2>
        <p class="mt-3 text-ink-600 dark:text-cream-200/80 leading-relaxed">
          Tekan tombol pesan untuk langsung terhubung dengan tim kami lewat WhatsApp.
        </p>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {k.packages.map((p) => (
          <article class={`relative flex flex-col rounded-3xl border p-6 md:p-7 ${p.badge ? 'border-amber-500/40 bg-amber-500/[0.04]' : 'border-ink-900/10 dark:border-cream-100/10'}`}>
            {p.badge && (
              <span class="absolute -top-3 left-6 rounded-full bg-amber-500 px-3 py-1 text-xs font-semibold text-ink-950">{p.badge}</span>
            )}
            <h3 class="font-display text-2xl font-semibold tracking-tightest">{p.name}</h3>
            {p.tagline && <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/80">{p.tagline}</p>}

            <div class="mt-5">
              {p.price !== null ? (
                <p class="font-display text-3xl font-semibold tracking-tightest">
                  {formatPrice(p.price, p.currency)}
                  {p.unit && <span class="ml-1.5 text-sm font-normal text-ink-500 dark:text-cream-300/60">/ {p.unit}</span>}
                </p>
              ) : (
                <p class="font-display text-2xl font-semibold tracking-tightest">Hubungi kami</p>
              )}
              {p.priceNote && <p class="mt-1.5 text-xs text-ink-500 dark:text-cream-300/60 leading-relaxed">{p.priceNote}</p>}
            </div>

            {p.specs.length > 0 && (
              <dl class="mt-5 divide-y divide-ink-900/5 dark:divide-cream-100/5 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 text-sm">
                {p.specs.map((s) => (
                  <div class="flex items-center justify-between gap-4 px-4 py-2.5">
                    <dt class="text-ink-500 dark:text-cream-300/60">{s.label}</dt>
                    <dd class="font-medium text-right">{s.value}</dd>
                  </div>
                ))}
              </dl>
            )}

            {p.features.length > 0 && (
              <ul class="mt-5 space-y-2.5">
                {p.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm">
                    <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-teal-600 dark:text-teal-400" />
                    <span class="text-ink-700 dark:text-cream-100/90">{f}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="mt-auto pt-7">
              <Button href={hrefPaket(p.name)} external class="w-full">{p.ctaLabel}</Button>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {k.process.length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Cara kerja</h2>
      <ol class="mt-8 grid gap-3 md:grid-cols-4">
        {k.process.map((s) => (
          <li class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 p-5">
            <p class="font-mono text-xs text-amber-600 dark:text-amber-400">{s.n}</p>
            <h3 class="mt-1 font-display text-lg font-semibold tracking-tightest">{s.title}</h3>
            {s.text && <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/80">{s.text}</p>}
          </li>
        ))}
      </ol>
    </section>
  )}

  {k.faq.length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-ink-900/10 dark:border-cream-100/10">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">Pertanyaan umum</h2>
      <div class="mt-8 max-w-3xl"><FAQAccordion items={k.faq} /></div>
    </section>
  )}

  <section class="container-page py-16 md:py-24">
    <div class="rounded-3xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/50 dark:bg-ink-900/40 px-6 py-12 md:px-12 md:py-16 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tightest">{k.cta.title}</h2>
      {k.cta.text && <p class="mt-4 mx-auto max-w-xl text-ink-600 dark:text-cream-200/80 leading-relaxed">{k.cta.text}</p>}
      <div class="mt-8 flex justify-center"><Button href={umum} external size="lg">{k.cta.label}</Button></div>
      <p class="mt-4 text-xs text-ink-500 dark:text-cream-300/60">Tombol ini membuka WhatsApp official Vanillate dengan pesan yang sudah terisi.</p>
    </div>
  </section>
</BaseLayout>
