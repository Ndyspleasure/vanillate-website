---
// Slug lama produk Hand Sign Camera (sebelum diganti ke `hand-sign-camera`).
// GitHub Pages tidak bisa 301, jadi URL lama jadi stub redirect.
import RedirectStub from '@components/RedirectStub.astro';
import { site } from '@data/site';

const to = `${site.url}/products/hand-sign-camera/`;
---

<RedirectStub to={to} title="Pindah ke Hand Sign Camera" text="Halaman produk ini telah dipindahkan ke" linkLabel="Hand Sign Camera" />
