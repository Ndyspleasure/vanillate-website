---
import { url } from '@utils/url';
const target = url('/izin/mcpagent/');
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>Izin akses Agent Hub</title>
</head>
<body>
  <a href={target} id="consent">Buka halaman izin akses Agent Hub</a>
  <script is:inline>
    const destination = new URL(document.getElementById('consent').href);
    destination.search = location.search;
    location.replace(destination.href);
  </script>
</body>
</html>
