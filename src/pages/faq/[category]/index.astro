---
// HALAMAN KATEGORI FAQ — /faq/<kategori>
//
// Daftar seluruh pertanyaan dalam satu kategori. Menjadi tujuan tombol
// "Lihat Panduan" pada produk yang dipetakan ke kategori ini, sekaligus tujuan
// redirect dari URL dokumentasi lama (/docs/<slug>).
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import { bots } from '@data/bots';
import { faqCategories, faqCategoryUrl, faqIndexUrl, faqUrl, faqsByCategory } from '@data/faq';
import type { FaqCategory, FaqEntry } from '@data/faq';
import type { IconName } from '@data/icons';
import { ringkas } from '@utils/markdown';
import { url } from '@utils/url';

export function getStaticPaths() {
  return faqCategories.map((c) => ({
    params: { category: c.slug },
    props: { kategori: c, daftar: faqsByCategory(c.slug), lainnya: faqCategories.filter((x) => x.slug !== c.slug) },
  }));
}

interface Props {
  kategori: FaqCategory;
  daftar: FaqEntry[];
  lainnya: FaqCategory[];
}

const { kategori, daftar, lainnya } = Astro.props as Props;

// Produk yang memakai kategori ini — supaya pembaca yang mendarat di sini dari
// pencarian bisa langsung menuju produknya.
const produk = bots.filter((b) => b.faqCategory === kategori.slug);
---

<BaseLayout
  title={`FAQ ${kategori.name}`}
  description={kategori.description || `Pertanyaan yang sering ditanyakan seputar ${kategori.name}.`}
>
  <div class="container-page pt-16 md:pt-24 pb-24">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm text-ink-500 dark:text-cream-300/60">
      <a href={faqIndexUrl()} class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors">FAQ</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink-800 dark:text-cream-100">{kategori.name}</span>
    </nav>

    <div class="flex items-start gap-4 mb-6">
      <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400" aria-hidden="true">
        <Icon name={kategori.icon as IconName} class="h-6 w-6" />
      </span>
      <div class="min-w-0">
        <h1 class="font-display font-semibold tracking-tightest text-4xl md:text-5xl leading-tight">{kategori.name}</h1>
        {kategori.description && (
          <p class="mt-3 max-w-2xl text-lg text-ink-600 dark:text-cream-200/80 leading-relaxed">{kategori.description}</p>
        )}
      </div>
    </div>

    {produk.length > 0 && (
      <div class="mb-10 flex flex-wrap gap-3">
        {produk.map((p) => (
          <a
            href={url(`/products/${p.slug}`)}
            class="inline-flex items-center gap-2 rounded-full border border-ink-900/10 dark:border-cream-100/10 px-4 py-2 text-sm hover:border-amber-500/50 transition-colors"
          >
            <Icon name={p.icon} class="h-4 w-4 text-amber-600 dark:text-amber-500" />
            Halaman {p.shortName}
          </a>
        ))}
      </div>
    )}

    <!-- Daftar pertanyaan -->
    {daftar.length === 0 ? (
      <div class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 px-6 py-16 text-center">
        <p class="font-display text-lg font-semibold tracking-tightest">Belum ada FAQ pada kategori ini.</p>
        <p class="mt-2 text-sm text-ink-500 dark:text-cream-300/60">Coba kategori lain di halaman FAQ.</p>
        <a href={faqIndexUrl()} class="mt-6 inline-flex items-center gap-1.5 text-sm text-amber-600 dark:text-amber-400 hover:text-amber-500 transition-colors">
          Kembali ke FAQ
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    ) : (
      <div class="grid gap-3">
        {daftar.map((f, i) => (
          <a
            href={faqUrl(f.category, f.slug)}
            class="reveal group rounded-2xl border border-ink-900/10 dark:border-cream-100/10 px-5 py-4 md:px-6 md:py-5 hover:border-amber-500/50 transition-colors"
            style={`--reveal-delay: ${Math.min(i, 8) * 50}ms`}
          >
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h2 class="font-display text-lg font-semibold tracking-tightest group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                  {f.question}
                </h2>
                <p class="mt-1.5 text-sm text-ink-600 dark:text-cream-200/70 leading-relaxed">{ringkas(f.answer, 170)}</p>
              </div>
              <svg class="mt-1 flex-none text-ink-400 dark:text-cream-300/40 group-hover:text-amber-500 group-hover:translate-x-1 transition-all" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    )}

    <!-- Kategori lain -->
    {lainnya.length > 0 && (
      <section class="mt-16 pt-10 border-t border-ink-900/10 dark:border-cream-100/10">
        <p class="eyebrow mb-4">Kategori Lain</p>
        <div class="grid gap-3 sm:grid-cols-2">
          {lainnya.map((c) => (
            <a href={faqCategoryUrl(c.slug)} class="group flex items-center gap-3 p-4 rounded-xl border border-ink-900/10 dark:border-cream-100/10 hover:border-amber-500/50 transition-colors">
              <span class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400" aria-hidden="true">
                <Icon name={c.icon as IconName} class="h-5 w-5" />
              </span>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-sm group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">{c.name}</p>
                <p class="text-xs text-ink-500 dark:text-cream-300/60">{faqsByCategory(c.slug).length} pertanyaan</p>
              </div>
              <svg class="flex-none text-ink-400 dark:text-cream-300/40 group-hover:text-amber-500 transition-colors" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
