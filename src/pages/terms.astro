---
import BaseLayout from '@layouts/BaseLayout.astro';
import { url } from '@utils/url';

const lastUpdated = '22 November 2026';

// Daftar isi ringkas — sekaligus penanda nomor & judul tiap section.
const toc = [
  { n: '01', id: 'acceptance', label: 'Acceptance of Terms' },
  { n: '02', id: 'scope', label: 'Scope of These Terms' },
  { n: '03', id: 'description', label: 'Description of Services' },
  { n: '04', id: 'user-responsibilities', label: 'User Responsibilities' },
  { n: '05', id: 'server-owner', label: 'Server Owner Responsibilities' },
  { n: '06', id: 'virtual-items', label: 'Virtual Items & In-Game Economy' },
  { n: '07', id: 'wallet', label: 'Vanillate Wallet & Vani Poin' },
  { n: '08', id: 'data-privacy', label: 'Data Usage and Privacy' },
  { n: '09', id: 'availability', label: 'Availability' },
  { n: '10', id: 'suspension', label: 'Suspension and Termination' },
  { n: '11', id: 'liability', label: 'Limitation of Liability' },
  { n: '12', id: 'changes', label: 'Changes to Terms' },
  { n: '13', id: 'contact', label: 'Contact' },
];
---

<BaseLayout
  title="Terms of Service"
  description="Ketentuan penggunaan komunitas, game, bot, dan layanan Vanillate Studio."
>
  <!-- HERO -->
  <section class="relative overflow-hidden pt-20 md:pt-28 pb-10">
    <div class="aurora bg-teal-500/15 h-[360px] w-[360px] top-[-120px] right-[6%]" aria-hidden="true"></div>
    <div class="container-page max-w-3xl relative">
      <p class="eyebrow mb-6 animate-fade-up">Legal</p>
      <h1 class="font-display font-semibold tracking-tightest text-4xl md:text-6xl leading-tight mb-5 animate-fade-up">
        Terms of Service
      </h1>
      <p class="max-w-2xl text-lg text-ink-600 dark:text-cream-200/80 leading-relaxed animate-fade-up" style="animation-delay: 0.1s">
        Ketentuan yang mengatur akses dan penggunaan seluruh produk dan layanan yang dikembangkan Vanillate Studio.
      </p>
      <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/50 dark:bg-ink-900/50 px-3.5 py-1.5 font-mono text-xs text-ink-500 dark:text-cream-300/70 animate-fade-up" style="animation-delay: 0.15s">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        Last Updated: {lastUpdated}
      </div>
    </div>
  </section>

  <!-- TABLE OF CONTENTS -->
  <section class="container-page max-w-3xl pb-4">
    <nav class="rounded-2xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-100/40 dark:bg-ink-900/40 p-5 md:p-6 reveal" aria-label="Daftar isi">
      <p class="eyebrow mb-4">Daftar Isi</p>
      <ol class="grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
        {toc.map((s) => (
          <li>
            <a href={`#${s.id}`} class="group flex items-center gap-3 rounded-lg px-2 py-1.5 -mx-2 text-sm text-ink-700 dark:text-cream-200 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors">
              <span class="font-mono text-xs text-amber-600 dark:text-amber-500 flex-none">{s.n}</span>
              <span class="group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">{s.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <!-- BODY -->
  <section class="container-page max-w-3xl pb-24">
    <div class="text-ink-700 dark:text-cream-200 leading-relaxed">
      <section id="acceptance" class="legal-sec reveal scroll-mt-24">
        <div class="legal-head">
          <span class="legal-badge">01</span>
          <h2 class="legal-title">Acceptance of Terms</h2>
        </div>
        <p class="mb-4">
          These Terms of Service ("Terms") govern your access to and use of the products and services developed and operated by Vanillate Studio ("Vanillate Studio", "we", "our", or "us").
        </p>
        <p>
          By inviting, accessing, or using any of our Services, you agree to be bound by these Terms. If you do not agree with these Terms, you must stop using the Services immediately.
        </p>
      </section>

      <section id="scope" class="legal-sec reveal scroll-mt-24">
        <div class="legal-head">
          <span class="legal-badge">02</span>
          <h2 class="legal-title">Scope of These Terms</h2>
        </div>
        <p class="mb-4">
          These Terms apply to all products and services operated by Vanillate Studio (collectively, the "Services"), including but not limited to:
        </p>
        <ul class="space-y-2 pl-0 list-none mb-4">
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Every Discord bot and application developed by Vanillate Studio</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>The official Vanillate Studio website and any related features</span></li>
        </ul>
        <p class="mb-4">
          These Terms also apply to any new bots, applications, or services released by Vanillate Studio in the future, unless that product is expressly provided with its own separate terms.
        </p>
        <div class="rounded-2xl border border-amber-600/20 dark:border-amber-400/20 bg-amber-50/40 dark:bg-amber-950/20 p-5 md:p-6">
          <p class="text-sm mb-3">
            <strong>Special Terms for Specific Features:</strong> Certain features may be governed by additional or separate terms. For example, the Cross-Server Matchmaking feature in Vanillate.ID (formerly Vanillate Sambung Kata) is subject to the <a
              href={url('/terms-matchmaking')}
              class="text-amber-600 dark:text-amber-400 underline underline-offset-2 hover:text-amber-700 dark:hover:text-amber-300"
            >Cross-Server Matchmaking Terms of Use</a>.
          </p>
        </div>
      </section>

      <section id="description" class="legal-sec reveal scroll-mt-24">
        <div class="legal-head">
          <span class="legal-badge">03</span>
          <h2 class="legal-title">Description of Services</h2>
        </div>
        <p class="mb-4">
          Our Services primarily consist of Discord bots that provide interactive gameplay, community, and server management features, together with the Vanillate Dashboard on our website where server administrators configure them. Depending on the Service, these may include, but are not limited to:
        </p>
        <ul class="space-y-2 pl-0 list-none mb-4">
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Multiplayer and single-player gameplay systems</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Player statistics and progression tracking</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Leaderboards and ranking systems</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Virtual economy, item, boost, or reward systems</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Achievements, quests, and community engagement features</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Social features such as counting, daily streaks, anonymous confessions, and server promotion (Share Server)</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Vanillate Wallet, a community reward program in which Vani Poin (VP) can be withdrawn as real money</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Server management tools such as verification, automatic roles, welcome messages, leveling, and security notifications</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>The Vanillate Dashboard for configuring the bot in a server</span></li>
        </ul>
        <p>
          Feature availability varies between Services. We may modify, update, add, or remove features of any Service at any time without prior notice to improve service quality or ensure stability.
        </p>
      </section>

      <section id="user-responsibilities" class="legal-sec reveal scroll-mt-24">
        <div class="legal-head">
          <span class="legal-badge">04</span>
          <h2 class="legal-title">User Responsibilities</h2>
        </div>
        <p class="mb-4">Users agree to use the Services responsibly and must:</p>
        <ul class="space-y-2 pl-0 list-none">
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Follow Discord Terms of Service and Community Guidelines</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Use the Services only for their intended purposes</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not exploit bugs, glitches, or unintended mechanics</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not use automated scripts, bots, or external tools to gain unfair advantages</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not interfere with or disrupt the normal operation of any Service</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not submit content that is unlawful, threatening, harassing, hateful, sexually explicit, or that infringes the rights of others</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not use social features, including anonymous ones, to target, abuse, or harm other people</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not use server promotion (Share Server) for misleading, unsafe, or Discord-rule-breaking content</span></li>
        </ul>
        <p class="mt-4">Content you submit through the Services remains your responsibility. Anonymous features are meant to protect privacy between members, not to enable misuse. We may remove content and restrict access to some or all of the Services to keep the community safe.</p>
        <p class="mt-4">Violation of these rules may result in restricted access to some or all of the Services.</p>
      </section>

      <section id="server-owner" class="legal-sec reveal scroll-mt-24">
        <div class="legal-head">
          <span class="legal-badge">05</span>
          <h2 class="legal-title">Server Owner Responsibilities</h2>
        </div>
        <p class="mb-4">Server owners and administrators are responsible for:</p>
        <ul class="space-y-2 pl-0 list-none">
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Managing the permissions granted to any Vanillate Studio bot in their server</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Ensuring the Services are used appropriately within their server</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Removing a bot if they no longer wish to use it</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Granting the permissions a feature needs and keeping the bot's role positioned above any roles it must manage</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Informing their members about the features enabled in the server, such as verification, leveling, or security notices, where required</span></li>
        </ul>
      </section>

      <section id="virtual-items" class="legal-sec reveal scroll-mt-24">
        <div class="legal-head">
          <span class="legal-badge">06</span>
          <h2 class="legal-title">Virtual Items and In-Game Economy</h2>
        </div>
        <p class="mb-4">
          Some Services include virtual currencies, items, boosts, or other in-game content ("Virtual Items"). Virtual Items:
        </p>
        <ul class="space-y-2 pl-0 list-none mb-4">
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Have no real-world monetary value and cannot be redeemed, exchanged, or sold for real money or anything of value outside the Services. Vani Poin (VP), governed by section 07, is the only exception and is separate from every other in-game currency or item</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>May be adjusted, rebalanced, or reset when necessary for fairness, stability, or feature updates</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Remain part of the Services and are not owned by users</span></li>
        </ul>
        <p>
          Buying, selling, or trading Virtual Items or accounts outside the Services is prohibited.
        </p>
      </section>

      <section id="wallet" class="legal-sec reveal scroll-mt-24">
        <div class="legal-head">
          <span class="legal-badge">07</span>
          <h2 class="legal-title">Vanillate Wallet and Vani Poin (VP)</h2>
        </div>
        <p class="mb-4">
          This section applies once Vanillate Wallet is made available. Where it conflicts with another section of these Terms on a matter concerning VP, this section prevails. How Wallet data is handled is explained in our <a href={url('/privacy')} class="text-amber-600 dark:text-amber-400 underline underline-offset-2 hover:text-amber-700 dark:hover:text-amber-300">Privacy Policy</a>.
        </p>
        <h3 class="legal-sub">7.1 Voluntary Participation and Acceptance of Wallet Terms</h3>
        <p class="mb-3">Participation in Vanillate Wallet is voluntary. Before using Vanillate Wallet for the first time, you will be asked to expressly accept these Terms, including this section, and our Privacy Policy. By expressly accepting them and participating in the program, you agree to comply with these Terms, the Wallet program rules shown in Vanillate Wallet, and the other applicable policies made available on our official website. We record the version you accepted, the time of acceptance, and your Discord user ID.</p>
        <p class="mb-3">Participation does not guarantee future rewards, income, or the permanent availability of any Wallet feature. If we make a material change to the Wallet rules, we may ask you to accept the updated rules before you earn new VP or use affected features. If you do not accept them, you may stop participating in new activities, and your legitimately earned balance and earlier transactions will still be handled under the rules that applied to them and mandatory legal requirements.</p>
        <p class="mb-3">Accepting these Terms does not waive any right that cannot lawfully be waived.</p>
        <h3 class="legal-sub">7.2 Nature of Vani Poin</h3>
        <p class="mb-3">Vanillate Wallet is an optional community rewards feature of Vanillate.ID, opened with the <span class="font-mono text-sm">/dompet</span> command and operated by Vanillate Studio. Vani Poin ("VP") may be awarded to eligible users for qualifying activities, including verified votes for Vanillate.ID on Top.gg, genuine daily activity with the bot, and other activities expressly supported by the program.</p>
        <p class="mb-3">VP is separate from ordinary in-game currencies, items, and virtual rewards, and cannot be exchanged for or from them. VP cannot be bought and does not expire.</p>
        <p class="mb-3">Where the cash withdrawal feature is enabled, eligible VP may be withdrawn at the published rate of 1 VP to IDR 1, subject to the applicable eligibility requirements, withdrawal rules, security checks, and the availability of supported payment methods.</p>
        <p class="mb-3">VP is not offered as a bank deposit, an investment product, an interest bearing account, or government issued currency, and it does not earn interest, dividends, or investment returns. Its legal classification remains subject to applicable law, and nothing in these Terms exempts Vanillate Studio from a regulatory requirement that applies to its actual activities.</p>
        <h3 class="legal-sub">7.3 Rights of Vanillate Studio</h3>
        <p class="mb-3">Vanillate Wallet is provided by Vanillate Studio on a voluntary basis. Subject to applicable law, Vanillate Studio may:</p>
        <ul class="space-y-2 pl-0 list-none mb-3">
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Set and change eligibility requirements for the program</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Decide reward amounts, the ways VP can be earned, and the features available, and change reward rates for future activity</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Open, close, or limit enrollment and participation in the program</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Take time to review reward claims, reject invalid claims, and ask for additional verification</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Temporarily suspend withdrawals or transfers where there is a security risk, a service disruption, suspected fraud, or a compliance reason that can be justified</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Review transaction history to prevent abuse, and correct system errors, duplicated VP, and unauthorized transactions through auditable records</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Restrict or end the participation of users who break these rules, in proportion to the violation and following its review procedure</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Suspend or discontinue optional Wallet features or the whole program for legitimate operational, financial, security, or legal reasons, following section 7.12</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Protect its operating funds and infrastructure, and refuse requests that conflict with the program rules or applicable law</span></li>
        </ul>
        <p class="mb-3">Vanillate Studio is not obligated to offer future VP for any particular activity, to keep specific reward rates indefinitely, or to operate optional reward features permanently. Taking part in Vanillate Wallet does not create an employment, agency, partnership, investment, or guaranteed income relationship between you and Vanillate Studio.</p>
        <p class="mb-3">Operational decisions may be made by an authorized administrator. Each decision must have a clear basis, is recorded, and can be reviewed if it was made in error. These rights apply to future rewards and to the protection of the program. They do not authorize arbitrary cancellation of legitimately earned VP, disregard of accepted transactions, or removal of rights protected by applicable law.</p>
        <h3 class="legal-sub">7.4 Your Obligations</h3>
        <p class="mb-3">If you participate in Vanillate Wallet, you must:</p>
        <ul class="space-y-2 pl-0 list-none mb-3">
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Comply with these Terms, our Privacy Policy, and the Wallet program rules</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Provide accurate information</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Keep your Discord account and your Wallet PIN secure</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not cheat, exploit vulnerabilities, or manipulate rewards or qualifying activities</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not use other accounts to obtain an unfair benefit</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not use Vanillate Wallet for any unlawful activity</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Use only a payment account that you own or are lawfully entitled to use</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Cooperate with verification and security checks</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Not claim rewards for activity that has not met the requirements or has not been verified</span></li>
          <li class="flex gap-3"><span class="text-amber-600 dark:text-amber-500 font-mono text-sm mt-1.5 flex-none">→</span><span>Understand that rewards do not guarantee any income and that features may change under these rules</span></li>
        </ul>
        <p class="mb-3">Breaking these rules may lead to restricted features, a review of your transactions, cancellation of VP that is proven to be invalid, or the end of your participation, following the review procedure in section 7.9.</p>
        <h3 class="legal-sub">7.5 Reward Eligibility and Verification</h3>
        <p class="mb-3">VP is awarded only when the applicable eligibility conditions have been met and the qualifying activity has been validly verified. Duplicate, falsified, manipulated, or otherwise invalid reward claims may be rejected. A failed, interrupted, or unverified activity does not by itself create an entitlement to VP.</p>
        <p class="mb-3">Where a valid reward was not credited because of a technical error, Vanillate Studio may investigate and correct it using its transaction records. Reward amounts and eligibility rules may change for the future only. Previously verified rewards will not be reduced solely because a reward rate changes.</p>
        <h3 class="legal-sub">7.6 Withdrawals</h3>
        <p class="mb-3">When withdrawals are available, eligible users may submit withdrawal requests under the rules displayed in Vanillate Wallet. The initial minimum withdrawal is 1,000 VP, subject to the published configuration. Withdrawals are paid manually by an authorized administrator through supported Indonesian bank or e-wallet transfers, and transfer fees are covered by Vanillate Studio.</p>
        <p class="mb-3">The published processing target is 24 working hours, counting Monday to Friday in the Asia/Jakarta time zone. National holidays are counted as working days under the current program policy. This is an operational target, not a guarantee: processing may be delayed by payment provider availability, technical incidents, incorrect recipient details, verification requirements, security reviews, or other legitimate circumstances. Vanillate Studio will make reasonable efforts to tell you about material delays.</p>
        <p class="mb-3">You may ask to cancel a withdrawal before it is processed, subject to approval. An accepted withdrawal will not be rejected arbitrarily. Any rejection, cancellation, or reversal follows the withdrawal rules and is recorded with a reason, and the VP of a rejected or cancelled withdrawal is returned to your Wallet. A payout whose outcome is uncertain is verified with the payment provider before any further payment attempt. A completed withdrawal is final and will not be paid again or treated as unpaid without investigation.</p>
        <h3 class="legal-sub">7.7 Payment Account and Security</h3>
        <p class="mb-3">Only one active payment account may be registered per Wallet, and each payment account may be registered to only one Discord account. Registering or changing it requires a one time code sent by Discord direct message and may be reviewed manually.</p>
        <p class="mb-3">Withdrawals and transfers require your PIN. Vanillate Studio will never ask for your PIN. Changing your payment account or resetting your PIN pauses withdrawals and transfers for 24 hours. Vanillate Studio will take reasonable steps to check the intended recipient before completing a payout. Do not register payment details belonging to another person.</p>
        <h3 class="legal-sub">7.8 Transfers Between Users</h3>
        <p class="mb-3">When enabled, VP may be transferred between eligible users through the official Wallet interface only, authorized with the required security steps. A valid completed transfer is generally final. Suspected fraud, unauthorized transactions, duplicate transfers, or technical errors may be investigated and corrected through an auditable process.</p>
        <p class="mb-3">Transfers must not be used for fraud, unlawful activity, money laundering, unauthorized commercial transactions, or breaches of platform rules.</p>
        <h3 class="legal-sub">7.9 Abuse, Fraud, and Security Reviews</h3>
        <p class="mb-3">Vanillate Studio may review suspicious activity and the related transaction records, and may temporarily hold a specific withdrawal or transfer, or restrict affected Wallet functions, where reasonably necessary to investigate a specific security or legal concern, protect users, preserve system integrity, or comply with the law. Holds and restrictions are proportionate to the identified risk, recorded with a reason, and lifted when the review ends without a finding.</p>
        <p class="mb-3">Verified erroneous credits and fraudulently obtained VP may be corrected through auditable transactions. Legitimately earned balances are not confiscated merely because an automated risk indicator exists, and you may request a review of a Wallet decision through our official support channel.</p>
        <h3 class="legal-sub">7.10 Technical Errors and Corrections</h3>
