---
// Redirect permanen: katalog dipindah dari /bots ke /products (reposisi umbrella).
// Situs statis → tak ada redirect sisi server, jadi memakai meta-refresh +
// canonical. Dikeluarkan dari sitemap (lihat astro.config.mjs).
import { url } from '@utils/url';
const to = url('/products');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={to} />
    <title>Pindah ke Produk</title>
  </head>
  <body>
    <p>Halaman ini kini berada di <a href={to}>Produk</a>.</p>
    <script is:inline set:html={`location.replace(${JSON.stringify(to)});`}></script>
  </body>
</html>
