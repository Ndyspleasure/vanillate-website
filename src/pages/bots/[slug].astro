---
// Redirect per-produk: /bots/<slug> → /products/<slug>. Satu stub per slug yang
// dikenal, dibangun dari registry produk. Dikeluarkan dari sitemap.
import { bots } from '@data/bots';
import { url } from '@utils/url';

export function getStaticPaths() {
  return bots.map((b) => ({ params: { slug: b.slug }, props: { to: url(`/products/${b.slug}`) } }));
}

const { to } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={to} />
    <title>Pindah</title>
  </head>
  <body>
    <p>Halaman ini kini berada di <a href={to}>halaman produk</a>.</p>
    <script is:inline set:html={`location.replace(${JSON.stringify(to)});`}></script>
  </body>
</html>
