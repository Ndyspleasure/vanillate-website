---
// Layout khusus area admin.
//
// Sengaja TIDAK memakai Header/Footer publik: area ini bukan bagian dari
// perjalanan pengunjung biasa, dan menautkannya dari navigasi umum hanya
// menambah permukaan yang tidak perlu.
//
// Semua halaman yang memakai layout ini di-set noindex.
import '../styles/global.css';
import { url } from '@utils/url';

export interface Props {
  title: string;
  /** Halaman login memakai false: belum ada sesi yang bisa diperiksa. */
  requireAuth?: boolean;
  /** Kunci menu yang sedang aktif. */
  active?: string;
}

const { title, requireAuth = true, active } = Astro.props;

// Menu admin dikelompokkan per bidang kerja supaya sidebar tetap terbaca saat
// jumlah halaman bertambah. Item tunggal (Ringkasan) memakai `href` langsung;
// grup memakai `items` dan bisa dibuka-tutup.
const menu = [
  {
    key: 'ringkasan', label: 'Ringkasan', href: '/admin/dashboard',
    icon: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
  },
  {
    key: 'grup-konten', label: 'Konten',
    icon: '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/>',
    items: [
      { key: 'halaman', label: 'Konten Halaman', href: '/admin/halaman' },
      { key: 'konten',  label: 'Pengumuman',     href: '/admin/konten' },
    ],
  },
  {
    key: 'grup-faq', label: 'FAQ & Panduan',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
    items: [
      { key: 'faq',            label: 'Pertanyaan', href: '/admin/faq' },
      { key: 'faq-kategori',   label: 'Kategori',   href: '/admin/faq/categories' },
    ],
  },
  {
    key: 'grup-produk', label: 'Produk',
    icon: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
    items: [
      { key: 'produk', label: 'Katalog Produk', href: '/admin/produk' },
    ],
  },
  {
    key: 'grup-bot', label: 'Operasional Bot',
    icon: '<path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>',
    items: [
      { key: 'kontrol', label: 'Kontrol Bot',   href: '/admin/kontrol' },
      { key: 'operasi', label: 'Operasi Bot',   href: '/admin/operasi' },
      { key: 'games',   label: 'Monitor Game',  href: '/admin/games' },
      { key: 'promo',   label: 'Promo',         href: '/admin/promo' },
      { key: 'kata',    label: 'Moderasi Kata', href: '/admin/kata' },
    ],
  },
  {
    key: 'grup-partnership', label: 'Partnership', href: '/admin/partnership',
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m17 11 2 2 4-4"/>',
    match: 'partnership',
  },
  {
    key: 'grup-data', label: 'Data & Laporan',
    icon: '<path d="M3 3v18h18"/><path d="m7 15 3-4 3 3 5-7"/>',
    items: [
      { key: 'statistik', label: 'Statistik',     href: '/admin/statistik' },
      { key: 'logs',      label: 'Log Aktivitas', href: '/admin/logs' },
      { key: 'server',    label: 'Server',        href: '/admin/server' },
      { key: 'pemain',    label: 'Pemain',        href: '/admin/pemain' },
    ],
  },
];

/** Grup dianggap aktif bila salah satu anaknya (atau dirinya) sedang dibuka. */
function grupAktif(m: any, aktif?: string): boolean {
  if (m.key === aktif) return true;
  if (m.match && aktif === m.match) return true;
  return Array.isArray(m.items) && m.items.some((i: any) => i.key === aktif);
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Admin Vanillate</title>
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />

    <script is:inline>
      // Area admin dipakai lama dan sering malam hari — default gelap,
      // tapi tetap hormati pilihan tema yang sudah tersimpan.
      (function () {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('theme');
          if (stored ? stored === 'dark' : true) document.documentElement.classList.add('dark');
        } catch (_) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-cream-50 dark:bg-ink-950 text-ink-900 dark:text-cream-100">
    {requireAuth ? (
      <>
        <!--
          Gerbang tampilan. Konten admin disembunyikan sampai sesi terverifikasi,
          supaya kerangka dashboard tidak sempat berkedip untuk orang yang tidak
          berhak. Ini murni soal tampilan — penjagaan datanya ada di RLS Supabase.
        -->
        <div id="admin-gate" class="flex min-h-screen items-center justify-center">
          <div class="text-center">
            <div class="mx-auto h-8 w-8 animate-spin rounded-full border-2 border-amber-500/30 border-t-amber-500"></div>
            <p class="mt-4 text-sm text-ink-500 dark:text-cream-300/60">Memeriksa sesi…</p>
          </div>
        </div>

        <div id="admin-shell" class="hidden lg:grid lg:grid-cols-[260px_1fr] min-h-screen">
          <!-- SIDEBAR -->
          <aside class="border-b lg:border-b-0 lg:border-r border-ink-900/10 dark:border-cream-100/10 lg:sticky lg:top-0 lg:h-screen flex flex-col">
            <div class="p-6 border-b border-ink-900/10 dark:border-cream-100/10">
              <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">Vanillate</p>
              <p class="font-display text-lg font-semibold tracking-tightest mt-1">Panel Admin</p>
            </div>

            <nav class="flex-1 p-4 overflow-x-auto" aria-label="Navigasi admin">
              <ul class="flex lg:flex-col gap-1">
                {menu.map((m) => {
                  const aktif = grupAktif(m, active);
                  const kelasBaris = `flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium whitespace-nowrap transition-colors ${
                    aktif
                      ? 'bg-amber-500/15 text-amber-700 dark:text-amber-400'
                      : 'text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5'
                  }`;
                  return (
                    <li>
                      {m.items ? (
                        <div data-grup={m.key}>
                          <button type="button" class={kelasBaris} data-grup-toggle aria-expanded={aktif ? 'true' : 'false'}>
                            <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={m.icon} />
                            <span class="flex-1 text-left">{m.label}</span>
                            <svg class="h-3.5 w-3.5 flex-none transition-transform" data-grup-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={aktif ? '' : 'transform: rotate(-90deg)'}>
                              <path d="m6 9 6 6 6-6" />
                            </svg>
                          </button>
                          <ul class:list={['mt-1 space-y-0.5 lg:pl-4', !aktif && 'hidden']} data-grup-panel>
                            {m.items.map((i) => (
                              <li>
                                <a
                                  href={url(i.href)}
                                  aria-current={active === i.key ? 'page' : undefined}
                                  class={`block rounded-lg border-l-2 px-3 py-2 text-sm whitespace-nowrap transition-colors ${
                                    active === i.key
                                      ? 'border-amber-500 bg-amber-500/10 text-amber-700 dark:text-amber-400 font-medium'
                                      : 'border-ink-900/10 dark:border-cream-100/10 text-ink-600 dark:text-cream-200/70 hover:border-amber-500/50 hover:bg-ink-900/5 dark:hover:bg-cream-100/5'
                                  }`}
                                >
                                  {i.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ) : (
                        <a href={url(m.href)} class={kelasBaris} aria-current={aktif ? 'page' : undefined}>
                          <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={m.icon} />
                          {m.label}
                        </a>
                      )}
                    </li>
                  );
                })}
              </ul>
            </nav>

            <div class="p-4 border-t border-ink-900/10 dark:border-cream-100/10">
              <div class="px-3 py-2 mb-2">
                <p class="text-sm font-medium" id="admin-name">—</p>
                <p class="text-xs text-ink-500 dark:text-cream-300/60" id="admin-role">—</p>
              </div>
              <button
                type="button"
                id="admin-logout"
                class="w-full rounded-xl border border-ink-900/10 dark:border-cream-100/10 px-3 py-2 text-sm font-medium text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors"
              >
                Keluar
              </button>
            </div>
          </aside>

          <!-- KONTEN -->
          <div class="min-w-0">
            <slot />
          </div>
        </div>
      </>
    ) : (
      <slot />
    )}

    <!--
      Skrip penjaga sesi.

      Ditaruh di level atas template dan BUKAN di dalam `{requireAuth && (...)}`.
      Astro hanya mem-bundle <script> yang bisa dianalisis secara statis; skrip
      di dalam ekspresi kondisional dikirim mentah ke browser, sehingga baris
      `import` di dalamnya langsung gagal ("Cannot use import statement outside
      a module") dan penjagaan tidak pernah berjalan.

      Halaman login memakai requireAuth={false} dan tidak merender #admin-gate,
      jadi ada tidaknya elemen itu yang dipakai sebagai penanda apakah penjagaan
      perlu dijalankan.
    -->
    <script>
      import { requireAdmin, logout } from '@/lib/admin-auth';
      import { url } from '@/utils/url';

      const gate = document.getElementById('admin-gate');
      const shell = document.getElementById('admin-shell');

      if (gate && shell) {
        (async () => {
          const profile = await requireAdmin(url('/admin'));
          if (!profile) return; // requireAdmin sudah melakukan redirect

          const nameEl = document.getElementById('admin-name');
          const roleEl = document.getElementById('admin-role');
          if (nameEl) nameEl.textContent = profile.display_name || profile.username;
          if (roleEl) roleEl.textContent = profile.role;

          gate.remove();
          shell.classList.remove('hidden');

          // Beri tahu halaman bahwa sesi siap, supaya bisa mulai mengambil data.
          document.dispatchEvent(new CustomEvent('admin:ready', { detail: profile }));
        })();

        document.getElementById('admin-logout')?.addEventListener('click', async () => {
          await logout();
          window.location.replace(url('/admin'));
        });
      }
    </script>

    <script>
      // Buka-tutup grup sidebar. Grup halaman yang sedang dibuka selalu
      // terbuka dari server; pilihan manual disimpan supaya bertahan antar
      // halaman. Tanpa JS, grup aktif tetap terlihat (kelas hidden dari server).
      (() => {
        const KUNCI = 'vanillate-admin-grup';
        let tertutup: string[] = [];
        try {
          tertutup = JSON.parse(localStorage.getItem(KUNCI) || '[]');
        } catch (_) {
          tertutup = [];
        }

        document.querySelectorAll<HTMLElement>('[data-grup]').forEach((grup) => {
          const nama = grup.dataset.grup!;
          const tombol = grup.querySelector<HTMLButtonElement>('[data-grup-toggle]');
          const panel = grup.querySelector<HTMLElement>('[data-grup-panel]');
          const chevron = grup.querySelector<HTMLElement>('[data-grup-chevron]');
          if (!tombol || !panel) return;

          // Grup berisi halaman aktif tidak pernah ikut disembunyikan.
          const punyaAktif = !!panel.querySelector('[aria-current="page"]');
          const setTerbuka = (terbuka: boolean) => {
            panel.classList.toggle('hidden', !terbuka);
            tombol.setAttribute('aria-expanded', String(terbuka));
            if (chevron) chevron.style.transform = terbuka ? '' : 'rotate(-90deg)';
          };

          if (!punyaAktif && tertutup.includes(nama)) setTerbuka(false);

          tombol.addEventListener('click', () => {
            const terbukaSekarang = !panel.classList.contains('hidden');
            setTerbuka(!terbukaSekarang);
            const daftar = new Set(tertutup);
            if (terbukaSekarang) daftar.add(nama);
            else daftar.delete(nama);
            tertutup = [...daftar];
            try { localStorage.setItem(KUNCI, JSON.stringify(tertutup)); } catch (_) {}
          });
        });
      })();
    </script>
  </body>
</html>
