---
// Layout khusus area admin.
//
// Sengaja TIDAK memakai Header/Footer publik: area ini bukan bagian dari
// perjalanan pengunjung biasa, dan menautkannya dari navigasi umum hanya
// menambah permukaan yang tidak perlu.
//
// Semua halaman yang memakai layout ini di-set noindex.
import '../styles/global.css';
import { url } from '@utils/url';
import AdminMenuNode from '../components/AdminMenuNode.astro';
import { adminMenu, jejak, indeksPencarian } from '../lib/admin-menu';

export interface Props {
  title: string;
  /** Halaman login memakai false: belum ada sesi yang bisa diperiksa. */
  requireAuth?: boolean;
  /** Kunci menu yang sedang aktif. */
  active?: string;
}

const { title, requireAuth = true, active } = Astro.props;

// Menu admin berbentuk pohon kategori bertingkat (src/lib/admin-menu.ts).
// Grup yang berisi halaman aktif otomatis terbuka; breadcrumb dihitung dari
// jalur yang sama.
const jalur = jejak(adminMenu, active);
const indeksCari = indeksPencarian(adminMenu);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Admin Vanillate</title>
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />

    <script is:inline>
      // Area admin dipakai lama dan sering malam hari — default gelap,
      // tapi tetap hormati pilihan tema yang sudah tersimpan.
      (function () {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('theme');
          if (stored ? stored === 'dark' : true) document.documentElement.classList.add('dark');
        } catch (_) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <style is:global>
      /*
        Sidebar ditutup.
        Layar lebar: menyempit jadi rail ikon (logo, ikon kategori, tema); klik logo
        atau ikon kategori membuka lagi. Layar kecil: sidebar disembunyikan dan
        tombol buka melayang di kiri atas.
      */
      @media (min-width: 1024px) {
        #admin-shell.sidebar-tutup { grid-template-columns: 72px minmax(0, 1fr); }
        #admin-shell.sidebar-tutup .rail-sembunyi,
        #admin-shell.sidebar-tutup [data-label],
        #admin-shell.sidebar-tutup [data-grup-chevron],
        #admin-shell.sidebar-tutup [data-grup-panel],
        #admin-shell.sidebar-tutup #admin-cari-wrap,
        #admin-shell.sidebar-tutup #admin-cari-hasil,
        #admin-shell.sidebar-tutup #admin-sidebar-kaki { display: none !important; }
        #admin-shell.sidebar-tutup .rail-tampil { display: inline-flex !important; }
        #admin-shell.sidebar-tutup #admin-sidebar-kepala { flex-direction: column; align-items: center; padding: 1rem 0.5rem; gap: 0.5rem; }
        #admin-shell.sidebar-tutup #admin-nav { padding: 0.75rem 0.5rem; overflow-x: hidden; }
        #admin-shell.sidebar-tutup #admin-nav [data-top] { justify-content: center; padding-left: 0; padding-right: 0; }
        #admin-shell.sidebar-tutup #admin-melayang { display: none !important; }
      }
      @media (max-width: 1023px) {
        #admin-shell.sidebar-tutup > aside { display: none; }
        #admin-shell.sidebar-tutup .admin-konten { padding-top: 3.25rem; }
      }
    </style>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-cream-50 dark:bg-ink-950 text-ink-900 dark:text-cream-100">
    {requireAuth ? (
      <>
        <!--
          Gerbang tampilan. Konten admin disembunyikan sampai sesi terverifikasi,
          supaya kerangka dashboard tidak sempat berkedip untuk orang yang tidak
          berhak. Ini murni soal tampilan — penjagaan datanya ada di RLS Supabase.
        -->
        <div id="admin-gate" class="flex min-h-screen items-center justify-center">
          <div class="text-center">
            <div class="mx-auto h-8 w-8 animate-spin rounded-full border-2 border-amber-500/30 border-t-amber-500"></div>
            <p class="mt-4 text-sm text-ink-500 dark:text-cream-300/60">Memeriksa sesi…</p>
          </div>
        </div>

        <div id="admin-shell" class="hidden lg:grid lg:grid-cols-[260px_1fr] min-h-screen">
          <!-- SIDEBAR -->
          <aside class="border-b lg:border-b-0 lg:border-r border-ink-900/10 dark:border-cream-100/10 lg:sticky lg:top-0 lg:h-screen flex flex-col">
            <div id="admin-sidebar-kepala" class="p-6 border-b border-ink-900/10 dark:border-cream-100/10 flex items-start justify-between gap-2">
              <a href={url('/admin/dashboard')} data-logo aria-label="Vanillate" class="flex flex-none items-center gap-3 min-w-0">
                <img src={url('/logos/mark/light/original.png')} alt="" width="32" height="32" class="h-8 w-8 flex-none object-contain dark:hidden" />
                <img src={url('/logos/mark/dark/original.png')} alt="" width="32" height="32" class="hidden h-8 w-8 flex-none object-contain dark:block" />
                <span class="min-w-0 rail-sembunyi">
                  <span class="block font-mono text-[0.65rem] uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">Vanillate</span>
                  <span class="block font-display text-lg font-semibold tracking-tightest mt-0.5">Panel Admin</span>
                </span>
              </a>
              <div class="flex flex-none items-center gap-0.5 -mr-2 -mt-1 rail-ikon">
                <button type="button" data-theme-toggle aria-label="Ganti tema terang atau gelap" title="Tema terang/gelap" class="inline-flex h-9 w-9 flex-none items-center justify-center rounded-lg text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors"><svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg><svg class="block dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg></button>
                <button type="button" data-sidebar-tutup aria-label="Tutup sidebar" title="Tutup sidebar" class="inline-flex h-9 w-9 flex-none items-center justify-center rounded-lg text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors rail-sembunyi">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 3v18" /><path d="m16 15-3-3 3-3" /></svg>
                </button>
                <button type="button" data-sidebar-buka aria-label="Buka sidebar" title="Buka sidebar" class="inline-flex h-9 w-9 flex-none items-center justify-center rounded-lg text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors hidden rail-tampil">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 3v18" /><path d="m14 9 3 3-3 3" /></svg>
                </button>
              </div>
            </div>

            <!--
              Cari halaman admin. Murni di browser: menyaring daftar menu yang
              sudah ada di halaman, tanpa query database. Tekan "/" atau Ctrl+K
              untuk fokus, Enter membuka hasil pertama, Esc menghapus.
            -->
            <div id="admin-cari-wrap" class="px-4 pt-4">
              <label for="admin-cari" class="sr-only">Cari halaman admin</label>
              <div class="relative">
                <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-500 dark:text-cream-300/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input
                  id="admin-cari"
                  type="search"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="Cari halaman… ( / )"
                  class="w-full rounded-xl border border-ink-900/10 dark:border-cream-100/10 bg-transparent py-2 pl-9 pr-3 text-sm placeholder:text-ink-500 dark:placeholder:text-cream-300/50 focus:outline-none focus:ring-2 focus:ring-amber-500/50"
                />
              </div>
            </div>

            <nav id="admin-cari-hasil" class="hidden flex-1 p-4 overflow-y-auto" aria-label="Hasil pencarian halaman" aria-live="polite">
              <ul class="space-y-0.5">
                {indeksCari.map((e) => (
                  <li data-cari-item data-cari-teks={e.teks} hidden>
                    <a
                      href={url(e.node.href!)}
                      class="block rounded-lg px-3 py-2 text-sm hover:bg-ink-900/5 dark:hover:bg-cream-100/5 focus:bg-ink-900/5 dark:focus:bg-cream-100/5 focus:outline-none"
                    >
                      <span class="block font-medium">{e.node.label}</span>
                      {e.jalur.length > 1 && (
                        <span class="block text-xs text-ink-500 dark:text-cream-300/60">{e.jalur.slice(0, -1).join(' › ')}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
              <p id="admin-cari-kosong" class="hidden px-3 py-2 text-sm text-ink-500 dark:text-cream-300/60">Tidak ada halaman yang cocok.</p>
            </nav>

            <nav id="admin-nav" class="flex-1 p-4 overflow-x-auto" aria-label="Navigasi admin">
              <ul class="flex lg:flex-col gap-1">
                {adminMenu.map((m) => (
                  <li>
                    <AdminMenuNode node={m} active={active} />
                  </li>
                ))}
              </ul>
            </nav>

            <div id="admin-sidebar-kaki" class="p-4 border-t border-ink-900/10 dark:border-cream-100/10">
              <div class="px-3 py-2 mb-2">
                <p class="text-sm font-medium" id="admin-name">—</p>
                <p class="text-xs text-ink-500 dark:text-cream-300/60" id="admin-role">—</p>
              </div>
              <button
                type="button"
                id="admin-logout"
                class="w-full rounded-xl border border-ink-900/10 dark:border-cream-100/10 px-3 py-2 text-sm font-medium text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors"
              >
                Keluar
              </button>
            </div>
          </aside>

          <!-- KONTEN -->
          <div class="min-w-0 admin-konten">
            <!-- Tombol buka sidebar + tema, tampil hanya saat sidebar ditutup. -->
            <div id="admin-melayang" class="hidden lg:!hidden fixed left-3 top-3 z-40 items-center gap-0.5 rounded-xl border border-ink-900/10 dark:border-cream-100/10 bg-cream-50 dark:bg-ink-950 p-1 shadow-sm">
              <button type="button" data-sidebar-buka aria-label="Buka sidebar" title="Buka sidebar" class="inline-flex h-9 w-9 flex-none items-center justify-center rounded-lg text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 3v18" /><path d="m14 9 3 3-3 3" /></svg>
              </button>
              <button type="button" data-theme-toggle aria-label="Ganti tema terang atau gelap" title="Tema terang/gelap" class="inline-flex h-9 w-9 flex-none items-center justify-center rounded-lg text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5 transition-colors"><svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg><svg class="block dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg></button>
            </div>
            {jalur.length > 1 && (
              <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 gap-y-1 px-6 lg:px-8 pt-5 text-xs text-ink-500 dark:text-cream-300/60">
                {jalur.map((n, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true">›</span>}
                    {i === jalur.length - 1 ? (
                      <span aria-current="page" class="font-medium text-ink-900 dark:text-cream-100">{n.label}</span>
                    ) : (
                      <span>{n.label}</span>
                    )}
                  </>
                ))}
              </nav>
            )}
            <slot />
          </div>
        </div>
      </>
    ) : (
      <slot />
    )}

    <!--
      Skrip penjaga sesi.

      Ditaruh di level atas template dan BUKAN di dalam `{requireAuth && (...)}`.
      Astro hanya mem-bundle <script> yang bisa dianalisis secara statis; skrip
      di dalam ekspresi kondisional dikirim mentah ke browser, sehingga baris
      `import` di dalamnya langsung gagal ("Cannot use import statement outside
      a module") dan penjagaan tidak pernah berjalan.

      Halaman login memakai requireAuth={false} dan tidak merender #admin-gate,
      jadi ada tidaknya elemen itu yang dipakai sebagai penanda apakah penjagaan
      perlu dijalankan.
    -->
    <script>
      import { requireAdmin, logout } from '@/lib/admin-auth';
      import { url } from '@/utils/url';

      const gate = document.getElementById('admin-gate');
      const shell = document.getElementById('admin-shell');

      if (gate && shell) {
        (async () => {
          const profile = await requireAdmin(url('/admin'));
          if (!profile) return; // requireAdmin sudah melakukan redirect

          const nameEl = document.getElementById('admin-name');
          const roleEl = document.getElementById('admin-role');
          if (nameEl) nameEl.textContent = profile.display_name || profile.username;
          if (roleEl) roleEl.textContent = profile.role;

          gate.remove();
          shell.classList.remove('hidden');

          // Beri tahu halaman bahwa sesi siap, supaya bisa mulai mengambil data.
          document.dispatchEvent(new CustomEvent('admin:ready', { detail: profile }));
        })();

        document.getElementById('admin-logout')?.addEventListener('click', async () => {
          await logout();
          window.location.replace(url('/admin'));
        });
      }
    </script>

    <script>
      // Kotak cari halaman sidebar (data dari server, disaring di browser).
      import { cocokPencarian } from '@/lib/admin-menu';

      (() => {
        const input = document.getElementById('admin-cari') as HTMLInputElement | null;
        const hasil = document.getElementById('admin-cari-hasil');
        const nav = document.getElementById('admin-nav');
        const kosong = document.getElementById('admin-cari-kosong');
        if (!input || !hasil || !nav || !kosong) return;
        const item = [...hasil.querySelectorAll<HTMLElement>('[data-cari-item]')];

        const saring = () => {
          const q = input.value;
          const mencari = q.trim().length > 0;
          nav.classList.toggle('hidden', mencari);
          hasil.classList.toggle('hidden', !mencari);
          let ada = 0;
          for (const li of item) {
            const cocok = mencari && cocokPencarian(li.dataset.cariTeks || '', q);
            li.hidden = !cocok;
            if (cocok) ada++;
          }
          kosong.classList.toggle('hidden', !mencari || ada > 0);
        };

        const tautan = () => item.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLAnchorElement>('a')!);

        input.addEventListener('input', saring);
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            tautan()[0]?.click();
          } else if (e.key === 'Escape') {
            input.value = '';
            saring();
          } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            tautan()[0]?.focus();
          }
        });
        hasil.addEventListener('keydown', (e) => {
          const daftar = tautan();
          const i = daftar.indexOf(document.activeElement as HTMLAnchorElement);
          if (i < 0) return;
          if (e.key === 'ArrowDown') { e.preventDefault(); daftar[i + 1]?.focus(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); (daftar[i - 1] ?? input).focus(); }
          else if (e.key === 'Escape') { input.focus(); }
        });

        document.addEventListener('keydown', (e) => {
          const el = e.target as HTMLElement | null;
          const mengetik = !!el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));
          if ((e.key === '/' && !mengetik && !e.ctrlKey && !e.metaKey) || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) {
            e.preventDefault();
            input.focus();
            input.select();
          }
        });
      })();
    </script>

    <script>
      // Tutup/buka sidebar dan ganti tema. Pilihan disimpan di browser.
      (() => {
        const shell = document.getElementById('admin-shell');
        const melayang = document.getElementById('admin-melayang');
        if (!shell || !melayang) return;
        const KUNCI = 'vanillate-admin-sidebar';
        const atur = (tutup: boolean) => {
          shell.classList.toggle('sidebar-tutup', tutup);
          melayang.classList.toggle('hidden', !tutup);
          melayang.classList.toggle('flex', tutup);
          // Pencarian aktif menyembunyikan menu; kosongkan supaya rail tetap berisi ikon.
          const cari = document.getElementById('admin-cari') as HTMLInputElement | null;
          if (tutup && cari?.value) { cari.value = ''; cari.dispatchEvent(new Event('input')); }
          try { localStorage.setItem(KUNCI, tutup ? 'tutup' : 'buka'); } catch (_) {}
        };
        try { if (localStorage.getItem(KUNCI) === 'tutup') atur(true); } catch (_) {}
        document.querySelectorAll('[data-sidebar-tutup]').forEach((b) => b.addEventListener('click', () => atur(true)));
        document.querySelectorAll('[data-sidebar-buka]').forEach((b) => b.addEventListener('click', () => atur(false)));

        // Mode rail (layar lebar, sidebar ditutup): logo dan ikon kategori membuka
        // sidebar lagi; ikon kategori sekaligus membuka grupnya.
        const rail = () => shell.classList.contains('sidebar-tutup') && window.matchMedia('(min-width: 1024px)').matches;
        document.querySelector('[data-logo]')?.addEventListener('click', (e) => {
          if (!rail()) return;
          e.preventDefault();
          atur(false);
        });
        document.getElementById('admin-nav')?.addEventListener('click', (e) => {
          if (!rail()) return;
          const t = (e.target as HTMLElement).closest<HTMLElement>('[data-grup-toggle][data-top]');
          if (!t) return;
          e.stopImmediatePropagation();
          atur(false);
          const panel = t.parentElement?.querySelector<HTMLElement>(':scope > [data-grup-panel]');
          panel?.classList.remove('hidden');
          t.setAttribute('aria-expanded', 'true');
          t.querySelector<HTMLElement>('[data-grup-chevron]')?.style.setProperty('transform', '');
        }, true);

        document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
          b.addEventListener('click', () => {
            const gelap = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('theme', gelap ? 'dark' : 'light'); } catch (_) {}
          }),
        );
      })();

      // Posisi gulir sidebar diingat antar halaman, supaya pindah halaman tidak
      // melempar menu kembali ke atas.
      (() => {
        const nav = document.getElementById('admin-nav');
        if (!nav) return;
        try {
          const simpan = Number(sessionStorage.getItem('vanillate-admin-nav-scroll'));
          if (simpan > 0) nav.scrollTop = simpan;
        } catch (_) {}
        nav.addEventListener('scroll', () => {
          try { sessionStorage.setItem('vanillate-admin-nav-scroll', String(nav.scrollTop)); } catch (_) {}
        }, { passive: true });
      })();

      // Buka-tutup grup sidebar. Grup halaman yang sedang dibuka selalu
      // terbuka dari server; pilihan manual disimpan supaya bertahan antar
      // halaman. Tanpa JS, grup aktif tetap terlihat (kelas hidden dari server).
      (() => {
        const KUNCI = 'vanillate-admin-grup';
        let tertutup: string[] = [];
        try {
          tertutup = JSON.parse(localStorage.getItem(KUNCI) || '[]');
        } catch (_) {
          tertutup = [];
        }

        document.querySelectorAll<HTMLElement>('[data-grup]').forEach((grup) => {
          const nama = grup.dataset.grup!;
          const tombol = grup.querySelector<HTMLButtonElement>(':scope > [data-grup-toggle]');
          const panel = grup.querySelector<HTMLElement>(':scope > [data-grup-panel]');
          const chevron = grup.querySelector<HTMLElement>(':scope > [data-grup-toggle] [data-grup-chevron]');
          if (!tombol || !panel) return;

          // Grup berisi halaman aktif tidak pernah ikut disembunyikan.
          const punyaAktif = !!panel.querySelector('[aria-current="page"]');
          const setTerbuka = (terbuka: boolean) => {
            panel.classList.toggle('hidden', !terbuka);
            tombol.setAttribute('aria-expanded', String(terbuka));
            if (chevron) chevron.style.transform = terbuka ? '' : 'rotate(-90deg)';
          };

          if (!punyaAktif && tertutup.includes(nama)) setTerbuka(false);

          tombol.addEventListener('click', () => {
            const terbukaSekarang = !panel.classList.contains('hidden');
            setTerbuka(!terbukaSekarang);
            const daftar = new Set(tertutup);
            if (terbukaSekarang) daftar.add(nama);
            else daftar.delete(nama);
            tertutup = [...daftar];
            try { localStorage.setItem(KUNCI, JSON.stringify(tertutup)); } catch (_) {}
          });
        });
      })();
    </script>
  </body>
</html>
