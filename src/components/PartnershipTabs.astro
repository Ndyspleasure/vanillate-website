---
// Sub-navigasi area Partnership.
//
// Partnership punya beberapa halaman yang saling berhubungan (Overview,
// Broadcast, Active Players, dst). Sidebar admin hanya menampilkan satu entri
// "Partnership" supaya tidak penuh; tab inilah yang memindah antar halamannya.
import { url } from '@utils/url';

export interface Props {
  /** Kunci tab yang sedang aktif. */
  active: string;
}

const { active } = Astro.props;

const tabs = [
  { key: 'overview', label: 'Overview',         href: '/admin/partnership' },
  { key: 'broadcast', label: 'Broadcast DM',    href: '/admin/partnership/broadcast' },
  { key: 'players',  label: 'Active Players',   href: '/admin/partnership/active-players' },
  { key: 'history',  label: 'Campaign History', href: '/admin/partnership/history' },
  { key: 'products', label: 'Produk & Harga',   href: '/admin/partnership/products' },
  { key: 'templates', label: 'Templates',       href: '/admin/partnership/templates' },
  { key: 'settings', label: 'Settings',         href: '/admin/partnership/settings' },
];
---

<nav class="px-6 lg:px-10 border-b border-ink-900/10 dark:border-cream-100/10 overflow-x-auto">
  <ul class="flex gap-1 -mb-px">
    {tabs.map((t) => (
      <li>
        <a
          href={url(t.href)}
          class={`inline-block whitespace-nowrap border-b-2 px-3 py-3 text-sm font-medium transition-colors ${
            active === t.key
              ? 'border-amber-500 text-amber-700 dark:text-amber-400'
              : 'border-transparent text-ink-600 dark:text-cream-200/70 hover:text-ink-900 dark:hover:text-cream-100'
          }`}
          aria-current={active === t.key ? 'page' : undefined}
        >
          {t.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
