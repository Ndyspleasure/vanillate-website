---
import { site } from '@data/site';
import { bots } from '@data/bots';
import { pageContent } from '@data/pages';
import { t } from '../i18n/id';

// Deskripsi & teks footer dikelola dari /admin/halaman → tab "Global".
const global = pageContent('global');
import LogoPNG from './LogoPNG.astro';
import Icon from './Icon.astro';
import { buildDirectMailtoUrl, buildDirectWhatsappUrl } from '@data/support';
import { url } from '@utils/url';
const year = new Date().getFullYear();

// Kanal komunikasi resmi. Ikon SVG (satu icon pack) + aria-label agar aksesibel.
// `newTab: false` untuk mailto supaya tidak meninggalkan tab kosong.
const channels = [
  { label: 'Discord Support', href: site.links.discordSupport, icon: 'discord' as const, newTab: true },
  { label: 'WhatsApp Support', href: buildDirectWhatsappUrl(), icon: 'whatsapp' as const, newTab: true },
  { label: 'Email Support', href: buildDirectMailtoUrl(), icon: 'mail' as const, newTab: false },
];
---

<footer class="mt-32 border-t border-ink-900/5 dark:border-cream-100/5">
  <div class="container-page py-16 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2 max-w-sm">
      <div class="inline-flex items-center mb-4">
        <LogoPNG variant="footer" alt={site.name} class="h-10" />
      </div>
      <p class="text-sm text-ink-600 dark:text-cream-300 leading-relaxed">{global.description}</p>
      <div class="mt-6 flex items-center gap-2">
        {channels.map((c) => (
          <a
            href={c.href}
            target={c.newTab ? '_blank' : undefined}
            rel={c.newTab ? 'noopener noreferrer' : undefined}
            aria-label={c.label}
            title={c.label}
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-ink-900/10 dark:border-cream-100/10 text-ink-600 dark:text-cream-300 hover:border-amber-500/50 hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
          >
            <Icon name={c.icon} class="h-5 w-5" />
          </a>
        ))}
      </div>
    </div>

    <div>
      <p class="eyebrow mb-4">Produk</p>
      <ul class="space-y-2">
        {bots.map((bot) => (
          <li>
            <a href={url(`/products/${bot.slug}`)} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">
              {bot.shortName}
            </a>
          </li>
        ))}
        <li>
          <a href={url('/products')} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">
            Semua produk
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="eyebrow mb-4">Tautan</p>
      <ul class="space-y-2">
        <li><a href={url('/about')} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Tentang</a></li>
        <li><a href={url('/faq')} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">FAQ & Panduan</a></li>
        <li><a href={url('/changelog')} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Changelog</a></li>
        <li><a href={url('/partnership')} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Partnership</a></li>
        <li><a href={url('/support')} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Support</a></li>
        <li><a href={url('/support#hubungi-support')} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Hubungi Support</a></li>
        <li><a href={url('/terms')} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">{t.nav.terms}</a></li>
        <li><a href={url('/privacy')} class="text-sm text-ink-700 dark:text-cream-200 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">{t.nav.privacy}</a></li>
      </ul>
    </div>
  </div>

  <div class="hairline">
    <div class="container-page py-6 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-xs text-ink-500 dark:text-cream-300/60">&copy; {year} {site.name}. {t.footer.rights}</p>
      <p class="text-xs text-ink-500 dark:text-cream-300/60 font-mono">{global.footerTagline}</p>
    </div>
  </div>
</footer>
