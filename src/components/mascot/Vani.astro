---
// ═══════════════════════════════════════════════════════════════════════════
// Vani — maskot resmi Vanillate Studio.
//
// Komponen tunggal, dependency-free, yang menampilkan karakter Vani sebagai
// bagian dari visual identity, bukan sekadar gambar tempelan. Dipakai ulang di
// banyak halaman lewat satu API sederhana — tidak perlu menulis <img> manual.
//
//   <Vani />                                  (default, size md, animasi subtle)
//   <Vani variant="hero" size="lg" priority /> (di atas fold, muat lebih awal)
//   <Vani variant="support" size="md" />
//   <Vani variant="error" size="sm" alt="" /> (dekoratif, tak dibaca screen reader)
//
// Prinsip: character first, effects second.
//   • Identitas karakter TIDAK diubah — tanpa filter hue/brightness/contrast,
//     tanpa redraw. Yang menyesuaikan tema hanyalah bingkai, bayangan, dan glow
//     di sekeliling karakter (lihat <style> di bawah).
//   • Aset JPG berlatar terang, jadi Vani dibingkai seperti "potret" — tetap
//     rapi di light maupun dark mode tanpa memaksakan warna baru ke karakter.
//   • Rasio gambar dijaga (object-fit: contain, aspect-ratio terkunci) supaya
//     tidak ada bagian karakter yang terpotong dan tidak ada layout shift.
//   • Semua animasi halus & otomatis mati saat prefers-reduced-motion.
//
// Ekstensi masa depan (§24 brief): saat tersedia aset pose/ekspresi berbeda
// (mis. vani-support.webp), cukup arahkan SOURCES[variant] ke aset baru —
// pemanggilan <Vani variant="support" /> di seluruh situs otomatis ikut.
import { url } from '@utils/url';

export interface Props {
  variant?: 'default' | 'hero' | 'about' | 'support' | 'empty' | 'error';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  animation?: 'none' | 'float' | 'fade' | 'subtle';
  priority?: boolean;
  alt?: string;
  class?: string;
}

const {
  variant = 'default',
  size = 'md',
  animation = 'subtle',
  priority = false,
  alt = 'Vani, maskot Vanillate Studio',
  class: className = '',
} = Astro.props;

// Satu sumber kebenaran untuk aset per-variant. Sekarang semuanya memakai aset
// utama vani.jpg; strukturnya sengaja dibuat agar aset pose/ekspresi baru cukup
// ditambahkan di sini tanpa menyentuh markup atau halaman pemanggil.
const MASCOT = '/mascot/vani.jpg';
const SOURCES: Record<NonNullable<Props['variant']>, string> = {
  default: MASCOT,
  hero: MASCOT,
  about: MASCOT,
  support: MASCOT,
  empty: MASCOT,
  error: MASCOT,
};

const src = url(SOURCES[variant] ?? MASCOT);

// priority=true → muat segera (hero above-the-fold). Selebihnya lazy supaya
// maskot tidak pernah mendahului konten utama saat halaman dibuka.
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;

// alt kosong = murni dekorasi → gambar tidak dibacakan screen reader.
const decorative = alt.trim() === '';
---

<div
  class:list={['vani', className]}
  data-variant={variant}
  data-size={size}
  data-animation={animation}
>
  <!-- Glow/ambient di sekeliling bingkai (bukan pada karakter). Menyesuaikan
       tema; sangat halus agar Vani tidak terasa "AI generated". -->
  <div class="vani__ambient" aria-hidden="true"></div>

  <div class="vani__frame">
    <div class="vani__media">
      <img
        class="vani__img"
        src={src}
        alt={alt}
        width="1200"
        height="896"
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
        draggable="false"
        aria-hidden={decorative ? 'true' : undefined}
      />
    </div>
  </div>
</div>

<style>
  /* ── Layout dasar ────────────────────────────────────────────────────────
     Lebar dikendalikan clamp() per size; tinggi mengikuti aspect-ratio aset
     (1200:896) sehingga ruang sudah dipesan sebelum gambar termuat → tanpa
     layout shift. max-width: 100% menjamin tidak pernah ada overflow. */
  .vani {
    position: relative;
    display: inline-block;
    width: var(--vani-w, clamp(140px, 30vw, 220px));
    max-width: 100%;
    aspect-ratio: 1200 / 896;
    isolation: isolate;
    /* Entrance: sekali saat elemen dirender. Halus & singkat. */
    animation: vani-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Ukuran responsif — semua pakai clamp(min, prefer-vw, max) supaya luwes
     dari mobile kecil sampai wide desktop tanpa breakpoint kaku. */
  .vani[data-size='sm'] { --vani-w: clamp(96px, 20vw, 132px); }
  .vani[data-size='md'] { --vani-w: clamp(140px, 30vw, 220px); }
  .vani[data-size='lg'] { --vani-w: clamp(200px, 40vw, 320px); }
  .vani[data-size='xl'] { --vani-w: clamp(240px, 52vw, 420px); }

  /* ── Bingkai (potret) ────────────────────────────────────────────────────
     Aset berlatar terang; bingkai membuatnya terasa disengaja di kedua tema.
     Yang berubah antar-tema hanya border/shadow/glow, bukan karakter. */
  .vani__frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 1.25rem;
    overflow: hidden;
    /* Light mode */
    border: 1px solid rgba(17, 16, 21, 0.1); /* ink-900/10 */
    background: radial-gradient(115% 90% at 50% 32%, #ffffff 0%, #fbf8f1 60%, #f5efe0 100%);
    box-shadow: 0 20px 60px -30px rgba(11, 10, 14, 0.3);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s ease,
      border-color 0.4s ease;
    will-change: transform;
  }

  .vani__media {
    width: 100%;
    height: 100%;
    /* Float loop hidup di layer ini, terpisah dari entrance (yang ada di
       .vani), sehingga kedua transform tidak saling menimpa. */
    animation: vani-float var(--vani-dur, 4.4s) ease-in-out infinite;
    animation-delay: 0.8s; /* mulai setelah entrance selesai */
  }

  /* Aspek gambar dipertahankan; contain memastikan seluruh karakter (kepala,
     kaki, ekor) selalu utuh dan tidak pernah terpotong. */
  .vani__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* ── Ambient glow ────────────────────────────────────────────────────────
     Berada di belakang bingkai (pada latar halaman), sangat halus. Ini "sentuhan
     tema" untuk dark mode (glow ungu + emas) — di luar karakter, bukan filter. */
  .vani__ambient {
    position: absolute;
    inset: -14%;
    z-index: -1;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(232, 184, 74, 0.18), transparent 72%);
    opacity: 0.7;
    transition: opacity 0.4s ease;
  }

  /* ── Dark mode ───────────────────────────────────────────────────────────
     Bingkai memakai border terang tipis + bayangan lebih dalam + glow emas/ungu
     yang sangat halus. Interior tetap terang agar aset menyatu (potret bercahaya
     di atas latar gelap), tanpa mengubah warna asli Vani. */
  :global(html.dark) .vani__frame {
    border-color: rgba(245, 239, 224, 0.12); /* cream-100/12 */
    box-shadow:
      0 24px 60px -28px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(232, 184, 74, 0.06);
  }

  :global(html.dark) .vani__ambient {
    background:
      radial-gradient(closest-side, rgba(232, 184, 74, 0.16), transparent 70%),
      radial-gradient(closest-side at 65% 75%, rgba(108, 59, 235, 0.14), transparent 72%);
    opacity: 0.85;
  }

  /* ── Hover (desktop pointer halus saja) ──────────────────────────────────
     Sangat ringan: sedikit terangkat + glow menguat. Tidak pernah bergantung
     pada hover — mobile tetap mendapat pengalaman penuh tanpa ini. */
  @media (hover: hover) and (pointer: fine) {
    .vani:hover .vani__frame {
      transform: translateY(-4px) scale(1.015);
      box-shadow: 0 28px 70px -30px rgba(11, 10, 14, 0.38);
    }
    .vani:hover .vani__ambient { opacity: 1; }
    :global(html.dark) .vani:hover .vani__frame {
      box-shadow:
        0 30px 70px -26px rgba(0, 0, 0, 0.7),
        0 0 0 1px rgba(232, 184, 74, 0.12);
    }
  }

  /* ── Varian animasi ──────────────────────────────────────────────────────
     subtle (default): float sangat kecil & lambat.
     float           : float sedikit lebih terasa.
     fade            : hanya entrance, tanpa loop.
     none            : statis penuh. */
  .vani[data-animation='subtle'] .vani__media { --vani-dur: 4.6s; --vani-lift: -3px; }
  .vani[data-animation='float']  .vani__media { --vani-dur: 3.6s; --vani-lift: -6px; }
  .vani[data-animation='fade']   .vani__media,
  .vani[data-animation='none']   .vani__media { animation: none; }
  .vani[data-animation='none'] { animation: none; }

  @keyframes vani-enter {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes vani-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(var(--vani-lift, -3px)); }
  }

  /* ── Reduced motion ──────────────────────────────────────────────────────
     Matikan semua animasi (entrance, float, transisi hover). Vani tetap tampil
     normal sebagai gambar statis. */
  @media (prefers-reduced-motion: reduce) {
    .vani,
    .vani__media { animation: none !important; }
    .vani__frame { transition: none; }
    .vani { opacity: 1; }
  }
</style>
