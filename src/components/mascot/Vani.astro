---
// ═══════════════════════════════════════════════════════════════════════════
// Vani — maskot resmi Vanillate Studio.
//
// Komponen tunggal, dependency-free, yang menampilkan karakter Vani sebagai
// bagian dari visual identity. Dipakai ulang di banyak halaman lewat satu API
// sederhana — tidak perlu menulis <img> manual.
//
//   <Vani />                                   (default, size md, animasi subtle)
//   <Vani variant="hero" size="lg" priority /> (di atas fold, muat lebih awal)
//   <Vani expression="thumbsup" size="sm" />   (pilih pose/ekspresi langsung)
//   <Vani variant="error" alt="" />            (dekoratif, tak dibaca screen reader)
//
// Aset: PNG transparan per-ekspresi di /public/mascot/vani/. Karakter "melayang"
// (tanpa kotak/bingkai putih); yang menyesuaikan tema hanya bayangan & glow
// halus di sekelilingnya — identitas & warna karakter tidak pernah diubah
// (tanpa filter hue/brightness/contrast, tanpa redraw).
//
// Dua cara memilih gambar:
//   • variant   → makna penempatan (hero/support/dst), dipetakan ke satu
//                 ekspresi default lewat VARIANT_EXPRESSION.
//   • expression→ pilih pose spesifik langsung; menimpa pemetaan variant.
//
// Menambah pose baru cukup: taruh PNG di /public/mascot/vani/ lalu daftarkan di
// SOURCES (nama → dimensi) — tidak perlu menyentuh markup atau halaman pemanggil.
import { url } from '@utils/url';

type Variant = 'default' | 'hero' | 'about' | 'support' | 'empty' | 'error';
type Expression =
  | 'default' | 'wave' | 'happy' | 'celebrate' | 'thinking' | 'thumbsup'
  | 'support' | 'oops' | 'peek' | 'point-left' | 'point-right' | 'sleeping'
  | 'lineup';

export interface Props {
  variant?: Variant;
  expression?: Expression;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  animation?: 'none' | 'float' | 'fade' | 'subtle';
  priority?: boolean;
  alt?: string;
  class?: string;
}

const {
  variant = 'default',
  expression,
  size = 'md',
  animation = 'subtle',
  priority = false,
  alt = 'Vani, maskot Vanillate Studio',
  class: className = '',
} = Astro.props;

// Dimensi intrinsik tiap aset (setelah trim). Dipakai untuk mengunci
// aspect-ratio → tidak ada layout shift, dan proporsi karakter terjaga.
const SOURCES: Record<Expression, { file: string; w: number; h: number }> = {
  default:       { file: 'vani-default.png',     w: 771, h: 800 },
  wave:          { file: 'vani-wave.png',        w: 777, h: 800 },
  happy:         { file: 'vani-happy.png',       w: 771, h: 800 },
  celebrate:     { file: 'vani-celebrate.png',   w: 781, h: 800 },
  thinking:      { file: 'vani-thinking.png',    w: 771, h: 800 },
  thumbsup:      { file: 'vani-thumbsup.png',    w: 771, h: 800 },
  support:       { file: 'vani-support.png',     w: 771, h: 800 },
  oops:          { file: 'vani-oops.png',        w: 771, h: 800 },
  peek:          { file: 'vani-peek.png',        w: 611, h: 800 },
  'point-left':  { file: 'vani-point-left.png',  w: 800, h: 784 },
  'point-right': { file: 'vani-point-right.png', w: 800, h: 784 },
  sleeping:      { file: 'vani-sleeping.png',    w: 771, h: 800 },
  lineup:        { file: 'vani-lineup.png',      w: 800, h: 418 },
};

// Ekspresi default untuk tiap variant (penempatan semantik).
const VARIANT_EXPRESSION: Record<Variant, Expression> = {
  default: 'default',
  hero: 'wave',
  about: 'happy',
  support: 'support',
  empty: 'thinking',
  error: 'oops',
};

const resolved = expression ?? VARIANT_EXPRESSION[variant] ?? 'default';
const asset = SOURCES[resolved] ?? SOURCES.default;
const src = url(`/mascot/vani/${asset.file}`);

// priority=true → muat segera (hero above-the-fold). Selebihnya lazy supaya
// maskot tidak pernah mendahului konten utama saat halaman dibuka.
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;

// alt kosong = murni dekorasi → gambar tidak dibacakan screen reader.
const decorative = alt.trim() === '';
---

<div
  class:list={['vani', className]}
  data-size={size}
  data-animation={animation}
  style={`--vani-ar:${asset.w}/${asset.h}`}
>
  <!-- Glow/ambient di belakang karakter (bukan pada karakter). Sangat halus,
       menyesuaikan tema, membantu siluet terbaca di latar apa pun. -->
  <div class="vani__ambient" aria-hidden="true"></div>

  <div class="vani__media">
    <img
      class="vani__img"
      src={src}
      alt={alt}
      width={asset.w}
      height={asset.h}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      draggable="false"
      aria-hidden={decorative ? 'true' : undefined}
    />
  </div>
</div>

<style>
  /* ── Layout dasar ────────────────────────────────────────────────────────
     Lebar dikendalikan clamp() per size; tinggi mengikuti aspect-ratio aset
     sehingga ruang sudah dipesan sebelum gambar termuat → tanpa layout shift.
     max-width: 100% menjamin tidak pernah ada overflow horizontal. */
  .vani {
    position: relative;
    display: inline-block;
    width: var(--vani-w, clamp(150px, 30vw, 240px));
    max-width: 100%;
    aspect-ratio: var(--vani-ar, 771 / 800);
    isolation: isolate;
    animation: vani-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Ukuran responsif — clamp(min, prefer-vw, max), luwes dari mobile kecil
     sampai wide desktop. Cukup besar agar pose & ekspresi tetap jelas. */
  .vani[data-size='sm'] { --vani-w: clamp(110px, 22vw, 150px); }
  .vani[data-size='md'] { --vani-w: clamp(150px, 30vw, 240px); }
  .vani[data-size='lg'] { --vani-w: clamp(210px, 42vw, 360px); }
  .vani[data-size='xl'] { --vani-w: clamp(260px, 54vw, 460px); }

  .vani__media {
    width: 100%;
    height: 100%;
    /* Float loop di layer ini, terpisah dari entrance (di .vani), agar kedua
       transform tidak saling menimpa. */
    animation: vani-float var(--vani-dur, 4.6s) ease-in-out infinite;
    animation-delay: 0.8s;
  }

  /* Karakter melayang transparan. object-fit: contain menjaga seluruh karakter
     (kepala, telinga, kaki, ekor) selalu utuh, tidak pernah terpotong.
     drop-shadow = bayangan pijakan lembut (bukan mengubah karakter). */
  .vani__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    filter: drop-shadow(0 16px 22px rgba(11, 10, 14, 0.22));
    transition: filter 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Ambient glow (halus, di belakang karakter) ──────────────────────────
     Light: hangat vanilla/emas tipis. Menegaskan karakter tanpa "efek AI". */
  .vani__ambient {
    position: absolute;
    inset: 6%;
    z-index: -1;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(232, 184, 74, 0.14), transparent 72%);
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }

  /* ── Dark mode ───────────────────────────────────────────────────────────
     Bayangan lebih dalam + glow emas/ungu sangat halus supaya siluet gelap
     terangkat dari latar gelap. Warna karakter tetap. */
  :global(html.dark) .vani__img {
    filter: drop-shadow(0 18px 26px rgba(0, 0, 0, 0.55));
  }
  :global(html.dark) .vani__ambient {
    background:
      radial-gradient(closest-side, rgba(232, 184, 74, 0.14), transparent 70%),
      radial-gradient(closest-side at 60% 72%, rgba(108, 59, 235, 0.12), transparent 72%);
    opacity: 0.85;
  }

  /* ── Hover (desktop pointer halus saja) ──────────────────────────────────
     Sangat ringan: sedikit terangkat + glow menguat. Tidak pernah bergantung
     pada hover — mobile tetap mendapat pengalaman penuh tanpa ini. */
  @media (hover: hover) and (pointer: fine) {
    .vani:hover .vani__img {
      transform: translateY(-4px) scale(1.02);
      filter: drop-shadow(0 24px 30px rgba(11, 10, 14, 0.28));
    }
    .vani:hover .vani__ambient { opacity: 0.9; }
    :global(html.dark) .vani:hover .vani__img {
      filter: drop-shadow(0 26px 32px rgba(0, 0, 0, 0.6));
    }
  }

  /* ── Varian animasi ──────────────────────────────────────────────────────
     subtle (default): float sangat kecil & lambat.
     float           : float sedikit lebih terasa.
     fade            : hanya entrance, tanpa loop.
     none            : statis penuh. */
  .vani[data-animation='subtle'] .vani__media { --vani-dur: 4.6s; --vani-lift: -3px; }
  .vani[data-animation='float']  .vani__media { --vani-dur: 3.6s; --vani-lift: -6px; }
  .vani[data-animation='fade']   .vani__media,
  .vani[data-animation='none']   .vani__media { animation: none; }
  .vani[data-animation='none'] { animation: none; }

  @keyframes vani-enter {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes vani-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(var(--vani-lift, -3px)); }
  }

  /* ── Reduced motion ──────────────────────────────────────────────────────
     Matikan semua animasi (entrance, float, transisi hover). Vani tetap tampil
     normal sebagai gambar statis. */
  @media (prefers-reduced-motion: reduce) {
    .vani,
    .vani__media { animation: none !important; }
    .vani__img { transition: none; }
    .vani { opacity: 1; }
  }
</style>
