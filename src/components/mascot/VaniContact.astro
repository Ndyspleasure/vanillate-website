---
// ═══════════════════════════════════════════════════════════════════════════
// VaniContact — widget "Hubungi kami" di pojok layar.
//
// Vani (pose peek) mengintip dari sudut kiri-bawah sebagai tombol. Saat diklik,
// muncul panel kecil berisi kanal kontak: Discord, WhatsApp, dan Email —
// semuanya dari satu sumber kebenaran (site.ts / support.ts), tanpa hardcode.
//
// Aksesibilitas: tombol punya aria-expanded + aria-controls; panel bisa ditutup
// dengan Escape atau klik di luar; fokus kembali ke tombol saat ditutup.
// Menghormati prefers-reduced-motion. Ditempatkan di kiri-bawah agar tidak
// bertabrakan dengan tombol "Kembali ke atas" (kanan-bawah).
import { site } from '@data/site';
import {
  supportEmail,
  formatWhatsappNumber,
  buildDirectWhatsappUrl,
  buildDirectMailtoUrl,
} from '@data/support';
import { url } from '@utils/url';

const discordUrl = site.links.discordSupport;
const whatsappUrl = buildDirectWhatsappUrl();
const mailUrl = buildDirectMailtoUrl();
const whatsappDisplay = formatWhatsappNumber();
const peekSrc = url('/mascot/vani/vani-peek.png');
---

<div class="vani-contact" data-vani-contact>
  <!-- Panel kontak -->
  <div id="vani-contact-panel" class="vani-contact__panel" data-vc-panel role="dialog" aria-label="Kontak Vanillate" hidden>
    <div class="vani-contact__head">
      <div>
        <p class="vani-contact__title">Hubungi kami</p>
        <p class="vani-contact__sub">Vani bantu arahkan kamu ke tim.</p>
      </div>
      <button type="button" class="vani-contact__close" data-vc-close aria-label="Tutup">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <a class="vani-contact__item" href={discordUrl} target="_blank" rel="noopener noreferrer">
      <span class="vani-contact__ic vani-contact__ic--discord" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369A19.79 19.79 0 0 0 16.558 3.2a.074.074 0 0 0-.079.037c-.34.607-.719 1.4-.984 2.02a18.27 18.27 0 0 0-5.487 0 12.6 12.6 0 0 0-.997-2.02.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C1.27 7.94.62 11.42.94 14.86a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127c-.598.35-1.22.645-1.873.892a.076.076 0 0 0-.04.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-4.061-.838-7.51-3.549-10.464a.06.06 0 0 0-.031-.028ZM8.02 12.766c-1.183 0-2.157-1.086-2.157-2.42 0-1.334.955-2.42 2.157-2.42 1.21 0 2.176 1.095 2.157 2.42 0 1.334-.956 2.42-2.157 2.42Zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.334.955-2.42 2.157-2.42 1.21 0 2.176 1.095 2.157 2.42 0 1.334-.946 2.42-2.157 2.42Z"/></svg>
      </span>
      <span class="vani-contact__body">
        <span class="vani-contact__label">Discord Server</span>
        <span class="vani-contact__meta">Komunitas &amp; bantuan cepat</span>
      </span>
      <svg class="vani-contact__go" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M17 7H8M17 7v9"/></svg>
    </a>

    <a class="vani-contact__item" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
      <span class="vani-contact__ic vani-contact__ic--wa" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347Zm-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.83 9.83 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.881 9.884Zm8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413Z"/></svg>
      </span>
      <span class="vani-contact__body">
        <span class="vani-contact__label">WhatsApp</span>
        <span class="vani-contact__meta">{whatsappDisplay}</span>
      </span>
      <svg class="vani-contact__go" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M17 7H8M17 7v9"/></svg>
    </a>

    <a class="vani-contact__item" href={mailUrl}>
      <span class="vani-contact__ic vani-contact__ic--mail" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </span>
      <span class="vani-contact__body">
        <span class="vani-contact__label">Email</span>
        <span class="vani-contact__meta">{supportEmail}</span>
      </span>
      <svg class="vani-contact__go" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M17 7H8M17 7v9"/></svg>
    </a>
  </div>

  <!-- Tombol pemicu: Vani mengintip -->
  <button
    type="button"
    class="vani-contact__btn"
    data-vc-toggle
    aria-label="Hubungi kami"
    aria-expanded="false"
    aria-controls="vani-contact-panel"
  >
    <img src={peekSrc} alt="" width="611" height="800" decoding="async" loading="lazy" draggable="false" />
  </button>
</div>

<style>
  .vani-contact {
    position: fixed;
    bottom: 1.25rem;
    left: 1.25rem;
    z-index: 40;
  }

  /* ── Tombol Vani mengintip ─────────────────────────────────────────────── */
  .vani-contact__btn {
    display: block;
    width: clamp(66px, 15vw, 84px);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    line-height: 0;
    filter: drop-shadow(0 10px 16px rgba(11, 10, 14, 0.28));
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
    animation: vc-bob 4.8s ease-in-out infinite;
  }
  .vani-contact__btn img {
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
  :global(html.dark) .vani-contact__btn {
    filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.55));
  }
  @media (hover: hover) and (pointer: fine) {
    .vani-contact__btn:hover { transform: translateY(-3px) scale(1.04); }
  }
  .vani-contact__btn:focus-visible {
    outline: none;
    border-radius: 12px;
    box-shadow: 0 0 0 3px rgba(232, 184, 74, 0.6);
  }

  /* ── Panel kontak ──────────────────────────────────────────────────────── */
  .vani-contact__panel {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    width: clamp(238px, 78vw, 296px);
    max-width: calc(100vw - 2.5rem);
    padding: 0.85rem;
    border-radius: 1rem;
    background: var(--vc-bg, #fbf8f1);
    border: 1px solid rgba(17, 16, 21, 0.1);
    box-shadow: 0 20px 50px -20px rgba(11, 10, 14, 0.35);
    transform-origin: bottom left;
  }
  :global(html.dark) .vani-contact__panel {
    --vc-bg: #1a1820;
    border-color: rgba(245, 239, 224, 0.12);
    box-shadow: 0 24px 56px -22px rgba(0, 0, 0, 0.7);
  }
  @media (prefers-reduced-motion: no-preference) {
    .vani-contact__panel[data-open] {
      animation: vc-pop 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  .vani-contact__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    padding: 0.15rem 0.15rem 0.55rem;
    border-bottom: 1px solid rgba(17, 16, 21, 0.08);
  }
  :global(html.dark) .vani-contact__head { border-color: rgba(245, 239, 224, 0.1); }
  .vani-contact__title {
    font-weight: 600;
    font-size: 0.95rem;
    color: #111015;
  }
  :global(html.dark) .vani-contact__title { color: #fbf8f1; }
  .vani-contact__sub {
    font-size: 0.75rem;
    margin-top: 0.1rem;
    color: #565162;
  }
  :global(html.dark) .vani-contact__sub { color: rgba(245, 239, 224, 0.6); }
  .vani-contact__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: #565162;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .vani-contact__close:hover { background: rgba(17, 16, 21, 0.06); color: #111015; }
  :global(html.dark) .vani-contact__close { color: rgba(245, 239, 224, 0.7); }
  :global(html.dark) .vani-contact__close:hover { background: rgba(245, 239, 224, 0.08); color: #fbf8f1; }

  /* ── Item kanal ────────────────────────────────────────────────────────── */
  .vani-contact__item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem;
    border-radius: 0.7rem;
    text-decoration: none;
    color: #111015;
    transition: background 0.2s ease;
  }
  .vani-contact__item + .vani-contact__item { margin-top: 0.15rem; }
  .vani-contact__item:hover { background: rgba(232, 184, 74, 0.12); }
  :global(html.dark) .vani-contact__item { color: #f5efe0; }
  :global(html.dark) .vani-contact__item:hover { background: rgba(232, 184, 74, 0.14); }
  .vani-contact__item:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgba(232, 184, 74, 0.6);
  }

  .vani-contact__ic {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 0.6rem;
    color: #fff;
  }
  .vani-contact__ic--discord { background: #5865f2; }
  .vani-contact__ic--wa { background: #25d366; }
  .vani-contact__ic--mail { background: linear-gradient(135deg, #e8b84a, #c99a2e); }

  .vani-contact__body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .vani-contact__label { font-size: 0.85rem; font-weight: 600; line-height: 1.2; }
  .vani-contact__meta {
    font-size: 0.72rem;
    margin-top: 0.1rem;
    color: #565162;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(html.dark) .vani-contact__meta { color: rgba(245, 239, 224, 0.6); }
  .vani-contact__go { flex: none; color: #a49b86; }
  .vani-contact__item:hover .vani-contact__go { color: #c99a2e; }

  @keyframes vc-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  @keyframes vc-pop {
    from { opacity: 0; transform: translateY(8px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vani-contact__btn { animation: none; }
    .vani-contact__btn, .vani-contact__panel { transition: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-vani-contact]');
  if (root) {
    const btn = root.querySelector<HTMLButtonElement>('[data-vc-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-vc-panel]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-vc-close]');

    if (btn && panel) {
      const open = () => {
        panel.hidden = false;
        panel.setAttribute('data-open', '');
        btn.setAttribute('aria-expanded', 'true');
        document.addEventListener('keydown', onKey);
        document.addEventListener('click', onOutside, true);
      };
      const close = (focusBtn = false) => {
        panel.hidden = true;
        panel.removeAttribute('data-open');
        btn.setAttribute('aria-expanded', 'false');
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('click', onOutside, true);
        if (focusBtn) btn.focus();
      };
      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape') close(true);
      };
      const onOutside = (e: MouseEvent) => {
        if (!root.contains(e.target as Node)) close();
      };

      btn.addEventListener('click', () => {
        if (panel.hidden) open();
        else close();
      });
      closeBtn?.addEventListener('click', () => close(true));
    }
  }
</script>
