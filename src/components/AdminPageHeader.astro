---
// Judul halaman di area admin. Dipakai semua halaman dashboard supaya
// jarak dan hierarki teksnya seragam.
export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="px-6 lg:px-10 pt-10 pb-6 border-b border-ink-900/10 dark:border-cream-100/10">
  <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">{eyebrow}</p>
  <h1 class="font-display text-2xl md:text-3xl font-semibold tracking-tightest mt-2">{title}</h1>
  {description && (
    <p class="mt-2 max-w-2xl text-sm text-ink-500 dark:text-cream-300/60 leading-relaxed">{description}</p>
  )}
  <slot />
</header>
