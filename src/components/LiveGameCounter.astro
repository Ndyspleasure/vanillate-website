---
// LiveGameCounter.astro
// Penghitung "game sedang berjalan" untuk visualisasi di beranda.
//
// Perilaku angka:
//   • berubah tiap 5 detik,
//   • acak dalam rentang 58–1134,
//   • SINKRON antar-pengunjung — nilainya diturunkan secara deterministik dari
//     "ember waktu" 5 detik (bukan Math.random yang beda tiap browser), lalu
//     di-anchor ke jam server (header Date) sehingga klien dengan jam lokal yang
//     meleset pun melihat angka yang sama pada detik yang sama.
//   • pergantian angka dianimasikan gaya "odometer" — tiap digit menggulung
//     vertikal dari angka lama ke angka baru.
//
// Catatan: ini angka simulasi untuk efek visual, bukan telemetri nyata.

const MIN = 2000;
const MAX = 12000;
const PERIOD_MS = 5000;

// Hash deterministik: ember-waktu → nilai. Fungsi yang sama persis dipakai di
// server (nilai awal, aman tanpa-JS) dan di client, jadi hasilnya identik.
function valueForBucket(bucket: number): number {
  let h = bucket >>> 0;
  h = Math.imul(h ^ (h >>> 16), 2246822507);
  h = Math.imul(h ^ (h >>> 13), 3266489909);
  h = (h ^ (h >>> 16)) >>> 0;
  return MIN + (h % (MAX - MIN + 1));
}

function formatNum(n: number): string {
  return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}

// Nilai awal dari waktu build — sekadar placeholder yang masuk akal untuk
// pengunjung tanpa JS; client langsung mengoreksinya ke nilai tersinkron.
const initial = valueForBucket(Math.floor(Date.now() / PERIOD_MS));
---

<div class="mt-6 max-w-4xl" data-live-game data-min={MIN} data-max={MAX} data-period={PERIOD_MS}>
  <div
    class="flex items-center justify-between gap-4 rounded-2xl border border-ink-900/10 dark:border-cream-100/10 bg-gradient-to-r from-amber-500/[0.08] via-cream-50 to-cream-50 dark:from-amber-500/[0.10] dark:via-ink-950 dark:to-ink-950 px-5 py-5 sm:px-6"
  >
    <div class="flex items-center gap-3.5">
      <span class="relative flex h-2.5 w-2.5 flex-none" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-500/70"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-amber-500"></span>
      </span>
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500 dark:text-cream-300/60">
          Sedang berlangsung
        </p>
        <p class="text-sm font-semibold text-ink-800 dark:text-cream-100">Game berjalan di seluruh server</p>
      </div>
    </div>
    <div class="text-right">
      <span
        class="lgc-odometer font-display text-3xl md:text-4xl font-semibold text-ink-900 dark:text-cream-50"
        data-live-value
        aria-hidden="true"
      >{formatNum(initial)}</span>
      <span class="sr-only" data-live-sr>{formatNum(initial)} sesi aktif</span>
      <span class="block font-mono text-[10px] uppercase tracking-[0.15em] text-ink-400 dark:text-cream-300/50">
        sesi aktif sekarang
      </span>
    </div>
  </div>
</div>

<style is:global>
  /* Odometer angka "live". Kelas diberi prefix lgc- dan dibuat global karena
     elemen digit dibangun via JS (scoped-style Astro tak menjangkaunya). */
  .lgc-odometer {
    display: inline-flex;
    align-items: flex-end;
    line-height: 1;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  .lgc-col {
    position: relative;
    display: inline-block;
    width: 1ch;
    height: 1em;
    overflow: hidden;
  }
  .lgc-reel {
    display: flex;
    flex-direction: column;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .lgc-reel > span {
    display: flex;
    height: 1em;
    line-height: 1;
    align-items: center;
    justify-content: center;
  }
  .lgc-sep {
    display: inline-block;
  }
  @media (prefers-reduced-motion: reduce) {
    .lgc-reel {
      transition: none !important;
    }
  }
</style>

<script>
  // Penggerak counter "game sedang berjalan". Progressive enhancement: tanpa JS,
  // angka awal dari server tetap tampil (statis).
  const root = document.querySelector<HTMLElement>('[data-live-game]');
  const el = root?.querySelector<HTMLElement>('[data-live-value]');
  const sr = root?.querySelector<HTMLElement>('[data-live-sr]');

  if (root && el) {
    const MIN = Number(root.dataset.min) || 2000;
    const MAX = Number(root.dataset.max) || 12000;
    const PERIOD = Number(root.dataset.period) || 5000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Sama persis dengan hash di sisi server → sinkron lintas klien.
    function valueForBucket(bucket: number): number {
      let h = bucket >>> 0;
      h = Math.imul(h ^ (h >>> 16), 2246822507);
      h = Math.imul(h ^ (h >>> 13), 3266489909);
      h = (h ^ (h >>> 16)) >>> 0;
      return MIN + (h % (MAX - MIN + 1));
    }
    function formatNum(n: number): string {
      return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    // ── Odometer: bangun kolom digit yang menggulung ──────────────────────
    function makeReel(): HTMLElement {
      const reel = document.createElement('span');
      reel.className = 'lgc-reel';
      for (let d = 0; d < 10; d++) {
        const cell = document.createElement('span');
        cell.textContent = String(d);
        reel.appendChild(cell);
      }
      return reel;
    }

    // digit sekarang per posisi (satuan=0, puluhan=1, …) untuk titik awal roll.
    let prevFromRight: number[] | null = null;

    function renderValue(value: number, animate: boolean) {
      const digits = String(value);
      const total = digits.length;
      const fromRight = digits.split('').reverse().map(Number);

      const frag = document.createDocumentFragment();
      const pending: { reel: HTMLElement; target: number; rightIndex: number }[] = [];

      for (let i = 0; i < total; i++) {
        const rightIndex = total - 1 - i;
        const digit = Number(digits[i]);
        const col = document.createElement('span');
        col.className = 'lgc-col';
        const reel = makeReel();
        col.appendChild(reel);
        frag.appendChild(col);

        // Titik awal roll: angka lama di posisi yang sama (kalau ada), agar
        // digit menggulung dari nilai sebelumnya ke nilai baru.
        const startDigit =
          animate && prevFromRight && prevFromRight[rightIndex] != null
            ? prevFromRight[rightIndex]
            : digit;
        reel.style.transition = 'none';
        reel.style.transform = `translateY(-${startDigit}em)`;
        pending.push({ reel, target: digit, rightIndex });

        // Pemisah ribuan.
        const posFromRight = total - i;
        if (posFromRight > 1 && (posFromRight - 1) % 3 === 0) {
          const sep = document.createElement('span');
          sep.className = 'lgc-sep';
          sep.textContent = '.';
          frag.appendChild(sep);
        }
      }

      el!.replaceChildren(frag);
      if (sr) sr.textContent = formatNum(value) + ' sesi aktif';

      if (animate) {
        void el!.offsetHeight; // commit posisi awal sebelum menganimasikan
        for (const p of pending) {
          p.reel.style.transition = ''; // pakai transisi dari stylesheet
          p.reel.style.transitionDelay = `${p.rightIndex * 30}ms`;
          p.reel.style.transform = `translateY(-${p.target}em)`;
        }
      }

      prevFromRight = fromRight;
    }

    let offset = 0; // (jam server − jam lokal), dalam ms
    const now = () => Date.now() + offset;

    let lastBucket = -1;
    let first = true;
    function update() {
      const bucket = Math.floor(now() / PERIOD);
      if (bucket === lastBucket) return;
      lastBucket = bucket;
      renderValue(valueForBucket(bucket), !first && !reduced);
      first = false;
    }

    // Jadwalkan pembaruan tepat di batas kelipatan 5 detik (dengan jam server),
    // supaya semua klien berganti angka pada instan yang sama.
    function loop() {
      update();
      const delay = PERIOD - (now() % PERIOD) + 20; // +20ms bantalan lewati batas
      window.setTimeout(loop, delay);
    }

    // Counter langsung hidup memakai jam lokal — tak menunggu jaringan.
    loop();

    // Penyempurnaan sinkronisasi: anchor ke jam server via header Date
    // (same-origin → header terbaca), dijalankan saat idle supaya tidak balapan
    // dengan pemuatan halaman. Bila jam lokal meleset, offset dikoreksi dan
    // tick berikutnya ikut menyesuaikan. Gagal → tetap pakai jam lokal.
    function anchorToServerClock() {
      fetch(window.location.href, { method: 'HEAD', cache: 'no-store' })
        .then((res) => {
          const d = res.headers.get('date');
          if (d) {
            const server = new Date(d).getTime();
            if (Number.isFinite(server)) offset = server - Date.now();
          }
        })
        .catch(() => {});
    }
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(anchorToServerClock, { timeout: 2000 });
    } else {
      window.setTimeout(anchorToServerClock, 500);
    }
  }
</script>
