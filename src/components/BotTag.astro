---
// BotTag.astro — Lencana bergaya tag "APP" Discord.
//
// Meniru tag verifikasi yang muncul di sebelah nama bot di dalam Discord:
// kotak blurple kecil berisi centang + tulisan "APP" untuk aplikasi
// terverifikasi. Dipakai untuk menandai bahwa bot Vanillate adalah aplikasi
// Discord resmi/terverifikasi.
//
// Pakai:
//   <BotTag verified />             → ✓ APP (terverifikasi)
//   <BotTag />                      → APP (aplikasi, tanpa centang)
//   <BotTag verified size="lg" />   → versi lebih besar untuk hero halaman detail
//
// - Warna blurple (#5865F2) mengikuti warna khas tag Discord agar langsung
//   dikenali, dan tampil konsisten di tema terang maupun gelap.
export interface Props {
  verified?: boolean;
  size?: 'sm' | 'lg';
  class?: string;
}

const { verified = false, size = 'sm', class: className = '' } = Astro.props;

const sizeClass =
  size === 'lg'
    ? 'gap-1 rounded-md px-1.5 py-0.5 text-xs'
    : 'gap-0.5 rounded px-1 py-0.5 text-[10px]';

const checkClass = size === 'lg' ? 'h-3.5 w-3.5' : 'h-3 w-3';

const label = verified ? 'Aplikasi Discord terverifikasi' : 'Aplikasi Discord';
---

<span
  class:list={[
    'inline-flex select-none items-center align-middle font-semibold uppercase leading-none tracking-wide text-white bg-[#5865F2]',
    sizeClass,
    className,
  ]}
  role="img"
  aria-label={label}
  title={label}
>
  {verified && (
    <svg
      viewBox="0 0 16 15.2"
      class:list={['-ml-0.5 flex-none', checkClass]}
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M7.4,11.17,4,8.62,5,7.26l2,1.53L10.64,4l1.36,1Z" />
    </svg>
  )}
  <span>App</span>
</span>
