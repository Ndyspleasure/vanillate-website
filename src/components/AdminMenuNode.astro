---
// Satu simpul menu sidebar admin, dirender rekursif (Astro.self) sehingga
// kategori bisa bersarang tanpa batas tingkat. Data: src/lib/admin-menu.ts.
import { url } from '@utils/url';
import { simpulAktif, type MenuNode } from '../lib/admin-menu';

export interface Props {
  node: MenuNode;
  active?: string;
  /** 0 = tingkat teratas (berikon). */
  depth?: number;
}

const { node, active, depth = 0 } = Astro.props;
const aktif = simpulAktif(node, active);
const halamanIni = !!active && (node.key === active || node.match === active);

const baris =
  'flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium whitespace-nowrap transition-colors';
const kelasTop = `${baris} ${
  aktif
    ? 'bg-amber-500/15 text-amber-700 dark:text-amber-400'
    : 'text-ink-600 dark:text-cream-200/70 hover:bg-ink-900/5 dark:hover:bg-cream-100/5'
}`;
const kelasAnak = (ini: boolean, kategori: boolean) =>
  `flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm whitespace-nowrap transition-colors ${
    ini
      ? 'bg-amber-500/10 text-amber-700 dark:text-amber-400 font-medium'
      : `${kategori && aktif ? 'text-ink-900 dark:text-cream-100 font-medium' : 'text-ink-600 dark:text-cream-200/70'} hover:bg-ink-900/5 dark:hover:bg-cream-100/5`
  }`;
---

{node.items ? (
  <div data-grup={node.key}>
    <button
      type="button"
      class={depth === 0 ? kelasTop : kelasAnak(false, true)}
      data-grup-toggle
      data-top={depth === 0 ? '' : undefined}
      aria-label={depth === 0 ? node.label : undefined}
      title={depth === 0 ? node.label : undefined}
      aria-expanded={aktif ? 'true' : 'false'}
    >
      {depth === 0 && node.icon && (
        <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={node.icon} />
      )}
      <span class="flex-1 text-left" data-label>{node.label}</span>
      <svg class="h-3.5 w-3.5 flex-none transition-transform" data-grup-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={aktif ? '' : 'transform: rotate(-90deg)'}>
        <path d="m6 9 6 6 6-6" />
      </svg>
    </button>
    <ul class:list={['mt-1 space-y-0.5 border-l border-ink-900/10 dark:border-cream-100/10 ml-5 pl-1', !aktif && 'hidden']} data-grup-panel>
      {node.items.map((anak) => (
        <li>
          <Astro.self node={anak} active={active} depth={depth + 1} />
        </li>
      ))}
    </ul>
  </div>
) : (
  <>
    <a
      href={url(node.href!)}
      aria-current={halamanIni ? 'page' : undefined}
      class={depth === 0 ? kelasTop : kelasAnak(halamanIni, false)}
      data-top={depth === 0 ? '' : undefined}
      aria-label={depth === 0 ? node.label : undefined}
      title={depth === 0 ? node.label : undefined}
      data-sidebar-tab={node.tab}
      data-sidebar-dinamis={node.dinamis ? node.href : undefined}
    >
      {depth === 0 && node.icon && (
        <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={node.icon} />
      )}
      <span data-label>{node.label}</span>
    </a>
    {node.dinamis && halamanIni && (
      <ul class="mt-1 space-y-0.5 border-l border-ink-900/10 dark:border-cream-100/10 ml-5 pl-1" data-sidebar-tabs-dinamis></ul>
    )}
  </>
)}
